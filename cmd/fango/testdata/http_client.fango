import Bytes
import Fail exposing (Fail)
import Http exposing (Body(..))
import Http.Client as Client
import IO
import Json
import List
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Stream
import Url
import Writer

numbers : Stream.Stream Int Int e
numbers = Stream.unfold 0 { n -> if n < 200000 then Just (n, n + 1) else Nothing }

-- Requests against the server named by the first argument, a base URL.
-- The second argument names a file to upload.
requests : String ->{Client.Http, Fail Client.Error, IO, Fail IO.Error} ()
requests file =
    print (attemptClient { Client.getText "/text" })
    print (attemptClient { Client.getJson @(List Int) "/json" })
    print (case attemptClient { Client.getText "/missing" } of
            Err (Client.BadStatus reply) -> "status " ++ show reply.status ++ " " ++ Bytes.toStringLossy reply.body
            _ -> "unexpected"
    )
    generated = StreamBody { w ->
        case Json.withWriter w { Json.array numbers } of
            Ok _ -> ()
            Err problem -> Fail.fail (Client.Protocol (Http.InvalidMessage problem.message))
    }
    print (Bytes.toStringLossy (Client.post "/count" generated).body)
    print (Bytes.toStringLossy (Client.post "/file" (Http.fileBody file)).body)
    roundTrip = Client.request "POST" "/gzip" |> Client.withBody (BytesBody (Bytes.fromString "round trip")) |> Client.compressRequest
    print (Bytes.toStringLossy (Client.fetch roundTrip).body)
    print (attemptClient { Client.configure { c -> { c | readTimeoutMs = 200 } } { Client.get "/slow" } }
            |> Result.map { _ -> "" }
    )

attemptIO : (() ->{Fail IO.Error | e} a) ->{e} Result IO.Error a
attemptIO action = Fail.attempt action

attemptClient : (() ->{Fail Client.Error | e} a) ->{e} Result Client.Error a
attemptClient action = Fail.attempt action

main() =
    case IO.args() of
        [base, file] ->
            print (attemptIO { attemptClient { Client.run { Client.configure { c -> { c | baseUrl = Url.parse base } } { requests file } } } })
        _ -> IO.exit 2
