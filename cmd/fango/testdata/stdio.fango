import Bytes
import Console exposing (Output(..))
import Process
import Result exposing (Result(..))

line : Maybe IO.Line -> String
line value =
    case value of
        Nothing -> "EOF"
        Just found -> found.text ++ ":" ++ show found.ending

bytes : Maybe Bytes.Bytes -> List Int
bytes value =
    case value of
        Nothing -> []
        Just found -> Bytes.toList found

exercise : () ->{Console} ()
exercise() =
    print (bytes (Console.readBytes 1))
    print (line (Console.readLine()))
    print (bytes (Console.readBytes 1))
    print (line (Console.readLine()))
    print (Console.readBytes 0 == Just Bytes.empty)
    print (line (Console.readLine()))
    print (Console.readBytes 0 == Nothing)
    Console.write "out\n"
    Console.writeTo Stderr "err\n"
    Console.writeBytes Stderr (Bytes.fromList [255, 0, 65])

main() =
    exercise()
    print (Process.args())
    Process.exit Process.success
