import Fail exposing (Fail)
import Http.Client as Client
import IO
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))

-- Fetches the first argument over TLS trusting the CA in the second, then
-- without it, then the third argument, a host the certificate does not name.
outcome : Result Client.Error (Result Client.Unexpected String) -> String
outcome result =
    case result of
        Ok (Ok text) -> text
        Ok (Err _) -> "unexpected status"
        Err (Client.Transport _) -> "rejected"
        Err error -> show error

fetchWith : Maybe String -> String ->{IO} String
fetchWith caFile target =
    config = { Client.defaultConfig | caFile = caFile }
    outcome (Client.attempt { Client.run config { Client.attemptUnexpected { Client.getText target } } })

main() =
    case IO.args() of
        [target, caFile, otherHost] ->
            print (fetchWith (Just caFile) target)
            print (fetchWith Nothing target)
            print (fetchWith (Just caFile) otherHost)
        _ -> IO.exit 2
