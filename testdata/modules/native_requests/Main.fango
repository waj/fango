import Device
import Runtime.NativeRequest
import Runtime.Scope
import Runtime.Coroutine
import Runtime.Work
import Maybe exposing (Maybe(..))

producer : (String ->{Runtime.Coroutine.Suspension} ()) -> () ->{IO, Runtime.Coroutine.Suspension} ()
producer pause () = Runtime.Scope.bracket Device.openDevice Device.closeDevice (\device ->
    Runtime.NativeRequest.scope 1 (\host ->
        case Runtime.NativeRequest.register host (\token -> Device.submit token device 2) (\_ -> print "unexpected callback") of
            Nothing -> print "rejected"
            Just _ ->
                print (Runtime.NativeRequest.counts host)
                pause "running"))

main() = Runtime.Coroutine.scope (\scope ->
    first = Runtime.Work.register (Runtime.Coroutine.facet scope) producer
    second = Runtime.Work.register (Runtime.Coroutine.facet scope) producer
    owner = Runtime.Work.owner scope
    print (Runtime.Work.advance owner first ())
    print (Runtime.Work.advance owner second ())
    print "draining children")
