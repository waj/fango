import Context
import Runtime.Coroutine
import Runtime.Service
import Runtime.Work

make pause () = Runtime.Service.run pause (\_ -> Context.bind 30)

main() = Runtime.Coroutine.with make (\root ->
    case Runtime.Coroutine.advance root () of
        Runtime.Coroutine.Finished context -> Runtime.Coroutine.scope (\scope ->
            first = Runtime.Work.register (Runtime.Coroutine.facet scope) (Context.producer context)
            second = Runtime.Work.register (Runtime.Coroutine.facet scope) (Context.producer context)
            owner = Runtime.Work.owner scope
            print (Runtime.Work.advance owner first ())
            print (Runtime.Work.advance owner second ())
            print (Runtime.Work.advance owner first ())
            print (Runtime.Work.advance owner second ()))
        _ -> print "unexpected")
