module Context exposing (Bound, bind, producer)

import Coroutine
import Service
import Stream

{-# service #-}
effect Dispatch
    submit : Int ->{Service.Invocation Int ()} ()

type Bound = Bound (Int ->{Service.Invocation Int ()} ())

bind offset = handle Bound (\value -> submit value) of
    submit value -> resume (Service.invoke (value + offset))

class Submit context
    deliver : context -> Int ->{Service.Invocation Int ()} ()

instance Submit Bound
    deliver (Bound action) value = action value

forward context value = deliver context value

producer context pause () = Service.run pause (\_ ->
    Stream.toList (Stream.generate (\_ ->
        forward context 1
        Stream.yield "value")))
