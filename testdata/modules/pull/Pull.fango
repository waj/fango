module Pull exposing (Emit, Pull, emit, read, withValues)

import Coroutine exposing (Coroutine, Drive, Step(..))

effect Emit a
    emit : a -> ()

{-# resource #-}
type Pull a e = Pull (Coroutine a () () e)

withValues : (() ->{Emit a | e} ()) -> (Pull a e ->{Drive | e} result) ->{e} result
withValues producer consumer = Coroutine.with
    (\pause _ -> handle producer () of
        emit value -> resume (pause value))
    (\work -> consumer (Pull work))

read : Pull a e ->{Drive | e} Maybe a
read (Pull work) = case Coroutine.advance work () of
    Suspended value -> Just value
    Finished () -> Nothing
    Closed -> Nothing
