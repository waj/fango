module Pull exposing (Pull, read, withValues)
import Iterator

type Pull a e = Pull (Iterator.Iterator a e)

withValues values consumer = consumer (Pull (Iterator.start values ({ pending ->
    case pending of
        [] -> Nothing
        [value | rest] -> Just (value, rest) })))

read (Pull cursor) = case Iterator.next cursor of
    Nothing -> Nothing
    Just (value, next) -> Just (value, Pull next)
