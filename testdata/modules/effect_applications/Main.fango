module Main exposing (main)

import Applied exposing (Put(..), both)

-- Each handler names the application it takes; label order never decides.
dropStrings : (() ->{Put String | e} a) ->{e} a
dropStrings action = handle action() of
    put _ -> resume ()

dropBools : (() ->{Put Bool | e} a) ->{e} a
dropBools action = handle action() of
    put _ -> resume ()

main = if dropBools { dropStrings { both() } } then 42 else 0
