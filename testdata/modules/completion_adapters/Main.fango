import Actions exposing (..)
import Runtime.Completion
import Failure
import Helpers
import Fail

observe flag =
    handle (handle (\_ ->
        completed = Actions.captureAction flag
        case Runtime.Completion.failure completed of
            Just failure -> print (Failure.argumentCount failure)
            Nothing -> print 0
        print (Helpers.replay completed))() of
            reject text number -> print (text ++ show number)) of
        halt reason -> print reason

main() =
    observe True
    observe False
    print (Fail.attempt (\_ ->
        completed = Runtime.Completion.capture (\_ ->
            Fail.fail "saved"
            0)
        case Helpers.inspect completed of
            Just failure -> Failure.argumentCount failure
            Nothing -> 0))
