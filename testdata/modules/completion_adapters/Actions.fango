module Actions exposing (Fault, Halt, reject, halt, Attempt(..), captureAction)

import Helpers

effect Fault
    abort reject : String -> Int -> value

effect Halt
    abort halt : Bool -> value

class Attempt a
    action : a ->{Fault, Halt} Int

instance Attempt Bool
    action flag = if flag then reject "pair" 7 else halt False

captureAction value = Helpers.capture (\_ -> action value)
