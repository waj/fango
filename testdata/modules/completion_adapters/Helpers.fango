module Helpers exposing (capture, replay, inspect)

import Runtime.Completion exposing (Completion)
import Fail
import Failure

capture : (() ->{e} a) ->{e} Completion a e
capture action = Runtime.Completion.capture action

replay : Completion a e ->{e} a
replay completed = Runtime.Completion.replay completed

inspect : Completion Int {Fail.Fail error} -> Maybe Failure.Failure
inspect completed = Runtime.Completion.failure completed
