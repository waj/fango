import Runtime.Coroutine
import Runtime.Work
import Helpers exposing (Box(..))

main() =
    Runtime.Coroutine.with (\pause start ->
        reply = pause (start + 1)
        reply + 2) (\cursor ->
        Runtime.Work.run (\owner ->
            make = Helpers.publisher (Runtime.Work.facet owner)
            item = Box (make cursor)
            print (Helpers.drive owner item 10)
            print (Helpers.drive owner item 20)
            Helpers.close owner item))
