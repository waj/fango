import Coroutine
import Work
import Helpers exposing (Box(..))

main() =
    Coroutine.with (\pause start ->
        reply = pause (start + 1)
        reply + 2) (\cursor ->
        Work.run (\owner ->
            make = Helpers.publisher (Work.facet owner)
            item = Box (make cursor)
            print (Helpers.drive owner item 10)
            print (Helpers.drive owner item 20)
            Helpers.close owner item))
