import Server exposing (Action(..), App, Attempt, Fail(..), Log(..), Pair, Risky, serve, settle, swap)

logged : () ->{App} Int
logged() =
    info "logged"
    1

pureAction() = 2

fromImport : Action
fromImport = Action logged

run (Action action) = serve action

failing : Attempt String
failing() =
    info "failing"
    fail "failed"

twice : Pair Int
twice = swap (1, 2)

main() =
    print (settle failing)
    print twice
    print (run fromImport)
    print (run (Action pureAction))
