import Runtime.Coroutine
import Runtime.Work
import Helpers

main() = Runtime.Coroutine.scope (\scope ->
    cursor = Helpers.allocate scope
    make = Helpers.register (Runtime.Coroutine.facet scope)
    work = make
    print (Runtime.Coroutine.advance cursor 10)
    print (Runtime.Coroutine.advance cursor 20)
    print (Helpers.drive (Runtime.Work.owner scope) work "hello")
    print (Helpers.drive (Runtime.Work.owner scope) work "done"))
