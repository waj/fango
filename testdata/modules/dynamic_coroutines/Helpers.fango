module Helpers exposing (allocate, register, drive)

import Runtime.Coroutine
import Runtime.Work

allocate scope = Runtime.Coroutine.create scope (\pause start ->
    reply = pause (start + 1)
    reply + 2)

register facet = Runtime.Work.register facet (\pause start ->
    reply = pause (start ++ "?")
    reply ++ "!")

drive owner work reply = Runtime.Work.advance owner work reply
