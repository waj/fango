module Consumers exposing (Consumer, escape, make, prefix, run)

import Iterator exposing (Iterator)
import Maybe exposing (Maybe(..))

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{Iterator.Traversal | e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just value -> foldCursor combine (combine value initial) cursor

type Consumer e = Consumer (Iterator Int e ->{Iterator.Traversal | e} Int)

sum : Iterator Int e ->{Iterator.Traversal | e} Int
sum cursor = foldCursor (\element acc -> element + acc) 0 cursor

twice cursor =
    alias = cursor
    first = sum alias
    second = sum cursor
    first + second

make : () -> Consumer e
make() = Consumer twice

run : Consumer e -> Iterator Int e ->{Iterator.Traversal | e} Int
run (Consumer action) cursor = action cursor

prefix : Int ->{IO} (Iterator Int e ->{Iterator.Traversal | e} Int)
prefix extra =
    print "prefix"
    \cursor -> sum cursor + extra

escape : Iterator Int e -> (() -> Iterator Int e)
escape cursor = \_ -> cursor
