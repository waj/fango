import Consumers
import Stream

produce : () ->{Stream.Yield Int, IO} ()
produce() =
    print "produce"
    Stream.yield 1
    Stream.yield 2
    Stream.yield 3

main() =
    print (Stream.withCursor (Stream.generate produce) (Consumers.run (Consumers.make())))
    print (Stream.withCursor (Stream.generate produce) (Consumers.prefix 4))
