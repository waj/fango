import Consumers
import Stream

produce = Stream.unfold 1 ({ value ->
    if value == 1 then print "produce" else ()
    if value > 3 then Nothing else Just (value, value + 1) })

main() =
    print (Stream.withCursor produce (Consumers.run (Consumers.make())))
    print (Stream.withCursor produce (Consumers.prefix 4))
