module Helpers exposing (pair, withValue)

import Runtime.Scope

pair : (() ->{e} Int) -> (() ->{e} Int) ->{e} Int
pair left right = left() + right()

withValue : (() ->{e} Int) -> (Int ->{e} ()) -> (Int ->{e} a) ->{e} a
withValue acquire release action = Runtime.Scope.bracket acquire release action
