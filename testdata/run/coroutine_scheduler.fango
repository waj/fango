import Runtime.Coroutine
import Iterator
import List
import Runtime.Scope
import Stream

type Request = Yield | Wait Int deriving (Show)
type Result = Result String Int deriving (Show)
type Job a = Job String a
type Queue a = Queue (List a) (List a)

enqueue value (Queue front back) = Queue front [value | back]
dequeue (Queue [] []) = Nothing
dequeue (Queue [] back) = dequeue (Queue (List.reverse back) [])
dequeue (Queue [value | rest] back) = Just (value, Queue rest back)

-- One advance returns to this loop; a wait is kept out of the ready queue.
-- Signals are deterministic fake registrations, delivered only when ready is empty.
dispatch : Int -> Queue (Job (Runtime.Coroutine.Coroutine Request () Result {IO | e})) -> List (Int, Job (Runtime.Coroutine.Coroutine Request () Result {IO | e})) ->{Runtime.Coroutine.Drive, IO | e} ()
dispatch budget ready waiting =
    if budget == 0 then print "abandon"
    else
        case dequeue ready of
            Nothing -> case waiting of
                [] -> ()
                [(key, job) | remainingWaits] ->
                    print ("signal " ++ show key)
                    dispatch budget (enqueue job ready) remainingWaits
            Just (Job name work, rest) ->
                print ("run " ++ name)
                step = Runtime.Coroutine.advance work ()
                case step of
                    Runtime.Coroutine.Suspended Yield ->
                        dispatch (budget - 1) (enqueue (Job name work) rest) waiting
                    Runtime.Coroutine.Suspended (Wait key) ->
                        print ("wait " ++ name ++ " " ++ show key)
                        dispatch (budget - 1) rest [(key, Job name work) | waiting]
                    Runtime.Coroutine.Finished result ->
                        print result
                        dispatch (budget - 1) rest waiting
                    Runtime.Coroutine.Closed ->
                        print "unexpected closed"
                    Runtime.Coroutine.Polled ->
                        print "unexpected poll"

rounds : (Request ->{Runtime.Coroutine.Suspension} ()) -> String -> Int ->{Runtime.Coroutine.Suspension, IO} ()
rounds pause name 0 = ()
rounds pause name count =
    print ("yield " ++ name)
    pause Yield
    rounds pause name (count - 1)

first : Int -> (Request ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} Result
first count pause () = Runtime.Scope.finally (\_ ->
    rounds pause "A" count
    -- The scheduler's pause happens while Iterator.next still owns its advance.
    source = Stream.generate (\_ -> Runtime.Scope.finally (\_ ->
        pause (Wait 7)
        Stream.yield 41) (\_ -> print "cleanup stream"))
    value = Stream.withCursor source (\cursor -> Iterator.next cursor)
    case value of
        Just number -> Result "A" (number + 1)
        Nothing -> Result "A" 0) (\_ -> print "cleanup A")

second : Int -> (Request ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} Result
second count pause () = Runtime.Scope.finally (\_ ->
    rounds pause "B" count
    pause Yield
    Result "B" 99) (\_ -> print "cleanup B")

run count budget = Runtime.Coroutine.with (first count) (\a ->
    Runtime.Coroutine.with (second count) (\b ->
        dispatch budget (Queue [Job "A" a, Job "B" b] []) []
        -- Repeated terminal close must not repeat cleanup.
        Runtime.Coroutine.close b
        Runtime.Coroutine.close b
        Runtime.Coroutine.close a
        Runtime.Coroutine.close a
        print (Runtime.Coroutine.advance a ())
        print (Runtime.Coroutine.advance b ())))

main() =
    print "complete"
    run 2 100
    print "early"
    run 2 5
