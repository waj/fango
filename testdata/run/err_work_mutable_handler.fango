import Runtime.Coroutine
import Runtime.Work

effect Counter
    tick : () -> Int

withRead : ((() -> Int) ->{e} a) ->{e} a
withRead use =
    handle use (\_ -> tick()) with current = 0 of
        tick () -> resume current with current + 1

main() =
    withRead (\read ->
        Runtime.Coroutine.with (\_ () -> read()) (\cursor ->
            Runtime.Work.run (\owner ->
                item = Runtime.Work.pack (Runtime.Work.facet owner) cursor
                ())))
