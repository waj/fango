-- Pure parsing through the standard Reader API using specialized handlers.
-- Distinct nominal effects stand in for two reader instances; the test does
-- not claim that the compiler supports fresh scoped effect instances.
import Bytes
import Reader exposing (Reader)

clamp count size = if count < 0 then 0 else if count > size then size else count

effect FirstInput
    firstBuffer : () -> Bytes.Bytes
    firstSkip : Int -> Int

effect SecondInput
    secondBuffer : () -> Bytes.Bytes
    secondSkip : Int -> Int

withFirst : Bytes.Bytes -> (Reader FirstInput ->{FirstInput | e} a) ->{e} a
withFirst bytes action =
    handle action { buffered = firstBuffer, refill = { _ -> False }, skip = firstSkip } with contents = bytes on
        firstBuffer () -> resume contents with contents
        firstSkip wanted ->
            count = clamp wanted (Bytes.length contents)
            resume count with Bytes.slice count (Bytes.length contents) contents

withSecond : Bytes.Bytes -> (Reader SecondInput ->{SecondInput | e} a) ->{e} a
withSecond bytes action =
    handle action { buffered = secondBuffer, refill = { _ -> False }, skip = secondSkip } with contents = bytes on
        secondBuffer () -> resume contents with contents
        secondSkip wanted ->
            count = clamp wanted (Bytes.length contents)
            resume count with Bytes.slice count (Bytes.length contents) contents

parsePair : Reader e -> Reader e ->{e} String
parsePair first second =
    a = Reader.readUpTo first 1
    b = Reader.readUpTo second 1
    c = Reader.readUpTo first 99
    d = Reader.readUpTo second 99
    Bytes.toStringLossy (Bytes.concat [a, b, c, d])

-- The exact pure annotation is part of the test: both cursors are used inside
-- the nested handler and the first still has its own independent position.
parsed : String
parsed = withFirst (Bytes.fromString "abc") ({ first ->
    withSecond (Bytes.fromString "XYZ") ({ second -> parsePair first second }) })

main = parsed
