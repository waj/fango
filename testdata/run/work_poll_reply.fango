import Runtime.Coroutine
import Runtime.Work

countdown n = if n == 0 then () else countdown (n - 1)

producer : (Int ->{Runtime.Coroutine.Suspension} Int) -> Int ->{Runtime.Coroutine.Suspension} Int
producer pause initial =
    countdown 2000
    answer = pause 7
    initial + answer

drive owner work reply polls =
    case Runtime.Work.advance owner work reply of
        Runtime.Coroutine.Polled -> drive owner work reply (polls + 1)
        Runtime.Coroutine.Suspended request ->
            print request
            drive owner work 5 polls
        Runtime.Coroutine.Finished value ->
            print value
            print (polls > 0)
        Runtime.Coroutine.Closed -> print "unexpected close"

main() = Runtime.Coroutine.scope (\scope ->
    work = Runtime.Work.register (Runtime.Coroutine.facet scope) producer
    drive (Runtime.Work.owner scope) work 37 0)
