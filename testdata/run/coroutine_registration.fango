import Runtime.Coroutine
import Runtime.Work
import Fail

effect Dispatch
    context : () -> Runtime.Coroutine.Facet

number : (Int ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension} Int
number pause () =
    pause 1
    42

text : (String ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} String
text pause () =
    print "text started"
    pause "ready"
    "done"

registerAll() =
    a = Runtime.Work.register (context()) number
    b = Runtime.Work.register (context()) text
    (a, b)

main() = Runtime.Coroutine.scope (\scope ->
    (a, b) = handle registerAll() of
        context () -> resume (Runtime.Coroutine.facet scope)
    owner = Runtime.Work.owner scope
    print (Runtime.Work.advance owner a ())
    print (Runtime.Work.advance owner b ())
    print (Runtime.Work.advance owner a ())
    print (Runtime.Work.advance owner b ()))
