import Runtime.Coroutine
import Runtime.Work

select flag first second = if flag then first else second

main() =
    Runtime.Coroutine.with (\_ () -> ()) (\cursor ->
        Runtime.Work.run (\first ->
            Runtime.Work.run (\second ->
                selected = select True first second
                item = Runtime.Work.pack (Runtime.Work.facet selected) cursor
                other = select False first second
                Runtime.Work.close other item)))
