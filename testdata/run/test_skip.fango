import Expect
import Test exposing (Test, describe, skip, test, todo)
import Process

-- Skipped tests and groups count every test they hold, a todo under a skip
-- included, and make the run incomplete.

suite : Test {}
suite =
    describe "skipping"
        [ test "runs" { Expect.equal 1 1 }
        , skip (test "not run" { Expect.equal 1 2 })
        , skip (describe "whole group"
            [ test "not run either" { Expect.failWith "never" }
            , todo "nor written"
            ])
        ]

main() = Process.runSystem { Test.run suite }
