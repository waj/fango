import Runtime.Coroutine
import Runtime.Work
import Fail

schedule : Runtime.Coroutine.Coroutine () () () {Fail.Fail String} ->{Runtime.Coroutine.Drive} ()
schedule cursor =
    Runtime.Work.run (\owner ->
        ignored = Fail.attempt (\_ -> Runtime.Work.pack (Runtime.Work.facet owner) cursor)
        ())

main() = ()
