import Runtime.Coroutine
import Runtime.Service
import Stream

{-# service #-}
effect Dispatch
    submit : Int ->{Runtime.Service.Invocation Int ()} ()

type Bound = Bound (Int ->{Runtime.Service.Invocation Int ()} ())

bind offset = handle Bound (\value -> submit value) of
    submit value -> resume (Runtime.Service.invoke (value + offset))

producer (Bound service) pause () = Runtime.Service.run pause (\_ ->
    Stream.toList (Stream.generate (\_ ->
        service 1
        Stream.yield "first"
        service 2
        Stream.yield "second")))

main() =
    context = bind 20
    Runtime.Coroutine.with (producer context) (\cursor ->
        print (Runtime.Coroutine.advance cursor ())
        print (Runtime.Coroutine.advance cursor ())
        print (Runtime.Coroutine.advance cursor ()))
