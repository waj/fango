import Coroutine
import Service
import Stream

{-# service #-}
effect Dispatch
    submit : Int ->{Service.Invocation Int ()} ()

type Bound = Bound (Int ->{Service.Invocation Int ()} ())

bind offset = handle Bound (\value -> submit value) of
    submit value -> resume (Service.invoke (value + offset))

producer (Bound service) pause () = Service.run pause (\_ ->
    Stream.toList (Stream.generate (\_ ->
        service 1
        Stream.yield "first"
        service 2
        Stream.yield "second")))

main() =
    context = bind 20
    Coroutine.with (producer context) (\cursor ->
        print (Coroutine.advance cursor ())
        print (Coroutine.advance cursor ())
        print (Coroutine.advance cursor ()))
