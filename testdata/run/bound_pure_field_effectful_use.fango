-- A bound closure stored at a pure arrow and projected in a body that performs
-- something. `withAsk`'s clauses perform nothing, so the honest field type
-- names no effect at all, and consumers still get to do their own work while
-- holding the instance. Two activations answer independently.
effect Ask
    ask : () -> String

effect Extra
    bump : Int -> Int

type AskInstance = { askNow : () -> String }

withAsk : String -> (AskInstance ->{e} a) ->{e} a
withAsk str f =
    handle f (AskInstance { askNow = \_ -> ask() }) of
        ask () -> resume str

body : () ->{Extra} String
body() =
    withAsk "Hello" (\hello ->
        withAsk "Bye" (\bye ->
            n = bump 1
            hello.askNow() ++ bye.askNow() ++ (if n > 1 then "!" else "?")))

main() =
    text =
        handle body() of
            bump n -> resume (n + 1)
    print text
