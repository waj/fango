effect Exception ex
    abort throw : ex -> a

finally : (() ->{Exception ex | e} a) -> (() ->{e} ()) ->{Exception ex | e} a
finally action cleanup =
    handle action() on
        throw msg ->
            cleanup()
            throw msg
        return result ->
            cleanup()
            result

catch : (() ->{Exception ex | e} a) -> (ex ->{e} a) ->{e} a
catch action handler =
    handle action() on
        throw msg -> handler msg
        return result -> result

main() =
    catch
        ({ _ -> finally ({ _ -> throw "boom" }) ({ _ -> print "cleanup" }) })
        ({ msg -> print msg })
