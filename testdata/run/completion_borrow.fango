import Runtime.Completion
import Runtime.Scope

type Port = { emit : String ->{IO} () }

effect Escape
    abort escape : (String ->{IO} ()) -> Int

main() =
    Runtime.Scope.bracket (\_ -> Port { emit = print }) (\_ -> ()) (\port ->
        handle (\_ ->
            completed = Runtime.Completion.capture (\_ -> escape port.emit)
            Runtime.Completion.replay completed)() of
            escape emit -> emit "live resource"
            return _ -> ())
