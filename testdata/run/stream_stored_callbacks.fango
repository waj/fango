import Stream

type Box e = Box (Int ->{e} Int)

runBox : Box e -> Int ->{e} Int
runBox (Box action) value = action value

makeBox : () ->{IO} Box IO
makeBox() =
    print "factory"
    Box (\value ->
        print value
        value + 1)

type Chain e = End | Link (Box e) (Chain e)

runChain : Chain e -> Int ->{e} Int
runChain chain value = case chain of
    End -> value
    Link box rest -> runChain rest (runBox box value)

class Invoke a
    invoke : a -> Int ->{IO} Int

instance Invoke (Box IO)
    invoke = runBox

once action = Stream.unfold False (\done ->
    if done then Nothing else Just (action(), True))

emit : Invoke a => a -> Stream.Stream Bool Int IO
emit stored = once (\_ -> invoke stored 4)

main() =
    box = makeBox()
    source = once (\_ -> runBox box 4)
    Stream.forEach print source
    Stream.forEach print source
    chain = Link box (Link box End)
    Stream.forEach print (once (\_ -> runChain chain 6))
    Stream.forEach print (emit box)
