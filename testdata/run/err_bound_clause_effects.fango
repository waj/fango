-- Calling a bound closure runs the handler's clauses, so the arrow it is
-- adapted to must allow what those clauses perform.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

noisy : Int -> (Cell ->{IO} a) ->{IO} a
noisy start use =
    handle use (Cell ({ _ -> tick() })) with n = start of
        tick () ->
            print "tick"
            resume n with n + 1

main() =
    noisy 0 ({ c ->
        case c of
            Cell ta -> print (ta()) })
