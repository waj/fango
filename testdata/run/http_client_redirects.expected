  GET /old HTTP/1.1; Host: example.com; 
  GET /new HTTP/1.1; Host: example.com; 
Ok "200 http://example.com/new at GET /new HTTP/1.1"
  POST /see-other HTTP/1.1; Host: example.com; Content-Length: 4; 
  GET /result HTTP/1.1; Host: example.com; 
Ok "200 http://example.com/result at GET /result HTTP/1.1"
  POST /temporary HTTP/1.1; Host: example.com; Content-Length: 4; 
