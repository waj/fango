Ok "200 http://example.com/kept at POST /kept HTTP/1.1"
  POST /temporary HTTP/1.1; Host: example.com; 
Ok "307 http://example.com/temporary "
  GET /elsewhere HTTP/1.1; Host: example.com; Authorization: Bearer secret; 
  GET /landing HTTP/1.1; Host: other.example.com; 
Ok "200 http://other.example.com/landing at GET /landing HTTP/1.1"
  GET /downgrade HTTP/1.1; Host: example.com; 
