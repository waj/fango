import Completion
import Scope

type Port = { emit : String ->{IO} () }

effect Escape
    abort escape : (String ->{IO} ()) -> Int

main() =
    handle Scope.bracket (\_ -> Port { emit = print }) (\_ -> ()) (\port ->
        completed = Completion.capture (\_ -> escape port.emit)
        Completion.replay completed) of
        escape emit -> emit "released resource"
        return _ -> ()
