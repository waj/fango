import Stream
import Runtime.Coroutine
import Iterator
import Maybe exposing (Maybe(..))
import Runtime.Scope

eachCursor : (a ->{e} ()) -> Iterator.Iterator a e ->{Runtime.Coroutine.Drive | e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just value ->
        action value
        eachCursor action cursor

type Cleanup = Cleanup (() ->{Stream.Yield Int} ())

runCleanup (Cleanup cleanup) = cleanup()

main() =
    cleanup = Cleanup (\_ -> Stream.yield 1)
    Stream.withCursor (Stream.generate (\_ ->
        Runtime.Scope.finally (\_ -> ()) (\_ -> runCleanup cleanup))) (eachCursor print)
