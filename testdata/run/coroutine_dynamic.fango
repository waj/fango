import Runtime.Coroutine

makeWork scope = Runtime.Coroutine.create scope (\pause initial ->
    reply = pause (initial + 1)
    reply + 10)

main() = Runtime.Coroutine.scope (\scope ->
    work = makeWork scope
    print (Runtime.Coroutine.advance work 1)
    print (Runtime.Coroutine.advance work 5)
    print (Runtime.Coroutine.advance work 9))
