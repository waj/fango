import Fail
import Scope
import Result exposing (Result(..))

type Port = { emit : String ->{IO} () }

effect Release
    abort release : (String ->{IO} ()) -> ()

main() =
    report = Scope.bracket (\_ -> Port { emit = print }) (\_ -> ()) (\port ->
        handle Fail.attemptReport (\_ -> Scope.finally (\_ -> Fail.fail "body") (\_ -> release port.emit)) of
            release _ -> Ok ())
    ()
