import Runtime.Coroutine
import Runtime.Work
import Fail

failed : (() ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, Fail.Fail String} ()
failed pause () =
    pause ()
    Fail.fail "never started"

register facet =
    ignored = Fail.attempt (\_ -> Runtime.Work.register facet failed)
    ()

main() = print (Fail.attempt (\_ -> Runtime.Coroutine.scope (\scope ->
    register (Runtime.Coroutine.facet scope)
    print "registered")))
