import Runtime.Cell
import Runtime.Completion
import Runtime.Coroutine
import Fail
import Runtime.Scope
import Runtime.Work

action : () ->{IO, Fail.Fail String} String
action() = Runtime.Scope.finally (\_ ->
    Fail.fail "failed"
    "unreachable") (\_ -> print "released")

job : Runtime.Cell.Publisher (Runtime.Completion.Completion String {IO, Fail.Fail String}) -> (() ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO, Fail.Fail String} ()
job cell pause () =
    pause ()
    completed : Runtime.Completion.Completion String {IO, Fail.Fail String}
    completed = Runtime.Completion.capture action
    print (Runtime.Cell.publish cell completed)

observe view = case Runtime.Cell.read view of
    Nothing -> "pending"
    Just completed -> Runtime.Completion.replay completed

main() = print (Fail.attempt (\_ -> Runtime.Coroutine.scope (\scope ->
    cell = Runtime.Cell.create scope
    first = Runtime.Cell.reader cell
    second = Runtime.Cell.reader cell
    child = Runtime.Work.register (Runtime.Coroutine.facet scope) (job cell)
    print (observe first)
    print (Runtime.Work.advance (Runtime.Work.owner scope) child ())
    print (Runtime.Work.advance (Runtime.Work.owner scope) child ())
    print (Fail.attempt (\_ -> observe first))
    print (Fail.attempt (\_ -> observe second)))))
