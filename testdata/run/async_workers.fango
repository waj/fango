import Async

worker : Int -> () ->{Async.Async String} Int
worker number () =
    Async.sleep 1
    number * 2

main() = ignore (Async.run (\_ ->
    first = Async.spawn (worker 21)
    second = Async.spawn (\_ -> worker 10 ())
    print (Async.awaitResult first)
    print (Async.awaitResult second)
    print (Async.awaitResult first)))
