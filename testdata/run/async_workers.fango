import Async

worker : Int -> () ->{Async.Async} Int
worker number () =
    Async.sleep 1
    number * 2

main() = ignore (Async.runOutcome ({ _ ->
    first = Async.spawn (worker 21)
    second = Async.spawn ({ _ -> worker 10 () })
    print (Async.awaitOutcome first)
    print (Async.awaitOutcome second)
    print (Async.awaitOutcome first) }))
