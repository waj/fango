import Runtime.Completion
import Runtime.Coroutine
import Fail
import Failure
import Runtime.Scope

main() =
    print (Fail.attempt (\_ -> Runtime.Coroutine.with
        (\pause () ->
            completed = Runtime.Completion.capture (\_ -> Runtime.Scope.finally (\_ ->
                pause "before"
                Fail.fail "machine body"
                0) (\_ -> Fail.fail "machine cleanup"))
            pause "captured"
            case Runtime.Completion.failure completed of
                Just failure -> print (List.length (Failure.suppressed failure))
                Nothing -> print 0
            Runtime.Completion.replay completed)
        (\work ->
            print (Runtime.Coroutine.advance work ())
            print (Runtime.Coroutine.advance work ())
            print (Runtime.Coroutine.advance work ()))))
    print (Fail.attempt (\_ ->
        completed = Runtime.Completion.capture (\_ -> Runtime.Coroutine.with
            (\pause () -> Runtime.Scope.finally (\_ ->
                pause "opened"
                7) (\_ -> Fail.fail "owner cleanup"))
            (\work ->
                print (Runtime.Coroutine.advance work ())
                9))
        print "owner captured"
        Runtime.Completion.replay completed))
    print (Runtime.Completion.replay (Runtime.Completion.capture (\_ ->
        Fail.attempt (\_ ->
            Fail.fail "local"
            1))))
