import Stream
import File
import Fail

emitLines file = case File.readLine file of
    Nothing -> ()
    Just line ->
        print ("read " ++ line.text)
        Stream.yield line.text
        emitLines file

lines path = Stream.generate (\_ -> File.withFile path emitLines)

pipeline() = Stream.toList (Stream.take 2 (Stream.filter (\line -> line /= "skip") (lines "input.txt")))

main() = print (Fail.attempt pipeline)
