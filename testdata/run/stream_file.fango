import Stream
import File
import Fail

lineStep file = case IO.readLine file of
    Nothing -> Nothing
    Just line ->
        print ("read " ++ line.text)
        Just (line.text, file)

pipeline() = File.withFile "input.txt" ({ file ->
    source = Stream.unfold file lineStep
    Stream.toList (Stream.take 2 (Stream.filter ({ line -> line /= "skip" }) source)) })

main() = print (Fail.attempt pipeline)
