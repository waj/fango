import Runtime.Coroutine
import Runtime.Scope
import Runtime.Work

countdown n = if n == 0 then () else countdown (n - 1)

producer : (() ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} ()
producer pause () = Runtime.Scope.finally
    (\_ ->
        countdown 10000
        pause ())
    (\_ ->
        countdown 10000
        print "released")

start owner work =
    case Runtime.Work.advance owner work () of
        Runtime.Coroutine.Polled -> start owner work
        Runtime.Coroutine.Suspended _ -> ()
        _ -> print "unexpected start"

main() = Runtime.Coroutine.scope (\scope ->
    work = Runtime.Work.register (Runtime.Coroutine.facet scope) producer
    owner = Runtime.Work.owner scope
    start owner work
    Runtime.Work.close owner work
    print "closed")
