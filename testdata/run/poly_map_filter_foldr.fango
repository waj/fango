type Chain a = Empty | Link a (Chain a) deriving (Eq, Show)

map : (a -> b) -> Chain a -> Chain b
map f xs =
    case xs of
        Empty -> Empty
        Link x rest -> Link (f x) (map f rest)

filter : (a -> Bool) -> Chain a -> Chain a
filter p xs =
    case xs of
        Empty -> Empty
        Link x rest -> if p x then Link x (filter p rest) else filter p rest

foldr : (a -> b -> b) -> b -> Chain a -> b
foldr f z xs =
    case xs of
        Empty -> z
        Link x rest -> f x (foldr f z rest)

upto : Int -> Chain Int
upto n = if n < 1 then Empty else Link n (upto (n - 1))

main =
    xs = upto 10
    small = filter ({ x -> x < 6 }) xs
    print (foldr ({ x acc -> x + acc }) 0 (map ({ x -> x * x }) small))
