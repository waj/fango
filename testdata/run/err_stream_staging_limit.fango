import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Meta exposing (Code)

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator state a e ->{e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just (value, next) -> foldCursor combine (combine value initial) next

spin = Stream.unfold () ({ _ -> Just (0, ()) })

count : () -> Int
count() = Stream.withCursor spin ({ cursor -> foldCursor ({ element acc -> element + acc }) 0 cursor })

main() = print $(Meta.lift (count()))
