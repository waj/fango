import Runtime.Coroutine
import Runtime.Service

{-# service #-}
effect Dispatch
    submit : Int ->{Runtime.Service.Invocation Int ()} ()

action() =
    submit 1
    submit 2
    42

producer pause () = Runtime.Service.run pause (\_ ->
    handle action() of
        submit value -> resume (Runtime.Service.invoke (value + 10)))

main() = Runtime.Coroutine.with producer (\cursor ->
    print (Runtime.Coroutine.advance cursor ())
    print (Runtime.Coroutine.advance cursor ())
    print (Runtime.Coroutine.advance cursor ()))
