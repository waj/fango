import Fail
import File
import Reader
import State
import Result exposing (Result(..))

main() =
    result = Fail.attempt ({ _ ->
        wrapped = File.withFile "input.txt" ({ file -> Just file })
        case wrapped of
            Just file -> IO.readLine file
            Nothing -> Nothing })
    print (case result of
        Err _ -> True
        Ok _ -> False)
