import Runtime.Coroutine

main() = Runtime.Coroutine.with (\outerPause () ->
    Runtime.Coroutine.scope (\scope ->
        work = Runtime.Coroutine.create scope (\innerPause () ->
            ignored = if False then innerPause () else ()
            outerPause "foreign"
            42)
        Runtime.Coroutine.advance work ())) (\outer ->
    print (Runtime.Coroutine.advance outer ())
    print (Runtime.Coroutine.advance outer ())
    print (Runtime.Coroutine.advance outer ()))
