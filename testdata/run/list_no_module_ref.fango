-- Bracket syntax alone: this file builds and matches lists without ever naming
-- the List module, which is the case where the bundled type contributes only
-- its runtime representation and no module-level reference.
sum values =
    case values of
        [] -> 0
        [value | rest] -> value + sum rest

firstTwo values =
    case values of
        [] -> "none"
        [_] -> "one"
        [_, _ | _] -> "many"

main() =
    print (sum [1, 2, 3, 4])
    print (firstTwo [])
    print (firstTwo [9])
    print (firstTwo [9, 8, 7])
    print (sum [0 | [1, 2]])
