import Async
import Async.IO
import Fail
import Runtime.Scope

cancelled() = Runtime.Scope.finally (\_ ->
    Async.IO.sleep 3000
    print "unexpected timer completion") (\_ -> print "timer drained")

main() =
    print (Async.runWithCapacity 0 (\_ -> 1))
    print (Async.runWithCapacity 1 (\_ ->
        first = Async.spawn (\_ -> Async.IO.sleep 1)
        second = Async.spawn (\_ -> Async.IO.sleep 0)
        Async.await first
        Async.await second
        "capacity reused"))
    print (Fail.attempt (\_ -> Async.runWithCapacity 1 (\_ ->
        sleeper = Async.spawn cancelled
        failing = Async.spawn (\_ -> Fail.fail "stop")
        Async.yield()
        1)))
    print (Fail.attempt (\_ -> Async.run (\_ -> Runtime.Scope.finally
        (\_ ->
            Async.IO.sleep 0
            1)
        (\_ -> Fail.fail "cleanup"))))
