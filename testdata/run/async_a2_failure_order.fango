import Async
import Fail
import Failure
import List
import Maybe
import Result exposing (Result(..))
import Runtime.Scope

first() = Runtime.Scope.finally (\_ ->
    Async.yield()
    Fail.fail "first") (\_ -> Fail.fail "first cleanup")

second() = Runtime.Scope.finally (\_ ->
    Async.yield()
    print "second resumed") (\_ -> Fail.fail "second cleanup")

typedArgument : Failure.Failure -> Maybe.Maybe String
typedArgument failure = Failure.argument 0 failure

main() =
    report = Fail.attemptReport (\_ -> Async.run (\_ ->
        firstTask = Async.spawn first
        secondTask = Async.spawn second
        Async.yield()
        1))
    case report of
        Ok value -> print value
        Err detail ->
            print detail.primary
            print (List.map typedArgument detail.suppressed)
