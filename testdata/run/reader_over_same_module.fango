-- The same shape as `reader_over_io`, with the source performing an effect
-- declared in this module. `readAll` drives the reader through the row it is
-- indexed by, so the loop's calls are ordinary direct calls: nothing here
-- exits or suspends.
effect Reading
    buffered : () -> String
    refill : () -> Bool

type Reader e =
    { buffered : () ->{e} String
    , refill : () ->{e} Bool
    }

type Source e = { pull : () ->{e} String }

over : Source e -> (Reader e ->{e} a) ->{e} a
over source use =
    handle use (Reader { buffered = \_ -> buffered(), refill = \_ -> refill() }) with pending = "" of
        buffered () -> resume pending with pending
        refill () ->
            chunk = source.pull()
            resume (chunk /= "") with pending ++ chunk

readAll : Reader e ->{e} String
readAll reader =
    if reader.refill() then readAll reader
    else reader.buffered()

effect Feed
    next : () -> String

main() =
    text =
        handle over (Source { pull = \_ -> next() }) readAll with n = 0 of
            next () ->
                chunk = if n == 0 then "ab" else if n == 1 then "cd" else ""
                resume chunk with n + 1
    print text
