-- Explicit IO references keep independent reader state.
import Runtime.Ref

type Reader e =
    { buffered : () ->{IO | e} String
    , refill : () ->{IO | e} Bool
    }

type Source e = { pull : () ->{e} String }

over : Source e -> (Reader e ->{IO | e} a) ->{IO | e} a
over source use =
    pending = Runtime.Ref.new ""
    use (Reader {
        buffered = \_ -> Runtime.Ref.read pending,
        refill = \_ ->
            chunk = source.pull()
            Runtime.Ref.write pending (Runtime.Ref.read pending ++ chunk)
            chunk /= ""
    })

readAll : Reader e ->{IO | e} String
readAll reader =
    if reader.refill() then readAll reader
    else reader.buffered()

effect Feed
    next : () -> String

main() =
    text =
        handle over (Source { pull = \_ -> next() }) readAll with n = 0 of
            next () ->
                chunk = if n == 0 then "ab" else if n == 1 then "cd" else ""
                resume chunk with n + 1
    print text
