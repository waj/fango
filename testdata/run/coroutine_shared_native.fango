import Runtime.Coroutine
import Runtime.Work
import Runtime.Scope
import Runtime.Native

{-# shared-resource #-}
type Cell = Cell Runtime.Native.Any

new : Int ->{IO} Cell
new = native

increment : Cell ->{IO} ()
increment = native

read : Cell ->{IO} Int
read = native

release : Cell ->{IO} ()
release = native

worker cell pause () = Runtime.Scope.bracket (\_ -> ()) (\_ -> print "child released") (\_ ->
    increment cell
    pause ()
    increment cell
    read cell)

main() = Runtime.Scope.bracket (\_ -> new 0) release (\cell ->
    Runtime.Coroutine.scope (\scope ->
        first = Runtime.Work.register (Runtime.Coroutine.facet scope) (worker cell)
        second = Runtime.Work.register (Runtime.Coroutine.facet scope) (worker cell)
        owner = Runtime.Work.owner scope
        print (Runtime.Work.advance owner first ())
        print (Runtime.Work.advance owner second ())
        print (read cell)
        print (Runtime.Work.advance owner first ())
        print (Runtime.Work.advance owner second ())
        print (read cell)
        abandoned = Runtime.Work.register (Runtime.Coroutine.facet scope) (worker cell)
        print (Runtime.Work.advance owner abandoned ())))
