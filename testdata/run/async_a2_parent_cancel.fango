import Async
import Fail
import Runtime.Scope

nested() = Async.context (\_ ->
    child = Async.spawn (\_ -> Runtime.Scope.finally (\_ ->
        Async.waitSignal 9
        print "not resumed") (\_ -> print "inner released"))
    Async.yield()
    1)

main() = print (Fail.attempt (\_ -> Async.run (\_ ->
    child = Async.spawn nested
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Async.yield()
    Fail.fail "root"
    1)))
