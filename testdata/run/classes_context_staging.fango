class Inspect a
    inspect : a -> String

instance Inspect a
    inspect _ = "fallback"

early() = inspect True
fixedCode() = if early() == "fallback" then `"fallback"` else `"show"`
callerCode x = if inspect x == "fallback" then `"fallback"` else `"show"`

before = $(callerCode True)

instance Show a => Inspect a
    inspect _ = "show"

after = $(callerCode True)
fixed = $(fixedCode())

main() =
    print before
    print after
    print fixed
    print (early())
    print (inspect True)
