import Stream
import Runtime.Scope
import Fail
import Failure
import Result exposing (Result(..))

release label () =
    print ("start " ++ label)
    Stream.yield label
    print ("end " ++ label)
    Fail.fail label

showFailure failure =
    message : Maybe String
    message = Failure.argument 0 failure
    print message

main() =
    result = Fail.attemptReport (\_ -> Stream.forEach print (Stream.generate (\_ ->
        Runtime.Scope.finally
            (\_ -> Runtime.Scope.finally (\_ -> Fail.fail "body") (release "inner"))
            (release "outer"))))
    case result of
        Ok _ -> print "unexpected success"
        Err report ->
            print report.primary
            List.each showFailure report.suppressed
