-- A row literal stands as a type argument wherever the parameter it fills is
-- row-kinded, at the same spellings an arrow's row has: empty, a list of
-- labels with their arguments, and a list with an open tail. Each source's
-- annotation is the only thing fixing its row, and the pure one performs
-- nothing at all.
import Fail exposing (Fail)

type Source e = { pull : () ->{e} String }

pure : Source {}
pure = { pull = \_ -> "pure" }

noisy : Source {IO}
noisy = { pull = \_ ->
    print "pulling"
    "noisy" }

failing : Source {IO, Fail String}
failing = { pull = \_ ->
    print "failing"
    Fail.fail "empty" }

open : Source {IO | e}
open = { pull = \_ ->
    print "open"
    "open" }

drain : Source e ->{e} String
drain source = source.pull()

main() =
    print (drain pure)
    print (drain noisy)
    print (show (Fail.attempt \_ -> drain failing))
    print (drain open)
