import Runtime.Coroutine
main() =
    Runtime.Coroutine.with
        (\pause initial ->
            answer = pause ("hello " ++ initial)
            answer ++ "!")
        (\work ->
            print (Runtime.Coroutine.advance work "Ada")
            print (Runtime.Coroutine.advance work "received")
            print (Runtime.Coroutine.advance work "ignored"))
