-- A concrete specialization used to break a structural instance cycle by
-- giving one head a base case. Instances for a constructed type are composed
-- from their arguments' instances, which cannot consult such a head, so the
-- specialization is refused at its declaration and the cycle stands.
type LeftBox a = LeftBox a
type RightBox a = RightBox a
instance Show (RightBox a) => Show (LeftBox a)
    show left = case left of
        LeftBox value -> show (RightBox value)
instance Show (LeftBox a) => Show (RightBox a)
    show right = case right of
        RightBox value -> show (LeftBox value)
instance Show (RightBox Bool)
    show value = "escape"

main() = print (LeftBox True)
