-- A handled closure cannot be coerced to an arrow that hides its effect.
effect Counter
    tick : () -> Int

type Cell e = { step : () ->{e} Int }

counter : Int -> (Cell e ->{e} a) ->{e} a
counter start action =
    handle action { step = { _ -> tick() } } with n = start on
        tick () -> resume n with n + 1

main() =
    counter 0 ({ a ->
        counter 100 ({ b ->
            print (a.step())
            print (b.step())
            print (a.step()) }) })
