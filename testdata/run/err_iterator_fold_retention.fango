import Stream
import Iterator
import Maybe exposing (Maybe(..))
import State

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{Iterator.Traversal | e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just value -> foldCursor combine (combine value initial) cursor

type Pending = Empty | Saved (() -> Int)

produce : () ->{Stream.Yield Int | e} ()
produce() =
    Stream.yield 1
    Stream.yield 2

retain : a -> Int
retain cursor = 42

consume : Iterator.Iterator Int (State.State (Maybe (() -> Int))) ->{Iterator.Traversal, State.State (Maybe (() -> Int))} ()
consume cursor =
    step element previous =
        case previous of
            Empty -> Saved (\_ -> retain cursor)
            Saved read ->
                State.put (Just read)
                Empty
    unused = foldCursor step Empty cursor
    ()

escape() = State.run Nothing (\_ -> Stream.withCursor (Stream.generate produce) consume)

main() = print "unreachable"
