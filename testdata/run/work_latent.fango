import Coroutine
import Work
import Fail

schedule cursor =
    Work.run (\owner ->
        ignored = Fail.attempt (\_ -> Work.pack (Work.facet owner) cursor)
        ())

main() =
    result = Fail.attempt (\_ ->
        Coroutine.with (\_ () -> Fail.fail "unstarted") (\cursor ->
            schedule cursor
            print "registered"))
    print result
