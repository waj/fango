import Runtime.Coroutine
import Runtime.Work
import Fail

schedule cursor =
    Runtime.Work.run (\owner ->
        ignored = Fail.attempt (\_ -> Runtime.Work.pack (Runtime.Work.facet owner) cursor)
        ())

main() =
    result = Fail.attempt (\_ ->
        Runtime.Coroutine.with (\_ () -> Fail.fail "unstarted") (\cursor ->
            schedule cursor
            print "registered"))
    print result
