import Runtime.Coroutine
import Runtime.Work

producer : (Int ->{Runtime.Coroutine.Suspension} Int) -> Int ->{Runtime.Coroutine.Suspension} Int
producer pause initial =
    value = pause (initial + 1)
    value + 2

main() =
    Runtime.Coroutine.with producer (\cursor ->
        Runtime.Work.run (\owner ->
            item = Runtime.Work.pack (Runtime.Work.facet owner) cursor
            print (Runtime.Work.advance owner item 10)
            print (Runtime.Work.advance owner item 20)
            Runtime.Work.close owner item
            print (Runtime.Work.advance owner item 30)))
