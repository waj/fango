import Stream
import Iterator
import Maybe exposing (Maybe(..))

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator state a e ->{e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just (value, next) -> foldCursor combine (combine value initial) next

type Held state a e = Held (Iterator.Iterator state a e)
type Consumer state e = Consumer (Iterator.Iterator state Int e ->{e} Int)

produce : Stream.Stream (List Int) Int e
produce = Stream.fromList [1, 2, 3]

sumCursor : Iterator.Iterator state Int e ->{e} Int
sumCursor cursor = foldCursor ({ element acc -> element + acc }) 0 cursor

sumHeld (Held cursor) = sumCursor cursor

twice cursor =
    alias = cursor
    read() = sumHeld (Held alias)
    first = read()
    second = sumCursor cursor
    first + second

makeConsumer() = Consumer twice

runStored source =
    case makeConsumer() of
        Consumer consume -> Stream.withCursor source consume

class Consume a
    consume : Iterator.Iterator (List a) a IO ->{IO} Int

instance Consume Int
    consume cursor = sumCursor cursor

independent : Iterator.Iterator state Int e -> (() -> Int)
independent cursor = { _ -> 42 }

main() =
    print (Stream.withCursor produce twice)
    print (runStored produce)
    print (Stream.withCursor produce consume)
    print (Stream.withCursor produce ({ left ->
        Stream.withCursor produce ({ right ->
            a = sumCursor left
            b = sumCursor right
            c = sumCursor left
            a + b + c }) }))
    saved = Stream.withCursor produce independent
    print (saved())
