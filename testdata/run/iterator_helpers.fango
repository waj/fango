import Runtime.Coroutine
import Stream
import Iterator
import Maybe exposing (Maybe(..))

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{Runtime.Coroutine.Drive | e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just value -> foldCursor combine (combine value initial) cursor

type Held a e = Held (Iterator.Iterator a e)
type Consumer e = Consumer (Iterator.Iterator Int e ->{Runtime.Coroutine.Drive | e} Int)

produce : () ->{Stream.Yield Int | e} ()
produce() =
    Stream.yield 1
    Stream.yield 2
    Stream.yield 3

sumCursor : Iterator.Iterator Int e ->{Runtime.Coroutine.Drive | e} Int
sumCursor cursor = foldCursor (\element acc -> element + acc) 0 cursor

sumHeld (Held cursor) = sumCursor cursor

twice cursor =
    alias = cursor
    read() = sumHeld (Held alias)
    first = read()
    second = sumCursor cursor
    first + second

makeConsumer() = Consumer twice

runStored source =
    case makeConsumer() of
        Consumer consume -> Stream.withCursor (Stream.generate source) consume

class Consume a
    consume : Iterator.Iterator a IO ->{Runtime.Coroutine.Drive, IO} Int

instance Consume Int
    consume cursor = sumCursor cursor

independent : Iterator.Iterator Int e -> (() -> Int)
independent cursor = \_ -> 42

main() =
    print (Stream.withCursor (Stream.generate produce) twice)
    print (runStored produce)
    print (Stream.withCursor (Stream.generate produce) consume)
    print (Stream.withCursor (Stream.generate produce) (\left ->
        Stream.withCursor (Stream.generate produce) (\right ->
            a = sumCursor left
            b = sumCursor right
            c = sumCursor left
            a + b + c)))
    saved = Stream.withCursor (Stream.generate produce) independent
    print (saved())
