import Runtime.Async.Cooperative
import Runtime.Cell
import Runtime.Service
import Runtime.Work

early context publisher pause initial = Runtime.Service.run pause (\_ ->
    Runtime.Async.Cooperative.signal 8
    Runtime.Async.Cooperative.signal 8
    Runtime.Async.Cooperative.waitSignal 8
    print "early once"
    published = Runtime.Cell.publish publisher 1
    ())

scripted context publisher pause initial = Runtime.Service.run pause (\_ ->
    print "park"
    Runtime.Async.Cooperative.waitSignal 3
    print "script once"
    published = Runtime.Cell.publish publisher 2
    ())

self context publisher pause initial = Runtime.Service.run pause (\_ ->
    Runtime.Async.Cooperative.waitTask 0
    published = Runtime.Cell.publish publisher 3
    ())

stalled context publisher pause initial = Runtime.Service.run pause (\_ ->
    Runtime.Async.Cooperative.waitSignal 99
    published = Runtime.Cell.publish publisher 4
    ())

unpublished context publisher pause initial = Runtime.Service.run pause (\_ ->
    published = if False then Runtime.Cell.publish publisher 5 else False
    ())

missingChild publisher pause initial = Runtime.Service.run pause (\_ ->
    published = if False then Runtime.Cell.publish publisher 6 else False
    ())

missingRoot context publisher pause initial = Runtime.Service.run pause (\_ ->
    owner = context
    childCell = Runtime.Cell.createIn owner
    childWork = Runtime.Work.register owner (missingChild childCell)
    child = Runtime.Async.Cooperative.spawn context childWork (Runtime.Cell.reader childCell)
    value = Runtime.Async.Cooperative.await child
    published = Runtime.Cell.publish publisher value
    ())

collisionChild publisher pause initial = Runtime.Service.run pause (\_ ->
    print "task one complete"
    published = Runtime.Cell.publish publisher 10
    ())

collisionRoot context publisher pause initial = Runtime.Service.run pause (\_ ->
    owner = context
    childCell = Runtime.Cell.createIn owner
    childWork = Runtime.Work.register owner (collisionChild childCell)
    child = Runtime.Async.Cooperative.spawn context childWork (Runtime.Cell.reader childCell)
    Runtime.Async.Cooperative.waitSignal 1
    published = Runtime.Cell.publish publisher 5
    ())

main() =
    print (Runtime.Async.Cooperative.run [] early)
    print (Runtime.Async.Cooperative.run [3, 3] scripted)
    print (Runtime.Async.Cooperative.run [] self)
    print (Runtime.Async.Cooperative.run [] stalled)
    print (Runtime.Async.Cooperative.run [] unpublished)
    print (Runtime.Async.Cooperative.run [] missingRoot)
    print (Runtime.Async.Cooperative.run [] collisionRoot)
