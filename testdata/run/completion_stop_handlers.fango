import Completion
import Coroutine
import Fail exposing (fail)
import Failure
import Scope

effect Report
    abort report : String -> Int

main() =
    Coroutine.with (\pause () ->
        completed = Completion.capture (\_ -> handle Scope.finally (\_ ->
            pause "ready"
            7) (\_ -> Fail.fail "cleanup") of
            fail message ->
                print ("handled " ++ message)
                0)
        print "published completion"
        9) (\work ->
        print (Coroutine.advance work ())
        Coroutine.close work
        print (Coroutine.advance work ()))
    handle (\_ ->
        completed = Completion.capture (\_ -> Coroutine.with (\pause () ->
            handle Scope.finally (\_ ->
                Scope.finally (\_ ->
                    pause "failure"
                    7) (\_ -> Fail.fail "cleanup body")) (\_ -> Fail.fail "outer cleanup") of
                fail message -> report ("handler " ++ message)) (\work ->
                print (Coroutine.advance work ())
                Coroutine.close work
                0))
        case Completion.failure completed of
            Just failure ->
                print (List.length (Failure.suppressed failure))
                List.each (\secondary -> print (List.length (Failure.suppressed secondary))) (Failure.suppressed failure)
            Nothing -> print 0
        print (Completion.replay completed))() of
        report message -> print message
