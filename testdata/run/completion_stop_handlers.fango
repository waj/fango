import Runtime.Completion
import Runtime.Coroutine
import Fail exposing (fail)
import Failure
import Runtime.Scope

effect Report
    abort report : String -> Int

main() =
    Runtime.Coroutine.with (\pause () ->
        completed = Runtime.Completion.capture (\_ -> handle Runtime.Scope.finally (\_ ->
            pause "ready"
            7) (\_ -> Fail.fail "cleanup") of
            fail message ->
                print ("handled " ++ message)
                0)
        print "published completion"
        9) (\work ->
        print (Runtime.Coroutine.advance work ())
        Runtime.Coroutine.close work
        print (Runtime.Coroutine.advance work ()))
    handle (\_ ->
        completed = Runtime.Completion.capture (\_ -> Runtime.Coroutine.with (\pause () ->
            handle Runtime.Scope.finally (\_ ->
                Runtime.Scope.finally (\_ ->
                    pause "failure"
                    7) (\_ -> Fail.fail "cleanup body")) (\_ -> Fail.fail "outer cleanup") of
                fail message -> report ("handler " ++ message)) (\work ->
                print (Runtime.Coroutine.advance work ())
                Runtime.Coroutine.close work
                0))
        case Runtime.Completion.failure completed of
            Just failure ->
                print (List.length (Failure.suppressed failure))
                List.each (\secondary -> print (List.length (Failure.suppressed secondary))) (Failure.suppressed failure)
            Nothing -> print 0
        print (Runtime.Completion.replay completed))() of
        report message -> print message
