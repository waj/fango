import Fail
import Scope

type Port = { emit : String ->{IO} () }

effect Release
    abort release : (String ->{IO} ()) -> ()

main() =
    report = Fail.attemptReport (\_ ->
        Scope.bracket (\_ -> Port { emit = print }) (\_ -> ()) (\port ->
            handle Scope.finally (\_ -> Fail.fail "body") (\_ -> release port.emit) of
                release _ -> ()))
    ()
