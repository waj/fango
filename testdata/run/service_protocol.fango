import Runtime.Coroutine
import Runtime.Service

{-# service #-}
effect Query request reply
    query : request ->{Runtime.Service.Invocation request reply} reply
    checkpoint : () ->{Runtime.Service.Invocation request reply} reply

calls() =
    first = query "hello"
    second = checkpoint()
    first + second

producer pause initial = Runtime.Service.run pause (\_ -> handle calls() of
    query value -> resume (Runtime.Service.invoke value)
    checkpoint () -> resume (Runtime.Service.invoke "again"))

main() = Runtime.Coroutine.with producer (\cursor ->
    print (Runtime.Coroutine.advance cursor 0)
    print (Runtime.Coroutine.advance cursor 40)
    print (Runtime.Coroutine.advance cursor 2))
