import IO
import Maybe exposing (Maybe(..))

doSomething : () ->{IO} ()
doSomething() = print "do"

doNothing : () -> ()
doNothing() = ()

register : (() ->{IO} ()) ->{IO} ()
register action = action()

identity x = x

collect : (() ->{IO} ()) ->{IO} ()
collect program = program()

main : () ->{IO} ()
main() =
    register doSomething
    saved = identity doSomething
    saved()
    collect doSomething
    case readLine() of
        Nothing -> print ""
        Just line -> print line.text
    if True then doSomething() else doNothing()
