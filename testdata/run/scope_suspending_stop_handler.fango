import Runtime.Coroutine
import Fail exposing (fail)
import Runtime.Scope

main() =
    print (Fail.attempt (\_ -> Runtime.Coroutine.with (\pause () ->
        handle Runtime.Scope.finally (\_ ->
            pause "ready"
            7) (\_ -> Fail.fail "cleanup") of
            fail message ->
                pause ("cleanup handler " ++ message)
                0) (\work ->
        first = Runtime.Coroutine.advance work ()
        print (Runtime.Coroutine.stop work)
        print (Runtime.Coroutine.advance work ()))))
