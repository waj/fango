-- A handled closure cannot be coerced to an arrow that hides its effect.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

counter : Int -> (Cell ->{IO} a) ->{IO} a
counter start action =
    handle action (Cell ({ _ -> tick() })) with n = start on
        tick () -> resume n with n + 1

main() =
    counter 0 ({ outer ->
        case outer of
            Cell ta ->
                print (ta())
                counter 500 ({ _ -> print (ta()) })
                print (ta()) })
