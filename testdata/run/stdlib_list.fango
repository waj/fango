import Console exposing (write)
import List

mark value = if value < 2 then Console.write "a" else Console.write "b"

ints : List.List Int
ints = List.range 0 2

floats : List.List Float
floats = List.range 0 2

empty : List.List Int
empty = List.range 3 2

main() =
    List.each mark ints
    Console.write "|"
    List.each mark floats
    write "|"
    List.each ({ _ -> Console.write "bad" }) empty
    Console.write ""
    Console.write "二"
    print "done"
