import Runtime.Coroutine
import Runtime.Work

main() =
    Runtime.Coroutine.with (\pause () ->
        Runtime.Coroutine.with (\_ () -> pause ()) (\inner ->
            Runtime.Work.run (\owner ->
                item = Runtime.Work.pack (Runtime.Work.facet owner) inner
                ()))) (\outer ->
        ignored = Runtime.Coroutine.advance outer ()
        ())
