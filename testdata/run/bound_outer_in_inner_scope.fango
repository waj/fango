-- Passing an outer activation's record inward is an inner owner retaining an
-- outer resource, which the escape rules permit. The pair is allocated inside
-- the inner counter's scope and holds the outer counter's bound closure.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)
type Both = Both Cell Cell

counter : Int -> (Cell ->{IO} a) ->{IO} a
counter start use =
    handle use (Cell (\_ -> tick())) with n = start of
        tick () -> resume n with n + 1

report : Both ->{IO} ()
report pair =
    case pair of
        Both (Cell ta) (Cell tb) ->
            print (ta())
            print (tb())
            print (ta())

main() =
    counter 0 (\outer ->
        counter 100 (\inner -> report (Both outer inner)))
