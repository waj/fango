import Runtime.NativeRequest
import Runtime.Completion
import Runtime.Coroutine
import Fail
import Failure
import List
import Runtime.Scope

main() =
    print (Runtime.Completion.replay (Runtime.NativeRequest.immediate (\_ -> 42)))
    completed = Runtime.NativeRequest.immediate (\_ -> Runtime.Coroutine.with (\pause () ->
        pause "local"
        7) (\cursor ->
        print (Runtime.Coroutine.advance cursor ())
        print (Runtime.Coroutine.advance cursor ())
        9))
    print (Runtime.Completion.replay completed)
    print (Fail.attempt (\_ ->
        failed = Runtime.NativeRequest.immediate (\_ -> Runtime.Scope.finally (\_ ->
            Fail.fail "body"
            0) (\_ -> Fail.fail "cleanup"))
        case Runtime.Completion.failure failed of
            Just failure -> print (List.length (Failure.suppressed failure))
            Nothing -> print "unexpected success"
        print (Fail.attempt (\_ -> Runtime.Completion.replay failed))
        print (Fail.attempt (\_ -> Runtime.Completion.replay failed))))
