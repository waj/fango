import Bytes
import Encoding
import Json exposing (Decode(..))
import List
import Reader
import Result exposing (Result(..))
import String
import Text.Reader as TextReader

type Count = Count Int deriving (Eq)

-- Custom decoders can decline speculative scanning without changing their
-- streaming semantics, including when nested in generated records/lists.
instance Decode Count
    decodeValue() = Count (decodeValue() + 1)
    scanValue _ = Nothing

type FastCount = FastCount Int deriving (Eq)

instance Decode FastCount
    decodeValue() = FastCount (decodeValue() + 1)
    scanValue cursor =
        scanned : Maybe (Int, Json.Scan)
        scanned = scanValue cursor
        case scanned of
            Nothing -> Nothing
            Just (value, rest) -> Just (FastCount (value + 1), rest)

type Packet = { count : Count, more : List Count } deriving (Decode, Eq)
type FastPacket = { count : FastCount, more : List FastCount } deriving (Decode, Eq)
type Named =
    { value : String  #[Json.Key "é\"key"]
    }
    deriving (Decode, Eq)
type Defaults =
    { value : Int  #[Json.Default `Json.at().offset`]
    }
    deriving (Decode, Eq)
openArrays count =
    if count == 0 then ()
    else
        Json.beginArray()
        openArrays (count - 1)

nested depth = Reader.withBytes (Bytes.fromString (String.padLeft depth '[' "" ++ "{\"é\\\"key\":\"ok\"}")) { reader ->
    Json.withPull reader {
        openArrays depth
        named : Named
        named = decodeValue()
        named.value == "ok"
    }
}

main() =
    print (case Json.parse @Packet "{\"count\":3,\"more\":[4,5]}" of
            Ok packet -> packet == Packet { count = Count 4, more = [Count 5, Count 6] }
            Err _ -> False
    )
    print (case Json.parse @FastPacket "{\"count\":3,\"more\":[4,5]}" of
            Ok packet -> packet == FastPacket { count = FastCount 4, more = [FastCount 5, FastCount 6] }
            Err _ -> False
    )
    print (case Json.parse @Named "{\"é\\\"key\":\"ok\"}" of
            Ok named -> named == Named { value = "ok" }
            Err _ -> False
    )
    print (Reader.withBytes (Bytes.fromList [123, 34, 233, 92, 34, 107, 101, 121, 34, 58, 34, 233, 34, 125]) { bytes ->
            TextReader.overWith Encoding.latin1 bytes { text ->
                case Json.readText @Named text of
                    Ok named -> named == Named { value = "é" }
                    Err _ -> False
            }
    })
    print (case Json.parse @Defaults "{}" of
            Ok defaults -> defaults == Defaults { value = 2 }
            Err _ -> False
    )
    print (case Json.parse @Defaults "{\"value\":9}" of
            Ok defaults -> defaults == Defaults { value = 9 }
            Err _ -> False
    )
    print (case nested 255 of
            Ok valid -> valid
            Err _ -> False
    )
    print (case nested 256 of
            Ok _ -> False
            Err error -> error.message == "JSON nesting exceeds 256 levels" && error.offset == 257
    )
