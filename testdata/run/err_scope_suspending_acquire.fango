import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Scope

eachCursor : (a ->{e} ()) -> Iterator.Iterator a e ->{Iterator.Traversal | e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just value ->
        action value
        eachCursor action cursor

withResource acquire use = Scope.bracket acquire (\_ -> ()) use

main() =
    Stream.withCursor (Stream.generate (\_ ->
        withResource (\_ -> Stream.yield 1) (\_ -> ()))) (eachCursor print)
