import Runtime.Async.Cooperative
import Runtime.Cell
import Runtime.Coroutine
import Runtime.Service
import Runtime.Work

foreignWorker publisher pause initial = Runtime.Service.run pause (\_ ->
    published = Runtime.Cell.publish publisher 7
    ())

root foreign reader context publisher pause initial = Runtime.Service.run pause (\_ ->
    task = Runtime.Async.Cooperative.spawn context foreign reader
    value = Runtime.Async.Cooperative.await task
    published = Runtime.Cell.publish publisher value
    ())

main() = Runtime.Coroutine.scope (\outer ->
    publisher = Runtime.Cell.create outer
    foreign = Runtime.Work.register (Runtime.Coroutine.facet outer) (foreignWorker publisher)
    print (Runtime.Async.Cooperative.run [] (root foreign (Runtime.Cell.reader publisher))))
