import Expect
import Test exposing (Test, describe, test, todo)
import Process

-- A todo is counted without running anything and makes the run incomplete.

suite : Test {}
suite =
    describe "todo"
        [ test "done" { Expect.equal 1 1 }
        , todo "empty separator"
        , todo "unicode separators"
        ]

main() = Process.runSystem { Test.run suite }
