import Dict
import Process
import String

-- Arguments are an effect: the same code reads the real command line under
-- the default handler `main` runs with, and a fixed list under `runWith`.
describe : () ->{Process.Environment} String
describe() =
    case Process.args() of
        [] -> "no arguments"
        args -> String.concat args

main() =
    print describe()
    print (Process.runWith [] Dict.empty describe)
    print (Process.runWith ["x", "y"] Dict.empty describe)
