import Runtime.Scope
import Result exposing (Result(..))

-- A failure raised by a handler's return transformation is still an exit from
-- the enclosing scope, so the release runs before it reaches the outer clause.

effect Fail error
    abort fail : error -> value

effect Note
    say : String -> ()

attempt action =
    handle action() of
        fail error -> Err error
        return value -> Ok value

open label =
    print ("open " ++ label)
    label

close label = print ("close " ++ label)

noted token = say ("note " ++ token)

failingReturn token =
    handle noted token of
        say message ->
            print message
            resume ()
        return _ -> fail ("return failed for " ++ token)

main() =
    outcome = attempt ({ _ ->
        Runtime.Scope.bracket ({ _ -> open "a" }) close failingReturn })
    case outcome of
        Ok value -> print "ok"
        Err error -> print ("err " ++ error)
