import Runtime.Coroutine
import Runtime.Scope
import Fail

unused : (Int ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} Int
unused pause =
    unused pause

complete : (Int ->{Runtime.Coroutine.Suspension} Int) -> Int -> Int
complete _ initial = initial + 1

failed : (Int ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO, Fail.Fail String} Bool
failed pause () = Runtime.Scope.finally (\_ ->
    pause 10
    Fail.fail "body") (\_ -> print "failed release")

type Producer request reply result e = Producer ((request ->{Runtime.Coroutine.Suspension} reply) -> reply ->{Runtime.Coroutine.Suspension | e} result)
failureSource = Producer failed
withProducer (Producer producer) use = Runtime.Coroutine.with producer use

main() =
    Runtime.Coroutine.with unused (\work ->
        Runtime.Coroutine.close work
        Runtime.Coroutine.close work
        print (Runtime.Coroutine.advance work ()))
    Runtime.Coroutine.with complete (\work ->
        print (Runtime.Coroutine.advance work 40)
        print (Runtime.Coroutine.advance work 90)
        Runtime.Coroutine.close work)
    Runtime.Coroutine.with (\pause initial ->
        Runtime.Scope.finally (\_ ->
            print initial
            answer = pause 7
            print answer
            True) (\_ -> print "release")) (\work ->
        alias = work
        print (Runtime.Coroutine.advance work "start")
        print (Runtime.Coroutine.advance alias "reply")
        print (Runtime.Coroutine.advance work "terminal"))
    Runtime.Coroutine.with (\pause () ->
        Runtime.Scope.finally (\_ ->
            pause 8
            pause 9) (\_ -> print "early release")) (\work ->
        print (Runtime.Coroutine.advance work ())
        Runtime.Coroutine.close work
        Runtime.Coroutine.close work
        print (Runtime.Coroutine.advance work ()))
    print (Fail.attempt (\_ -> withProducer failureSource (\work ->
        print (Fail.attempt (\_ -> Runtime.Coroutine.advance work ()))
        print (Fail.attempt (\_ -> Runtime.Coroutine.advance work ()))
        print (Fail.attempt (\_ -> Runtime.Coroutine.advance work ())))))
