import Async
import Fail
import Result exposing (Result(..))

effect Stop
    abort stop : Async.Task Int -> ()

waiter : Int -> () ->{Async.Async} Int
waiter value () =
    Async.sleep 60000
    value

main() =
    ignore (Async.runOutcome ({ _ ->
        child = Async.spawn (waiter 7)
        Async.cancel child
        print (Async.awaitOutcome child)
        print (Async.awaitOutcome child) }))
    handle
        ignore (Async.runOutcome ({ _ ->
            child = Async.spawn (waiter 9)
            stop child }))
    on
        stop child -> print (Async.wait child)
