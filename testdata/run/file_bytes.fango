import Bytes exposing (Bytes)
import Fail exposing (Fail, attempt)
import File
import IO exposing (Error, describeError)
import Result exposing (Result(..))

-- Counted byte reads and writes. `Bytes` crosses the sidecar boundary as a
-- plain `[]byte`, so a file holding something that is not text has a value to
-- live in; a `String` would have rewritten those bytes as U+FFFD.

report : Show a => String -> Result Error a ->{IO} ()
report label outcome =
    case outcome of
        Ok value -> print (label ++ ": " ++ show value)
        Err error -> print (label ++ ": " ++ describeError error)

readAll : IO.Handle -> List Bytes ->{IO, Fail Error} List Bytes
readAll file found =
    case IO.readBytes file 4 of
        Nothing -> List.reverse found
        Just chunk -> readAll file [chunk | found]

main() =
    -- A counted read picks up where a line read left off, because both go
    -- through the handle's own buffered reader.
    report "mixed" (attempt ({ _ -> File.withFile "input.bin" ({ file ->
        first = IO.readLine file
        head =
            case first of
                Nothing -> ""
                Just line -> line.text
        (head, IO.readBytes file 99) }) }))
    -- Short reads, then Nothing at end of file.
    report "counted" (attempt ({ _ -> File.withFile "input.bin" ({ file -> readAll file [] }) }))
    -- A count of zero answers empty, which is not end of file.
    report "empty" (attempt ({ _ -> File.withFile "input.bin" ({ file -> IO.readBytes file 0 }) }))
    -- Writing bytes back and reading them again.
    report "roundtrip" (attempt ({ _ ->
        File.withOutput "out.bin" ({ file -> IO.writeBytes file (Bytes.fromList [255, 0, 65]) })
        File.withFile "out.bin" ({ file -> IO.readBytes file 99 }) }))
    -- The failures are the ordinary ones.
    report "missing" (attempt ({ _ -> File.withFile "missing.bin" ({ file -> IO.readBytes file 1 }) }))
