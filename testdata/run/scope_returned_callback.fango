import Runtime.Scope


type Port = { emit : String ->{IO} (), label : String }

openPort : String -> Port
openPort label = Port { emit = \message -> print (label ++ ": " ++ message), label = label }

main() =
    leaked = Runtime.Scope.bracket (\_ -> openPort "a") (\port -> print ("close " ++ port.label)) (\port -> port.emit)
    leaked "after close"
