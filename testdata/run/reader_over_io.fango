-- Explicit IO references keep independent reader state.
import Runtime.Ref

type Reader e =
    { buffered : () ->{IO | e} String
    , refill : () ->{IO | e} Bool
    }

type Source e = { pull : () ->{e} String }

over : Source e -> (Reader e ->{IO | e} a) ->{IO | e} a
over source use =
    pending = Runtime.Ref.new ""
    use (Reader {
        buffered = \_ -> Runtime.Ref.read pending,
        refill = \_ ->
            chunk = source.pull()
            Runtime.Ref.write pending (Runtime.Ref.read pending ++ chunk)
            chunk /= ""
    })

trace : String ->{IO} String
trace chunk =
    print "pull"
    chunk

main() =
    text =
        over (Source { pull = \_ -> trace "ab" }) (\reader ->
            grew = reader.refill()
            again = reader.refill()
            if grew && again then reader.buffered() else "short")
    print text
