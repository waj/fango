-- `Reader.over`'s shape: a row-polymorphic handler whose clauses reach the
-- source, and therefore perform the abstract row, while its subject hands the
-- callback a record of closures indexed by that same row. The fields do not
-- name `Reading`, so each one binds to the activation whose subject built it
-- and every projected field is the row's arrow — here `IO`.
effect Reading
    buffered : () -> String
    refill : () -> Bool

type Reader e =
    { buffered : () ->{e} String
    , refill : () ->{e} Bool
    }

type Source e = { pull : () ->{e} String }

over : Source e -> (Reader e ->{e} a) ->{e} a
over source use =
    handle use (Reader { buffered = \_ -> buffered(), refill = \_ -> refill() }) with pending = "" of
        buffered () -> resume pending with pending
        refill () ->
            chunk = source.pull()
            resume (chunk /= "") with pending ++ chunk

trace : String ->{IO} String
trace chunk =
    print "pull"
    chunk

main() =
    text =
        over (Source { pull = \_ -> trace "ab" }) (\reader ->
            grew = reader.refill()
            again = reader.refill()
            if grew && again then reader.buffered() else "short")
    print text
