import Maybe exposing (Maybe(..))
import Async exposing (Outcome(..))
import Fail exposing (Fail)
import Result exposing (Result(..))
import Runtime.Ref
import Runtime.Scope

runStrings : (() ->{Async.Async String, IO, Fail String | e} a) ->{IO | e} Outcome (Result String a)
runStrings body = Async.run body

main() =
    shared = Runtime.Ref.new 10
    print (runStrings (\_ ->
        child = Async.spawn (\_ ->
            Runtime.Ref.write shared 42
            \n -> n + Runtime.Ref.read shared)
        callback = Async.await child
        callback 1))
    print (Runtime.Ref.read shared)
    print (runStrings (\_ -> Async.within (\_ -> Async.await (Async.spawn (\_ -> 7)))))
    print (runStrings (\_ -> Fail.attempt (\_ -> Async.within (\_ ->
        ignore (Async.spawn (\_ -> Fail.fail "nested"))
        1))))
    print (runStrings (\_ -> Runtime.Scope.finally
        (\_ ->
            Async.cancelScope()
            Async.checkpoint()
            1)
        (\_ -> print "cancel cleanup")))
    print (runStrings (\_ ->
        ch = Async.channel 1
        ignore (Async.send ch (\n -> n + 2))
        case Async.receive ch of
            Just fn -> fn 40
            Nothing -> Fail.fail "closed"))
