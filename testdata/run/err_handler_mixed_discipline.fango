import State exposing (State, get, put)

effect Fail error
    abort fail : error -> value

-- Abort-only and resumptive applications in one handler await a later stage.
guarded action =
    handle action() with cell = 0 on
        get () -> resume cell with cell
        put n -> resume () with n
        fail : String -> a
        fail _ -> cell
        return value -> value

main() = print (guarded { get() })
