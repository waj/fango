import Expect
import Test exposing (Test, describe, only, test)

-- With `only` in the tree just the focused tests run; the rest count as
-- skipped, and the run is incomplete even though nothing failed.

suite : Test {}
suite =
    describe "focus"
        [ test "would fail" { Expect.equal 1 2 }
        , only (describe "focused"
            [ test "runs" { Expect.equal 1 1 }
            , test "also runs" { Expect.equal 2 2 }
            ])
        , describe "ignored" [ test "would fail" { Expect.equal 1 2 } ]
        , only (test "a focused test" { Expect.equal 3 3 })
        ]

main() = Test.run suite
