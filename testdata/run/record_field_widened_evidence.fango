-- The same widening where the label it adds carries runtime evidence, which
-- is what decides where the adaptation belongs. `read` is stored performing
-- `Cell` alone; the body around the projection performs `Extra` too, so the
-- adapted arrow takes evidence the stored closure never declared. Only the
-- projection can supply it.
effect Cell
    get : () -> Int

effect Extra
    bump : Int -> Int

type Ops e = { read : () ->{Cell | e} Int }

withCell : (Ops e ->{Cell | e} a) ->{e} a
withCell use =
    handle use (Ops { read = { _ -> get() } }) on
        get () -> resume 7

body : () ->{Extra} Int
body() =
    noisy = bump 1
    withCell ({ o -> o.read() + noisy })

main() =
    answer =
        handle body() on
            bump n -> resume (n + 1)
    print answer
