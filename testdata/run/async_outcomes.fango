import Result exposing (Result(..))
import Async
import Fail exposing (Fail)
import Runtime.Scope

job : () ->{Fail String} Int
job() = Fail.fail "missing"

main() =
    print (Async.runOutcome { Async.awaitOutcome (Async.spawnAttempt job) })
    print (Async.runOutcome { Fail.attempt { Fail.fromResult (Async.await (Async.spawnAttempt job)) } })
    print (Fail.attempt { Async.runOutcome { Fail.fromResult (Async.await (Async.spawnAttempt job)) } })
    print (Async.runOutcome {
            ignore (Async.spawnAttempt job)
            123
    })
    print (Async.runOutcome {
            task = Async.completed 42
            (Async.await task, Async.await task)
    })
    print (Fail.attempt { Async.runOutcome { Runtime.Scope.finally job { print "cleanup" } } })
