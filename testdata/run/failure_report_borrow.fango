import Fail
import Scope
import Result exposing (Result(..))

type Port = { emit : String ->{IO} () }

effect Release
    abort release : (String ->{IO} ()) -> ()

main() =
    primary = Scope.bracket (\_ -> Port { emit = print }) (\_ -> ()) (\port ->
        report = handle Fail.attemptReport (\_ -> Scope.finally (\_ -> Fail.fail "body") (\_ -> release port.emit)) of
            release _ -> Ok ()
        case report of
            Err failure -> failure.primary
            Ok _ -> "success")
    print primary
