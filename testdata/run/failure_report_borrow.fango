import Fail
import Runtime.Scope
import Result exposing (Result(..))

type Port = { emit : String ->{IO} () }

effect Release
    abort release : (String ->{IO} ()) -> ()

main() =
    primary = Runtime.Scope.bracket ({ _ -> Port { emit = print } }) ({ _ -> () }) ({ port ->
        report = handle Fail.attemptReport ({ _ -> Runtime.Scope.finally ({ _ -> Fail.fail "body" }) ({ _ -> release port.emit }) }) of
            release _ -> Ok ()
        case report of
            Err failure -> failure.primary
            Ok _ -> "success" })
    print primary
