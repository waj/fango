import Runtime.Coroutine
import Stream
import Iterator
import Maybe exposing (Maybe(..))

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{Runtime.Coroutine.Drive | e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just value -> foldCursor combine (combine value initial) cursor

eachCursor : (a ->{e} ()) -> Iterator.Iterator a e ->{Runtime.Coroutine.Drive | e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just value ->
        action value
        eachCursor action cursor

main() =
    Stream.withCursor (Stream.generate (\_ ->
        Stream.yield 10
        Stream.yield 20
        Stream.yield 30)) (\iterator ->
            eachCursor print iterator)
    total = Stream.withCursor (Stream.generate (\_ ->
        Stream.yield 10
        Stream.yield 20
        Stream.yield 30)) (\iterator ->
            foldCursor (\value -> \sum -> value + sum) 0 iterator)
    print total
