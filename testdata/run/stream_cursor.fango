import Stream
import Iterator
import Maybe exposing (Maybe(..))

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator state a e ->{e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just (value, next) -> foldCursor combine (combine value initial) next

eachCursor : (a ->{e} ()) -> Iterator.Iterator state a e ->{e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just (value, next) ->
        action value
        eachCursor action next

main() =
    source = Stream.fromList [10, 20, 30]
    Stream.withCursor source (eachCursor print)
    print (Stream.withCursor source (foldCursor ({ value sum -> value + sum }) 0))
