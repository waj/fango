import Async
import Async.IO

main() = print (Async.run (\_ ->
    first = Async.race (\_ -> 10) (\_ -> Async.waitSignal 1; 20)
    second = Async.race (\_ -> Async.waitSignal 2; 10) (\_ -> 20)
    quick = Async.IO.timeout 0 (\_ -> 30)
    expired = Async.IO.timeout 2 (\_ -> Async.waitSignal 3; 40)
    invalid = Async.IO.timeout (0 - 1) (\_ -> 0)
    print first
    print second
    print quick
    print expired
    print invalid
    1))
