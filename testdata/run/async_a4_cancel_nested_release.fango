import Async
import Fail
import Runtime.Scope

child() = Runtime.Scope.finally
    (\_ -> Runtime.Scope.finally
        (\_ -> Async.waitSignal 17)
        (\_ ->
            print "inner start"
            Async.yield()
            print "inner end"))
    (\_ ->
        print "outer start"
        Async.yield()
        print "outer end")

root() =
    task = Async.spawn child
    Async.yield()
    Fail.fail "stop"
    ()

main() = print (Fail.attempt (\_ -> Async.run root))
