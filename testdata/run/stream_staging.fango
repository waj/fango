import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Meta exposing (Code)

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator state a e ->{e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just (value, next) -> foldCursor combine (combine value initial) next

produce = Stream.fromList [10, 20, 30]

total : () -> Int
total() = Stream.withCursor produce (\cursor -> foldCursor (\element acc -> element + acc) 0 cursor)

-- A producer factory may already be memoized by an earlier expansion. Its
-- next traversal must use the lowering installed for the current operand.
first : Code
first = quote $(Meta.lift (total()))

answer : Code
answer = quote ($(first) + $(Meta.lift (total())))

seven : Int
seven = 7

main() =
    print $(answer)
    print $(Meta.lift (Stream.withCursor (Stream.fromList [seven]) (\cursor -> foldCursor (\element acc -> element + acc) 0 cursor)))
