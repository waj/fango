import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Meta exposing (Code)

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{Iterator.Traversal | e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just value -> foldCursor combine (combine value initial) cursor

produce : () ->{Stream.Yield Int} ()
produce() =
    Stream.yield 10
    Stream.yield 20
    Stream.yield 30

total : () -> Int
total() = Stream.withCursor (Stream.generate produce) (\cursor -> foldCursor (\element acc -> element + acc) 0 cursor)

-- A producer factory may already be memoized by an earlier expansion. Its
-- next traversal must use the lowering installed for the current operand.
first : Code
first = quote $(Meta.lift (total()))

answer : Code
answer = quote ($(first) + $(Meta.lift (total())))

seven : Int
seven = 7

main() =
    print $(answer)
    print $(Meta.lift (Stream.withCursor (Stream.generate (\_ -> Stream.yield seven)) (\cursor -> foldCursor (\element acc -> element + acc) 0 cursor)))
