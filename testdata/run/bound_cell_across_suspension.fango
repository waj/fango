-- The wrapper runs inside a producer, so its callback suspends and the whole
-- handler is lowered to a state machine. The bound closure's own row is empty,
-- so it stays Direct: the activation installs an ordinary record of clause
-- closures over its state, and the closure keeps counting across the
-- suspensions between yields.
import Stream

effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

counter : Int -> (Cell ->{Counter | e} a) ->{e} a
counter start use =
    handle use (Cell (\_ -> tick())) with n = start of
        tick () -> resume n with n + 1

main() =
    numbers = Stream.generate (\_ ->
        counter 0 (\c ->
            case c of
                Cell ta ->
                    Stream.yield (ta())
                    Stream.yield (ta())
                    Stream.yield (ta())))
    print (Stream.toList numbers)
