type Key a = Key a

effect Put a
    put : a -> ()

both : () ->{Put (Key Bool), Put (Key String)} ()
both() =
    put (Key True)
    put (Key "answer")

-- Each handler names the application it takes; label order never decides.
printStrings : (() ->{Put (Key String), IO | e} a) ->{IO | e} a
printStrings action = handle action() on
    put (Key text) -> print text; resume ()

printBools : (() ->{Put (Key Bool), IO | e} a) ->{IO | e} a
printBools action = handle action() on
    put (Key flag) -> print flag; resume ()

main() = printBools { printStrings { both() } }
