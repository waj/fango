-- Naming the handled effect in the callback's row makes the wrapper
-- transport-polymorphic, so every variant of it is emitted, the Machine one
-- included. The bound closure is Direct in all of them.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

counter : Int -> (Cell ->{Counter, IO} a) ->{IO} a
counter start use =
    handle use (Cell (\_ -> tick())) with n = start of
        tick () -> resume n with n + 1

main() =
    counter 0 (\a ->
        counter 100 (\b ->
            case (a, b) of
                (Cell ta, Cell tb) ->
                    print (ta())
                    print (tb())
                    print (tick())
                    print (ta())))
