import Result exposing (Result(..))
import Task
import Bytes
import State
import List

type Payload = Payload (List Int) Bytes.Bytes
shared = [10, 11, 21]

worker : Task.Context -> Payload ->{IO} (Int, Bytes.Bytes)
worker context payload = case payload of
    Payload numbers bytes ->
        ignore (Task.isCancelled context)
        result = State.run 0 (\_ ->
            List.each (\n -> State.put (State.get() + n)) numbers
            State.get())
        (result.value, bytes)

main() = Task.scope (\scope ->
    tasks = List.map (\_ -> Task.spawn scope worker (Payload shared (Bytes.fromString "abc"))) [1, 2, 3, 4]
    List.each (\task -> case Task.await task of
        Ok (number, bytes) -> print (number, Bytes.length bytes)
        Err _ -> print (0, 0)) tasks)
