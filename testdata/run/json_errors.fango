import Bytes
import Json exposing (Decode, Encode(..))
import Json.Pull
import Maybe exposing (Maybe(..))
import Reader
import Result exposing (Result(..))
import Runtime.Local
import String

type Person = { name : String, age : Int } deriving (Encode, Decode)

report : Result Json.Error a -> String
report result =
    case result of
        Ok _ -> "ok"
        Err error -> error.message ++ " @" ++ error.path ++ " " ++ show error.line ++ ":" ++ show error.column

main() =
    print (report (Json.parse @Person "{\"name\":\"Ada\",\"age\":4,\"age\":5}"))
    print (report (Json.parse @Person "{\"name\":\"Ada\"}"))
    print (report (Json.parse @Person "{\"name\":9,\"age\":4}"))
    print (report (Json.parse @Person "{\"name\":\"Ada\",\"age\":4,\"extra\":[01]}"))
    print (report (Json.parse @(List Int) "[1, true]"))
    print (report (Json.parse @(List Int) "[0,1,2,3,4,5,6,7]"))
    print (report (Json.parse @(List Int) "[0,1,2,3,4,5,6,7,8]"))
    print (report (Json.parse @(List Int) "[0,1,2,3,4,5,6,7,true]"))
    print (report (Json.parse @(List (List Int)) "[[1,\"x\"]]"))
    print (report (Json.parse @Json.Value "{\"\":[01]}"))
    print (report (Json.parse @Person "{1:2}"))
    print (report (Json.parse @Person "{\"name\":\"Ada\",\"age\":4,}"))
    print (report (Json.parse @Person "{\"name\":\"Ada\" \"age\":4}"))
    print (report (Json.parse @Char "\"ø\""))
    print (report (Json.parse @Char "\"ab\""))
    print (report (Json.parse @Json.Value "[01]"))
    print (report (Json.parse @Json.Value "[\"\\uD800\"]"))
    print (report (Json.parse @Json.Value "[true,]"))
    print (report (Json.parse @Json.Value "1 2"))
    print (report (Json.parseBytes @Json.Value (Bytes.fromList [34, 255, 34])))
    case Json.parse @Json.Value (String.padLeft 257 '[' "" ++ "0" ++ String.padLeft 257 ']' "") of
        Ok _ -> print "ok"
        Err error -> print (error.message ++ " " ++ show error.line ++ ":" ++ show error.column)
    case Json.number "1.20e+3" of
        Ok value -> print (Json.numberText value)
        Err error -> print error.message
    result = Runtime.Local.run (Bytes.fromString "[1,2,3]") { cell ->
        source = Bytes.Source
            { pull = {
                remaining = cell.read()
                if Bytes.length remaining == 0 then Nothing
                else
                    cell.write (Bytes.slice 1 (Bytes.length remaining) remaining)
                    Just (Bytes.slice 0 1 remaining)
              }
            }
        Reader.over source { reader -> Json.read @(List Int) reader }
    }
    print (report result)
    print (Json.parse @Int "true")
    print (Json.parse @Int "true" == Err (Json.Error { message = "Expected JSON number", offset = 4, line = 1, column = 5, path = "" }))
    tokens = Reader.withBytes (Bytes.fromString "[true]") { reader ->
        Json.Pull.withReader reader { [Json.Pull.next(), Json.Pull.next(), Json.Pull.next(), Json.Pull.next()] }
    }
    print tokens
    print (tokens == Ok [Json.Pull.BeginArray, Json.Pull.BooleanToken True, Json.Pull.EndArray, Json.Pull.EndInput])
