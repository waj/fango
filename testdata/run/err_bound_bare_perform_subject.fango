-- A handled closure cannot be coerced to an arrow that hides its effect.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

both : (Cell ->{IO} a) ->{IO} a
both action =
    handle
        case Cell ({ _ -> tick() }) of
            outerCell ->
                handle
                    case tick() of
                        seen ->
                            print seen
                            action outerCell
                with m = 100 on
                    tick () -> resume m with m + 1
    with n = 0 on
        tick () -> resume n with n + 1

main() =
    both ({ c ->
        case c of
            Cell ta ->
                print (ta())
                print (ta()) })
