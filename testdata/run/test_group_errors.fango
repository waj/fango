import Expect
import Test exposing (Test, describe, skip, test, todo)
import Process

-- A group's own problems are failures of that group, reported before its
-- tests, which still run: an empty group, an empty group name, a test with
-- an empty name, and two tests sharing a name, seen through skip.

suite : Test {}
suite =
    describe "groups"
        [ describe "empty" []
        , describe ""
            [ test "runs anyway" { Expect.equal 1 1 } ]
        , describe "names"
            [ test "" { Expect.equal 1 1 }
            , test "twice" { Expect.equal 1 1 }
            , skip (test "twice" { Expect.equal 1 1 })
            , todo "twice"
            , test "once" { Expect.equal 1 1 }
            , test "once" { Expect.equal 1 2 }
            ]
        ]

main() = Process.runSystem { Test.run suite }
