-- A runner whose clause performs an effect its callback performs too. Rows
-- hold distinct applications, so `{Out, e}` with Out also in e shows Out
-- once, and the callback still finds Out's evidence through e.
effect Out
    out : String -> ()

effect Log
    log : String -> ()

runOut : (() ->{Out, e} a) ->{Console, e} a
runOut action =
    handle action() on
        out text ->
            print text
            resume ()

runLog : (() ->{Log, e} a) ->{Out, e} a
runLog action =
    handle action() on
        log line ->
            out ("log: " ++ line)
            resume ()

main() =
    runOut {
        runLog {
            log "a"
            out "b"
        }
    }
