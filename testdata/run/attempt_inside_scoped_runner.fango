import Fail exposing (Fail)
import Result exposing (Result(..))

type Outer = Outer deriving (Show)
type Inner = Inner deriving (Show)

failInner : () ->{Fail Inner} Int
failInner () = Fail.fail Inner

-- The callback's row holds `Fail Outer` from the runner and `Fail Inner` from
-- its body; the inner attempt handles the one its result names.
{-# scoped s #-}
serve : (Int ->{s} Int) ->{Fail Outer | e} Int
serve handler = handler 1

main() =
    print (Fail.attempt {
            serve { n ->
                case Fail.attempt { failInner () } of
                    Ok v -> v
                    Err Inner -> n + 41
            }
    })
