import Runtime.Coroutine
import Runtime.Work
import Fail

effect Dispatch
    context : () -> Runtime.Work.Facet

register cursor =
    packer = Runtime.Work.pack (context())
    send child = Fail.attempt (\_ -> packer child)
    ignored = send cursor
    ()

schedule cursor =
    Runtime.Work.run (\owner ->
        handle register cursor of
            context () ->
                selected = Runtime.Work.facet owner
                if True then resume selected else resume (Runtime.Work.facet owner))

main() =
    result = Fail.attempt (\_ ->
        Runtime.Coroutine.with (\_ () -> Fail.fail "unstarted") (\cursor ->
            schedule cursor
            print "registered through effect"))
    print result
