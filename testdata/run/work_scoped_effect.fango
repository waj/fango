import Coroutine
import Work
import Fail

effect Dispatch
    context : () -> Work.Facet

register cursor =
    packer = Work.pack (context())
    send child = Fail.attempt (\_ -> packer child)
    ignored = send cursor
    ()

schedule cursor =
    Work.run (\owner ->
        handle register cursor of
            context () ->
                selected = Work.facet owner
                if True then resume selected else resume (Work.facet owner))

main() =
    result = Fail.attempt (\_ ->
        Coroutine.with (\_ () -> Fail.fail "unstarted") (\cursor ->
            schedule cursor
            print "registered through effect"))
    print result
