import Async
import Fail

exitWorker : Int ->{Fail.Fail String} Int
exitWorker n = if n == 0 then Fail.fail "finished" else exitWorker (n - 1)

cpu() =
    result = Fail.attempt (\_ -> exitWorker 10000)
    print result

other() = print "other"

main() = print (Async.run (\_ ->
    first = Async.spawn cpu
    second = Async.spawn other
    Async.await first
    Async.await second))
