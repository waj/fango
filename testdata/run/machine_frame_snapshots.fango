import Stream
import List
import Runtime.Coroutine

produce : Int ->{Stream.Yield (() -> Int)} ()
produce n =
    if n <= 0 then ()
    else
        Stream.yield (\_ -> n)
        produce (n - 1)

main() =
    callbacks = Stream.toList (Stream.generate (\_ -> produce 5))
    print (List.map (\f -> f ()) callbacks)
    print (Runtime.Coroutine.with
        (\pause _ ->
            shifted x = pause (x + 100)
            shifted 7 + 1)
        (\work -> case Runtime.Coroutine.advance work 0 of
            Runtime.Coroutine.Suspended request -> case Runtime.Coroutine.advance work 40 of
                Runtime.Coroutine.Finished value -> (request, value)
                _ -> (0, 0)
            _ -> (0, 0)))
