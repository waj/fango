-- Explicit IO references keep independent reader state.
import Runtime.Ref

type Reader e =
    { buffered : () ->{IO | e} String
    , refill : () ->{IO | e} Bool
    }

type Source e = { pull : () ->{e} String }

over : Source e -> (Reader e ->{IO | e} a) ->{IO | e} a
over source use =
    pending = Runtime.Ref.new ""
    use (Reader {
        buffered = \_ -> Runtime.Ref.read pending,
        refill = \_ ->
            chunk = source.pull()
            Runtime.Ref.write pending (Runtime.Ref.read pending ++ chunk)
            chunk /= ""
    })

effect FeedA
    nextA : () -> String

effect FeedB
    nextB : () -> String

main() =
    handle
        handle
            over (Source { pull = \_ -> nextA() }) (\a ->
                over (Source { pull = \_ -> nextB() }) (\b ->
                    grewA = a.refill()
                    grewB = b.refill()
                    againA = a.refill()
                    print (a.buffered())
                    print (b.buffered())
                    print (grewA && grewB && againA)))
        with i = 0 of
            nextB () -> resume (if i == 0 then "XY" else "") with i + 1
    with j = 0 of
        nextA () -> resume (if j == 0 then "ab" else if j == 1 then "cd" else "") with j + 1
