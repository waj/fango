-- The body performs the cursor's own latent row, which the pure annotation
-- does not list. The rejection is right, and the report has to show it: the
-- two types differ only in the arrow's tail, so the row is printed although
-- it names no label.
import Stream
import Iterator exposing (Iterator)

leak : Iterator Int e -> Maybe Int
leak cursor = Stream.withCursor (Stream.fromList [9, 9, 9]) (\_ -> Iterator.next cursor)

main() = print "unreached"
