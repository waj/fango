import Stream
import Runtime.Scope
import Fail

source label = Stream.generate (\_ -> Runtime.Scope.finally (\_ ->
    print label
    Stream.yield 1
    Stream.yield 2) (\_ -> print "close"))

main() =
    print (Stream.toList (Stream.take 1 (source "early")))
    print (Stream.toList (source "exhaust"))
    Stream.withCursor (source "unused") (\_ -> ())
    print (Fail.attempt (\_ -> Stream.toList (Stream.generate (\_ ->
        Runtime.Scope.finally (\_ ->
            Stream.yield 3
            Fail.fail "body") (\_ -> print "failed producer closed")))))
    print (Fail.attempt (\_ -> Stream.toList (Stream.take 1 (Stream.generate (\_ ->
        Runtime.Scope.finally (\_ ->
            Stream.yield 4
            Stream.yield 5) (\_ -> Fail.fail "cleanup"))))))
