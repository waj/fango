import Stream
import Runtime.Scope
import Fail

withSource label action = Runtime.Scope.finally ({ _ ->
    print label
    action (Stream.fromList [1, 2]) }) ({ _ -> print "close" })

main() =
    print (withSource "early" ({ source -> Stream.toList (Stream.take 1 source) }))
    print (withSource "exhaust" Stream.toList)
    withSource "unused" ({ _ -> () })
    print (Fail.attempt ({ _ -> Runtime.Scope.finally ({ _ ->
        source = Stream.unfold 0 ({ state ->
            if state == 0 then Just (3, 1) else Fail.fail "body" })
        Stream.toList source }) ({ _ -> print "failed producer closed" }) }))
    print (Fail.attempt ({ _ -> Runtime.Scope.finally ({ _ ->
        Stream.toList (Stream.take 1 (Stream.fromList [4, 5])) }) ({ _ -> Fail.fail "cleanup" }) }))
