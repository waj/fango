-- Two nested activations of one effect, each with a closure bound in its own
-- subject. Binding replaces the by-name lookup with a captured reference, so
-- the outer cell answers from the outer activation even from inside the inner
-- one, and the two counters advance independently.
effect Counter
    tick : () -> Int

type Cell = Cell (() -> Int)

counter : Int -> (Cell ->{IO} a) ->{IO} a
counter start use =
    handle use (Cell (\_ -> tick())) with n = start of
        tick () -> resume n with n + 1

main() =
    counter 0 (\a ->
        counter 100 (\b ->
            case (a, b) of
                (Cell ta, Cell tb) ->
                    print (ta())
                    print (tb())
                    print (ta())))
