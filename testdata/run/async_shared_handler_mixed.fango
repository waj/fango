import Async exposing (Outcome(..))
import Fail exposing (Fail)
import List
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))

effect Counter
    next : () -> Int

effect Stop
    abort stop : () -> value

-- One handler owns a resumptive counter and an abort. Tasks inherit the
-- counter and its cell; the abort stays with the parent, which may still use
-- it after the tasks finish.
withCounter body =
    handle body() with count = 0 on
        next () -> resume count with count + 1
        stop () -> (Nothing, count)
        return value -> (Just value, count)

runStrings : (() ->{Async.Async String, IO, Fail String | e} a) ->{IO | e} Outcome (Result String a)
runStrings body = Async.run body

bump : Int ->{Counter} Int
bump n =
    if n == 0 then n
    else
        ignore next()
        bump (n - 1)

spawnAll () =
    before = next()
    tasks = List.map { _ -> Async.spawn ({ _ -> bump 100 }) } (List.range 1 8)
    awaited = List.map Async.await tasks
    after = next()
    (before, List.length awaited, after > before)

main() =
    (outcome, count) = withCounter ({ _ -> runStrings ({ _ -> spawnAll() }) })
    print (outcome, count > 1)
    (stopped, stoppedCount) = withCounter ({ _ ->
        finished = runStrings ({ _ -> spawnAll() })
        if next() > 0 then stop() else finished })
    print (stopped, stoppedCount > 1)
