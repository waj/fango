import Bytes exposing (Bytes)
import Fail exposing (Fail)
import Http exposing (Body(..))
import Http.Client as Client
import Http.GZip as GZip
import IO exposing (IO)
import Result exposing (Result(..))
import Url
import Writer

-- Prints each request as written and answers with `wire`.
answer : String -> Bytes ->{IO} Result Client.Error Bytes
answer wire request =
    print (Bytes.toStringLossy request)
    Ok (Bytes.fromString wire)

compressed : String -> Bytes
compressed text =
    (_, bytes) = Writer.collecting { w ->
        case GZip.encoding (BytesBody (Bytes.fromString text)) of
            StreamBody emit -> emit w
            _ -> ()
    }
    bytes

-- Answers with a gzip-encoded body.
answerGzip : String -> Bytes ->{IO} Result Client.Error Bytes
answerGzip text request =
    print (Bytes.toStringLossy request)
    body = compressed text
    Ok (Bytes.append (Bytes.fromString ("HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: " ++ show (Bytes.length body) ++ "\r\n\r\n")) body)

reply : Client.Reply -> String
reply r = show r.status ++ " " ++ show r.headers ++ " " ++ Bytes.toStringLossy r.body

main() =
    -- Content-Length, chunked, and close-delimited bodies; an interim response.
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello") {
        reply (Client.get "http://example.com/a?b=1")
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n") {
        reply (Client.get "http://example.com:8080/")
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.0 200 OK\r\n\r\nuntil close") {
        reply (Client.get "http://[::1]/")
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n") {
        reply (Client.fetch (Client.request "HEAD" "http://example.com/"))
    } })
    -- Request bodies, headers, and configuration.
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 204 No Content\r\n\r\n") {
        Client.configure { c -> { c | baseUrl = Url.parse "http://api.example.com/v1/", headers = [Http.Header { name = "X-Team", value = "core" }] } } {
            body = StreamBody { w ->
                Writer.writeString w "a"
                Writer.writeString w "b"
            }
            reply (Client.request "POST" "items" |> Client.withBody body |> Client.withBearer "token" |> Client.fetch)
        }
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok") {
        reply (Client.post "http://example.com/upload" (SizedBody 3 { w -> Writer.writeString w "xyz" }))
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 13\r\n\r\n{\"id\": 7}    ") {
        Client.postJson @Int "http://example.com/n" ["a", "b"]
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\n[1,2]\n") {
        Client.getJson @(List Int) "http://example.com/n"
    } })
    -- Compression.
    print (Fail.attempt { Client.stub (answerGzip "decoded body") {
        reply (Client.get "http://example.com/z")
    } })
    print (Fail.attempt { Client.stub (answerGzip "kept encoded") {
        r = Client.fetch (Client.withHeader "Accept-Encoding" "gzip" (Client.request "GET" "http://example.com/z"))
        show r.headers ++ " " ++ show (r.body == compressed "kept encoded")
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 4\r\n\r\nnope") {
        reply (Client.get "http://example.com/z")
    } })
    -- Failures.
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\n123456") {
        Client.configure { c -> { c | maxBodyBytes = 4 } } { Client.get "http://example.com/big" }
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\n\r\ngone") {
        Client.getText "http://example.com/missing"
    } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nnope!") {
        Client.getJson @Int "http://example.com/n"
    } })
    print (Fail.attempt { Client.stub { _ -> Err Client.Timeout } { Client.getText "http://example.com/" } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 2OO OK\r\n\r\n") { Client.getText "http://example.com/" } })
    print (Fail.attempt { Client.stub (answer "HTTP/1.1 200 OK\r\nContent-Length: 9\r\n\r\nshort") { Client.getText "http://example.com/" } })
    print (Fail.attempt { Client.stub (answer "") { Client.getText "relative" } })
    print (Fail.attempt { Client.stub (answer "") { Client.getText "http://user:pw@example.com/" } })
    print (Fail.attempt { Client.stub (answer "") { Client.getText "ftp://example.com/" } })
    print (Fail.attempt { Client.stub (answer "") {
        Client.fetch (Client.withHeader "Content-Length" "3" (Client.request "GET" "http://example.com/"))
    } })
