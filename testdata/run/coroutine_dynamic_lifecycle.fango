import Coroutine
import Scope
import Fail

unstarted : (String ->{Coroutine.Suspension} ()) -> () ->{Coroutine.Suspension, IO} ()
unstarted pause = unstarted pause

producer name pause () =
    print ("start " ++ name)
    Scope.finally (\_ ->
        pause name
        print ("finish " ++ name)) (\_ -> print ("cleanup " ++ name))

repeat scope n =
    if n == 0 then ()
    else
        work = Coroutine.create scope (\_ () -> n)
        ignored = Coroutine.advance work ()
        repeat scope (n - 1)

body scope = Coroutine.create scope (\pause () ->
    print "child"
    grandchild = Coroutine.create scope (\childPause () ->
        ignored = if False then childPause () else ()
        42)
    pause ()
    grandchild)

main() =
    Coroutine.scope (\scope ->
        never = Coroutine.create scope unstarted
        Coroutine.close never
        Coroutine.close never
        a = Coroutine.create scope (producer "a")
        b = Coroutine.create scope (producer "b")
        print (Coroutine.advance a ())
        print (Coroutine.advance b ())
        repeat scope 100)
    Coroutine.scope (\scope ->
        child = body scope
        print "body done"
        ignored = Coroutine.advance child ()
        case Coroutine.advance child () of
            Coroutine.Finished grandchild -> print (Coroutine.advance grandchild ())
            _ -> ())
    result = Fail.attempt (\_ -> Coroutine.scope (\scope ->
        a = Coroutine.create scope (producer "failed-driver")
        ignored = Coroutine.advance a ()
        Fail.fail "driver"
        ()))
    print result
