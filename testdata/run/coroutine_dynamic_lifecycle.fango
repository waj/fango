import Runtime.Coroutine
import Runtime.Scope
import Fail

unstarted : (String ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension, IO} ()
unstarted pause = unstarted pause

producer name pause () =
    print ("start " ++ name)
    Runtime.Scope.finally (\_ ->
        pause name
        print ("finish " ++ name)) (\_ -> print ("cleanup " ++ name))

repeat scope n =
    if n == 0 then ()
    else
        work = Runtime.Coroutine.create scope (\_ () -> n)
        ignored = Runtime.Coroutine.advance work ()
        repeat scope (n - 1)

body scope = Runtime.Coroutine.create scope (\pause () ->
    print "child"
    grandchild = Runtime.Coroutine.create scope (\childPause () ->
        ignored = if False then childPause () else ()
        42)
    pause ()
    grandchild)

main() =
    Runtime.Coroutine.scope (\scope ->
        never = Runtime.Coroutine.create scope unstarted
        Runtime.Coroutine.close never
        Runtime.Coroutine.close never
        a = Runtime.Coroutine.create scope (producer "a")
        b = Runtime.Coroutine.create scope (producer "b")
        print (Runtime.Coroutine.advance a ())
        print (Runtime.Coroutine.advance b ())
        repeat scope 100)
    Runtime.Coroutine.scope (\scope ->
        child = body scope
        print "body done"
        ignored = Runtime.Coroutine.advance child ()
        case Runtime.Coroutine.advance child () of
            Runtime.Coroutine.Finished grandchild -> print (Runtime.Coroutine.advance grandchild ())
            _ -> ())
    result = Fail.attempt (\_ -> Runtime.Coroutine.scope (\scope ->
        a = Runtime.Coroutine.create scope (producer "failed-driver")
        ignored = Runtime.Coroutine.advance a ()
        Fail.fail "driver"
        ()))
    print result
