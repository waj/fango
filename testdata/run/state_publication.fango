import Fail

effect Counter
    next : Bool -> Int

sequence() =
    first = next False
    last = next True
    (first, last)

rejectingRunner() =
    handle sequence() with count = 10 of
        next reject ->
            if reject then Fail.fail "rejected" else resume count with count + 1
        return value -> (value, count)

-- These names have no special meaning, including as state binders.
ordinaryValue() =
    shared = 3
    taskLocal = 4
    shared + taskLocal

ordinaryRunner() =
    handle next False with shared = ordinaryValue() of
        next _ -> resume shared with shared + 1
        return value -> (value, shared)

success() =
    handle (next False, next False) with count = 1 of
        next _ -> resume count with count + 1
        return value -> (value, count)

main() =
    print (Fail.attempt rejectingRunner)
    print (ordinaryRunner())
    print (success())
