import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Scope

eachCursor : (a ->{e} ()) -> Iterator.Iterator a e ->{Iterator.Traversal | e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just value ->
        action value
        eachCursor action cursor

effect Flush
    flush : () -> ()

main() = Stream.withCursor (Stream.generate (\_ ->
    handle Scope.finally (\_ -> ()) (\_ -> flush()) of
        flush () ->
            Stream.yield 1
            resume ())) (eachCursor print)
