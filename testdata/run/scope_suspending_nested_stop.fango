import Runtime.Coroutine
import Runtime.Scope

main() = Runtime.Coroutine.with
    (\outer () -> Runtime.Scope.finally
        (\_ -> Runtime.Coroutine.with
            (\inner () -> Runtime.Scope.finally
                (\_ ->
                    outer "body"
                    inner "unused")
                (\_ -> outer "inner release"))
            (\work -> Runtime.Coroutine.advance work ()))
        (\_ -> outer "outer release"))
    (\work ->
        print (Runtime.Coroutine.advance work ())
        print (Runtime.Coroutine.stop work)
        print (Runtime.Coroutine.advance work ())
        print (Runtime.Coroutine.advance work ()))
