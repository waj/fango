import Runtime.Coroutine
import Stream
import Iterator
import Maybe exposing (Maybe(..))
import Runtime.Scope

eachCursor : (a ->{e} ()) -> Iterator.Iterator a e ->{Runtime.Coroutine.Drive | e} ()
eachCursor action cursor = case Iterator.next cursor of
    Nothing -> ()
    Just value ->
        action value
        eachCursor action cursor

acquire n callback =
    if n <= 0 then callback() else acquire (n - 1) callback

main() = Stream.withCursor (Stream.generate (\_ ->
    Runtime.Scope.bracket (\_ -> acquire 2 (\_ -> Stream.yield 1)) (\_ -> ()) (\_ -> ()))) (eachCursor print)
