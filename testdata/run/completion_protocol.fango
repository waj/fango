import Runtime.Completion
import Fail
import Failure
import Runtime.Scope
import Result exposing (Result(..))

effect Stop
    abort stop : String -> Int -> value

main() =
    print (Runtime.Completion.replay (Runtime.Completion.capture (\_ -> 42)))
    print (Fail.attempt (\_ ->
        completed = Runtime.Completion.capture (\_ ->
            Fail.fail "detached"
            0)
        print "captured"
        Fail.attempt (\_ -> Runtime.Completion.replay completed)))
    handle (\_ ->
        completed = Runtime.Completion.capture (\_ -> stop "tuple" 7)
        case Runtime.Completion.failure completed of
            Just failure -> print (Failure.argumentCount failure)
            Nothing -> print 0
        handle Runtime.Completion.replay completed of
            stop text number -> print (text ++ show number))() of
        stop _ _ -> print "stale target"
    print (Fail.attempt (\_ ->
        completed = Runtime.Completion.capture (\_ -> Runtime.Scope.finally (\_ ->
            Fail.fail "primary"
            0) (\_ -> Fail.fail "cleanup"))
        case Runtime.Completion.failure completed of
            Just failure -> print (List.length (Failure.suppressed failure))
            Nothing -> print 0
        Runtime.Completion.replay completed))
