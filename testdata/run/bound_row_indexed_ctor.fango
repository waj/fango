-- A row-indexed constructor rather than a record. The closure reaches its
-- field through the container's row argument, which is a fresh variable while
-- the constructor is checked, so whether that position can simply absorb
-- `Counter` is not decided until the call that pins the row. Binding waits for
-- that, and the two counters then advance independently.
effect Counter
    tick : () -> Int

type Cell e = Cell (() ->{e} Int)

counter : Int -> (Cell e ->{e} a) ->{e} a
counter start use =
    handle use (Cell (\_ -> tick())) with n = start of
        tick () -> resume n with n + 1

main() =
    counter 0 (\a ->
        counter 100 (\b ->
            case (a, b) of
                (Cell ta, Cell tb) ->
                    print (ta())
                    print (tb())
                    print (ta())))
