-- `Ctx p` and `Ctx e` still overlap while their arguments are unknown.
-- The shared open row cannot assume they are distinct applications.

effect Ctx e
    current : () -> e

provide : e -> (() ->{Ctx e | r} a) ->{r} a
provide value body =
    handle body() of
        current () -> resume value

reprovide : (() ->{Ctx e | r} a) -> e ->{Ctx p | r} a
reprovide body value =
    ignore (current())
    provide value body

main() = print (provide 1 ({ _ -> reprovide ({ _ -> current() }) "x" }))
