-- `Ctx p` and `Ctx e` are distinct rigid applications. The shared open row
-- cannot substitute the body's required application for the annotated one.

effect Ctx e
    current : () -> e

provide : e -> (() ->{Ctx e | r} a) ->{r} a
provide value body =
    handle body() on
        current () -> resume value

reprovide : (() ->{Ctx e | r} a) -> e ->{Ctx p | r} a
reprovide body value =
    ignore (current())
    provide value body

main() = print (provide 1 ({ _ -> reprovide ({ _ -> current() }) "x" }))
