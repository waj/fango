import Runtime.Coroutine
import Runtime.Completion
import Runtime.Work
import Fail
import Runtime.Scope

-- Executable A0 representation probe. C6a's cells are still required to retain
-- these typed observations independently of their publication callbacks.
type Task a e = Task (Runtime.Completion.Completion a e)

await : Task a e ->{e} a
await (Task completed) = Runtime.Completion.replay completed

captureTask : (() ->{e} a) ->{e} Task a e
captureTask action = Task (Runtime.Completion.capture action)

effect Async
    checkpoint : () -> ()

job : (() ->{e} a) -> (Task a e ->{e} ()) -> (() ->{Runtime.Coroutine.Suspension} ()) -> () ->{Runtime.Coroutine.Suspension | e} ()
job action publish pause () =
    handle checkpoint () of
        checkpoint () -> resume (pause ())
    completed = captureTask action
    publish completed

runJobs : Runtime.Work.Owner e -> List (Runtime.Work.Work () () ()) ->{Runtime.Coroutine.Drive | e} ()
runJobs owner jobs = List.each (\work ->
    printStep (Runtime.Work.advance owner work ())
    printStep (Runtime.Work.advance owner work ())) jobs

printStep : Runtime.Coroutine.Step () () -> ()
printStep _ = ()

dispatch : Runtime.Coroutine.Coroutine () () () e -> Runtime.Coroutine.Coroutine () () () e ->{Runtime.Coroutine.Drive | e} ()
dispatch left right = Runtime.Work.run (\owner ->
    jobs = [Runtime.Work.pack (Runtime.Work.facet owner) left, Runtime.Work.pack (Runtime.Work.facet owner) right]
    runJobs owner jobs)

main() =
    print (Fail.attempt (\_ ->
        Runtime.Coroutine.with (job (\_ -> 42) (\task ->
            print (await task)
            print (await task))) (\intWork ->
            Runtime.Coroutine.with (job (\_ -> Runtime.Scope.finally (\_ ->
                Fail.fail "String failure"
                "unreachable") (\_ -> print "released")) (\task ->
                    print (Fail.attempt (\_ -> await task))
                    print (Fail.attempt (\_ -> await task)))) (dispatch intWork))))
