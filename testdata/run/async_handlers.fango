import Result exposing (Result(..))
import Async
import Fail exposing (Fail)

effect Database
    lookup : Int -> String

effect Stop
    abort stop : String -> value

withDatabase body =
    handle body() on
        lookup id -> resume "Alice"

withBrokenDatabase body =
    handle body() on
        lookup id -> Fail.fail "unavailable"

withStoppingDatabase body =
    handle body() on
        lookup id -> stop "stopped"

withStop body =
    handle body() on
        stop reason -> Err reason
        return value -> Ok value

query : () ->{Database, Fail String} String
query () =
    name = lookup 42
    if name == "" then Fail.fail "empty" else name

parallel action = Async.await (Async.spawn action)

main() =
    print (withDatabase { Async.runOutcome { Async.await (Async.spawnAttempt query) } })
    print (Async.runOutcome { Async.await (Async.spawnAttempt { withBrokenDatabase query }) })
    print (Async.runOutcome { parallel {
            result = withStop { withStoppingDatabase { lookup 42 } }
            case result of
                Ok value -> value
                Err reason -> reason
    } })
