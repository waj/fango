import Fail exposing (attempt)
import File
import State

-- Storing the handle in a State cell outside the scope would let the cell
-- outlive the file. The runner's result can carry it, so the call is rejected.

main() =
    outcome = State.run Nothing (\_ ->
        attempt (\_ -> File.withFile "input.txt" (\file -> State.put (Just file))))
    print "unreachable"
