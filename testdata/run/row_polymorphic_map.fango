type Chain a = Empty | Link a (Chain a) deriving (Eq, Show)

map : (a ->{e} b) -> Chain a ->{e} Chain b
map fn values =
    case values of
        Empty -> Empty
        Link x xs -> Link (fn x) (map fn xs)

increment x = x + 1

announce : Int ->{IO} Int
announce x =
    print x
    x + 10

numbers = Link 1 (Link 2 Empty)

main() =
    print (map increment numbers)
    print (map announce numbers)
