import Runtime.NativeRequest
import Runtime.Completion
import Maybe exposing (Maybe(..))
import Fail
import Runtime.Native
import Runtime.Scope

{-# resource #-}
type Device = Device Runtime.Native.Any
openDevice : () ->{IO} Device
openDevice = native
closeDevice : Device ->{IO} ()
closeDevice = native
submit : Runtime.NativeRequest.Registration -> Device -> Int ->{IO} ()
submit = native
finish : Device ->{IO} ()
finish = native

showPoll host callback = case Runtime.NativeRequest.poll host callback of
    Nothing -> print "pending"
    Just completed -> print (Fail.attempt (\_ -> Runtime.Completion.replay completed))

main() = print (Fail.attempt (\_ -> Runtime.Scope.bracket openDevice closeDevice (\device ->
    Runtime.NativeRequest.scope 1 (\host ->
        case Runtime.NativeRequest.register host (\token -> submit token device 0) (\_ -> 42) of
            Nothing -> print "rejected"
            Just callback ->
                print (Runtime.NativeRequest.counts host)
                showPoll host callback
                showPoll host callback
        print (Fail.attempt (\_ ->
            ignored = Runtime.NativeRequest.register host (\_ -> Fail.fail "before begin") (\_ -> ())
            ()))
        print (Runtime.NativeRequest.counts host)
        print (Fail.attempt (\_ ->
            ignored = Runtime.NativeRequest.register host (\token ->
                submit token device 2
                Fail.fail "after begin") (\_ -> ())
            ()))
        print (Runtime.NativeRequest.counts host)
        case Runtime.NativeRequest.register host (\token -> submit token device 1) (\_ -> Runtime.Scope.finally (\_ ->
            print "callback"
            Fail.fail "callback failed"
            0) (\_ -> print "callback cleanup")) of
            Nothing -> print "rejected"
            Just callback ->
                showPoll host callback
                case Runtime.NativeRequest.register host (\token -> submit token device 0) (\_ -> 0) of
                    Nothing -> print "full"
                    Just _ -> print "unexpected admission"
                finish device
                showPoll host callback
                print (Runtime.NativeRequest.counts host)
        case Runtime.NativeRequest.register host (\token -> submit token device 2) (\_ -> print "unexpected callback") of
            Nothing -> print "rejected"
            Just callback ->
                print (Runtime.NativeRequest.counts host)
                Runtime.NativeRequest.cancel callback
                Runtime.NativeRequest.drain callback
                print (Runtime.NativeRequest.counts host)
        case Runtime.NativeRequest.register host (\token -> submit token device 2) (\_ -> ()) of
            Nothing -> print "rejected"
            Just _ -> print "scope draining"))))
