import NativeRequest
import Completion
import Maybe exposing (Maybe(..))
import Fail
import Native
import Scope

{-# resource #-}
type Device = Device Native.Any
openDevice : () ->{IO} Device
openDevice = native
closeDevice : Device ->{IO} ()
closeDevice = native
submit : NativeRequest.Registration -> Device -> Int ->{IO} ()
submit = native
finish : Device ->{IO} ()
finish = native

showPoll host callback = case NativeRequest.poll host callback of
    Nothing -> print "pending"
    Just completed -> print (Fail.attempt (\_ -> Completion.replay completed))

main() = print (Fail.attempt (\_ -> Scope.bracket openDevice closeDevice (\device ->
    NativeRequest.scope 1 (\host ->
        case NativeRequest.register host (\token -> submit token device 0) (\_ -> 42) of
            Nothing -> print "rejected"
            Just callback ->
                print (NativeRequest.counts host)
                showPoll host callback
                showPoll host callback
        print (Fail.attempt (\_ ->
            ignored = NativeRequest.register host (\_ -> Fail.fail "before begin") (\_ -> ())
            ()))
        print (NativeRequest.counts host)
        print (Fail.attempt (\_ ->
            ignored = NativeRequest.register host (\token ->
                submit token device 2
                Fail.fail "after begin") (\_ -> ())
            ()))
        print (NativeRequest.counts host)
        case NativeRequest.register host (\token -> submit token device 1) (\_ -> Scope.finally (\_ ->
            print "callback"
            Fail.fail "callback failed"
            0) (\_ -> print "callback cleanup")) of
            Nothing -> print "rejected"
            Just callback ->
                showPoll host callback
                case NativeRequest.register host (\token -> submit token device 0) (\_ -> 0) of
                    Nothing -> print "full"
                    Just _ -> print "unexpected admission"
                finish device
                showPoll host callback
                print (NativeRequest.counts host)
        case NativeRequest.register host (\token -> submit token device 2) (\_ -> print "unexpected callback") of
            Nothing -> print "rejected"
            Just callback ->
                print (NativeRequest.counts host)
                NativeRequest.cancel callback
                NativeRequest.drain callback
                print (NativeRequest.counts host)
        case NativeRequest.register host (\token -> submit token device 2) (\_ -> ()) of
            Nothing -> print "rejected"
            Just _ -> print "scope draining"))))
