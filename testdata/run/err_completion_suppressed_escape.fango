import Completion
import Fail
import Scope

type Port = { emit : String ->{IO} () }

effect Escape
    abort escape : (String ->{IO} ()) -> ()

main() =
    handle (\_ ->
        escaped = Fail.attempt (\_ -> Scope.bracket
            (\_ -> Port { emit = print })
            (\_ -> ())
            (\port -> Completion.capture (\_ -> Scope.finally (\_ ->
                Fail.fail "primary"
                0) (\_ -> escape port.emit))))
        ())() of
        escape _ -> ()
