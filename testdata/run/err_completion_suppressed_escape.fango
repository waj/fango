import Runtime.Completion
import Fail
import Runtime.Scope

type Port = { emit : String ->{IO} () }

effect Escape
    abort escape : (String ->{IO} ()) -> ()

main() =
    handle (\_ ->
        escaped = Fail.attempt (\_ -> Runtime.Scope.bracket
            (\_ -> Port { emit = print })
            (\_ -> ())
            (\port -> Runtime.Completion.capture (\_ -> Runtime.Scope.finally (\_ ->
                Fail.fail "primary"
                0) (\_ -> escape port.emit))))
        ())() of
        escape _ -> ()
