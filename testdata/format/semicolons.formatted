module Semicolons exposing (run)

import Basics exposing (..)
import IO exposing (print)

compact = \a b -> print a; b + 1
locals x = y = x + 1; print y; y * 2
annotated x = y : Int; y = x; y
localFunction n = f 0 = 0; f x = x + 1; f n
destructure pair = (x, y) = pair; x + y

wrapped x = print x;
    x + 1

commented = print 1; -- keep this separator
    2

run = ()
