module Decls exposing (Color(..), Console, Pair, Show(..))

import Basics exposing (..)

infixl 6 (+++)
infixr 5 (<|>)
infix 4 (===)

type Color = Red | Green | Blue deriving (Eq, Show)

type Tree a
    = Leaf
    | Node (Tree a) a (Tree a)
    deriving (Eq, Show)

type Pair a = { first : a, second : a } deriving (Eq)

type Wide =
    { alpha : Int
    , beta : String
    }
    deriving (Eq, Show)

type SplitUnion = First | Second
    deriving (Eq)

type SplitRecord = { value : Int }
    deriving (Show)

type Fn e = Wrap (Int ->{e} String) | Pure (Maybe (List Int))

type Pairs = Holder (Int, String) (Maybe (Int, Int, Int))

effect Console
    print : String -> ()
    readLine : () -> String

effect Fail e
    abort fail : e -> ()

class Show a
    show : a -> String

class Num a
    (+) : a -> a -> a
    fromInt : Int -> a

pureFn : Fn {}
pureFn = Pure Nothing

listedFn : Fn {Console, Fail String}
listedFn = Pure Nothing

openFn : Fn {Console | e}
openFn = Pure Nothing
