bare =
    use   run config
    fetch url

binder =
    first = 1
    use (a,b) <- pair first
    -- a comment between items
    use (Just c) <- lookup
    a + b + c

configured =
    use Client.run
    use Client.configure { c ->
        { c | readTimeoutMs = 200 }
    }
    Client.getText "/slow"

inline = twice { use x <- pair 1;  use run; x }

scoped =
    total =
        use State.run 0
        bump()
        get()
    total.value
