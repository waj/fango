{-# no-prelude #-}
module Handlers exposing (Counter(..), runCounter, runFail)

import Basics exposing (..)

effect Counter
    tick : () -> Int
    reset : () -> ()

effect Fail e
    abort fail : e -> value

type Totals = { value : Int, count : Int }

runCounter : (() ->{Counter | e} a) ->{e} Totals
runCounter action =
    handle action() with count = 0 of
        tick () -> resume count with count + 1
        reset () -> resume () with 0
        return value -> { value = value, count = count }

runFail : (() ->{Fail String | e} a) ->{e} Int
runFail action =
    handle action() of
        fail message ->
            0
        return value -> 1

run = 1
