effect Log
    info : String -> ()

effect Db
    query : String -> Int

alias App = {Log, Db}
fetch : () ->{App} Int
fetch() = query "x"

:type fetch
caller() = fetch()
:type caller
mixed() =
    info "first"
    fetch()

:type mixed
spelled : () ->{Log, Db} Int
spelled() = fetch()

:type spelled
partly() = handle fetch() on
    info _ -> resume ()

:type partly
bare : () ->{App} ()
bare() = ()

alias App = {Log}
narrowed : () ->{App} ()
narrowed() = info "x"

:type narrowed
effect Fail error
    abort fail : error -> a

alias Risky error = {Log, Fail error}
risky : e ->{Risky e} Int
risky e = fail e

:type risky
atString() = risky "x"
:type atString
alias Pair a = (a, a)
swap : Pair a -> Pair a
swap (x, y) = (y, x)

:type swap
alias Pair a = {Fail a}
wrong : Pair
wrong = 1

:q
