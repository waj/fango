effect Stop
    abort stop : () -> a

runStop : (() ->{Stop, e} a) ->{e} Maybe a
runStop action =
    handle action() on
        stop () -> Nothing
        return v -> Just v

use runStop
w = stop ()
w
:end
n
m
a
