pair : Int -> ((Int, Int) ->{e} a) ->{e} a
pair n k = k (n, n * 2)
skip : (() ->{e} a) -> Int
skip _ = 5
use skip
effect Stop
    abort stop : () -> a

runStop : (() ->{Stop | e} a) ->{e} Maybe a
runStop action =
    handle action() on
        stop () -> Nothing
        return v -> Just v

use runStop
use (a, b) <- pair 4
total = a + b
kept = 7
total
stop ()
kept
total
