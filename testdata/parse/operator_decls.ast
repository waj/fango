(module Ops (exposing <+> |> Semi(..))
  (def <+> (params a b) (ann (-> Int (-> Int Int))) (binop + (binop * (var a) (int 10)) (var b)))
  (infixl 5 <+>)
  (def |> (params x f) (ann (-> a (-> (-> a b) b))) (app (var f) (var x)))
  (infixl 1 |>)
  (class Semi a (<> (-> a (-> a a))))
  (instance  Semi Int (def <> (params x y) (binop <+> (var x) (var y))))
  (deriver Semi (def <> (params subject left right) (var left)))
  (def sum (app (app (var fold) (var <+>)) (int 0)))
  (def mixed (binop |> (binop <+> (int 1) (int 2)) (var negate))))
