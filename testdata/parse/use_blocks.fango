-- A `use` item applies its head to the rest of the block as a callback.
bare =
    use run config
    fetch url

binder =
    first = 1
    use (a, b) <- pair first
    use (Just c) <- lookup
    a + b + c

nested =
    use outer
    use inner 2
    log "both"
    done

inline = twice { use x <- pair 1; use run; x }

scoped =
    total =
        use State.run 0
        bump()
        get()
    branch = if total.value > 0 then
            use x <- pair total.value
            x
        else 0
    case branch of
        0 ->
            use r <- Reader.withBytes bytes
            Reader.readAll r
        _ -> empty

-- `with` is still an ordinary name outside handler state.
binding =
    with x = x + 1
    with 2

stateful action =
    handle
        use run
        action()
    with count = 0 on
        tick () -> resume () with count + 1

-- A `use` line after `resume v` starts an item; it is not resume state.
resumed action =
    handle action() on
        tick () ->
            n = resume ()
            use run
            n
