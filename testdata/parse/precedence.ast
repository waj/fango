(module
  (def a (binop - (binop - (int 1) (int 2)) (int 3)))
  (def b (binop - (binop + (int 1) (binop * (int 2) (int 3))) (int 4)))
  (def c (binop * (binop + (int 1) (int 2)) (int 3)))
  (def d (binop - (binop * (binop * (int 2) (int 3)) (int 4)) (int 5)))
  (def + (params a b) (ann (-> Int (-> Int Int))) (var a))
  (infixl 6 +)
  (def - (params a b) (ann (-> Int (-> Int Int))) (var a))
  (infixl 6 -)
  (def * (params a b) (ann (-> Int (-> Int Int))) (var a))
  (infixl 7 *))
