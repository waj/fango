(module
  (def f (binop + (float 1.5) (binop * (float 2) (float 0.5))))
  (def s (binop ++ (string "a") (binop ++ (string "b") (string "c"))))
  (def t (ctor True))
  (def u (ctor False))
  (def c (binop <= (int 1) (int 2)))
  (def e (binop == (string "x") (string "y")))
  (def d (binop / (float 1) (float 2)))
  (def + (params a b) (ann (-> Float (-> Float Float))) (var a))
  (infixl 6 +)
  (def * (params a b) (ann (-> Float (-> Float Float))) (var a))
  (infixl 7 *)
  (def / (params a b) (ann (-> Float (-> Float Float))) (var a))
  (infixl 7 /)
  (def ++ (params a b) (ann (-> String (-> String String))) (var a))
  (infixr 5 ++)
  (def == (params a b) (ann (-> String (-> String Bool))) (ctor True))
  (infix 4 ==)
  (def <= (params a b) (ann (-> Int (-> Int Bool))) (ctor True))
  (infix 4 <=))
