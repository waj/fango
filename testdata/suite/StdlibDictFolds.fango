module StdlibDictFolds exposing (suite)

import Dict
import Expect
import List
import State exposing (State(..))
import Test exposing (Test, describe, test)

base : Dict.Dict String Int
base = Dict.fromList [("c", 3), ("a", 1), ("b", 2)]

empty : Dict.Dict String Int
empty = Dict.empty

-- Records a visit, so the order a callback runs in is observable without
-- printing from inside a test.
visit : String ->{State (List String)} ()
visit key = put [key | get ()]

visited : (() ->{State (List String)} a) -> List String
visited action = List.reverse (State.run [] action).state

suite : Test {}
suite =
    describe "Dict"
        [ describe "foldl"
            [ test "ascends" { Expect.equal "abc" (Dict.foldl { (k, _) acc -> acc ++ k } "" base) }
            , test "combines values" { Expect.equal 6 (Dict.foldl { (_, v) acc -> acc + v } 0 base) }
            , test "answers the seed for an empty dict" { Expect.equal 0 (Dict.foldl { (_, v) acc -> acc + v } 0 empty) }
            , test "runs an effectful callback in ascending order" {
                -- the row is open, so the callback's order is part of the contract
                Expect.equal ["a1", "b2", "c3"] (visited { Dict.foldl { (k, v) _ -> visit (k ++ show v) } () base })
            }
            ]
        , describe "foldr"
            [ test "descends" { Expect.equal "cba" (Dict.foldr { (k, _) acc -> acc ++ k } "" base) }
            , test "answers the seed for an empty dict" { Expect.equal 0 (Dict.foldr { (_, v) acc -> acc + v } 0 empty) }
            , test "runs an effectful callback in descending order" {
                Expect.equal ["c3", "b2", "a1"] (visited { Dict.foldr { (k, v) _ -> visit (k ++ show v) } () base })
            }
            ]
        , describe "map"
            [ test "preserves keys, size, and order while changing the value type" {
                Expect.equal (Dict.fromList [("a", "a1"), ("b", "b2"), ("c", "c3")]) (Dict.map { (k, v) -> k ++ show v } base)
                Expect.equal 3 (Dict.size (Dict.map { (_, v) -> v * 2 } base))
                Expect.equal ["a", "b", "c"] (Dict.keys (Dict.map { (_, v) -> v * 2 } base))
                Expect.equal Dict.empty (Dict.map { (_, v) -> v * 2 } empty)
            }
            , test "runs its callback in ascending order" {
                Expect.equal ["a", "b", "c"] (visited { Dict.map { (k, _) -> visit k } base })
            }
            ]
        , test "toList round-trips through fromList" { Expect.equal base (Dict.fromList (Dict.toList base)) }
        ]
main() = Test.run suite
