module StdlibWordsFoldl exposing (tests)

import Expect
import List
import String
import Test

wordCount text = List.foldl { _ total -> total + 1 } 0 (String.words text)

tests : Test.Test {}
tests = Test.test "stdlib_words_foldl" {
    Expect.equal 0 (wordCount "")
    Expect.equal 3 (wordCount "  one\ttwo   three  ")
    Expect.equal 2 (wordCount "héllo 二")
}

main() = Test.run tests
