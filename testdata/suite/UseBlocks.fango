module UseBlocks exposing (tests)

import Bytes exposing (Bytes)
import Expect
import Fail
import Http.Client as Client
import Reader
import Result exposing (Result(..))
import State exposing (State, get, put)
import Test
import Process

bump : () ->{State Int} ()
bump () = put (get() + 1)

-- Answers every request with the same body.
answer : Bytes -> Result Client.Error Bytes
answer _ = Ok (Bytes.fromString "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")

-- Each `use` wraps the rest of its block; the first one is outermost.
fetchTwice : () -> Result Client.Error String
fetchTwice () =
    use Fail.attempt
    use Client.stub answer
    use Client.configure { c -> { c | userAgent = "with" } }
    first = Client.getText "http://example.com/a"
    first ++ " " ++ Client.getText "http://example.com/b"

-- A scoped runner's callback parameter is bound by `<-`.
firstWord : String -> String
firstWord text =
    use reader <- Reader.withBytes (Bytes.fromString text)
    Bytes.toStringLossy (Reader.readUpTo reader 5)

tests : Test.Test {}
tests = Test.test "use_blocks" {
    Expect.equal "ok ok" (Expect.ok fetchTwice())
    Expect.equal "hello" (firstWord "hello world")
    counted =
        -- The block on the right of `=` ends the State handler's scope.
        use State.run 10
        bump()
        bump()
        get()
    Expect.equal 12 counted.value
    Expect.equal [3, 6, 9] (List.map { n -> use (a, b) <- { k -> k (n, n * 2) }; a + b } [1, 2, 3])
}

main() = Process.runSystem { Test.run tests }
