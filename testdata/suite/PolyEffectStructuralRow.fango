module PolyEffectStructuralRow exposing (tests)

import Expect
import Test
import Process
effect Read a
    read : () -> a

effect Apply
    apply : a -> (() ->{Read (List a)} List a) -> List a

tests : Test.Test {}
tests = Test.test "poly_effect_structural_row" {
    result = handle apply 42 { _ -> read() } on
        apply value f -> resume (handle f() on
                read () -> resume [value]
        )
    Expect.equal [42] result
}

main() = Process.runSystem { Test.run tests }
