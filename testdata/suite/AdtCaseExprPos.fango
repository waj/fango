module AdtCaseExprPos exposing (tests)

import Expect
import Test
type MaybeInt = NothingI | JustI Int deriving (Eq, Show)

orZero m = (case m of
    JustI n -> n
    NothingI -> 0) * 10

top = case JustI 4 of
    JustI n -> n + 1
    NothingI -> 0

nested m =
    case (case m of
        NothingI -> JustI 1
        JustI n -> JustI (n + 1)) of
        JustI n -> n
        NothingI -> 0

tests : Test.Test {}
tests = Test.test "adt_case_expr_pos" {
    Expect.equal 36 (orZero (JustI 3) + top + nested NothingI)
}

main() = Test.run tests
