module FailureReportResourceRetained exposing (tests)

import Random
import Expect
import Fail
import IO
import Runtime.Scope
import Test

type Port = { emit : String ->{IO} () }

effect Release
    abort release : (String ->{IO} ()) -> ()

fixtureBody() =
    report = Fail.attemptReport { _ ->
        Runtime.Scope.bracket { _ -> Port { emit = { _ -> Random.runSystem {} } } } { _ -> () } { port ->
            handle Runtime.Scope.finally { _ -> Fail.fail "body" } { _ -> release port.emit } on
                release _ -> ()
        }
    }
    ()

tests : Test.Test IO.IO
tests = Test.test "failure_report_resource_retained" { Expect.equal () fixtureBody() }

main() = Test.run tests
