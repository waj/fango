module HttpGzip exposing (tests)

import Bytes exposing (Bytes)
import Expect
import Http exposing (Body(..), Protocol(..))
import Http.GZip as GZip
import Http.Server
import Reader
import String
import Test
import Writer
import Process

compress : String -> Bytes
compress text =
    (_, bytes) = Writer.collecting { w ->
        case GZip.encoding (BytesBody (Bytes.fromString text)) of
            StreamBody emit -> emit w
            _ -> ()
    }
    bytes

-- Decodes `wire` with a limit, reporting a protocol failure.
decode : Int -> Bytes -> String
decode limit wire =
    handle
        Reader.withBytes wire { input ->
            (_, plain) = Writer.collecting { w -> Writer.copy (GZip.decoding limit input) w }
            show plain
        }
    on
        Http.invalid error -> show error

echo : Http.Server.Request e ->{e} Http.Server.Response e
echo request =
    (_, plain) = Writer.collecting { w -> Writer.copy request.body w }
    Http.Server.Response { status = 200, headers = request.headers, body = BytesBody plain }

-- Parses a request, decodes its body through the middleware, and echoes it.
serve : Bytes -> String
serve wire =
    handle
        Reader.withBytes wire { input ->
            (_, rendered) = Writer.collecting { output ->
                Http.Server.withRequest 8192 65536 1048576 input { request ->
                    Http.Server.writeResponse request.method output (GZip.decodeRequests 1024 echo request)
                }
            }
            show rendered
        }
    on
        Http.invalid error -> show error

gzipRequest : String -> Bytes -> Bytes
gzipRequest coding body =
    Bytes.append (Bytes.fromString ("POST /up HTTP/1.1\r\nHost: x\r\nContent-Encoding: " ++ coding ++ "\r\nContent-Length: " ++ show (Bytes.length body) ++ "\r\n\r\n")) body

tests : Test.Test {}
tests = Test.test "http_gzip" {
    wire = compress "hello, gzip"
    Expect.equal "\"hello, gzip\"" (decode 1024 wire)
    Expect.equal "Malformed \"invalid gzip body: unexpected EOF\"" (decode 1024 (Bytes.slice 0 (Bytes.length wire - 3) wire))
    Expect.equal "\"hello, gzip and more\"" (decode 1024 (Bytes.append wire (compress " and more")))
    Expect.equal "BodyTooLarge" (decode 1000 (compress (String.padLeft 100000 'z' "")))
    Expect.equal "\"HTTP/1.1 200 \\r\\nHost: x\\r\\nContent-Length: 11\\r\\n\\r\\nhello, gzip\"" (serve (gzipRequest "gzip" wire))
    Expect.equal "\"HTTP/1.1 415 \\r\\nContent-Length: 0\\r\\n\\r\\n\"" (serve (gzipRequest "br" wire))
}

main() = Process.runSystem { Test.run tests }
