module StdlibStringUnicode exposing (tests)

import Expect
import String
import Test
import Process

tests : Test.Test {}
tests = Test.test "stdlib_string_unicode" {
    Expect.equal 3 (String.length "aλ二")
    Expect.equal 6 (String.byteLength "aλ二")
    Expect.equal "λ二" (String.slice 1 3 "aλ二z")
    Expect.equal "aλ二" (String.slice (-4) 99 "aλ二")
    Expect.equal True (String.startsWith "aλ" "aλ二")
    Expect.equal "二" (String.fromChar '二')
    part = Expect.just (String.uncons "λ二")
    Expect.equal 'λ' part.first
    Expect.equal "二" part.rest
}

main() = Process.runSystem { Test.run tests }
