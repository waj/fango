module AsyncValues exposing (tests)

import Random
import Async exposing (Outcome(..))
import Expect
import Fail exposing (Fail)
import IO
import Result exposing (Result(..))
import Runtime.Scope
import State
import Test

runStrings : (() ->{Async.Async, IO, Fail String | e} a) ->{IO | e} Outcome (Result String a)
runStrings body = Async.runOutcome { Fail.attempt body }

type Observation
    = ValueOutcome (Async.Outcome (Result String Int))
    | NestedOutcome (Async.Outcome (Result String (Result String Int)))
    | Trace String
    deriving (Eq, Show)

record : Observation ->{IO, State.State (List Observation)} ()
record value =
    Random.runSystem { () }
    State.put [value | State.get()]

recordValueOutcome : Async.Outcome (Result String Int) ->{IO, State.State (List Observation)} ()
recordValueOutcome value = record (ValueOutcome value)

recordNestedOutcome : Async.Outcome (Result String (Result String Int)) ->{IO, State.State (List Observation)} ()
recordNestedOutcome value = record (NestedOutcome value)

recordTrace : String ->{IO, State.State (List Observation)} ()
recordTrace value = record (Trace value)

fixtureBody : () ->{IO, State.State (List Observation)} ()
fixtureBody() =
    recordValueOutcome scopeValue()
    recordNestedOutcome nestedFailure()
    recordValueOutcome (runStrings { _ ->
            Runtime.Scope.finally
                { _ ->
                    gate : Async.Channel Int
                    gate = Async.channel 0
                    task = Async.spawn { ignore (Async.receive gate); 1 }
                    Async.cancel task
                    Async.await task
                }
                { _ -> recordTrace "cancel cleanup" }
    })
    recordValueOutcome functionChannel()

scopeValue : () ->{IO} Async.Outcome (Result String Int)
scopeValue() = runStrings { _ -> Async.scope { _ -> Async.await (Async.spawn { _ -> 7 }) } }

nestedFailure : () ->{IO} Async.Outcome (Result String (Result String Int))
nestedFailure() = runStrings { _ ->
    Fail.attempt { _ ->
        Async.scope { _ ->
            Fail.fail "nested"
            1
        }
    }
}

functionChannel : () ->{IO} Async.Outcome (Result String Int)
functionChannel() = runStrings { _ ->
    ch = Async.channel 1
    ignore (Async.send ch { n -> n + 2 })
    case Async.receive ch of
        Just fn -> fn 40
        Nothing -> Fail.fail "closed"
}

observations : () ->{IO} List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test IO.IO
tests = Test.test "async_values" {
    Expect.equal [ ValueOutcome (Async.Completed (Ok 7))
                 , NestedOutcome (Async.Completed (Ok (Err "nested")))
                 , Trace "cancel cleanup"
                 , ValueOutcome Async.Cancelled
                 , ValueOutcome (Async.Completed (Ok 42))
                 ] observations()
}

main() = Test.run tests
