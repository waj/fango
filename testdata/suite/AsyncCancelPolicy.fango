module AsyncCancelPolicy exposing (tests)

import Async
import Expect
import Fail
import IO
import Result exposing (Result(..))
import Runtime.Scope
import State
import Test
import Process

type Observation = ChannelOutcome (Async.Outcome (Maybe Int)) | ValueOutcome (Async.Outcome Int) | Trace String deriving (Eq, Show)

record : Observation ->{IO, State.State (List Observation)} ()
record value =
    ignore (Fail.attempt { IO.write IO.stdout "" })
    State.put [value | State.get()]

recordChannelOutcome : Async.Outcome (Maybe Int) ->{IO, State.State (List Observation)} ()
recordChannelOutcome value = record (ChannelOutcome value)

recordValueOutcome : Async.Outcome Int ->{IO, State.State (List Observation)} ()
recordValueOutcome value = record (ValueOutcome value)

recordTrace : String ->{IO, State.State (List Observation)} ()
recordTrace value = record (Trace value)

fixtureBody : () ->{IO, State.State (List Observation)} ()
fixtureBody() =
    recordChannelOutcome (Async.runOutcome {
            ready = Async.channel 0
            gate = Async.channel 0
            target = Async.spawn { Async.receive gate }
            observer = Async.spawn {
                ignore (Async.send ready ())
                Async.await target
            }
            ignore (Async.receive ready)
            Async.cancel observer
            recordChannelOutcome (Async.awaitOutcome observer)
            ignore (Async.send gate 11)
            Async.await target
    })
    recordValueOutcome (Async.runOutcome {
            ready = Async.channel 0
            gate : Async.Channel Int
            gate = Async.channel 0
            child = Async.spawn {
                ignore (Async.spawn {
                        Runtime.Scope.finally {
                            ignore (Async.send ready ())
                            Async.receive gate
                        } { recordTrace "descendant cleaned" }
                })
                Async.receive gate
            }
            ignore (Async.receive ready)
            Async.cancel child
            recordChannelOutcome (Async.awaitOutcome child)
            42
    })

observations : () ->{IO} List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test IO.IO
tests = Test.test "async_cancel_policy" {
    Expect.equal [ ChannelOutcome Async.Cancelled
                 , ChannelOutcome (Async.Completed (Just 11))
                 , Trace "descendant cleaned"
                 , ChannelOutcome Async.Cancelled
                 , ValueOutcome (Async.Completed 42)
                 ] observations()
}

main() = Process.runSystem { Test.run tests }
