module IfLayout exposing (tests)

import Expect
import State
import Test
-- Aligned `else if` chains, keyword-led branches, and block branches all run
-- the same in both backends.
describe : Int ->{State.State (List Observation)} String
describe n =
    if n > 10 then
        label = "big"
        recordText "classified"
        label
    else if n > 5 then
        "medium"
    else
        "small"

sumTo : Int -> Int -> Int
sumTo total n =
    if n <= 0
    then
        total
    else
        sumTo (total + n) (n - 1)

type Observation = Text String | Integer Int deriving (Eq, Show)

recordText : String ->{State.State (List Observation)} ()
recordText value = State.put [Text value | State.get()]

recordInt : Int ->{State.State (List Observation)} ()
recordInt value = State.put [Integer value | State.get()]

fixtureBody : () ->{State.State (List Observation)} ()
fixtureBody() =
    recordText (describe 20)
    recordText (describe 7)
    recordText (describe 1)
    recordInt (sumTo 0 4)

observations : () -> List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "if_layout" {
    Expect.equal [Text "classified", Text "big", Text "medium", Text "small", Integer 10] observations()
}

main() = Test.run tests
