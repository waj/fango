module IteratorHelpers exposing (tests)

import Expect
import IO
import Iterator
import Maybe exposing (Maybe(..))
import Stream
import Test

foldCursor : (a -> b ->{e} b) -> b -> Iterator.Iterator a e ->{e} b
foldCursor combine initial cursor = case Iterator.next cursor of
    Nothing -> initial
    Just (value, next) -> foldCursor combine (combine value initial) next

type Held a e = Held (Iterator.Iterator a e)
type Consumer e = Consumer (Iterator.Iterator Int e ->{e} Int)

produce : Stream.Stream Int e
produce = Stream.fromList [1, 2, 3]

sumCursor : Iterator.Iterator Int e ->{e} Int
sumCursor cursor = foldCursor { element acc -> element + acc } 0 cursor

sumHeld (Held cursor) = sumCursor cursor

twice cursor =
    alias = cursor
    read() = sumHeld (Held alias)
    first = read()
    second = sumCursor cursor
    first + second

makeConsumer() = Consumer twice

runStored source =
    case makeConsumer() of
        Consumer consume -> Stream.withCursor source consume

class Consume a
    consume : Iterator.Iterator a IO ->{IO} Int

instance Consume Int
    consume cursor = sumCursor cursor

independent : Iterator.Iterator Int e -> () -> Int
independent cursor = { _ -> 42 }

tests : Test.Test IO.IO
tests = Test.test "iterator_helpers" {
    Expect.equal 12 (Stream.withCursor produce twice)
    Expect.equal 12 (runStored produce)
    Expect.equal 6 (Stream.withCursor produce consume)
    Expect.equal 18 (Stream.withCursor produce { left ->
            Stream.withCursor produce { right ->
                a = sumCursor left
                b = sumCursor right
                c = sumCursor left
                a + b + c
            }
    })
    saved = Stream.withCursor produce independent
    Expect.equal 42 saved()
}

main() = Test.run tests
