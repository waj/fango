module ClassesContextOrder exposing (tests)

import Expect
import Test
import Process
class Inspect a
    inspect : a -> String
instance Show a => Inspect a
    inspect x = "show"

before() = inspect True
forward x = inspect x

instance Eq a => Inspect a
    inspect x = "eq"
afterEq() = inspect True

instance (Eq a, Show a) => Inspect a
    inspect x = "both"
afterBoth() = inspect True

instance Ord a => Inspect a
    inspect x = "ord"

tests : Test.Test {}
tests = Test.test "classes_context_order" {
    Expect.equal "show" before()
    Expect.equal "eq" afterEq()
    Expect.equal "both" afterBoth()
    Expect.equal "ord" (forward 42)
    Expect.equal "both" (forward True)
}

main() = Process.runSystem { Test.run tests }
