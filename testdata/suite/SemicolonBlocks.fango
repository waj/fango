module SemicolonBlocks exposing (tests)

import Expect
import State
import Test
increment = { a b -> recordInt a; b + 1 }

recordInt : Int ->{State.State (List Int)} ()
recordInt value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List Int)} ()
fixtureBody() = recordInt (increment 10 41)

observations : () -> List Int
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "semicolon_blocks" {
    Expect.equal [10, 42] observations()
}

main() = Test.run tests
