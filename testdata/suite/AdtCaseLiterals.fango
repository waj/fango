module AdtCaseLiterals exposing (tests)

import Expect
import Test
describe n =
    case n of
        0 -> "zero"
        -1 -> "minus one"
        _ -> "many"

bucket f =
    case f of
        0 -> "origin"
        2.5 -> "half"
        _ -> "other"

greet s =
    case s of
        "hi" -> 1
        "bye" -> 2
        _ -> 3

tests : Test.Test {}
tests = Test.test "adt_case_literals" {
    p1 = Expect.equal "zero" (describe 0)
    p2 = Expect.equal "minus one" (describe (-1))
    p3 = Expect.equal "many" (describe 7)
    p4 = Expect.equal "origin" (bucket 0.0)
    p5 = Expect.equal "half" (bucket 2.5)
    p6 = Expect.equal 2 (greet "bye")
    Expect.equal 3 (greet "what")
}

main() = Test.run tests
