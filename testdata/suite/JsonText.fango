module JsonText exposing (tests)

import Bytes
import Encoding
import Expect
import Fail
import Json
import List
import Reader
import Result exposing (Result(..))
import Runtime.Local
import String
import Test
import Text.Reader as TextReader
import Text.Writer as TextWriter
import Writer
import Process

decoded : String -> Result Json.Error String -> Bool
decoded expected result = case result of
    Err _ -> False
    Ok text -> text == expected

tests : Test.Test {}
tests = Test.test "json_text" {
    Expect.equal True (decoded "😀" (Json.parse @String "\"\\uD83D\\uDE00\""))
    Expect.equal True (decoded "é二😀�" (Json.parse @String "\"é二😀�\""))
    Expect.equal True (case Json.stringify "é\n二\t😀\"\\" of
            Err _ -> False
            Ok encoded -> decoded "é\n二\t😀\"\\" (Json.parse @String encoded)
    )
    Expect.equal True (Reader.withBytes (Bytes.fromList [34, 233, 255, 34]) { bytes ->
            TextReader.overWith Encoding.latin1 bytes { text -> decoded "éÿ" (Json.readText @String text) }
    })
    Expect.equal True (case Fail.attempt { Writer.collecting { bytes -> TextWriter.overWith Encoding.latin1 bytes { text -> Json.writeText text "éÿ" } } } of
            Err _ -> False
            Ok (outcome, bytes) -> case outcome of
                Err _ -> False
                Ok _ -> bytes == Bytes.fromList [34, 233, 255, 34]
    )
    Expect.equal True (case Fail.attempt { Writer.collecting { bytes -> TextWriter.overWith Encoding.latin1 bytes { text -> Json.writeText text "😀" } } } of
            Err _ -> False
            Ok (outcome, _) -> case outcome of
                Ok _ -> False
                Err error -> String.contains "not representable" error.message && error.offset == -1
    )
    Expect.equal True (Runtime.Local.run (Bytes.toList (Bytes.fromString "[\"é二😀\",\"\\uD83D\\uDE00\"]")) { remaining ->
            source = Bytes.Source
                { pull = {
                    case remaining.read() of
                        [] -> Nothing
                        [byte | rest] ->
                            remaining.write rest
                            Just (Bytes.fromList [byte])
                  }
                }
            Reader.over source { bytes ->
                case Json.read @(List String) bytes of
                    Err _ -> False
                    Ok values -> values == ["é二😀", "😀"]
            }
    })
    Expect.equal True (case Json.parseBytes @Json.Value (Bytes.fromList [91, 34, 195, 169, 34, 44, 255, 93]) of
            Ok _ -> False
            Err error -> error.offset == 6 && error.line == 1 && error.column == 7
    )
    Expect.equal True (case Json.parseBytes @Json.Value (Bytes.fromList [91, 34, 195, 169, 240, 159]) of
            Ok _ -> False
            Err error -> error.offset == 4 && error.line == 1 && error.column == 5 && error.path == ""
    )
    Expect.equal True (case Fail.attempt { Reader.over (Bytes.Source { pull = { Fail.fail "source" } }) { bytes -> Json.read @String bytes } } of
            Err error -> error == "source"
            Ok _ -> False
    )
    Expect.equal True (Runtime.Local.run (0, 0) { counts ->
            parent = Writer.Writer
                { emit = { _ ->
                    (writes, flushes) = counts.read()
                    counts.write (writes + 1, flushes)
                  }
                , flush = {
                    (writes, flushes) = counts.read()
                    counts.write (writes, flushes + 1)
                  }
                }
            case Json.write parent "é" of
                Err _ -> False
                Ok _ -> counts.read() == (3, 0)
    })
}

main() = Process.runSystem { Test.run tests }
