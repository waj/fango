module StreamRecovery exposing (tests)

import Expect
import Fail
import Iterator
import Result exposing (Result(..))
import Runtime.Scope
import State
import Stream
import Test

source = Stream.unfold 0 { state ->
    if state == 0 then Just (9, 1) else Fail.fail "producer failed"
}

type Observation = ResultValue (Result String ()) | Trace String | Value Int deriving (Eq, Show)

record : Observation ->{State.State (List Observation)} ()
record value = State.put [value | State.get()]

recordResultValue : Result String () ->{State.State (List Observation)} ()
recordResultValue value = record (ResultValue value)

recordTrace : String ->{State.State (List Observation)} ()
recordTrace value = record (Trace value)

recordValue : Int ->{State.State (List Observation)} ()
recordValue value = record (Value value)

fixtureBody : () ->{State.State (List Observation)} ()
fixtureBody() = recordResultValue (Fail.attempt { _ ->
        Runtime.Scope.finally { _ ->
            Stream.withCursor source { cursor ->
                case Iterator.next cursor of
                    Nothing -> recordTrace "empty"
                    Just (value, next) ->
                        recordValue value
                        recordTrace (case Fail.attempt { _ -> Iterator.next next } of
                                Err error -> error
                                Ok _ -> "unexpected success"
                        )
                        recordTrace (case Fail.attempt { _ -> Iterator.next next } of
                                Err error -> error
                                Ok _ -> "unexpected success"
                        )
            }
        } { _ -> recordTrace "closed" }
})

observations : () -> List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "stream_recovery" {
    Expect.equal [ Value 9
                 , Trace "producer failed"
                 , Trace "producer failed"
                 , Trace "closed"
                 , ResultValue (Ok ())
                 ] observations()
}

main() = Test.run tests
