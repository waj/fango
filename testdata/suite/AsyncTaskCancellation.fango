module AsyncTaskCancellation exposing (tests)

import Random
import Async
import Expect
import Fail
import IO
import Result exposing (Result(..))
import State
import Test

effect Stop
    abort stop : Async.Task Int -> ()

waiter : Int -> () ->{Async.Async} Int
waiter value () =
    Async.sleep 60000
    value

type Observation = TaskOutcome (Async.Outcome Int) deriving (Eq, Show)

record : Observation ->{IO, State.State (List Observation)} ()
record value =
    Random.runSystem {}
    State.put [value | State.get()]

recordTaskOutcome : Async.Outcome Int ->{IO, State.State (List Observation)} ()
recordTaskOutcome value = record (TaskOutcome value)

fixtureBody : () ->{IO, State.State (List Observation)} ()
fixtureBody() =
    ignore (Async.runOutcome { _ ->
            child = Async.spawn (waiter 7)
            Async.cancel child
            recordTaskOutcome (Async.awaitOutcome child)
            recordTaskOutcome (Async.awaitOutcome child)
    })
    handle
        ignore (Async.runOutcome { _ ->
                child = Async.spawn (waiter 9)
                stop child
        })
    on
        stop child -> recordTaskOutcome (Async.wait child)

observations : () ->{IO} List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test IO.IO
tests = Test.test "async_task_cancellation" {
    Expect.equal [ TaskOutcome Async.Cancelled
                 , TaskOutcome Async.Cancelled
                 , TaskOutcome Async.Cancelled
                 ] observations()
}

main() = Test.run tests
