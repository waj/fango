module EffectRowNestedArguments exposing (tests)

import Expect
import State
import Test
type Key a = Key a

effect Put a
    put : a -> ()

both : () ->{Put (Key Bool), Put (Key String)} ()
both() =
    put (Key True)
    put (Key "answer")

-- Each handler names the application it takes; label order never decides.
observeStrings : (() ->{Put (Key String), State.State (List Observation) | e} a) ->{State.State (List Observation) | e} a
observeStrings action = handle action() on
    put (Key text) -> recordText text; resume ()

observeBools : (() ->{Put (Key Bool), State.State (List Observation) | e} a) ->{State.State (List Observation) | e} a
observeBools action = handle action() on
    put (Key flag) -> recordBool flag; resume ()

type Observation = Text String | Flag Bool deriving (Eq, Show)

recordText : String ->{State.State (List Observation)} ()
recordText value = State.put [Text value | State.get()]

recordBool : Bool ->{State.State (List Observation)} ()
recordBool value = State.put [Flag value | State.get()]

fixtureBody : () ->{State.State (List Observation)} ()
fixtureBody() = observeBools { observeStrings { both() } }

observations : () -> List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "effect_row_nested_arguments" {
    Expect.equal [Flag True, Text "answer"] observations()
}

main() = Test.run tests
