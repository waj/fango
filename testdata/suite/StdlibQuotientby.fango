module StdlibQuotientby exposing (tests)

import Basics exposing (modBy, quotientBy, remainderBy)
import Expect
import Test

-- quotientBy pairs with remainderBy (both truncate); divBy would pair with
-- modBy (both floor) but does not exist yet.
identity : Int -> Int -> Bool
identity divisor x = quotientBy divisor x * divisor + remainderBy divisor x == x

tests : Test.Test {}
tests = Test.test "stdlib_quotientby" {
    Expect.equal 2 (quotientBy 3 7)
    Expect.equal (-2) (quotientBy 3 (-7))
    Expect.equal (-2) (quotientBy (-3) 7)
    Expect.equal 2 (quotientBy (-3) (-7))
    Expect.equal 42 (quotientBy 1 42)
    Expect.equal (-42) (quotientBy (-1) 42)
    Expect.equal 0 (quotientBy 7 3)
    Expect.equal 0 (quotientBy 7 (-3))
    Expect.equal True (identity 3 7)
    Expect.equal True (identity 3 (-7))
    Expect.equal True (identity (-3) 7)
    Expect.equal True (identity (-3) (-7))
    Expect.equal True (identity 5 0)
    -- Truncation rounds toward zero; modBy still floors.
    Expect.equal (-1) (remainderBy 3 (-7))
    Expect.equal 2 (modBy 3 (-7))
}

main() = Test.run tests
