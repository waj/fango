module EquationsRecordLambda exposing (tests)

import Expect
import Test
-- A lambda has one pattern row, so an irrefutable record pattern is enough.
type Point = { x : Int, y : Int } deriving (Show)

shift : Int -> Point -> Point
shift by (Point { x = a, y = b }) = Point { x = a + by, y = b + by }

tests : Test.Test {}
tests = Test.test "equations_record_lambda" {
    area = { (Point { x = a, y = b }) -> a * b }
    Expect.equal 12 (area (Point { x = 3, y = 4 }))
    Expect.equal "Point { x = 4, y = 5 }" (show (shift 1 (Point { x = 3, y = 4 })))
}

main() = Test.run tests
