module FileGenericWrapper exposing (tests)

import Expect
import Fail exposing (Fail)
import File
import IO exposing (Error)
import Test

-- The wrapper exports the callback lifetime obligation to its callers.

withWrapped : String -> (File.Handle ->{File.FileSystem, Fail Error | e} a) ->{File.FileSystem, Fail Error | e} a
withWrapped path action =
    File.withFile path action

tests : Test.Test File.FileSystem
tests = Test.test "file_generic_wrapper" {
    path = "missing-file-generic-wrapper-test"
    error = Expect.err (Fail.attempt { withWrapped path { _ -> () } })
    Expect.equal IO.NotFound error.kind
    Expect.equal path error.path
}

main() = Test.run tests
