module EquationTwoProducts exposing (tests)

import Expect
import Test
import Process
-- Equations whose columns are all constructor patterns on single-constructor
-- products, in pure functions small enough to be inlined at their call sites.
type Pair = Pair Int Int deriving (Eq, Show)
type Box = Box Int deriving (Eq, Show)

combine : Pair -> Pair -> Pair
combine (Pair a b) (Pair c d) = Pair (a + c) (b + d)

scaleBy : Box -> Pair -> Pair
scaleBy (Box k) (Pair a b) = Pair (k * a) (k * b)

total (Pair a b) = a + b

tests : Test.Test {}
tests = Test.test "equation_two_products" {
    first = Pair 1 2
    Expect.equal (Pair 4 6) (combine first (Pair 3 4))
    Expect.equal (Pair 4 8) (scaleBy (Box 2) (combine first first))
    Expect.equal 9 (total (scaleBy (Box 3) first))
}

main() = Process.runSystem { Test.run tests }
