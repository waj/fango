module ClassesRecordFields exposing (tests)

import Expect
import Test
import Process
class Inspect a
    inspect : a -> String

class Shift a
    shift : a -> a

type Point = { x : Float, y : Float } deriving (Show)
type Named = { label : String, point : Point } deriving (Show)

quoted : String -> String
quoted text = "\"" ++ text ++ "\""

instance Inspect Point
    inspect point = "Point { x = " ++ show point.x ++ ", y = " ++ show point.y ++ " }"

instance Inspect Named
    inspect named = quoted named.label ++ " at " ++ inspect named.point

instance Shift Point
    shift point = { point | x = point.x + 1.0 }

instance Shift Named
    shift named = { named | point = shift named.point }

tests : Test.Test {}
tests = Test.test "classes_record_fields" {
    Expect.equal "Point { x = 1, y = 2 }" (inspect (Point { x = 1.0, y = 2.0 }))
    Expect.equal "\"origin\" at Point { x = 0, y = 0 }" (inspect (Named { label = "origin", point = Point { x = 0.0, y = 0.0 } }))
    Expect.equal "Point { x = 2, y = 2 }" (inspect (shift (Point { x = 1.0, y = 2.0 })))
    Expect.equal "Named { label = \"a\", point = Point { x = 2, y = 2 } }" (show (shift (Named { label = "a", point = Point { x = 1.0, y = 2.0 } })))
}

main() = Process.runSystem { Test.run tests }
