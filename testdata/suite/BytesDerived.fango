module BytesDerived exposing (tests)

import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Expect
import Fail
import Failure
import Result exposing (Result(..))
import Runtime.Scope
import Test
import Process

-- Bytes is an ordinary nominal type to the deriver, so a type holding one
-- derives like any other.
type Packet = Packet Bytes Int deriving (Eq, Ord, Show)

effect Wire
    abort send : Bytes -> ()

tests : Test.Test {}
tests = Test.test "bytes_derived" {
    first = Packet (Bytes.fromString "ab") 1
    second = Packet (Bytes.fromString "ac") 1
    Expect.equal "Packet \"ab\" 1" (show first)
    Expect.equal first first
    Expect.notEqual first second
    Expect.equal True (first < second)
    Expect.equal "[Packet \"ab\" 1, Packet \"ac\" 1]" (show [first, second])
    table = Dict.insert (Bytes.fromString "k") 7 Dict.empty
    Expect.equal (Just 7) (Dict.get (Bytes.fromString "k") table)
    Expect.equal Nothing (Dict.get (Bytes.fromString "j") table)
    result : Result (Fail.Report Bytes) Int
    result =
        handle
            Fail.attemptReport {
                Runtime.Scope.finally { Fail.fail (Bytes.fromString "body"); 1 } { send (Bytes.fromString "close\r\n") }
            }
        on
            send _ -> Ok 0
    failed = Expect.err result
    Expect.equal (Bytes.fromString "body") failed.primary
    Expect.equal 1 (List.length failed.suppressed)
    List.each { failure ->
        Expect.equal "BytesDerived.send" (Failure.operationName failure)
        payload : Maybe Bytes
        payload = Failure.argument 0 failure
        Expect.equal (Just (Bytes.fromString "close\r\n")) payload
        text : Maybe String
        text = Failure.argument 0 failure
        Expect.equal Nothing text
    } failed.suppressed
}

main() = Process.runSystem { Test.run tests }
