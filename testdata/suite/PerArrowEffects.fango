module PerArrowEffects exposing (tests)

import Expect
import State
import Test
make : () ->{State.State (List String)} () ->{State.State (List String)} ()
make() =
    recordText "create"
    { _ -> recordText "apply" }

recordText : String ->{State.State (List String)} ()
recordText value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List String)} ()
fixtureBody() =
    callback = make()
    recordText "between"
    callback()

observations : () -> List String
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "per_arrow_effects" {
    Expect.equal ["create", "between", "apply"] observations()
}

main() = Test.run tests
