module NativePhantom exposing (tests)

import Expect
import Test
import Process
{-# resource #-}
type Token a = Token Int

number : Int -> Token Int
number = native

text : Int -> Token String
text = native

value : Token a -> Int
value = native

tests : Test.Test {}
tests = Test.test "native_phantom" {
    Expect.equal 7 (value (number 7))
    Expect.equal 8 (value (text 8))
}

main() = Process.runSystem { Test.run tests }
