module BoolShortCircuit exposing (tests)

import Expect
import State
import Test
-- The right operand of `&&`/`||` is not evaluated when the left operand
-- already decides the result, so its effects do not happen either.
loud : Bool ->{State.State Int} Bool
loud value =
    State.put (State.get() + 1)
    value

check : (() ->{State.State Int} Bool) -> (Bool, Int)
check action =
    observed = State.run 0 action
    (observed.value, observed.state)

tests : Test.Test {}
tests = Test.test "bool_short_circuit" {
    Expect.equal (False, 0) (check { False && loud True })
    Expect.equal (True, 0) (check { True || loud False })
    Expect.equal (False, 1) (check { True && loud False })
    Expect.equal (True, 1) (check { False || loud True })
}

main() = Test.run tests
