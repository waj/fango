{-# no-prelude #-}
module StringInterpolationNoPrelude exposing (tests)

import Expect
import Test
import Process
fixtureBody() = "#{True} #{'二'}"

tests : Test.Test {}
tests = Test.test "string_interpolation_no_prelude" { Expect.equal "True 二" fixtureBody() }

main() = Process.runSystem { Test.run tests }
