module MetaLocalFunction exposing (tests)

import Expect
import Meta exposing (Code, Items(..))
import State
import Test
import Process

counter : Code
counter = Meta.lambda "_offset" { offset ->
    Meta.localFunction "_count" (Item "_remaining" (Item "_total" NoItems)) { self parameters ->
        case parameters of
            Item remaining (Item total NoItems) ->
                `if $(remaining) == 0 then $(total)
                    else $(self) ($(remaining) - 1) ($(total) + $(offset))`
            _ -> Meta.fail "Expected two counter parameters"
    } { self -> Meta.sequence `State.put ["count" | State.get()]` `$(self) 2000000 0` }
}

identityCode : Code
identityCode = Meta.localFunction "_identity" (Item "_value" NoItems) { _ parameters ->
    case parameters of
        Item value NoItems -> value
        _ -> Meta.fail "Expected one identity parameter"
} { self -> self }

count : Int ->{State.State (List String)} Int
count = $(counter)

identity = $(identityCode)

observations : () -> (Int, List String)
observations() =
    observed = State.run [] { count 3 }
    (observed.value, List.reverse observed.state)

tests : Test.Test {}
tests = Test.test "meta_local_function" {
    Expect.equal (6000000, ["count"]) observations()
    Expect.equal (42, "generic") (identity 42, identity "generic")
}

main() = Process.runSystem { Test.run tests }
