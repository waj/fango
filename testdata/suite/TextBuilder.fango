module TextBuilder exposing (tests)

import Basics
import Expect
import List
import String
import Test
import Text.Builder as Builder exposing (append, appendChar, appendFloat, appendInt)
import Process

build : List String -> Builder.Builder
build parts = List.foldl Builder.append Builder.empty parts

tests : Test.Test {}
tests = Test.test "text_builder" {
    Expect.equal "" (Builder.toString Builder.empty)
    base = build ["caf", "é ", "東京"]
    Expect.equal "café 東京" (Builder.toString base)
    -- Two versions extend one base: the second must not see the first's text.
    left = Builder.append " left" base
    right = Builder.appendChar '🚚' (Builder.appendChar ' ' base)
    Expect.equal "café 東京 left" (Builder.toString left)
    Expect.equal "café 東京 🚚" (Builder.toString right)
    Expect.equal "café 東京" (Builder.toString base)
    -- Extending the older version again after a newer one copies its prefix.
    again = Builder.append "!" left
    Expect.equal "café 東京 left!" (Builder.toString again)
    Expect.equal "café 東京 left?" (Builder.toString (Builder.append "?" left))
    Expect.equal "" (Builder.toString (Builder.append "" Builder.empty))
    Expect.equal "x" (Builder.toString (Builder.appendChar 'x' Builder.empty))
    long = List.foldl { n builder -> Builder.appendChar (if Basics.modBy 2 n == 0 then 'a' else 'b') builder } Builder.empty (List.range 1 1000)
    Expect.equal 1000 (String.length (Builder.toString long))
    piped = Builder.empty |> append "foo" |> appendInt 123 |> appendChar '!' |> appendFloat 1.25
    Expect.equal "foo123!1.25" (Builder.toString piped)
}

main() = Process.runSystem { Test.run tests }
