module SubsumptionSharedOpenRow exposing (tests)

import Expect
import State
import Test
import Process
type Source a e = Source (() ->{e} a)

read : Source a e ->{e} a
read source = case source of
    Source action -> action()

withSource : Source a e -> (Source a e ->{e} b) ->{e} b
withSource source consumer = consumer source

readAndObserve : Source a e ->{State.State (List Observation) | e} a
readAndObserve source =
    recordText "read"
    read source

observed : Source a e ->{State.State (List Observation) | e} a
observed source = withSource source { cursor -> readAndObserve cursor }

type Observation = Text String | Integer Int deriving (Eq, Show)

recordText : String ->{State.State (List Observation)} ()
recordText value = State.put [Text value | State.get()]

recordInt : Int ->{State.State (List Observation)} ()
recordInt value = State.put [Integer value | State.get()]

fixtureBody : () ->{State.State (List Observation)} ()
fixtureBody() = recordInt (observed (Source { _ -> 42 }))

observations : () -> List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "subsumption_shared_open_row" {
    Expect.equal [Text "read", Integer 42] observations()
}

main() = Process.runSystem { Test.run tests }
