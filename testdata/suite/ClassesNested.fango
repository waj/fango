module ClassesNested exposing (tests)

import Expect
import Test
import Text.Builder
import Process

type Wrap a = Wrap a
type Box a = Box a

instance Show (Box (Wrap Int))
    showTo built value = Text.Builder.append (show value) built
    show b = "box of wrapped ints"

tests : Test.Test {}
tests = Test.test "classes_nested" {
    Expect.equal "box of wrapped ints" (show (Box (Wrap 1)))
}

main() = Process.runSystem { Test.run tests }
