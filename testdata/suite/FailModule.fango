module FailModule exposing (tests)

import Expect
import Fail exposing (Fail, attempt, fail, fromResult)
import Result exposing (Result(..))
import String
import Test

-- The bundled Fail module: attempt captures a failure as a Result, fromResult
-- raises an Err, and a nested attempt handles the innermost failure only.

parsePositive : String ->{Fail String} Int
parsePositive text =
    case String.toInt text of
        Nothing -> fail ("not a number: " ++ text)
        Just n -> if n > 0 then n else fail ("not positive: " ++ text)

decrement : Int -> Result String Int
decrement n = if n == 0 then Err "zero" else Ok (n - 1)

tests : Test.Test {}
tests = Test.test "fail_module" {
    Expect.equal (Ok 42) (attempt { parsePositive "42" })
    Expect.equal (Err "not a number: x") (attempt { parsePositive "x" })
    Expect.equal (Err "not positive: -3") (attempt { parsePositive "-3" })
    Expect.equal (Ok 9) (attempt { fromResult (decrement 10) })
    Expect.equal (Err "zero") (attempt { fromResult (decrement 0) })
    Expect.equal (Err "outer saw inner failure") (attempt {
            inner = attempt { parsePositive "oops" }
            case inner of
                Err _ -> fail "outer saw inner failure"
                Ok n -> n
    })
    Expect.equal True (String.contains "ell" "hello")
    Expect.equal True (String.contains "" "hello")
    Expect.equal False (String.contains "hello!" "hello")
    Expect.equal True (String.contains "lo" "hello")
}

main() = Test.run tests
