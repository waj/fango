module StdlibStringTofloat exposing (tests)

import Expect
import String
import Test

tests : Test.Test {}
tests = Test.test "stdlib_string_tofloat" {
    Expect.equal (Just 0.0) (String.toFloat "0")
    Expect.equal (Just 0.0) (String.toFloat "-0")
    Expect.equal (Just 17.0) (String.toFloat "+17")
    Expect.equal (Just 1.25) (String.toFloat "1.25")
    Expect.equal (Just 1000.0) (String.toFloat "1e3")
    Expect.equal (Just 0.01) (String.toFloat "1.0E-2")
    Expect.equal (Just 5e-324) (String.toFloat "5e-324")
    Expect.equal (Just 1.7976931348623157e+308) (String.toFloat "1.7976931348623157e308")
    Expect.equal Nothing (String.toFloat "")
    Expect.equal Nothing (String.toFloat "+")
    Expect.equal Nothing (String.toFloat ".5")
    Expect.equal Nothing (String.toFloat "1.")
    Expect.equal Nothing (String.toFloat "1e")
    Expect.equal Nothing (String.toFloat " 1")
    Expect.equal Nothing (String.toFloat "1 ")
    Expect.equal Nothing (String.toFloat "NaN")
    Expect.equal Nothing (String.toFloat "Infinity")
    Expect.equal Nothing (String.toFloat "0x1p2")
    Expect.equal Nothing (String.toFloat "1e309")
    Expect.equal Nothing (String.toFloat "1e-4000")
}

main() = Test.run tests
