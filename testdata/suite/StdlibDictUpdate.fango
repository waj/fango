module StdlibDictUpdate exposing (suite)

import Dict
import Expect
import List
import Maybe exposing (Maybe(..))
import State exposing (State(..))
import Test exposing (Test, describe, test)
import Text.Builder
import Process

base : Dict.Dict String Int
base = Dict.fromList [("a", 1), ("b", 2)]

-- A key type whose Ord calls two spellings equivalent while Show keeps them
-- apart, so "the stored key is kept" is observable.
type Fold = Fold String

lower : Fold -> String
lower key =
    case key of
        Fold text -> if text == "A" then "a" else if text == "B" then "b" else text

instance Eq Fold
    (==) x y = lower x == lower y

instance Ord Fold
    (<) x y = lower x < lower y
    (>) x y = lower x > lower y
    (<=) x y = lower x <= lower y
    (>=) x y = lower x >= lower y

instance Show Fold
    showTo built value = Text.Builder.append (show value) built
    show key =
        case key of
            Fold text -> text

-- Records a call, so how often a callback runs is observable without
-- printing from inside a test.
visit : String ->{State (List String)} ()
visit key = put [key | get ()]

visited : (() ->{State (List String)} a) -> List String
visited action = List.reverse (State.run [] action).state

suite : Test {}
suite =
    describe "Dict.update"
        [ test "leaves an absent key absent when the callback answers Nothing" {
            Expect.equal base (Dict.update "z" { _ -> Nothing } base)
            Expect.equal 2 (Dict.size (Dict.update "z" { _ -> Nothing } base))
        }
        , test "inserts an absent key when the callback answers Just" {
            Expect.equal (Dict.fromList [("a", 1), ("b", 2), ("z", 9)]) (Dict.update "z" { _ -> Just 9 } base)
        }
        , test "replaces a present key's value when the callback answers Just" {
            Expect.equal (Dict.fromList [("a", 9), ("b", 2)]) (Dict.update "a" { _ -> Just 9 } base)
        }
        , test "removes a present key when the callback answers Nothing" {
            Expect.equal (Dict.fromList [("b", 2)]) (Dict.update "a" { _ -> Nothing } base)
        }
        , test "the callback sees what was there" {
            bump = { existing ->
                case existing of
                    Nothing -> Just 0
                    Just n -> Just (n + 100)
            }
            Expect.equal (Dict.fromList [("a", 101), ("b", 2)]) (Dict.update "a" bump base)
            Expect.equal (Dict.fromList [("a", 1), ("b", 2), ("z", 0)]) (Dict.update "z" bump base)
        }
        , test "inserting into an absent key matches insert" {
            Expect.equal (Dict.insert "z" 9 base) (Dict.update "z" { _ -> Just 9 } base)
        }
        , test "the callback runs exactly once per call, at the end of the search path" {
            -- the effect row is open, so a State callback is allowed
            bigger = Dict.fromList [("a", 1), ("b", 2), ("c", 3), ("d", 4), ("e", 5)]
            Expect.equal ["called"] (visited { Dict.update "d" { _ -> visit "called"; Just 40 } bigger })
            Expect.equal (Dict.fromList [("a", 1), ("b", 2), ("c", 3), ("d", 40), ("e", 5)]) (Dict.update "d" { _ -> Just 40 } bigger)
            -- and once even when the key is absent
            Expect.equal ["called"] (visited { Dict.update "zz" { _ -> visit "called"; Nothing } bigger })
            Expect.equal 5 (Dict.size (Dict.update "zz" { _ -> Nothing } bigger))
        }
        , test "the stored key survives; only the value changes" {
            folded = Dict.fromList [(Fold "a", 1)]
            Expect.equal "Dict [a = 2]" (show (Dict.insert (Fold "A") 2 folded))
            Expect.equal "Dict [a = 3]" (show (Dict.update (Fold "A") { _ -> Just 3 } folded))
            Expect.equal "Dict [a = 2]" (show (Dict.fromList [(Fold "a", 1), (Fold "A", 2)]))
        }
        ]
main() = Process.runSystem { Test.run suite }
