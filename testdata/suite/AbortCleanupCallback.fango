module AbortCleanupCallback exposing (tests)

import Expect
import State
import Test
import Process
effect Exception ex
    abort throw : ex -> a

finally : (() ->{Exception ex | e} a) -> (() ->{e} ()) ->{Exception ex | e} a
finally action cleanup =
    handle action() on
        throw msg ->
            cleanup()
            throw msg
        return result ->
            cleanup()
            result

catch : (() ->{Exception ex | e} a) -> (ex ->{e} a) ->{e} a
catch action handler =
    handle action() on
        throw msg -> handler msg
        return result -> result

recordText : String ->{State.State (List String)} ()
recordText value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List String)} ()
fixtureBody() =
    catch
        { _ -> finally { _ -> throw "boom" } { _ -> recordText "cleanup" } }
        { msg -> recordText msg }

observations : () -> List String
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "abort_cleanup_callback" {
    Expect.equal ["cleanup", "boom"] observations()
}

main() = Process.runSystem { Test.run tests }
