module STMQueue exposing (tests)

import Async exposing (Outcome(..))
import Expect
import IO
import List
import STM exposing (STM)
import STM.Queue as Queue exposing (Queue)
import Test

-- Whether a producer's sequence numbers arrived in increasing order.
ordered : Int -> List (Int, Int) -> Bool
ordered producer received =
    ascending (List.map { (_, n) -> n } (List.filter { (p, _) -> p == producer } received))

ascending : List Int -> Bool
ascending values =
    case values of
        [first, second | rest] -> first < second && ascending [second | rest]
        _ -> True

-- Three producers push their own numbered sequences through a small bounded
-- queue to three consumers. Every value arrives once, and each consumer sees
-- each producer's values in the order they were pushed.
fifo : () ->{IO} Outcome (Int, Int, Bool)
fifo() =
    Async.runOutcome {
        queue = STM.atomically { Queue.bounded 4 }
        producers = List.map { p -> Async.spawn { List.each { n -> STM.atomically { Queue.push queue (p, n) } } (List.range 1 100) } } (List.range 1 3)
        consumers = List.map { _ -> Async.spawn { List.map { _ -> STM.atomically { Queue.pop queue } } (List.range 1 100) } } (List.range 1 3)
        _ = Async.awaitAll producers
        received = Async.awaitAll consumers
        all = List.foldr { values rest -> List.foldr { value tail -> [value | tail] } rest values } [] received
        inOrder = List.foldl { values ok -> ok && ordered 1 values && ordered 2 values && ordered 3 values } True received
        (List.length all, List.foldl { (_, n) sum -> sum + n } 0 all, inOrder)
    }

-- A producer blocks while a bounded queue is full and proceeds once a
-- consumer frees a slot.
backpressure : () ->{IO} Outcome ((Bool, Bool), Int, (Bool, List Int))
backpressure() =
    Async.runOutcome {
        queue = STM.atomically { Queue.bounded 2 }
        started = STM.atomically { STM.new False }
        finished = STM.atomically { STM.new False }
        STM.atomically { Queue.push queue 1; Queue.push queue 2 }
        rejected = STM.atomically { Queue.tryPush queue 9 }
        producer = Async.spawn {
            STM.atomically { STM.write started True }
            STM.atomically { Queue.push queue 3 }
            STM.atomically { STM.write finished True }
        }
        STM.atomically { STM.check (STM.read started) }
        Async.sleep 5
        early = STM.atomically { STM.read finished }
        first = STM.atomically { Queue.pop queue }
        Async.await producer
        ((rejected, early), first, STM.atomically { (STM.read finished, Queue.drain queue) })
    }

popAny : List (Queue a) ->{STM} a
popAny queues =
    choose = List.foldr { queue rest -> { STM.orElse { Queue.pop queue } rest } } { STM.retry () } queues
    choose ()

-- `popAny` takes from whichever queue has a value, and a waiter blocked on
-- all of them wakes when any one is pushed.
selection : () ->{IO} Outcome (String, String, String)
selection() =
    Async.runOutcome {
        (first, middle, last) = STM.atomically { (Queue.unbounded (), Queue.unbounded (), Queue.unbounded ()) }
        queues = [first, middle, last]
        STM.atomically { Queue.push middle "middle" }
        taken = STM.atomically { popAny queues }
        waiter = Async.spawn { STM.atomically { popAny queues } }
        Async.sleep 1
        STM.atomically { Queue.push last "late" }
        second = Async.await waiter
        third = STM.atomically { STM.orElse { popAny queues } { "empty" } }
        (taken, second, third)
    }

tests : Test.Test IO.IO
tests = Test.test "stm_queue" {
    Expect.equal (Completed (300, 15150, True)) fifo()
    Expect.equal (Completed ((False, False), 1, (True, [2, 3]))) backpressure()
    Expect.equal (Completed ("middle", "late", "empty")) selection()
}

main() = Test.run tests
