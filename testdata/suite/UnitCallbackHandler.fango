module UnitCallbackHandler exposing (tests)

import Expect
import State
import Test
import Process
effect Console
    emit : String -> ()

program : () ->{Console} ()
program() = emit "handled"

collect : (() ->{Console} ()) ->{State.State (List String)} ()
collect action =
    handle action() on
        emit text ->
            recordText text
            resume ()

recordText : String ->{State.State (List String)} ()
recordText value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List String)} ()
fixtureBody() = collect program

observations : () -> List String
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "unit_callback_handler" {
    Expect.equal ["handled"] observations()
}

main() = Process.runSystem { Test.run tests }
