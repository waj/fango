module PolyFailureRebuild exposing (tests)

import Expect
import Fail
import Failure
import Result exposing (Result(..))
import Runtime.Scope
import Test

type Shape a = Circle a | Square a a | Empty deriving (Eq, Show)

type Pair a b = Pair a b deriving (Eq, Show)

effect Close a
    abort closeShape : Shape (List a) -> ()
    abort closePair : Maybe (Pair Int a) -> ()

effect Cleanup
    cleanupShape : a -> ()
    cleanupPair : a -> ()

effect Outer
    outer : b -> ()

suppressedArguments : Result (Fail.Report String) () -> List Failure.Failure
suppressedArguments report =
    case report of
        Err failure -> failure.suppressed
        Ok _ -> []

cleanups action =
    handle action () on
        cleanupShape value -> resume (
            handle
                Runtime.Scope.finally { _ -> Fail.fail "body" } { _ -> closeShape (Square [value] [value, value]) }
            on
                closeShape _ -> ()
                closePair _ -> ()
        )
        cleanupPair value -> resume (
            handle
                Runtime.Scope.finally { _ -> Fail.fail "body" } { _ -> closePair (Just (Pair 1 value)) }
            on
                closeShape _ -> ()
                closePair _ -> ()
        )

tests : Test.Test {}
tests = Test.test "poly_failure_rebuild" {
    shapes = suppressedArguments (Fail.attemptReport { cleanups { cleanupShape 42 } })
    Expect.equal 1 (List.length shapes)
    List.each { failure ->
        argument : Maybe (Shape (List Int))
        argument = Failure.argument 0 failure
        Expect.equal (Just (Square [42] [42, 42])) argument
        erased : Maybe (Shape (List String))
        erased = Failure.argument 0 failure
        Expect.equal Nothing erased
    } shapes
    pairs = suppressedArguments (Fail.attemptReport { cleanups { cleanupPair "text" } })
    Expect.equal 1 (List.length pairs)
    List.each { failure ->
        argument : Maybe (Maybe (Pair Int String))
        argument = Failure.argument 0 failure
        Expect.equal (Just (Just (Pair 1 "text"))) argument
    } pairs
    nested = suppressedArguments (Fail.attemptReport {
            cleanups {
                handle outer 7 on
                    outer value -> resume (cleanupShape [value])
            }
    })
    Expect.equal 1 (List.length nested)
    List.each { failure ->
        argument : Maybe (Shape (List (List Int)))
        argument = Failure.argument 0 failure
        Expect.equal (Just (Square [[7]] [[7], [7]])) argument
    } nested
}

main() = Test.run tests
