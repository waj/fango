module TailLoopUnitarg exposing (tests)

import Expect
import State
import Test
import Process
-- A non-atomic effectful argument to a Unit parameter: the Go ABI erases the
-- parameter but must not erase the argument's evaluation, and the observation must
-- observe the CURRENT n — before the loop reassigns it. Pins the jump's
-- ordered temporary prelude.
pump : Int -> () ->{State.State (List Int)} ()
pump n u = if n < 1 then u else pump (n - 1) (recordInt n)

recordInt : Int ->{State.State (List Int)} ()
recordInt value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List Int)} ()
fixtureBody() = pump 3 ()

observations : () -> List Int
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test {}
tests = Test.test "tail_loop_unitarg" {
    Expect.equal [3, 2, 1] observations()
}

main() = Process.runSystem { Test.run tests }
