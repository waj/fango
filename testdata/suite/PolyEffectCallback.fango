module PolyEffectCallback exposing (tests)

import Expect
import State
import Test
effect Apply
    apply : (a ->{State.State (List String)} a) -> a -> a

note : String ->{State.State (List String)} ()
note value = State.put [value | State.get()]

fixtureBody : () ->{State.State (List String)} Int
fixtureBody() =
    handle apply { x -> note "called"; x } 42 on
        apply f x -> resume (f x)

observations : () -> (Int, List String)
observations() =
    observed = State.run [] fixtureBody
    (observed.value, List.reverse observed.state)

tests : Test.Test {}
tests = Test.test "poly_effect_callback" {
    Expect.equal (42, ["called"]) observations()
}

main() = Test.run tests
