module AsyncRootCleanup exposing (tests)

import Random
import Async
import Expect
import Fail
import IO
import Result exposing (Result(..))
import Runtime.Scope
import State
import Test

blocked ready gate label () = Runtime.Scope.finally {
    ignore (Async.send ready ())
    Async.receive gate
} { recordTrace label }

type Observation
    = Trace String
    | RootFailure (Result String (Async.Outcome Int))
    | ChannelOutcome (Async.Outcome (Maybe Int))
    | CaughtFailure (Result String Int)
    | CaughtOutcome (Async.Outcome (Result String Int))
    deriving (Eq, Show)

record : Observation ->{IO, State.State (List Observation)} ()
record value =
    Random.runSystem {}
    State.put [value | State.get()]

recordTrace : String ->{IO, State.State (List Observation)} ()
recordTrace value = record (Trace value)

recordRootFailure : Result String (Async.Outcome Int) ->{IO, State.State (List Observation)} ()
recordRootFailure value = record (RootFailure value)

recordChannelOutcome : Async.Outcome (Maybe Int) ->{IO, State.State (List Observation)} ()
recordChannelOutcome value = record (ChannelOutcome value)

recordCaughtFailure : Result String Int ->{IO, State.State (List Observation)} ()
recordCaughtFailure value = record (CaughtFailure value)

recordCaughtOutcome : Async.Outcome (Result String Int) ->{IO, State.State (List Observation)} ()
recordCaughtOutcome value = record (CaughtOutcome value)

fixtureBody : () ->{IO, State.State (List Observation)} ()
fixtureBody() =
    recordRootFailure rootFailure()
    recordChannelOutcome (Async.runOutcome {
            outerGate = Async.channel 0
            sibling = Async.spawn { Async.receive outerGate }
            result = Fail.attempt {
                Async.scope {
                    ready = Async.channel 0
                    gate : Async.Channel Int
                    gate = Async.channel 0
                    ignore (Async.spawn (blocked ready gate "nested child cleaned"))
                    ignore (Async.receive ready)
                    Fail.fail "nested failed"
                    1
                }
            }
            recordCaughtFailure result
            ignore (Async.send outerGate 9)
            Async.await sibling
    })
    recordChannelOutcome (Async.runOutcome {
            gate = Async.channel 0
            child = Async.spawn { Async.receive gate }
            result = Fail.attempt { Fail.fail "caught inside"; 1 }
            recordCaughtFailure result
            ignore (Async.send gate 3)
            Async.await child
    })
    recordCaughtOutcome nestedCatch()

rootFailure : () ->{IO, State.State (List Observation)} Result String (Async.Outcome Int)
rootFailure() = Fail.attempt {
    Async.runOutcome {
        ready = Async.channel 0
        gate : Async.Channel Int
        gate = Async.channel 0
        ignore (Async.spawn (blocked ready gate "root child cleaned"))
        ignore (Async.receive ready)
        Fail.fail "root failed"
        1
    }
}

nestedCatch : () ->{IO} Async.Outcome (Result String Int)
nestedCatch() = Async.runOutcome {
    Async.scope {
        result = Fail.attempt { Fail.fail "nested catch"; 1 }
        result
    }
}

observations : () ->{IO} List Observation
observations() = List.reverse (State.run [] fixtureBody).state

tests : Test.Test IO.IO
tests = Test.test "async_root_cleanup" {
    Expect.equal [ Trace "root child cleaned"
                 , RootFailure (Err "root failed")
                 , Trace "nested child cleaned"
                 , CaughtFailure (Err "nested failed")
                 , ChannelOutcome (Async.Completed (Just 9))
                 , CaughtFailure (Err "caught inside")
                 , ChannelOutcome (Async.Completed (Just 3))
                 , CaughtOutcome (Async.Completed (Err "nested catch"))
                 ] observations()
}

main() = Test.run tests
