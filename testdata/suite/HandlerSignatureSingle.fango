module HandlerSignatureSingle exposing (tests)

import Expect
import Fail exposing (Fail, fail)
import Result exposing (Result(..))
import State exposing (State, get, put, update)
import Test

effect Clock mode
    tick : () -> Int

type Simulation = Simulation

-- Without the signature this handler would handle any `Fail e`; the
-- signature fixes `Fail String`, so the callback's row says so.
attemptText action =
    handle action() on
        fail : String -> a
        fail message -> Err ("failed: " ++ message)
        return value -> Ok value

-- The literal `0` is numeric-polymorphic; the signatures fix `State Int`.
counted action =
    handle action() with current = 0 on
        get : () -> Int
        get () -> resume current with current

        put : Int -> ()
        put next -> resume () with next

        update : (Int -> (a, Int)) -> a
        update step ->
            (result, next) = step current
            resume result with next
        return value -> (value, current)

-- `mode` appears in neither inputs nor result, so only the row names it.
simulated action =
    handle action() on
        tick : () ->{Clock Simulation} Int
        tick () -> resume 42

tests : Test.Test {}
tests = Test.test "handler_signature_single" {
    Expect.equal (Ok 1, 0) (counted { attemptText { if get() > 0 then fail "boom" else 1 } })
    Expect.equal (Err "failed: boom", 3) (counted { put 3; attemptText { if get() > 0 then fail "boom" else 1 } })
    Expect.equal (5, 5) (counted { put (get() + 5); get() })
    Expect.equal 43 (simulated { tick() + 1 })
}

main() = Test.run tests
