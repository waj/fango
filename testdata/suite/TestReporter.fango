module TestReporter exposing (checks)

import Expect
import Fail
import List
import Result exposing (Result(..))
import State
import Test exposing (Test, describe, only, skip, test, todo)
import Trace
import Process

-- Both helpers have closed pure result types: handling Reporter must not
-- leave IO or Expect in their rows.
collect : Test {} -> State.StateResult (List Test.Event) Test.Summary
collect suite =
    handle Test.execute suite with events = [] on
        Test.report event -> resume () with [event | events]
        return value -> { value = value, state = List.reverse events }

pure : Test {} -> Test.Summary
pure suite = Test.silent { Test.execute suite }

checks : Test {}
checks =
    describe "reporters"
        [ test "pure silent execution returns failures without exiting" {
            result = pure (test "fails" { Expect.failWith "failure" })
            Expect.equal 1 result.failed
            Expect.equal Test.RunFailed result.verdict
            Expect.equal Test.RunPassed (pure (test "passes" { () })).verdict
        }
        , test "ordered lifecycle and skipped subtree paths" {
            result = collect (describe "suite"
                    [ test "passes" { () }
                    , test "fails" { Expect.failWith "first"; Expect.failWith "unreachable" }
                    , skip (describe "skipped"
                            [ only (test "never" { Expect.failWith "unreachable" })
                            , skip (todo "placeholder")
                            , describe "" []
                            ]
                    )
                    , todo "later"
                    ]
            )
            Expect.equal (Test.Summary { passed = 1, failed = 1, skipped = 2, todo = 1, verdict = Test.RunFailed }) result.value
            Expect.equal
                [ Test.SuiteStarted 5
                , Test.CaseStarted ["suite", "passes"]
                , Test.CaseFinished ["suite", "passes"] Test.CasePassed
                , Test.CaseStarted ["suite", "fails"]
                , Test.CaseFinished ["suite", "fails"] (Test.CaseFailed (Expect.Error { message = "first", location = Just (Trace.Frame { function = "TestReporter.<lambda>", file = "TestReporter.fango", line = 35 }) }))
                , Test.CaseFinished ["suite", "skipped", "never"] Test.CaseSkipped
                , Test.CaseFinished ["suite", "skipped", "placeholder"] Test.CaseSkipped
                , Test.CaseFinished ["suite", "later"] Test.CaseTodo
                , Test.SuiteFinished result.value
                ] result.state
        }
        , test "focus skips bodies but preserves todos and validation" {
            result = collect (describe "focus"
                    [ test "ignored" { Expect.failWith "unreachable" }
                    , only (test "runs" { () })
                    , todo "pending"
                    , describe "empty" []
                    ]
            )
            Expect.equal (Test.Summary { passed = 1, failed = 1, skipped = 1, todo = 1, verdict = Test.RunFailed }) result.value
            Expect.equal
                [ Test.SuiteStarted 3
                , Test.CaseFinished ["focus", "ignored"] Test.CaseSkipped
                , Test.CaseStarted ["focus", "runs"]
                , Test.CaseFinished ["focus", "runs"] Test.CasePassed
                , Test.CaseFinished ["focus", "pending"] Test.CaseTodo
                , Test.GroupFailed ["focus", "empty"] "The group has no tests."
                , Test.SuiteFinished result.value
                ] result.state
            Expect.equal Test.RunIncomplete (pure (only (test "one" { () }))).verdict
            Expect.equal Test.RunIncomplete (pure (todo "one")).verdict
        }
        , test "group problems precede children and count individually" {
            result = collect (describe "" [test "" { () }, test "" { () }])
            Expect.equal 3 result.value.failed
            Expect.equal 2 result.value.passed
            Expect.equal
                [ Test.SuiteStarted 2
                , Test.GroupFailed [""] "The group has an empty name."
                , Test.GroupFailed [""] "A test in the group has an empty name."
                , Test.GroupFailed [""] "Two tests in the group are named \"\"."
                , Test.CaseStarted ["", ""]
                , Test.CaseFinished ["", ""] Test.CasePassed
                , Test.CaseStarted ["", ""]
                , Test.CaseFinished ["", ""] Test.CasePassed
                , Test.SuiteFinished result.value
                ] result.state
        }
        , test "unhandled body failure has no synthetic completion" {
            result = State.run [] {
                Fail.attempt {
                    handle Test.execute (test "aborts" { Fail.fail "body failure" }) on
                        Test.report event ->
                            State.put [event | State.get ()]
                            resume ()
                }
            }
            Expect.equal (Err "body failure") result.value
            Expect.equal [Test.SuiteStarted 1, Test.CaseStarted ["aborts"]] (List.reverse result.state)
        }
        , test "caller-handled effects pass through both execution and silent" {
            result = State.run 0 {
                Test.silent {
                    Test.execute (describe "state"
                            [ test "first" { State.put 1; Expect.failWith "stop"; State.put 100 }
                            , test "second" { Expect.equal 1 (State.get ()); State.put 2 }
                            ]
                    )
                }
            }
            Expect.equal 2 result.state
            Expect.equal 1 result.value.passed
            Expect.equal 1 result.value.failed
        }
        ]

main() = Process.runSystem { Test.run checks }
