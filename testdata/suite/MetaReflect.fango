module MetaReflect exposing (tests)

import Expect
import List exposing (List(..))
import Meta exposing (Code, Ctor(..), Field(..), Items(..), Reflected(..), TypeInfo(..))
import Test

type Point = { x : Int, y : Int }

type Tree = Leaf | Node Tree Int Tree

-- `typeOf T` reflects a closed type. Identity is the compiler's, not a name:
-- `sameType` compares nominal identity and structure together.
sameInt : Code
sameInt = Meta.lift (Meta.sameType (typeOf Int) (typeOf Int))

listVersusMaybe : Code
listVersusMaybe = Meta.lift (Meta.sameType (typeOf (List Int)) (typeOf (List Bool)))

sameHead : Code
sameHead =
    Meta.lift (Meta.sameType (Meta.head (typeOf (List Int))) (Meta.head (typeOf (List Bool))))

-- args walks into a type application; head drops the arguments.
firstArg : Code
firstArg =
    case Meta.args (typeOf (List Int)) of
        NoItems -> Meta.lift "none"
        Item arg _ -> Meta.lift (Meta.typeName arg)

-- info reads the schema. A scalar has none, and neither does a partial
-- application: `head` is for comparing identities, not for reading a shape.
summary : Meta.TypeRepr -> Code
summary repr =
    case Meta.info repr of
        Opaque -> Meta.lift ("opaque " ++ Meta.typeName repr)
        Visible schema ->
            Meta.lift (schema.name ++ "/" ++ show (Meta.lengthItems (Meta.ctorsIn schema)))

fieldNames : Meta.TypeRepr -> Code
fieldNames repr =
    case Meta.info repr of
        Opaque -> Meta.lift "opaque"
        Visible schema ->
            case Meta.ctorsIn schema of
                NoItems -> Meta.lift "none"
                Item ctor _ ->
                    Meta.lift (Meta.foldItems { text field -> text ++ field.name ++ ":" ++ Meta.typeName field.ty ++ " " } "" ctor.fields)

tests : Test.Test {}
tests = Test.test "meta_reflect" {
    Expect.equal True $(sameInt)
    Expect.equal False $(listVersusMaybe)
    Expect.equal True $(sameHead)
    Expect.equal "Int" $(firstArg)
    Expect.equal "Point/1" $(summary (typeOf Point))
    Expect.equal "Tree/2" $(summary (typeOf Tree))
    Expect.equal "opaque Int" $(summary (typeOf Int))
    Expect.equal "x:Int y:Int " $(fieldNames (typeOf Point))
    Expect.equal "opaque List" $(summary (Meta.head (typeOf (List Int))))
    Expect.equal False $(Meta.lift (Meta.isVar (typeOf Int)))
}

main() = Test.run tests
