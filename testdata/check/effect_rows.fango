delay : (() ->{e} a) -> () ->{e} a
delay action _ = action()

pure() = 1

map : (a ->{e} b) -> Chain a ->{e} Chain b
map fn values =
    case values of
        Empty -> Empty
        Link x xs -> Link (fn x) (map fn xs)

type Chain a = Empty | Link a (Chain a)

effect Note
    abort stop : String -> a

-- Statement order must not decide whether the surrounding row can still take
-- a label: both bodies call a `{e}` function and a `{Note | e}` one, and both
-- infer the same row.
plainFirst : (() ->{e} ()) -> (() ->{Note | e} ()) ->{Note | e} ()
plainFirst plain risky =
    plain()
    risky()

riskyFirst : (() ->{e} ()) -> (() ->{Note | e} ()) ->{Note | e} ()
riskyFirst plain risky =
    risky()
    plain()

-- A row literal in type-argument position is the row the annotation names,
-- so the inferred scheme keeps it closed where it was written closed.
type Source e = { pull : () ->{e} Int }

quiet : Source {}
quiet = { pull = { _ -> 0 } }

noted : Source {Note}
noted = { pull = { _ -> stop "no" } }

tailed : Source {Note | e}
tailed = { pull = { _ -> stop "no" } }
