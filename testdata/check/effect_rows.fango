delay : (() ->{e} a) -> () ->{e} a
delay action _ = action()

pure() = 1

map : (a ->{e} b) -> List a ->{e} List b
map fn values =
    case values of
        Nil -> Nil
        Cons x xs -> Cons (fn x) (map fn xs)

type List a = Nil | Cons a (List a)

effect Note
    abort stop : String -> a

-- Statement order must not decide whether the surrounding row can still take
-- a label: both bodies call a `{e}` function and a `{Note | e}` one, and both
-- infer the same row.
plainFirst : (() ->{e} ()) -> (() ->{Note | e} ()) ->{Note | e} ()
plainFirst plain risky =
    plain()
    risky()

riskyFirst : (() ->{e} ()) -> (() ->{Note | e} ()) ->{Note | e} ()
riskyFirst plain risky =
    risky()
    plain()
