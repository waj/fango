-- A typed JSON API served with the `web` library:
--
--     fango run --lib web examples/shop.fango -- 8080
--
-- `GET /orgs/acme/users/1` answers a user, `POST /orgs/acme/users` with a
-- JSON user answers it back unless its name is taken, and `GET /health` is a
-- plain route served beside them.
import Async
import Fail
import Http exposing (Protocol(..))
import Http.Server
import IO
import List exposing (List)
import Net
import Process
import Result exposing (Result(..))
import Shop.Api
import Shop.Users exposing (GetUser(..), NewUser(..), User(..), UserError(..), Users(..))
import String
import Web
import Web.Server

known : List User
known = [User { id = 1, name = "Ada" }, User { id = 2, name = "Grace" }]

find : (User -> Bool) -> List User -> Maybe User
find matches candidates =
    case candidates of
        [] -> Nothing
        [user | rest] -> if matches user then Just user else find matches rest

-- The implementation is an ordinary value of the contract's type.
directory : Users e
directory =
    { getUser = { request ->
        case find { user -> user.id == request.id } known of
            Just user -> Ok user
            Nothing -> Err NoSuchUser
      }
    , createUser = { request ->
        case find { user -> user.name == request.user.name } known of
            Just _ -> Err (NameTaken request.user.name)
            Nothing -> Ok request.user
      }
    }

dispatch = $(Web.Server.dispatch Shop.Api.api)

-- The directory has no effects of its own, so each operation runs directly.
app : Http.Server.Request {Protocol, e} ->{Protocol, e} Http.Server.Response {Protocol, e}
app request = dispatch directory Web.Server.direct request

main : () ->{IO, Console, Net.Network, Process.Environment} ()
main() =
    case Process.args() of
        [raw] ->
            case String.toInt raw of
                Just port ->
                    print ("Serving " ++ Web.link Shop.Api.getUserEndpoint (GetUser { org = "acme", id = 1, verbose = Nothing }))
                    print (Fail.attempt {
                            Async.runOutcome {
                                stop = Async.channel 1
                                Http.Server.serve (Http.Server.defaultConfig port) stop app
                            }
                    })
                Nothing -> print "usage: shop PORT"
        _ -> print "usage: shop PORT"
