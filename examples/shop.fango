-- A typed JSON API served with the `web` library:
--
--     fango run --lib web examples/shop.fango -- 8080
--
-- `GET /orgs/acme/users/1` answers a user, `POST /orgs/acme/users` with a
-- JSON user adds it unless its name is taken, and `GET /health` is a plain
-- route served beside them. Every organization shares one directory, kept
-- in `State` handled around the server.
import Async
import Fail
import Http.Server
import IO
import List exposing (List)
import Net
import Process
import Result exposing (Result(..))
import Shop.Api exposing (Org(..), Shop(..))
import Shop.Users exposing (GetUser(..), NewUser(..), User(..), UserError(..), Users(..))
import State
import String
import Web
import Web.Server

find : (User -> Bool) -> List User -> Maybe User
find matches candidates =
    case candidates of
        [] -> Nothing
        [user | rest] -> if matches user then Just user else find matches rest

-- Adds a user unless its name is taken, as one atomic update.
add : User -> List User -> (Result UserError User, List User)
add user known =
    case find { other -> other.name == user.name } known of
        Just _ -> (Err (NameTaken user.name), known)
        Nothing -> (Ok user, [user | known])

-- The implementation is an ordinary value of the contract's type. Its
-- directory is state handled once, around the whole server, and the API
-- serves it for every organization.
directory : Users {State.State (List User)}
directory =
    { getUser = { request ->
        case find { user -> user.id == request.id } State.get() of
            Just user -> Ok user
            Nothing -> Err NoSuchUser
      }
    , createUser = { request -> State.update (add request.user) }
    }

dispatch = $(Web.Server.dispatch (typeOf (Shop {})))

main : () ->{IO, Console, Net.Network, Process.Environment} ()
main() =
    case Process.args() of
        [raw] ->
            case String.toInt raw of
                Just port ->
                    print ("Serving " ++ Web.linkTo { (Shop.Api.links.users (Org { org = "acme" })).getUser (GetUser { id = 1, verbose = Nothing }) })
                    initial = [User { id = 1, name = "Ada" }, User { id = 2, name = "Grace" }]
                    print (Fail.attempt {
                            Async.runOutcome {
                                State.runAtomic initial {
                                    stop = Async.channel 1
                                    Http.Server.serve
                                        (Http.Server.defaultConfig port)
                                        stop
                                        (dispatch
                                            { users = { _ -> directory }
                                            , health = Shop.Api.health
                                            }
                                        )
                                }
                            }
                    })
                Nothing -> print "usage: shop PORT"
        _ -> print "usage: shop PORT"
