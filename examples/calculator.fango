-- A small recursive-descent calculator with variables and assignments.
-- Numbers are integers or decimals; names use ASCII letters, digits, and _.
-- Try: x = 3, then x * (2 + 4). Type :quit to finish.

import Dict
import Fail
import IO
import Result exposing (Result(..))
import String

type Token
    = NumberToken Float
    | NameToken String
    | PlusToken
    | MinusToken
    | TimesToken
    | DivideToken
    | EqualsToken
    | LeftParenToken
    | RightParenToken

type Expr
    = Number Float
    | Variable String
    | Negate Expr
    | Add Expr Expr
    | Subtract Expr Expr
    | Multiply Expr Expr
    | Divide Expr Expr

type Statement = Evaluate Expr | Assign String Expr

isDigit char = char >= '0' && char <= '9'

isLetter char = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || char == '_'

tokenize : String ->{Fail.Fail String} List Token
tokenize text =
    case String.uncons text of
        Nothing -> []
        Just (String.Uncons { first = char, rest = rest }) ->
            if char == ' ' || char == '\t' then
                tokenize rest
            else if isDigit char then
                (number, tail) = String.span (\c -> isDigit c || c == '.') text
                case String.toFloat number of
                    Just value -> [NumberToken value | tokenize tail]
                    Nothing -> Fail.fail "invalid number"
            else if isLetter char then
                (name, tail) = String.span (\c -> isLetter c || isDigit c) text
                [NameToken name | tokenize tail]
            else
                token =
                    case char of
                        '+' -> PlusToken
                        '-' -> MinusToken
                        '*' -> TimesToken
                        '/' -> DivideToken
                        '=' -> EqualsToken
                        '(' -> LeftParenToken
                        ')' -> RightParenToken
                        _ -> Fail.fail ("unexpected `" ++ String.fromChar char ++ "`")
                [token | tokenize rest]

-- expr   = term ((+ | -) term)*
-- term   = factor ((* | /) factor)*
-- factor = number | name | -factor | (expr)
parseExpr : List Token ->{Fail.Fail String} (Expr, List Token)
parseExpr tokens =
    go left [PlusToken | remaining] =
        (right, tail) = parseTerm remaining
        go (Add left right) tail
    go left [MinusToken | remaining] =
        (right, tail) = parseTerm remaining
        go (Subtract left right) tail
    go left remaining = (left, remaining)
    (first, rest) = parseTerm tokens
    go first rest

parseTerm : List Token ->{Fail.Fail String} (Expr, List Token)
parseTerm input =
    go left [TimesToken | remaining] =
        (right, tail) = parseFactor remaining
        go (Multiply left right) tail
    go left [DivideToken | remaining] =
        (right, tail) = parseFactor remaining
        go (Divide left right) tail
    go left remaining = (left, remaining)
    (first, rest) = parseFactor input
    go first rest

parseFactor : List Token ->{Fail.Fail String} (Expr, List Token)
parseFactor [NumberToken value | rest] = (Number value, rest)
parseFactor [NameToken name | rest] = (Variable name, rest)
parseFactor [MinusToken | rest] =
    (value, tail) = parseFactor rest
    (Negate value, tail)
parseFactor [LeftParenToken | rest] =
    (value, tail) = parseExpr rest
    case tail of
        [RightParenToken | remaining] -> (value, remaining)
        _ -> Fail.fail "expected `)`"
parseFactor _ = Fail.fail "expected an expression"

parse tokens =
    case parseExpr tokens of
        (value, []) -> value
        _ -> Fail.fail "unexpected trailing tokens"

parseStatement [NameToken name, EqualsToken | rest] = Assign name (parse rest)
parseStatement tokens = Evaluate (parse tokens)

evaluate : Dict.Dict String Float -> Expr ->{Fail.Fail String} Float
evaluate _ (Number value) = value
evaluate env (Variable name) =
    case Dict.get name env of
        Just value -> value
        Nothing -> Fail.fail ("unknown variable `" ++ name ++ "`")
evaluate env (Negate value) = 0.0 - evaluate env value
evaluate env (Add a b) = evaluate env a + evaluate env b
evaluate env (Subtract a b) = evaluate env a - evaluate env b
evaluate env (Multiply a b) = evaluate env a * evaluate env b
evaluate env (Divide a b) = evaluate env a / evaluate env b

execute env (Assign name expr) =
    value = evaluate env expr
    print (name ++ " = " ++ show value)
    Dict.insert name value env
execute env (Evaluate expr) =
    print (evaluate env expr)
    env

help() =
    print "Enter an expression or NAME = expression."
    print "Operators: + - * / and parentheses."
    print "Commands: :help, :quit"

loop env =
    IO.write "calc> "
    case readLine() of
        Nothing -> ()
        Just line ->
            text = String.trim line.text
            if text == ":quit" then
                print "Goodbye!"
            else if text == ":help" then
                help()
                loop env
            else if text == "" then
                loop env
            else
                case Fail.attempt (\_ -> execute env (parseStatement (tokenize text))) of
                    Ok next -> loop next
                    Err message ->
                        print ("error: " ++ message)
                        loop env

main() = loop Dict.empty
