import IO
import Range

printDensity : Int ->{IO} ()
printDensity density =
    if density > 8 then
        Console.write " "
    else if density > 4 then
        Console.write "."
    else if density > 2 then
        Console.write "*"
    else
        Console.write "+"

mandelConverger : Float -> Float -> Int -> Float -> Float -> Int
mandelConverger real imaginary iterations constantReal constantImaginary =
    if iterations > 255 || real * real + imaginary * imaginary >= 4 then
        iterations
    else
        mandelConverger
            (real * real - imaginary * imaginary + constantReal)
            (2 * real * imaginary + constantImaginary)
            (iterations + 1)
            constantReal
            constantImaginary

mandelConverge : Float -> Float -> Int
mandelConverge real imaginary =
    mandelConverger real imaginary 0 real imaginary

mandel : Float -> Float -> Float -> Float ->{IO} ()
mandel realStart imaginaryStart realMagnitude imaginaryMagnitude =
    drawRow row =
        drawPoint column =
            real = realStart + column * realMagnitude
            imaginary = imaginaryStart + row * imaginaryMagnitude
            printDensity (mandelConverge real imaginary)
        Range.each drawPoint 0 78
        print ""
    Range.each drawRow 0 40

main() = mandel (-2.3) (-1.3) 0.05 0.07
