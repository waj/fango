-- The shop's API, and its named endpoints.
module Shop.Api exposing (Org(..), Shop(..), getUserEndpoint, health, orgPrefix)

import Bytes
import Http exposing (Body(..))
import Http.Server exposing (Request(..), Response(..))
import Http.Server.Route
import Result exposing (Result(..))
import Shop.Users exposing (GetUser(..), User(..), UserError(..), Users(..))
import Web

-- A plain route beside the typed ones.
health : List Http.Server.Route.Param -> Request e ->{e} Response e
health _ _ = Response { status = 200, headers = [], body = BytesBody (Bytes.fromString "ok") }

-- The organization a request is for, read from the mount's prefix.
type Org =
    { #[Web.Path "org"]
      org : String
    }

-- The whole API: the users of each organization, and a health check.
type Shop e =
    { #[Web.Mount "/orgs/:org"]
      users : Org -> Users e
    , #[Web.Raw "GET /health"]
      health : List Http.Server.Route.Param -> Request e ->{e} Response e
    }

orgPrefix : Web.Prefix Org
orgPrefix = $(Web.prefix (typeOf (Shop {})) "users")

getUserEndpoint : Web.Endpoint GetUser (Result UserError User)
getUserEndpoint = $(Web.endpoint (typeOf (Shop {})) "users.getUser")
