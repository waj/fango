import Async
import Bytes
import Http exposing (Body(..))
import Http.GZip
import Http.Server
import Http.Server.Route as Route
import IO
import List exposing (List)
import Reader
import String
import Writer

hello : List Route.Param -> Http.Server.Request e ->{e} Http.Server.Response e
hello params _ =
    name = case Route.lookup "name" params of
        Just value -> value
        Nothing -> "world"
    Http.Server.Response { status = 200, headers = [], body = BytesBody (Bytes.fromString ("Hello, " ++ name ++ "!")) }

missing : Http.Server.Request e ->{e} Http.Server.Response e
missing _ = Http.Server.Response { status = 404, headers = [], body = Empty }

echo : List Route.Param -> Http.Server.Request e ->{e} Http.Server.Response e
echo _ request =
    (_, body) = Writer.collecting { output -> Reader.forEachChunk request.body (Writer.write output) }
    Http.Server.Response { status = 200, headers = [], body = BytesBody body }

stream : List Route.Param -> Http.Server.Request e ->{e} Http.Server.Response e
stream _ request = Http.Server.Response
    { status = 200
    , headers = []
    , body = StreamBody { output -> Reader.forEachChunk request.body (Writer.write output) }
    }

route : Http.Server.Request e ->{e} Http.Server.Response e
route request =
    helloRoute = Route.Route { method = "GET", pattern = "/hello/:name", handler = hello }
    echoRoute = Route.Route { method = "POST", pattern = "/echo", handler = echo }
    streamRoute = Route.Route { method = "POST", pattern = "/stream", handler = stream }
    handle Route.dispatch [helloRoute, echoRoute, streamRoute] missing request of
        Http.invalid _ -> Http.Server.Response { status = 400, headers = [], body = Empty }

app : Http.Server.Request e ->{e} Http.Server.Response e
app request = Http.GZip.wrap route request

main() =
    case IO.args() of
        [raw] ->
            case String.toInt raw of
                Just port ->
                    print (Async.run {
                            stop = Async.channel 1
                            Http.Server.serve (Http.Server.defaultConfig port) stop app
                    })
                Nothing -> print "usage: http_server PORT"
        _ -> print "usage: http_server PORT"
