-- A small, strict Scheme-like Lisp built with effect-based parser combinators.
--
--     fango run examples/lisp.fango             # multiline REPL; :quit exits
--     fango run examples/lisp.fango program.lisp
--
-- Values: signed Fango Int integers, #t/#f, Unicode strings, symbols, proper
-- lists, and procedures. Only #f is false. Quote shorthand is supported; ;
-- comments end at a line break. Strings accept \", \\, \n, \r, \t and literal
-- newlines. Source columns count Unicode scalars, with LF starting a new line.
--
-- Forms: quote, if (three operands), lambda, parallel-binding let, begin, and
-- top-level define (including procedure shorthand). Bodies are nonempty.
-- Closures capture lexical bindings; global names see current definitions,
-- supporting recursion, mutual recursion, and redefinition. Calls evaluate
-- left to right. Tail calls use an explicit loop, including mutual tail calls.
--
-- Built-ins: + and * (zero or more arguments), - (one or more), quotient and
-- remainder, binary = < <= > >=, list, cons, car, cdr, null?, list?, length,
-- equal?, and not. cons requires a proper-list tail; procedures compare false.
-- Arithmetic follows Fango Int, with division by zero reported as an error.
--
-- Every top-level result is printed; define returns its name and begin its
-- last value. A file stops on its first error with status 1. The REPL preserves
-- successful definitions after evaluation errors, discards the rest of the
-- submission, and continues. It buffers the whole submission before evaluating
-- anything; only unexpected EOF requests continuation. EOF during an unfinished
-- submission reports an error and exits with status 1.
--
-- This is an example dialect, not Scheme compatibility: no mutation, macros,
-- quasiquote, dotted pairs, floats, or local recursive definitions. Deeply nested
-- non-tail expressions still use the host stack.

import Dict exposing (Dict)
import Fail exposing (Fail)
import File
import LispEval
import LispReader
import Process
import Result exposing (Result(..))
import String

-- Evaluates the forms in order, printing each value, and stops at the first
-- error. Returns the definitions made so far and that error's diagnostic.
execute : String -> String -> Dict String LispEval.Value -> List LispReader.Expr ->{Console} (Dict String LispEval.Value, Maybe String)
execute filename source globals forms = case forms of
    [] -> (globals, Nothing)
    [first | rest] ->
        (next, result) = LispEval.top globals first
        case result of
            Ok value ->
                print (LispEval.render value)
                execute filename source next rest
            Err error -> (next, Just (LispReader.diagnostic filename source error))

repl : Dict String LispEval.Value -> String ->{Console, Fail String} ()
repl globals pending =
    Console.write (if pending == "" then "lisp> " else "...> ")
    case readLine() of
        Nothing ->
            if pending == "" then ()
            else case LispReader.read pending of
                Err error -> Fail.fail (LispReader.diagnostic "<stdin>" pending error)
                Ok _ -> ()
        Just line ->
            if pending == "" && String.trim line.text == ":quit" then ()
            else
                source = pending ++ line.text ++ line.ending
                case LispReader.read source of
                    Err error ->
                        if error.incomplete then repl globals source
                        else
                            print (LispReader.diagnostic "<stdin>" source error)
                            repl globals ""
                    Ok forms ->
                        (next, failure) = execute "<stdin>" source globals forms
                        case failure of
                            Nothing -> ()
                            Just diagnostic -> print diagnostic
                        repl next ""

file : String ->{Console, File.FileSystem, Fail String} ()
file path =
    source = case File.read path of
        Err error -> Fail.fail (IO.describeError error)
        Ok text -> text
    forms = case LispReader.read source of
        Err error -> Fail.fail (LispReader.diagnostic path source error)
        Ok parsed -> parsed
    (_, failure) = execute path source LispEval.initial forms
    case failure of
        Nothing -> ()
        Just diagnostic -> Fail.fail diagnostic

-- Prints a failure's diagnostic and reports it in the exit status.
report : (() ->{Fail String, e} ()) ->{Console, e} Process.Status
report action = case Fail.attempt action of
    Ok () -> Process.success
    Err diagnostic -> print diagnostic; Process.failure

main() = case Process.args() of
    [] -> report { repl LispEval.initial "" }
    [path] -> report { file path }
    _ -> print "usage: lisp [file]"; Process.status 2
