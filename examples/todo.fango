-- A small persistent Todo CLI.
--
--     todo add "buy milk"
--     todo list
--     todo done 2
--
-- State is compact JSON in todo.json in the current working directory.

import File
import Json exposing (Decode, Encode(..))
import Process
import Result exposing (Result(..))
import String

type Todo = { text : String, done : Bool } deriving (Encode, Decode)

storagePath : String
storagePath = "todo.json"

load : () ->{IO} Maybe (List Todo)
load() =
    case File.read storagePath of
        Err error ->
            case error.kind of
                IO.NotFound -> Just []
                _ ->
                    print (IO.describeError error)
                    Process.exit 1
                    Nothing
        Ok text ->
            parsed : Result Json.Error (List Todo)
            parsed = Json.parse @(List Todo) text
            case parsed of
                Ok todos -> Just todos
                Err _ -> Nothing

save : List Todo ->{IO} ()
save todos =
    case Json.stringify todos of
        Ok text ->
            case File.writeAll storagePath text of
                Ok () -> ()
                Err error ->
                    print (IO.describeError error)
                    Process.exit 1
        Err _ -> Process.exit 1

append : List Todo -> Todo -> List Todo
append todos todo =
    case todos of
        [] -> [todo]
        [first | rest] -> [first | append rest todo]

count : List a -> Int
count values =
    case values of
        [] -> 0
        [_ | rest] -> 1 + count rest

completeAt : Int -> Int -> List Todo -> Maybe (List Todo)
completeAt wanted index todos =
    case todos of
        [] -> Nothing
        [todo | rest] ->
            if wanted == index then
                Just [Todo { text = todo.text, done = True } | rest]
            else
                case completeAt wanted (index + 1) rest of
                    Nothing -> Nothing
                    Just changed -> Just [todo | changed]

printTodos : Int -> List Todo ->{IO} ()
printTodos index todos =
    case todos of
        [] -> ()
        [todo | rest] ->
            marker = if todo.done then "[x]" else "[ ]"
            print (show index ++ " " ++ marker ++ " " ++ todo.text)
            printTodos (index + 1) rest

storageFailure : () ->{IO} ()
storageFailure() =
    print "Invalid todo.json."
    Process.exit 1

usage : () ->{IO} ()
usage() =
    print "Usage: todo add TEXT | todo list | todo done NUMBER"
    Process.exit 2

addTodo : String ->{IO} ()
addTodo text =
    case load() of
        Nothing -> storageFailure()
        Just todos ->
            updated = append todos { text = text, done = False }
            save updated
            print ("Added " ++ show (count updated) ++ ": " ++ text)

listTodos : () ->{IO} ()
listTodos() =
    case load() of
        Nothing -> storageFailure()
        Just [] -> print "No todos."
        Just todos -> printTodos 1 todos

completeTodo : String ->{IO} ()
completeTodo raw =
    case String.toInt raw of
        Nothing -> usage()
        Just wanted ->
            if wanted < 1 then
                usage()
            else
                case load() of
                    Nothing -> storageFailure()
                    Just todos ->
                        case completeAt wanted 1 todos of
                            Nothing ->
                                print ("No todo at index " ++ show wanted ++ ".")
                                Process.exit 2
                            Just updated ->
                                save updated
                                print ("Completed " ++ show wanted ++ ".")

main() =
    case Process.args() of
        ["add", text] -> addTodo text
        ["list"] -> listTodos()
        ["done", raw] -> completeTodo raw
        _ -> usage()
