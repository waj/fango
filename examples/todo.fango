-- A small persistent Todo CLI.
--
--     todo add "buy milk"
--     todo list
--     todo done 2
--
-- State is compact JSON in todo.json in the current working directory.
-- Every way a command can go wrong is a `Problem`, raised with `Fail` where
-- it happens and reported once, by `main`, on standard error with the
-- matching exit status.

import Console exposing (Output(..))
import Fail exposing (Fail)
import File
import Json exposing (Decode, Encode(..))
import Process
import Result exposing (Result(..))
import String

type Todo = { text : String, done : Bool } deriving (Encode, Decode)

-- What can stop a command.
type Problem
    -- The arguments name no command.
    = Usage
    -- `done` named a todo that does not exist.
    | MissingIndex Int
    -- The store could not be read or written.
    | Storage IO.Error
    -- The store is not a list of todos.
    | InvalidStore
    -- The todos could not be encoded.
    | Unencodable Json.Error

describe : Problem -> String
describe problem =
    case problem of
        Usage -> "Usage: todo add TEXT | todo list | todo done NUMBER"
        MissingIndex index -> "No todo at index " ++ show index ++ "."
        Storage error -> IO.describeError error
        InvalidStore -> "Invalid todo.json."
        Unencodable error -> "Cannot encode the todos: " ++ error.message

-- A mistake in the command line is status 2; anything else is a failure.
statusOf : Problem -> Process.Status
statusOf problem =
    case problem of
        Usage -> Process.status 2
        MissingIndex _ -> Process.status 2
        _ -> Process.failure

storagePath : String
storagePath = "todo.json"

load : () ->{IO, Fail Problem} List Todo
load() =
    case File.read storagePath of
        Err error ->
            case error.kind of
                IO.NotFound -> []
                _ -> Fail.fail (Storage error)
        Ok text ->
            case Json.parse @(List Todo) text of
                Ok todos -> todos
                Err _ -> Fail.fail InvalidStore

save : List Todo ->{IO, Fail Problem} ()
save todos =
    case Json.stringify todos of
        Err error -> Fail.fail (Unencodable error)
        Ok text ->
            case File.writeAll storagePath text of
                Ok () -> ()
                Err error -> Fail.fail (Storage error)

append : List Todo -> Todo -> List Todo
append todos todo =
    case todos of
        [] -> [todo]
        [first | rest] -> [first | append rest todo]

count : List a -> Int
count values =
    case values of
        [] -> 0
        [_ | rest] -> 1 + count rest

completeAt : Int -> Int -> List Todo -> Maybe (List Todo)
completeAt wanted index todos =
    case todos of
        [] -> Nothing
        [todo | rest] ->
            if wanted == index then
                Just [Todo { text = todo.text, done = True } | rest]
            else
                case completeAt wanted (index + 1) rest of
                    Nothing -> Nothing
                    Just changed -> Just [todo | changed]

printTodos : Int -> List Todo ->{Console} ()
printTodos index todos =
    case todos of
        [] -> ()
        [todo | rest] ->
            marker = if todo.done then "[x]" else "[ ]"
            print (show index ++ " " ++ marker ++ " " ++ todo.text)
            printTodos (index + 1) rest

addTodo : String ->{IO, Console, Fail Problem} ()
addTodo text =
    updated = append load() { text = text, done = False }
    save updated
    print ("Added " ++ show (count updated) ++ ": " ++ text)

listTodos : () ->{IO, Console, Fail Problem} ()
listTodos() =
    case load() of
        [] -> print "No todos."
        todos -> printTodos 1 todos

completeTodo : String ->{IO, Console, Fail Problem} ()
completeTodo raw =
    case String.toInt raw of
        Nothing -> Fail.fail Usage
        Just wanted ->
            if wanted < 1 then
                Fail.fail Usage
            else
                case completeAt wanted 1 load() of
                    Nothing -> Fail.fail (MissingIndex wanted)
                    Just updated ->
                        save updated
                        print ("Completed " ++ show wanted ++ ".")

command : List String ->{IO, Console, Fail Problem} ()
command args =
    case args of
        ["add", text] -> addTodo text
        ["list"] -> listTodos()
        ["done", raw] -> completeTodo raw
        _ -> Fail.fail Usage

main() =
    case Fail.attempt { command Process.args() } of
        Ok () -> Process.success
        Err problem ->
            Console.writeTo Stderr (describe problem ++ "\n")
            statusOf problem
