-- Contract values for tests.
--
-- `strict` generates a value of a contract's type whose every operation
-- fails the test, naming the operation and its request. It takes an API and
-- the dotted location of a contract in it, `""` for the API itself. Record
-- update then stubs only what a test expects:
--
-- ```text
-- users = { $(Web.Testing.strict (typeOf (Shop {})) "users") | getUser = { _ -> Ok alice } }
-- ```
module Web.Testing exposing (strict)

import Expect exposing (Inspect(..))
import List exposing (List(..))
import Meta exposing (Code, Items(..), Lift(..))
import Result exposing (Result(..))
import Web exposing (Contract(..), Operation(..), Part(..))

listToItems : List a -> Items a
listToItems items =
    case items of
        [] -> NoItems
        [item | rest] -> Item item (listToItems rest)

strictOf : Contract -> Code
strictOf contract =
    fields = List.map { part ->
        case part of
            OperationPart operation ->
                label = "Unexpected call to " ++ operation.location ++ ": "
                Meta.lambda ("_web_" ++ operation.name) { request -> `Expect.failWith ($(lift label) ++ inspect $(request))` }
            MountPart inner -> strictOf inner
            RawPart name location _ _ ->
                label = "Unexpected request to " ++ location
                Meta.lambda ("_web_" ++ name) { _ -> Meta.lambda "_web_request" { _ -> `Expect.failWith $(lift label)` } }
    } contract.parts
    Meta.construct contract.ctor (listToItems fields)

-- Generates a value of the contract at a dotted location of an API whose
-- every operation fails through `Expect.failWith`, reporting the operation
-- and `inspect` of its request, and whose every raw route fails naming the
-- route.
strict : Meta.TypeRepr -> String -> Code
strict api location =
    case Web.contractAt api location of
        Err message -> Meta.fail message
        Ok found -> strictOf found
