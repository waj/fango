-- Serving a typed API with the HTTP server.
--
-- `dispatch` generates a request handler from an API. It takes the API's
-- implementation, one record whose mounted fields implement their contracts
-- and whose raw fields are their handlers, and then the request:
--
-- ```text
-- dispatch = $(Web.Server.dispatch (typeOf (Shop {})))
--
-- main() = Db.run { Http.Server.serve config stop { request -> dispatch (Shop { users = serveUsers, health = health }) request } }
-- ```
--
-- A mount with parameters is implemented by a function of them, here
-- `serveUsers : Org -> Users e`, called for each request it answers.
--
-- The implementations' own effects are those of the server's handler, so
-- they are handled around `Http.Server.serve`, once for the whole server, as
-- `Db.run` is above. An operation may also fail with `Fail Error`, which
-- answers that error's status; no other abort effect reaches a request.
--
-- Each operation decodes its request through its endpoint, calls the
-- implementation's field, and encodes the result through the same endpoint.
-- A path that matches no route answers 404; one that matches routes of other
-- methods answers 405 with `Allow`. Invalid input answers 400, a request body
-- that is not JSON 415, and a result that cannot be encoded 500, each with a
-- JSON body `{"message": …}`. A `GET` route also answers `HEAD`.
module Web.Server exposing (Error(..), Route, dispatch, route, serve)

import Bytes exposing (Bytes)
import Fail exposing (Fail)
import Http exposing (Body(..), Header(..))
import Http.Server exposing (Request(..), Response(..))
import Http.Server.Route
import Json
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Meta exposing (Bound(..), BoundField(..), Code, Items(..), Lift(..))
import Reader
import Result exposing (Result(..))
import String
import Url
import Web exposing (Contract(..), Endpoint(..), Incoming(..), Operation(..), Part(..), Prefix(..), Rejection(..), Reply(..), Segment(..))
import Writer

-- How a route answers: through a typed endpoint, with the whole body read,
-- or as a raw handler of the streaming request.
type Answer e
    = Typed (Incoming ->{e} Reply)
    | Untyped (List Http.Server.Route.Param -> Request e ->{e} Response e)

-- A route of a typed API: a method, a path template, and its answer.
type Route e =
    { method : String
    , template : List Segment
    , answer : Answer e
    }

type ErrorBody = { message : String }
    deriving (Json.Encode)

-- An application failure that answers with its own status, from 400 to 599
-- (500 otherwise), and a JSON body `{"message": …}`. An operation raises it
-- with `Fail.fail`.
type Error =
    {
      -- The status to answer with; one outside 400 to 599 answers 500.
      status : Int
      -- The message for the client.
    , message : String
    }
    deriving (Eq, Show)

templateOf : String -> List Segment
templateOf text =
    case Web.parseTemplate text of
        Ok segments -> segments
        Err _ -> []

errorReply : Int -> String -> Reply
errorReply status message =
    body =
        case Json.stringify (ErrorBody { message = message }) of
            Ok text -> Bytes.fromString text
            Err _ -> Bytes.empty
    Reply { status = status, headers = [Header { name = "Content-Type", value = "application/json" }], body = body }

-- The route of one endpoint, answered by a function. The function's input
-- and output types are the endpoint's, so they are checked here, before the
-- route erases them. A `Fail Error` it raises answers that error.
--
-- ```text
-- route Shop.Api.getUserEndpoint { request -> Db.findUser request.org request.id }
-- ```
route : Endpoint request response -> (request ->{Fail Error, e} response) -> Route e
route described implementation = Route { method = described.method, template = templateOf described.template, answer = Typed (answerWith described implementation) }

answerWith : Endpoint request response -> (request ->{Fail Error, e} response) -> Incoming ->{e} Reply
answerWith described implementation incoming =
    case described.readRequest incoming of
        Err rejection -> errorReply rejection.status rejection.message
        Ok request ->
            case Fail.attempt { implementation request } of
                Err error -> errorReply (validStatus error.status) error.message
                Ok result ->
                    case described.response.write result of
                        Ok reply -> reply
                        Err message -> errorReply 500 ("The response cannot be encoded: " ++ message)

-- Routes below mounts with parameters, which generated dispatchers build.
-- `read` decodes the parameters of every such mount on the way, and the
-- route's full template is given, because the endpoint's starts at the
-- nearest mount.
routeUnder : (Incoming -> Result Rejection params) -> String -> Endpoint request response -> (params -> request ->{Fail Error, e} response) -> Route e
routeUnder read template described implementation =
    typed = { incoming ->
        case read incoming of
            Err rejection -> errorReply rejection.status rejection.message
            Ok params -> answerWith described (implementation params) incoming
    }
    Route { method = described.method, template = templateOf template, answer = Typed typed }

rawRouteUnder : (Incoming -> Result Rejection params) -> String -> String -> (params -> List Http.Server.Route.Param -> Request e ->{e} Response e) -> Route e
rawRouteUnder read method template handler =
    untyped = { captured request ->
        found = Incoming { captures = List.map { param -> (param.name, param.value) } captured, query = [], headers = request.headers, body = Bytes.empty }
        case read found of
            Err rejection -> toResponse (errorReply rejection.status rejection.message)
            Ok params -> handler params captured request
    }
    Route { method = method, template = templateOf template, answer = Untyped untyped }

readOf : Prefix params -> Incoming -> Result Rejection params
readOf mount incoming = mount.readPrefix incoming

readBoth : (Incoming -> Result Rejection a) -> (Incoming -> Result Rejection b) -> Incoming -> Result Rejection (a, b)
readBoth outer inner incoming =
    case outer incoming of
        Err rejection -> Err rejection
        Ok first -> Result.map { second -> (first, second) } (inner incoming)

pairFirst : (a, b) -> a
pairFirst (first, _) = first

pairSecond : (a, b) -> b
pairSecond (_, second) = second

-- A raw route, which generated dispatchers build from `#[Web.Raw]` fields.
rawRoute : String -> String -> (List Http.Server.Route.Param -> Request e ->{e} Response e) -> Route e
rawRoute method template handler = Route { method = method, template = templateOf template, answer = Untyped handler }

-- An encoded `/` or `\` would change how the path splits, so it is rejected.
decodeSegment : String -> Maybe String
decodeSegment segment =
    if String.contains "%2F" segment || String.contains "%2f" segment || String.contains "%5C" segment || String.contains "%5c" segment then Nothing
    else Url.percentDecode segment

decodeAll : List String -> Maybe (List String)
decodeAll segments =
    case segments of
        [] -> Just []
        [segment | rest] ->
            case (decodeSegment segment, decodeAll rest) of
                (Just text, Just more) -> Just [text | more]
                _ -> Nothing

pathSegments : String -> Maybe (List String)
pathSegments target =
    path = Http.Server.Route.path target
    if path == "/" then Just []
    else decodeAll (String.split "/" (String.slice 1 (String.length path) path))

-- Literal segments rank before captures, and captures before a rest
-- capture, at the first position where two templates differ.
rank : Segment -> Int
rank segment =
    case segment of
        Literal _ -> 0
        Capture _ -> 1
        Rest _ -> 2

before : List Segment -> List Segment -> Bool
before left right =
    case (left, right) of
        ([a | rest], [b | more]) -> if rank a == rank b then before rest more else rank a < rank b
        ([], [_ | _]) -> True
        _ -> False

type Candidate e = { route : Route e, captures : List (String, String) }

matching : List (Route e) -> List String -> List (Candidate e)
matching routes actual =
    case routes of
        [] -> []
        [candidate | rest] ->
            case Web.matchTemplate candidate.template actual of
                Just captures -> [Candidate { route = candidate, captures = captures } | matching rest actual]
                Nothing -> matching rest actual

answers : String -> Route e -> Bool
answers method candidate = candidate.method == method || (method == "HEAD" && candidate.method == "GET")

best : List (Candidate e) -> Maybe (Candidate e) -> Maybe (Candidate e)
best candidates found =
    case candidates of
        [] -> found
        [candidate | rest] ->
            case found of
                Nothing -> best rest (Just candidate)
                Just current -> if before candidate.route.template current.route.template then best rest (Just candidate) else best rest found

allowed : List (Candidate e) -> List String -> List String
allowed candidates methods =
    case candidates of
        [] -> List.reverse methods
        [candidate | rest] ->
            method = candidate.route.method
            withMethod = if contains method methods then methods else [method | methods]
            allowed rest (if method == "GET" && not (contains "HEAD" withMethod) then ["HEAD" | withMethod] else withMethod)

not : Bool -> Bool
not value = if value then False else True

contains : String -> List String -> Bool
contains wanted items =
    case items of
        [] -> False
        [item | rest] -> item == wanted || contains wanted rest

joinComma : List String -> String
joinComma parts =
    case parts of
        [] -> ""
        [part] -> part
        [part | rest] -> part ++ ", " ++ joinComma rest

toResponse : Reply -> Response e
toResponse reply =
    body = if Bytes.length reply.body == 0 then Empty else BytesBody reply.body
    Response { status = reply.status, headers = reply.headers, body = body }

queryOf : String -> Maybe (List (String, String))
queryOf target =
    case Url.parse target of
        Just url -> Just (Url.queryParams url)
        Nothing -> Nothing

readBody : Request e ->{e} Bytes
readBody request =
    (_, bytes) = Writer.collecting { output -> Reader.forEachChunk request.body (Writer.write output) }
    bytes

-- Answers a request with the best route whose method and path match: a
-- literal segment beats a capture, and a capture a rest capture, at the
-- first position where their templates differ. A path that only routes of
-- other methods match answers 405 with `Allow`, and one that nothing matches
-- 404. Path segments are percent-decoded first; a malformed escape or an
-- encoded `/` or `\` answers 400.
serve : List (Route e) -> Request e ->{e} Response e
serve routes request =
    case pathSegments request.target of
        Nothing -> toResponse (errorReply 400 "The request path has an invalid escape.")
        Just actual ->
            candidates = matching routes actual
            case candidates of
                [] -> toResponse (errorReply 404 "No route matches this path.")
                _ ->
                    case best (List.filter { candidate -> answers request.method candidate.route } candidates) Nothing of
                        Nothing ->
                            reply = errorReply 405 "This path does not answer this method."
                            toResponse { reply | headers = [Header { name = "Allow", value = joinComma (allowed candidates []) } | reply.headers] }
                        Just chosen ->
                            case chosen.route.answer of
                                Untyped handler -> handler (List.map { (name, value) -> Http.Server.Route.Param { name = name, value = value } } chosen.captures) request
                                Typed handler ->
                                    case queryOf request.target of
                                        Nothing -> toResponse (errorReply 400 "The request target is invalid.")
                                        Just query ->
                                            incoming = Incoming { captures = chosen.captures, query = query, headers = request.headers, body = readBody request }
                                            toResponse (handler incoming)

validStatus : Int -> Int
validStatus status = if status >= 400 && status <= 599 then status else 500

listCode : List Code -> Code
listCode items =
    case items of
        [] -> `[]`
        [item | rest] -> `[$(item) | $(listCode rest)]`

append : List a -> List a -> List a
append left right =
    case left of
        [] -> right
        [item | rest] -> [item | append rest right]

-- The routes of an implementation, bound field by field, handed to `finish`.
contractRoutes : Contract -> Code -> (List Code -> Code) -> Code
contractRoutes contract implementation finish =
    Meta.match contract.info implementation { bound -> partRoutes contract.parts bound.fields [] finish }

partRoutes : List Part -> Items BoundField -> List Code -> (List Code -> Code) -> Code
partRoutes parts fields routes finish =
    case (parts, fields) of
        ([part | rest], Item field more) ->
            case part of
                OperationPart operation -> partRoutes rest more (append routes [`route $(operation.endpoint) $(field.value)`]) finish
                RawPart _ _ method template -> partRoutes rest more (append routes [`rawRoute $(lift method) $(lift template) $(field.value)`]) finish
                MountPart Nothing inner -> contractRoutes inner field.value { found -> partRoutes rest more (append routes found) finish }
                MountPart (Just code) inner -> partRoutes rest more (append routes (chainRoutes inner `readOf $(code)` { params -> `$(field.value) $(params)` })) finish
        _ -> finish routes

-- The routes of a contract below a mount with parameters. `read` decodes
-- the parameters of every such mount on the way, and `access` builds the
-- contract's implementation from the code of their value.
chainRoutes : Contract -> Code -> (Code -> Code) -> List Code
chainRoutes contract read access = chainParts contract read access 0 contract.parts

chainParts : Contract -> Code -> (Code -> Code) -> Int -> List Part -> List Code
chainParts contract read access index parts =
    case parts of
        [] -> []
        [part | rest] ->
            field = { params -> fieldAt contract index (access params) }
            here =
                case part of
                    OperationPart operation -> [`routeUnder $(read) $(lift operation.template) $(operation.endpoint) $(Meta.lambda "_web_params" field)`]
                    RawPart _ _ method template -> [`rawRouteUnder $(read) $(lift method) $(lift template) $(Meta.lambda "_web_params" field)`]
                    MountPart Nothing inner -> chainRoutes inner read field
                    MountPart (Just code) inner ->
                        chainRoutes inner `readBoth $(read) (readOf $(code))` { params -> `$(fieldAt contract index (access `pairFirst $(params)`)) (pairSecond $(params))` }
            append here (chainParts contract read access (index + 1) rest)

-- The field at a position of an implementation's code.
fieldAt : Contract -> Int -> Code -> Code
fieldAt contract index implementation = Meta.match contract.info implementation { bound -> nthValue index bound.fields }

nthValue : Int -> Items BoundField -> Code
nthValue index fields =
    case fields of
        Item field rest -> if index == 0 then field.value else nthValue (index - 1) rest
        NoItems -> Meta.fail "A contract field is missing."

-- Generates the request handler of an API reflected at the pure row, as
-- `typeOf (Shop {})`: a function taking the API's implementation and then
-- the request. Conflicting routes fail here.
dispatch : Meta.TypeRepr -> Code
dispatch api =
    case Result.andThen { (_, root) -> Result.map { _ -> root } (Web.apiRoutes root) } (Web.contractAt api "") of
        Err message -> Meta.fail message
        Ok root ->
            Meta.lambda "_web_implementation" { implementation ->
                contractRoutes root implementation { routes -> Meta.lambda "_web_dispatch_request" { request -> `serve $(listCode routes) $(request)` } }
            }
