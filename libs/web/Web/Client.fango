-- Calling a typed API over HTTP.
--
-- `client` generates a value of a contract's own type, given the server's
-- base URL. It takes an API and the dotted location of a contract in it,
-- `""` for the API itself. Each operation calls its endpoint with `call`, and
-- each mounted field is a client of its own contract:
--
-- ```text
-- catalog : Catalog {Http.Client.Http, Fail Web.Client.Error}
-- catalog = $(Web.Client.client (typeOf (Shop {})) "catalog") "https://shop.example"
-- ```
--
-- Every failure is raised in the caller's context, so `Fail.attempt`
-- around one call recovers that call's failure and later calls proceed. A
-- domain error is not a failure: it is the operation's `Result`.
module Web.Client exposing (Error(..), call, client)

import Fail exposing (Fail)
import Http exposing (Body(..), Header(..))
import Http.Client
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Meta exposing (Code, Items(..))
import Result exposing (Result(..))
import String
import Web exposing (Contract(..), Endpoint(..), Operation(..), Outgoing(..), Part(..), Reply(..))

-- Why a call failed.
type Error
    -- The HTTP client failed: no connection, a timeout, or a reply larger
    -- than its limit.
    = Transport Http.Client.Error
    -- The reply's status is not one the endpoint declares; with its body.
    | UnexpectedStatus Int String
    -- A declared status whose body or media type does not match.
    | InvalidResponse String
    -- A request field the endpoint cannot carry.
    | InvalidRequest String
    deriving (Eq, Show)

trimSlash : String -> String
trimSlash base =
    size = String.length base
    if size > 0 && String.slice (size - 1) size base == "/" then trimSlash (String.slice 0 (size - 1) base) else base

withHeaders : List Header -> Http.Client.Request e -> Http.Client.Request e
withHeaders headers outgoing =
    case headers of
        [] -> outgoing
        [header | rest] -> withHeaders rest (Http.Client.withHeader header.name header.value outgoing)

-- Calls one endpoint of the server at `base`, such as
-- `"https://shop.example"`. Redirects are not followed, so the endpoint's
-- own response is what is checked.
call : Endpoint request response -> String -> request ->{Http.Client.Http, Fail Error} response
call described base request =
    sent =
        case Web.outgoing described request of
            Ok found -> found
            Err message -> Fail.fail (InvalidRequest message)
    plain = withHeaders sent.headers (Http.Client.request sent.method (trimSlash base ++ sent.target))
    message =
        case sent.body of
            Just bytes -> Http.Client.withBody (BytesBody bytes) plain
            Nothing -> plain
    received =
        case Fail.attempt { Http.Client.configure { config -> { config | maxRedirects = 0 } } { Http.Client.fetch message } } of
            Ok found -> found
            Err problem -> Fail.fail (Transport problem)
    case described.response.read (Reply { status = received.status, headers = received.headers, body = received.body }) of
        Ok value -> value
        Err (Web.UnexpectedStatus status text) -> Fail.fail (UnexpectedStatus status text)
        Err (Web.InvalidResponse problem) -> Fail.fail (InvalidResponse problem)

listToItems : List a -> Items a
listToItems items =
    case items of
        [] -> NoItems
        [item | rest] -> Item item (listToItems rest)

-- `wrap` gives an endpoint the parameters of the mounts above it.
clientOf : Code -> (Code -> Code) -> Int -> Contract -> Code
clientOf base wrap depth contract =
    fields = List.map { part ->
        case part of
            OperationPart operation -> Meta.lambda ("_web_" ++ operation.name) { request -> `call $(wrap operation.endpoint) $(base) $(request)` }
            MountPart Nothing inner -> clientOf base wrap depth inner
            MountPart (Just code) inner ->
                Meta.lambda ("_web_params_" ++ show depth) { params -> clientOf base { described -> wrap `Web.under $(code) $(params) $(described)` } (depth + 1) inner }
            RawPart _ location _ _ -> Meta.fail ("The raw route `" ++ location ++ "` has no client; generate one for a mounted contract without raw routes.")
    } contract.parts
    Meta.construct contract.ctor (listToItems fields)

-- Generates a client of the contract at a dotted location of an API: a
-- function from the server's base URL to a value of the contract's type. A
-- mounted field with parameters is a function from them to its client. A
-- raw route has no client, so the contract must have none. A location below
-- mounts with parameters takes theirs first, outermost first:
--
-- ```text
-- acme : Users {Http.Client.Http, Fail Web.Client.Error}
-- acme = $(Web.Client.client (typeOf (Shop {})) "users") "https://shop.example" (Org { org = "acme" })
-- ```
client : Meta.TypeRepr -> String -> Code
client api location =
    case Web.contractAt api location of
        Err message -> Meta.fail message
        Ok (prefixes, found) -> Meta.lambda "_web_base" { base -> clientUnder base { described -> described } 0 prefixes found }

-- Takes the parameters of each mount above the contract, outermost first.
clientUnder : Code -> (Code -> Code) -> Int -> List Code -> Contract -> Code
clientUnder base wrap depth prefixes contract =
    case prefixes of
        [] -> clientOf base wrap depth contract
        [code | rest] -> Meta.lambda ("_web_params_" ++ show depth) { params -> clientUnder base { described -> wrap `Web.under $(code) $(params) $(described)` } (depth + 1) rest contract }
