module WebRoundTrip exposing (tests)

import Bytes
import Expect
import Fail exposing (Fail)
import Http exposing (Body(..), Protocol(..))
import Http.Client as Client
import Http.Server exposing (Request(..), Response(..))
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Shop.Api exposing (Org(..), Shop(..))
import Shop.Catalog exposing (Catalog(..), FilePath(..), Item(..), Lookup(..), Ratio(..), Search(..), Tag(..), Traced(..))
import Shop.Users exposing (GetUser(..), NewUser(..), User(..), UserError(..), Users(..))
import State
import String
import Test
import Web
import Web.Client
import Web.Server
import Web.Testing

dispatch = $(Web.Server.dispatch (typeOf (Shop {})))

alice = User { id = 7, name = "Alice" }

-- The users of one organization: the mount's parameters reach the
-- implementation, not the requests.
users : Org -> Users e
users org =
    { getUser = { query -> if org.org == "acme" && query.id == 7 then Ok alice else Err NoSuchUser }
    , createUser = { request -> if request.user.name == "Alice" then Err (NameTaken "Alice") else Ok request.user }
    , clear = { _ -> () }
    , count = { _ -> if org.org == "acme" then 1 else 0 }
    }

admins : Org -> Users e
admins org = { users org | count = { _ -> 100 } }

joinSlash : List String -> String
joinSlash parts =
    case parts of
        [] -> ""
        [part] -> part
        [part | rest] -> part ++ "|" ++ joinSlash rest

items : Catalog e
items =
    { item = { lookup -> Item { id = lookup.id, title = "item " ++ show lookup.id } }
    , newest = { _ -> Item { id = 0, title = "newest" } }
    , search = { query -> [Item { id = Maybe.withDefault 0 query.limit, title = query.q ++ " " ++ show query.tags }] }
    , file = { found -> joinSlash found.path }
    , trace = { traced -> traced.trace ++ " " ++ Maybe.withDefault "-" traced.note }
    , ratio = { _ -> Ratio { value = 1.0 / 0.0 } }
    }

app : Request {Protocol, e} ->{Protocol, e} Response {Protocol, e}
app request = dispatch (Shop { users = users, catalog = items, health = Shop.Api.health, admin = admins }) request

-- An API whose operations fail with their own status. An implementation
-- has one row, and a raw route reads the server's own request, so this API
-- has no raw route.
type Counted e =
    { #[Web.Mount "/orgs/:org"]
      users : Org -> Users e
    , #[Web.Mount "/"]
      catalog : Catalog e
    , #[Web.Mount "/admin/orgs/:org"]
      admin : Org -> Users e
    }

dispatchCounted = $(Web.Server.dispatch (typeOf (Counted {})))

-- An implementation with effects of its own: a counter, handled around the
-- server, and a failure that answers with its own status.
counting : Org -> Users {State.State Int, Fail Web.Server.Error}
counting org =
    { users org |
      clear = { _ -> Fail.fail (Web.Server.Error { status = 403, message = "Not for " ++ org.org }) }
    , count = { _ ->
        State.put (State.get() + 1)
        State.get()
    }
    }

withCounter : Request {Protocol, State.State Int, e} ->{Protocol, State.State Int, e} Response {Protocol, State.State Int, e}
withCounter request = dispatchCounted (Counted { users = counting, catalog = items, admin = admins }) request

shopIn : Org -> Users {Client.Http, Fail Web.Client.Error}
shopIn = $(Web.Client.client (typeOf (Shop {})) "users") "http://shop.example/"

acme : Org
acme = Org { org = "acme" }

shop : Users {Client.Http, Fail Web.Client.Error}
shop = shopIn acme

admin : Users {Client.Http, Fail Web.Client.Error}
admin = $(Web.Client.client (typeOf (Shop {})) "admin") "http://shop.example" acme

catalog : Catalog {Client.Http, Fail Web.Client.Error}
catalog = $(Web.Client.client (typeOf (Shop {})) "catalog") "http://shop.example"

-- Mounts with parameters inside each other: each level reads its own.
type Team =
    { #[Web.Path "team"]
      team : String
    }
    deriving (Eq, Show)

type Teams e =
    { #[Web.Mount "/teams/:team"]
      team : Team -> Users e
    }

type Nested e =
    { #[Web.Mount "/orgs/:org"]
      org : Org -> Teams e
    }

dispatchNested = $(Web.Server.dispatch (typeOf (Nested {})))

teamUsers : Org -> Team -> Users e
teamUsers org team = { users org | getUser = { query -> Ok (User { id = query.id, name = org.org ++ "/" ++ team.team }) } }

nestedApp : Request {Protocol, e} ->{Protocol, e} Response {Protocol, e}
nestedApp request = dispatchNested (Nested { org = { org -> Teams { team = teamUsers org } } }) request

nested : Nested {Client.Http, Fail Web.Client.Error}
nested = $(Web.Client.client (typeOf (Nested {})) "") "http://shop.example"

nestedUsers : Org -> Team -> Users {Client.Http, Fail Web.Client.Error}
nestedUsers = $(Web.Client.client (typeOf (Nested {})) "org.team") "http://shop.example"

nestedLinks : Nested {Web.Linking}
nestedLinks = $(Web.links (typeOf (Nested {})))

strictShop : Shop {Expect.Expect, e}
strictShop = $(Web.Testing.strict (typeOf (Shop {})) "")

stubbedShop : Shop {Expect.Expect, e}
stubbedShop = { strictShop | users = { org -> { strictShop.users org | count = { _ -> 3 } } } }

attempt : (() ->{Fail Web.Client.Error, e} a) ->{e} Result Web.Client.Error a
attempt action = Fail.attempt action

teapot : Request {Protocol, e} ->{Protocol, e} Response {Protocol, e}
teapot request =
    if String.contains "teapot" request.target then Response { status = 418, headers = [], body = BytesBody (Bytes.fromString "short and stout") }
    else app request

failureMessage : (() ->{Expect.Expect} ()) -> Maybe String
failureMessage body =
    handle body() on
        Expect.fail error -> Just error.message
        return _ -> Nothing

tests : Test.Test {}
tests = Test.describe "web round trips"
    [ Test.test "GET and POST through the generated client and dispatcher" {
        result = attempt {
            use Client.mock app
            found = shop.getUser (GetUser { id = 7, verbose = Nothing })
            missing = shop.getUser (GetUser { id = 8, verbose = Just True })
            created = shop.createUser (NewUser { user = User { id = 9, name = "Bo" } })
            taken = shop.createUser (NewUser { user = alice })
            ((found, missing), (created, taken), (shop.clear(), shop.count()))
        }
        Expect.equal (Ok ((Ok alice, Err NoSuchUser), (Ok (User { id = 9, name = "Bo" }), Err (NameTaken "Alice")), ((), 1))) result
    }
    , Test.test "a failed call leaves later calls working" {
        result = Client.mock teapot {
            first = attempt { (shopIn (Org { org = "teapot" })).count() }
            second = attempt { shop.count() }
            (first, second)
        }
        Expect.equal (Err (Web.Client.UnexpectedStatus 418 "short and stout"), Ok 1) result
    }
    , Test.test "each mount of one contract is served by its own implementation" {
        result = attempt {
            use Client.mock app
            (shop.count(), admin.count())
        }
        Expect.equal (Ok (1, 100)) result
    }
    , Test.test "query lists, optional values, rest captures, and headers" {
        result = attempt {
            use Client.mock app
            searched = catalog.search (Search { q = "lamp", tags = [Sale, New], limit = Just 3 })
            plain = catalog.search (Search { q = "desk", tags = [], limit = Nothing })
            file = catalog.file (FilePath { path = ["docs", "a b"] })
            traced = catalog.trace (Traced { trace = "t-1", note = Nothing })
            noted = catalog.trace (Traced { trace = "t-2", note = Just "n" })
            (searched, plain, (file, traced, noted))
        }
        Expect.equal (Ok ([Item { id = 3, title = "lamp [Sale, New]" }], [Item { id = 0, title = "desk []" }], ("docs|a b", "t-1 -", "t-2 n"))) result
    }
    , Test.test "nested mounts with parameters pass each its own" {
        result = attempt {
            use Client.mock nestedApp
            whole = ((nested.org acme).team (Team { team = "web" })).getUser (GetUser { id = 3, verbose = Nothing })
            located = (nestedUsers (Org { org = "zed" }) (Team { team = "ops" })).getUser (GetUser { id = 4, verbose = Nothing })
            (whole, located)
        }
        Expect.equal (Ok (Ok (User { id = 3, name = "acme/web" }), Ok (User { id = 4, name = "zed/ops" }))) result
        Expect.equal "/orgs/acme/teams/web/users/3" (Web.linkTo { ((nestedLinks.org acme).team (Team { team = "web" })).getUser (GetUser { id = 3, verbose = Nothing }) })
    }
    , Test.test "a literal segment wins over a capture" {
        result = attempt {
            use Client.mock app
            (catalog.newest(), catalog.item (Lookup { id = 5 }))
        }
        Expect.equal (Ok (Item { id = 0, title = "newest" }, Item { id = 5, title = "item 5" })) result
    }
    , Test.test "record update stubs one operation of a generated client" {
        stubbed = { shop | getUser = { _ -> Ok (User { id = 1, name = "Stub" }) } }
        result = attempt {
            use Client.mock teapot
            (stubbed.getUser (GetUser { id = 1, verbose = Nothing }), stubbed.count())
        }
        Expect.equal (Ok (Ok (User { id = 1, name = "Stub" }), 1)) result
    }
    , Test.test "implementations' effects are handled around the server" {
        result = State.run 41 {
            Client.mock withCounter {
                first = attempt { shop.count() }
                second = attempt { shop.count() }
                refused = attempt { shop.clear() }
                (first, second, refused)
            }
        }
        Expect.equal (Ok 42, Ok 43, Err (Web.Client.UnexpectedStatus 403 "{\"message\":\"Not for acme\"}")) result.value
        Expect.equal 43 result.state
    }
    , Test.test "a strict implementation answers only what a test stubs" {
        served : Request {Protocol, Expect.Expect, e} ->{Protocol, Expect.Expect, e} Response {Protocol, Expect.Expect, e}
        served request = dispatch stubbedShop request
        counted = attempt {
            use Client.mock served
            shop.count()
        }
        Expect.equal (Ok 3) counted
        message = failureMessage {
            _ = attempt {
                use Client.mock served
                shop.getUser (GetUser { id = 2, verbose = Nothing })
            }
            ()
        }
        Expect.equal (Just "Unexpected call to users.getUser: GetUser { verbose = Nothing, id = 2 }") message
        health = failureMessage {
            _ = Fail.attempt { Client.mock served { Client.get "http://shop.example/health" } }
            ()
        }
        Expect.equal (Just "Unexpected request to health") health
    }
    ]
