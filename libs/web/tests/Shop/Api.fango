module Shop.Api exposing (Org(..), Shop(..), createUserEndpoint, getUserEndpoint, health, orgPrefix, searchEndpoint)

import Bytes
import Http exposing (Body(..))
import Http.Server exposing (Request(..), Response(..))
import Http.Server.Route
import Result exposing (Result(..))
import Shop.Catalog exposing (Catalog(..), Search(..))
import Shop.Users exposing (GetUser(..), NewUser(..), User(..), UserError(..), Users(..))
import Web

-- An untyped route, served beside the typed ones.
health : List Http.Server.Route.Param -> Request e ->{e} Response e
health _ _ = Response { status = 200, headers = [], body = BytesBody (Bytes.fromString "ok") }

-- The parameters of a mount under an organization.
type Org =
    { #[Web.Path "org"]
      org : String
    }
    deriving (Eq, Show)

-- The whole API. `admin` mounts the same contract a second time.
type Shop e =
    { #[Web.Mount "/orgs/:org"]
      users : Org -> Users e
    , #[Web.Mount "/"]
      catalog : Catalog e
    , #[Web.Raw "GET /health"]
      health : List Http.Server.Route.Param -> Request e ->{e} Response e
    , #[Web.Mount "/admin/orgs/:org"]
      admin : Org -> Users e
    }

orgPrefix : Web.Prefix Org
orgPrefix = $(Web.prefix (typeOf (Shop {})) "users")

getUserEndpoint : Web.Endpoint GetUser (Result UserError User)
getUserEndpoint = $(Web.endpoint (typeOf (Shop {})) "users.getUser")

createUserEndpoint : Web.Endpoint NewUser (Result UserError User)
createUserEndpoint = $(Web.endpoint (typeOf (Shop {})) "users.createUser")

searchEndpoint : Web.Endpoint Search (List Shop.Catalog.Item)
searchEndpoint = $(Web.endpoint (typeOf (Shop {})) "catalog.search")
