import Web
import Web.Server

-- Two entries with one name.
type Ping e =
    { #[Web.Get "/ping"]
      ping : () ->{e} ()
    }

first = Web.mount "ping" "/a" (typeOf (Ping {}))

second = Web.mount "ping" "/b" (typeOf (Ping {}))

dispatch = $(Web.Server.dispatch (Web.api [first, second]))

main() = print "unreachable"
