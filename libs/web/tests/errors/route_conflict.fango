import Web
import Web.Server

-- Two mounts that answer the same route.
type Ping e =
    { #[Web.Get "/ping"]
      ping : () ->{e} ()
    }

type Api e =
    { #[Web.Mount "/"]
      first : Ping e
    , #[Web.Mount "/"]
      second : Ping e
    }

dispatch = $(Web.Server.dispatch (typeOf (Api {})))

main() = print "unreachable"
