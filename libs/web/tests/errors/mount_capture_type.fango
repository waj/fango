import Web

-- A mount capture read as two different types.
type ByName =
    { #[Web.Path "org"]
      org : String
    }

type ById =
    { #[Web.Path "org"]
      org : Int
    }

type Bad e =
    { #[Web.Get "/a"]
      a : ByName ->{e} ()
    , #[Web.Get "/b"]
      b : ById ->{e} ()
    }

type Api e =
    { #[Web.Mount "/orgs/:org"]
      bad : Bad e
    }

main() = print (Web.link $(Web.endpoint (typeOf (Api {})) "bad.a") (ByName { org = "x" }))
