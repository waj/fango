{
  "comments": {
    "lineComment": "--",
    "blockComment": ["{-", "-}"]
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"],
    ["$(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "$(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "{-", "close": "-}", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "(=|->|\\bof|\\bthen|\\belse)\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s+\\}"
  }
}
