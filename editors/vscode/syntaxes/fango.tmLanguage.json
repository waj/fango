{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fango",
  "scopeName": "source.fango",
  "patterns": [
    { "include": "#comments" },
    { "include": "#module_decl" },
    { "include": "#import_decl" },
    { "include": "#type_decl" },
    { "include": "#class_decl" },
    { "include": "#instance_decl" },
    { "include": "#effect_decl" },
    { "include": "#fixity_decl" },
    { "include": "#operator_annotation" },
    { "include": "#operator_definition" },
    { "include": "#annotation" },
    { "include": "#function_definition" },
    { "include": "#binding" },
    { "include": "#expressions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#pragma" },
        { "include": "#block_comment" },
        {
          "name": "comment.line.double-dash.fango",
          "match": "--.*$"
        }
      ]
    },
    "pragma": {
      "name": "meta.preprocessor.fango",
      "begin": "\\{-#",
      "end": "#-\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.preprocessor.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.preprocessor.fango" }
      },
      "patterns": [
        {
          "name": "keyword.control.directive.fango",
          "match": "\\b(?:no-prelude|resource)\\b"
        }
      ]
    },
    "block_comment": {
      "name": "comment.block.fango",
      "begin": "\\{-",
      "end": "-\\}",
      "patterns": [
        { "include": "#block_comment" }
      ]
    },
    "module_decl": {
      "match": "^(module)\\s+([A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.other.module.fango" },
        "2": { "name": "entity.name.namespace.fango" }
      }
    },
    "import_decl": {
      "match": "^(import)\\s+([A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Z][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.other.import.fango" },
        "2": { "name": "entity.name.namespace.fango" },
        "3": { "name": "keyword.other.as.fango" },
        "4": { "name": "entity.name.namespace.fango" }
      }
    },
    "type_decl": {
      "begin": "^(type)\\s+([A-Z][A-Za-z0-9_]*)",
      "end": "^(?=\\S)",
      "beginCaptures": {
        "1": { "name": "keyword.other.type.fango" },
        "2": { "name": "entity.name.type.fango" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#deriving" },
        {
          "name": "keyword.operator.assignment.fango",
          "match": "="
        },
        {
          "name": "keyword.operator.pipe.fango",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        },
        {
          "name": "punctuation.section.braces.fango",
          "match": "[{}]"
        },
        { "include": "#qualified_module" },
        {
          "match": "\\b([a-z][A-Za-z0-9_]*)(\\s*)(:)",
          "captures": {
            "1": { "name": "variable.other.member.fango" },
            "3": { "name": "keyword.operator.type-annotation.fango" }
          }
        },
        {
          "name": "entity.name.type.fango",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.generic-type.fango",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "deriving": {
      "begin": "\\b(deriving)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "keyword.other.deriving.fango" },
        "2": { "name": "punctuation.section.parens.begin.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.fango" }
      },
      "patterns": [
        {
          "name": "entity.name.type.class.fango",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        }
      ]
    },
    "class_decl": {
      "match": "^(class)\\s+([A-Z][A-Za-z0-9_]*)((?:\\s+[a-z][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.other.class.fango" },
        "2": { "name": "entity.name.type.class.fango" },
        "3": { "name": "variable.other.generic-type.fango" }
      }
    },
    "instance_decl": {
      "begin": "^(instance)\\b",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.other.instance.fango" }
      },
      "patterns": [
        { "include": "#type_expression" }
      ]
    },
    "effect_decl": {
      "match": "^(effect)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.effect.fango" },
        "2": { "name": "entity.name.type.effect.fango" }
      }
    },
    "operator_name": {
      "match": "(\\()\\s*([!#%&*+\\-/:<=>?@^|~]+)\\s*(\\))",
      "captures": {
        "1": { "name": "punctuation.section.parens.begin.fango" },
        "2": { "name": "entity.name.function.operator.fango" },
        "3": { "name": "punctuation.section.parens.end.fango" }
      }
    },
    "fixity_decl": {
      "match": "^(infixl|infixr|infix)\\s+([0-9])\\s*(\\()\\s*([!#%&*+\\-/:<=>?@^|~]+)\\s*(\\))",
      "captures": {
        "1": { "name": "keyword.other.fixity.fango" },
        "2": { "name": "constant.numeric.fango" },
        "3": { "name": "punctuation.section.parens.begin.fango" },
        "4": { "name": "entity.name.function.operator.fango" },
        "5": { "name": "punctuation.section.parens.end.fango" }
      }
    },
    "operator_annotation": {
      "begin": "^(\\s*)(\\()\\s*([!#%&*+\\-/:<=>?@^|~]+)\\s*(\\))\\s*(:)",
      "end": "$",
      "beginCaptures": {
        "2": { "name": "punctuation.section.parens.begin.fango" },
        "3": { "name": "entity.name.function.operator.fango" },
        "4": { "name": "punctuation.section.parens.end.fango" },
        "5": { "name": "keyword.operator.type-annotation.fango" }
      },
      "patterns": [
        { "include": "#type_expression" },
        {
          "begin": "(=)\\s*(native)\\b",
          "end": "(?=$)",
          "beginCaptures": {
            "1": { "name": "keyword.operator.assignment.fango" },
            "2": { "name": "keyword.other.native.fango" }
          },
          "patterns": [
            { "include": "#native_string" }
          ]
        }
      ]
    },
    "operator_definition": {
      "match": "^\\s*(\\()\\s*([!#%&*+\\-/:<=>?@^|~]+)\\s*(\\))(?=(?:[ \\t]+(?:\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\)|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\]|\\{[^{}]*\\}|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^'\\\\])'|-?[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?|\\^?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*))+[ \\t]*=(?![!#%&*+\\-/:<=>?@^|~]))",
      "captures": {
        "1": { "name": "punctuation.section.parens.begin.fango" },
        "2": { "name": "entity.name.function.operator.fango" },
        "3": { "name": "punctuation.section.parens.end.fango" }
      }
    },
    "annotation": {
      "begin": "^(\\s*)([a-z][A-Za-z0-9_]*)\\s*(:)",
      "end": "$",
      "beginCaptures": {
        "2": { "name": "entity.name.function.fango" },
        "3": { "name": "keyword.operator.type-annotation.fango" }
      },
      "patterns": [
        { "include": "#type_expression" },
        {
          "begin": "(=)\\s*(native)\\b",
          "end": "(?=$)",
          "beginCaptures": {
            "1": { "name": "keyword.operator.assignment.fango" },
            "2": { "name": "keyword.other.native.fango" }
          },
          "patterns": [
            { "include": "#native_string" }
          ]
        }
      ]
    },
    "type_expression": {
      "patterns": [
        { "include": "#comments" },
        {
          "name": "keyword.operator.arrow.fango",
          "match": "->"
        },
        {
          "name": "keyword.operator.big-arrow.fango",
          "match": "=>"
        },
        { "include": "#effect_row" },
        { "include": "#qualified_module" },
        {
          "name": "constant.language.unit.fango",
          "match": "\\(\\)"
        },
        {
          "name": "entity.name.type.fango",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.generic-type.fango",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        }
      ]
    },
    "effect_row": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.effect-row.begin.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.effect-row.end.fango" }
      },
      "patterns": [
        { "include": "#qualified_module" },
        {
          "name": "entity.name.type.effect.fango",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.generic-type.fango",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.pipe.fango",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        }
      ]
    },
    "function_definition": {
      "match": "^\\s*([a-z][A-Za-z0-9_]*)(?=(?:\\(\\)|(?:[ \\t]+(?:\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\)|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\]|\\{[^{}]*\\}|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^'\\\\])'|-?[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?|\\^?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*))+)[ \\t]*=(?![!#%&*+\\-/:<=>?@^|~]))",
      "captures": {
        "1": { "name": "entity.name.function.fango" }
      }
    },
    "binding": {
      "match": "^\\s*([a-z][A-Za-z0-9_]*)(?=\\s*=(?![!#%&*+\\-/:<=>?@^|~]))",
      "captures": {
        "1": { "name": "variable.other.definition.fango" }
      }
    },
    "expressions": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#native_expr" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#pin_pattern" },
        { "include": "#handler_state" },
        { "include": "#resume_expression" },
        { "include": "#lambda" },
        { "include": "#keywords" },
        { "include": "#return_clause" },
        { "include": "#booleans" },
        { "include": "#numbers" },
        { "include": "#list_expression" },
        { "include": "#record_expression" },
        { "include": "#qualified_module" },
        { "include": "#record_accessor" },
        {
          "name": "entity.name.type.fango",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        { "include": "#operator_name" },
        { "include": "#operators" },
        {
          "name": "variable.language.wildcard.fango",
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.unit.fango",
          "match": "\\(\\)"
        }
      ]
    },
    "lambda": {
      "comment": "A lambda may head an expression or follow application arguments. Its parameter header ends at the exact arrow token; the body uses the enclosing expression rules.",
      "begin": "\\\\",
      "end": "(?<![!#%&*+\\-/:<=>?@^|~])->(?![!#%&*+\\-/:<=>?@^|~])",
      "beginCaptures": {
        "0": { "name": "keyword.operator.lambda.fango" }
      },
      "endCaptures": {
        "0": { "name": "keyword.operator.arrow.fango" }
      },
      "patterns": [
        { "include": "#expressions" },
        { "name": "variable.parameter.fango", "match": "\\b[a-z][A-Za-z0-9_]*\\b" }
      ]
    },
    "list_expression": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.fango" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        },
        {
          "name": "keyword.operator.list-tail.fango",
          "match": "(?<![!#%&*+\\-/:<=>?@^|~])\\|(?![!#%&*+\\-/:<=>?@^|~])"
        },
        { "include": "#expressions" }
      ]
    },
    "record_expression": {
      "patterns": [
        {
          "begin": "\\b((?:[A-Z][A-Za-z0-9_]*\\.)*)([A-Z][A-Za-z0-9_]*)(\\s*)(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "support.other.module.fango" },
            "2": { "name": "entity.name.type.fango" },
            "4": { "name": "punctuation.section.braces.begin.fango" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.fango" }
          },
          "patterns": [ { "include": "#record_body" } ]
        },
        {
          "begin": "(\\{)(?=[^{}\\n]*\\|)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "punctuation.section.braces.begin.fango" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.fango" }
          },
          "patterns": [ { "include": "#record_body" } ]
        },
        {
          "begin": "(\\{)(?=\\s*[a-z][A-Za-z0-9_]*\\s*=(?!=|>))",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "punctuation.section.braces.begin.fango" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.fango" }
          },
          "patterns": [ { "include": "#record_body" } ]
        },
        {
          "begin": "(\\{)(?=\\s*$)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "punctuation.section.braces.begin.fango" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.fango" }
          },
          "patterns": [ { "include": "#record_body" } ]
        }
      ]
    },
    "record_body": {
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([a-z][A-Za-z0-9_]*)(\\s*)(=)(?!=|>)",
          "captures": {
            "1": { "name": "variable.other.member.fango" },
            "3": { "name": "keyword.operator.assignment.fango" }
          }
        },
        {
          "name": "punctuation.separator.comma.fango",
          "match": ","
        },
        { "include": "#expressions" }
      ]
    },
    "record_accessor": {
      "match": "(\\.)([a-z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.fango" },
        "2": { "name": "variable.other.member.fango" }
      }
    },
    "pin_pattern": {
      "match": "(\\^)((?:[A-Z][A-Za-z0-9_]*\\.)*)([a-z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.operator.pin.fango" },
        "2": { "name": "support.other.module.fango" },
        "3": { "name": "variable.other.readwrite.fango" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fango",
          "match": "\\b(if|then|else|case|of|handle|resume|quote|typeOf)\\b"
        },
        {
          "name": "keyword.other.fango",
          "match": "\\b(module|import|as|exposing|type|effect|abort|native|infixl|infixr|infix|class|instance|deriver|deriving)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.fango",
          "match": "\\b(let|in)\\b"
        }
      ]
    },
    "return_clause": {
      "name": "keyword.control.return.fango",
      "match": "^\\s*(return)\\b(?=(?:[ \\t]+(?:\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\)|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\]|\\{[^{}]*\\}|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:\\\\.|[^'\\\\])'|-?[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?|\\^?[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*))+[ \\t]*->)"
    },
    "handler_state": {
      "name": "keyword.control.with.fango",
      "match": "(?<=\\bhandle\\b[^\\n]*)\\bwith\\b(?=[ \\t]+[a-z][A-Za-z0-9_]*[ \\t]*=(?![!#%&*+\\-/:<=>?@^|~]))"
    },
    "resume_expression": {
      "begin": "\\b(resume)\\b",
      "end": "(?:(\\bwith\\b)(?=[ \\t]+[^\\n]+))|(?=$)",
      "beginCaptures": {
        "1": { "name": "keyword.control.fango" }
      },
      "endCaptures": {
        "1": { "name": "keyword.control.with.fango" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#qualified_module" },
        { "include": "#record_accessor" },
        { "include": "#operator_name" },
        { "include": "#operators" }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.fango",
      "match": "\\b(True|False)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.fango",
          "match": "\\b\\d+(?:\\.\\d+(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.fango",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "qualified_module": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)(?=[A-Za-z])",
      "captures": {
        "1": { "name": "support.other.module.fango" },
        "2": { "name": "punctuation.accessor.fango" }
      }
    },
    "string": {
      "name": "string.quoted.double.fango",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.fango" }
      },
      "patterns": [
        { "include": "#string_escapes" }
      ]
    },
    "string_escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.fango",
          "match": "\\\\[\\\\\"ntr]"
        },
        {
          "name": "invalid.illegal.escape.fango",
          "match": "\\\\."
        }
      ]
    },
    "char": {
      "patterns": [
        {
          "name": "constant.character.fango",
          "match": "'(?:\\\\[\\\\'ntr]|[^\\\\'\\r\\n])'"
        },
        {
          "name": "invalid.illegal.char.fango",
          "match": "'[^'\\r\\n]*'"
        }
      ]
    },
    "native_expr": {
      "begin": "\\b(native)\\b",
      "end": "(?=$)|(?<=\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.native.fango" }
      },
      "patterns": [
        { "include": "#native_string" }
      ]
    },
    "native_string": {
      "name": "string.quoted.double.native.fango",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.fango" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.fango" }
      },
      "patterns": [
        {
          "name": "constant.other.placeholder.fango",
          "match": "\\$\\d+"
        },
        { "include": "#string_escapes" }
      ]
    },
    "operators": {
      "comment": "Operator runs munch maximally in the lexer, so every reserved lexeme is bounded by non-operator characters — otherwise `-->` would highlight an arrow inside a comment and `|>` a pipe. The final catch-all carries user-declared operators, which have no fixed meaning to scope.",
      "patterns": [
        {
          "name": "keyword.operator.splice.fango",
          "match": "\\$\\("
        },
        {
          "name": "keyword.operator.range.fango",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.fango",
          "match": "(?<![!#%&*+\\-/:<=>?@^|~])->(?![!#%&*+\\-/:<=>?@^|~])"
        },
        {
          "name": "keyword.operator.big-arrow.fango",
          "match": "(?<![!#%&*+\\-/:<=>?@^|~])=>(?![!#%&*+\\-/:<=>?@^|~])"
        },
        {
          "name": "keyword.operator.assignment.fango",
          "match": "(?<![!#%&*+\\-/:<=>?@^|~])=(?![!#%&*+\\-/:<=>?@^|~])"
        },
        {
          "name": "keyword.operator.type-annotation.fango",
          "match": "(?<![!#%&*+\\-/:<=>?@^|~]):(?![!#%&*+\\-/:<=>?@^|~])"
        },
