{
  "name": "fango-lang",
  "displayName": "Fango",
  "description": "Syntax highlighting, formatting, navigation, hover, and diagnostics for the Fango programming language",
  "version": "0.3.0",
  "publisher": "fango",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./extension.js",
  "scripts": {
    "test:grammar": "node tests/tokenize.cjs",
    "test:extension": "node tests/extension.cjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "activationEvents": [
    "onLanguage:fango"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fango",
        "aliases": [
          "Fango",
          "fango"
        ],
        "extensions": [
          ".fango"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/fango-file.svg",
          "dark": "./images/fango-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "fango",
        "scopeName": "source.fango",
        "path": "./syntaxes/fango.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Fango",
      "properties": {
        "fango.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Fango executable. When empty, a Fango built at the workspace root is used if present, otherwise Fango from PATH."
        }
      }
    },
    "configurationDefaults": {
      "[fango]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "fango.fango-lang"
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "8.1.0"
  }
}
