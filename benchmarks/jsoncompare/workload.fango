import Process
import Fail
import File
import IO
import Json exposing (Decode)
import List
import Reader
import Result exposing (Result(..))
import String

type Shipping = { city : String, postal : String, latitude : Float, longitude : Float } deriving (Decode)
type Item = { sku : String, quantity : Int, unit_cents : Int } deriving (Decode)
type Order =
    { id : Int
    , customer : String
    , active : Bool
    , total_cents : Int
    , discount : Maybe String
    , shipping : Shipping
    , tags : List String
    , items : List Item
    , description : String
    } deriving (Decode)

type Totals = { records : Int, ids : Int, cents : Int, units : Int, text_bytes : Int }

summarize : Order -> Totals -> Totals
summarize order total = Totals
    { records = total.records + 1
    , ids = total.ids + order.id
    , cents = total.cents + order.total_cents
    , units = total.units + List.foldl { item n -> n + item.quantity } 0 order.items
    , text_bytes = total.text_bytes + String.byteLength order.description
    }

main() =
    case Process.args() of
        [path] ->
            case Fail.attempt { File.withFile path { file -> Reader.over (IO.source file) { reader -> Json.read @(List Order) reader } } } of
                Err error ->
                    print (IO.describeError error)
                    Process.exit 1
                Ok result -> case result of
                    Err error ->
                        print error.message
                        Process.exit 1
                    Ok orders ->
                        total = List.foldl summarize (Totals { records = 0, ids = 0, cents = 0, units = 0, text_bytes = 0 }) orders
                        Console.write (show total.records ++ " " ++ show total.ids ++ " " ++ show total.cents ++ " " ++ show total.units ++ " " ++ show total.text_bytes ++ "\n")
        _ ->
            Console.write "usage: fango-json FILE\n"
            Process.exit 1
