import Stream
import Iterator
import State
import Scope
import Basics exposing (quotientBy)

emit : Int ->{Stream.Yield Int} ()
emit n =
    if n <= 0 then ()
    else
        Stream.yield n
        emit (n - 1)

source n = Stream.generate (\_ -> emit n)

sumCursor cursor acc = case Iterator.next cursor of
    Nothing -> acc
    Just value -> sumCursor cursor (acc + value)

build n acc = if n <= 0 then acc else build (n - 1) [n | acc]

reopen n acc =
    if n <= 0 then acc
    else reopen (n - 1) (acc + Stream.fold (\x total -> x + total) 0 (source 8))

emitState : Int ->{State.State Int, Stream.Yield Int} ()
emitState n =
    if n <= 0 then ()
    else
        State.put (State.get () + 1)
        Stream.yield n
        emitState (n - 1)

effectful n =
    result = State.run 0 (\_ ->
        values = Stream.generate (\_ -> Scope.finally (\_ -> emitState n) (\_ -> State.put (State.get () + 1000)))
        Stream.fold (\x acc -> x + acc) 0 (Stream.take (quotientBy 2 n) values))
    result.value + result.state

run : Int -> Int -> Int
run which n = case which of
    0 -> Stream.fold (\x acc -> x + acc) 0 (source n)
    1 -> Stream.withCursor (source n) (\cursor -> sumCursor cursor 0)
    2 -> Stream.fold (\x acc -> x + acc) 0 (Stream.filter (\x -> x > quotientBy 2 n) (Stream.map (\x -> x + 1) (source n)))
    3 -> Stream.fold (\x acc -> x + acc) 0 (source n |> Stream.map (\x -> x + 1) |> Stream.map (\x -> x + 1) |> Stream.map (\x -> x + 1) |> Stream.map (\x -> x + 1))
    4 -> Stream.fold (\x acc -> x + acc) 0 (Stream.fromList (build n []))
    5 -> Stream.fold (\(a, b) acc -> a + b + acc) 0 (Stream.zip (source n) (source n))
    6 -> Stream.fold (\x acc -> x + acc) 0 (Stream.take (quotientBy 2 n) (source n))
    7 -> reopen n 0
    _ -> effectful n

main() = print (run 0 1000)
