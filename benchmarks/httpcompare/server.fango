import Fail
import Process
import Async
import Bytes
import Http exposing (Body(..))
import Http.Server
import IO
import String

respond : Http.Server.Request e ->{e} Http.Server.Response e
respond _ = Http.Server.Response
    { status = 200
    , headers = []
    , body = BytesBody (Bytes.fromString "Hello, world")
    }

main() =
    case Process.args() of
        [raw] ->
            case String.toInt raw of
                Just port ->
                    print (Fail.attempt { Async.runOutcome {
                            stop = Async.channel 1
                            Http.Server.serve (Http.Server.defaultConfig port) stop respond
                    } })
                Nothing -> Process.exit 2
        _ -> Process.exit 2
