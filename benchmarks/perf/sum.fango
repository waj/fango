import List

build : Int -> List.List Int
build n = if n < 1 then [] else [n | build (n - 1)]

sum : List.List Int -> Int
sum xs =
    case xs of
        [] -> 0
        [x | rest] -> x + sum rest

loop : Int -> Int -> Int
loop i acc = if i < 1 then acc else loop (i - 1) (acc + sum (build 100000))

main = print (loop 20 0)
