import Runtime.Scope

-- Scope setup and the normal path, at fixed nesting depth: each iteration
-- acquires, uses, and releases twice, so the measurement is per-scope cost
-- rather than one handler installation amortized over a long body.

step : Int -> Int
step total =
    Runtime.Scope.bracket { _ -> total } { _ -> () } { outer ->
        Runtime.Scope.bracket { _ -> outer + 1 } { _ -> () } { inner -> inner + 1 }
    }

drive : Int -> Int -> Int
drive n total = if n <= 0 then total else drive (n - 1) (step total)

main() = print (drive 20000000 0)
