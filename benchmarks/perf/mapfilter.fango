import List

upto : Int -> List.List Int
upto n = if n < 1 then [] else [n | upto (n - 1)]

chain : Int -> Int
chain n =
    List.foldr { x acc -> x + acc } 0
        (List.map { x -> x * 3 } (List.filter { x -> x < n } (upto n)))

loop : Int -> Int -> Int
loop i acc = if i < 1 then acc else loop (i - 1) (acc + chain 30000)

main = print (loop 20 0)
