{-# no-prelude #-}
-- Random numbers as an effect.
--
-- Code that needs randomness performs `Random`; the program chooses where the
-- numbers come from by running it under `runSeeded`, for reproducible draws,
-- or `runSystem`, for fresh ones.
module Random exposing (Random(..), int, runSeeded, runSystem)

import Basics exposing (..)
import IO exposing (IO)
import Runtime.Entry
import State

-- Drawing random integers. A `main` that performs it runs under
-- `runSystem` unless it installs another runner.
#[Runtime.Entry.DefaultHandler `runSystem`]
effect Random
    -- A draw from `lo` to `hi` inclusive; reversed bounds are swapped.
    int : Int -> Int -> Int

nextState : Int -> Int
nextState state = modBy 2147483648 (1103515245 * state + 12345)

valueAt : Int -> Int -> Int -> Int
valueAt state lo hi =
    lower = if hi < lo then hi else lo
    upper = if hi < lo then lo else hi
    span = upper - lower + 1
    if span == 0 then
        lower + state
    else
        lower + modBy span state

entropySeed : () ->{IO} Int
entropySeed = native

-- Answers every draw from a deterministic generator started at `seed`, so
-- the same seed produces the same draws, in the interpreter and in compiled
-- programs alike. The generator is a 31-bit linear congruential one with
-- glibc's constants: it is modulo-biased and not suitable for cryptography. Nested runs keep separate
-- sequences.
--
-- Tasks that inherit the runner share its sequence. Each draw consumes one
-- step exactly once, so concurrent tasks never repeat a draw, but which task
-- receives which draw depends on their scheduling.
--
-- ```fango
-- import Random
--
-- roll = Random.runSeeded 7 { Random.int 1 6 }
--
-- roll >= 1 && roll <= 6
-- Random.runSeeded 7 { Random.int 1 6 } == roll
-- ```
runSeeded : Int -> (() ->{Random | e} a) ->{e} a
runSeeded seed action =
    result = State.runAtomic (Seed seed) {
        handle action() on
            int lo hi -> resume (State.update { state -> draw state lo hi })
    }
    result.value

-- The generator state, private so that no caller's own `State` handler can
-- intercept the runner's.
type Seed = Seed Int

draw : Seed -> Int -> Int -> (Int, Seed)
draw state lo hi = case state of
    Seed current ->
        next = nextState current
        (valueAt next lo hi, Seed next)

-- `runSeeded` from a seed drawn from system entropy, so every run draws a
-- fresh sequence.
runSystem : (() ->{Random | e} a) ->{IO | e} a
runSystem action = runSeeded entropySeed() action
