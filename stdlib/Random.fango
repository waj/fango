module Random exposing (Random(..), int, runSeeded, runSystem)

effect Random
    int : Int -> Int -> Int

-- The private natives share one PRNG cell in the runtime; the handler
-- wrappers below swap and restore it so nested uses behave lexically.

swapSeed : Int -> Int
swapSeed = native "fangort.RandomSwap($1)"

nextInt : Int -> Int -> Int
nextInt = native "fangort.RandomInt($1, $2)"

entropySeed : () -> Int
entropySeed = native "fangort.RandomEntropy($1)"

-- runSeeded answers every `int lo hi` draw from a deterministic generator
-- started at seed: the same seed always produces the same draws. Under the
-- current tail-resumptive restriction a handler cannot carry state of its
-- own across resumes, so the state lives in the runtime cell the natives
-- advance.
runSeeded : Int -> (() ->{Random | e} a) ->{e} a
runSeeded seed action =
    old = swapSeed seed
    result =
        handle action() of
            int lo hi -> resume (nextInt lo hi)
    restored = swapSeed old
    result

-- runSystem answers draws from a system-entropy seed: a fresh sequence on
-- every run.
runSystem : (() ->{Random | e} a) ->{e} a
runSystem action = runSeeded (entropySeed()) action
