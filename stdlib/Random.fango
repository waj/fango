module Random exposing (Random(..), int, runSeeded, runSystem)

import IO exposing (IO)

effect Random
    int : Int -> Int -> Int

nextState : Int -> Int
nextState = native

valueAt : Int -> Int -> Int -> Int
valueAt = native

entropySeed : () ->{IO} Int
entropySeed = native

-- runSeeded answers every `int lo hi` draw from a deterministic generator
-- started at seed: the same seed always produces the same draws. Under the
runSeeded : Int -> (() ->{Random | e} a) ->{e} a
runSeeded seed action =
    handle action() with current = seed of
        int lo hi ->
            next = nextState current
            resume (valueAt next lo hi) with next

-- runSystem answers draws from a system-entropy seed: a fresh sequence on
-- every run.
runSystem : (() ->{Random | e} a) ->{IO | e} a
runSystem action = runSeeded (entropySeed()) action
