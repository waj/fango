{-# no-prelude #-}
-- Reading characters from a byte reader through an encoding.
--
-- A text reader decodes a `Reader` as it reads, in UTF-8 or another
-- `Encoding`. A character split across source chunks is completed by
-- refilling; an incomplete sequence at the end of input is an error, not
-- the end of input or a replacement character. Reads that can fail on
-- malformed input perform `Fail Encoding.Error`; the `try` operations answer
-- the error as a value instead. Every read stages its work before consuming,
-- so a failure, a short exact read, or an overflow consumes nothing.
--
-- While a text reader is in use, advance its parent only through it. Leaving
-- the scope keeps every unconsumed parent byte, lookahead included. Limits
-- count characters; the byte reader may still prefetch larger chunks, so put
-- a byte-framed body in `Reader.limited` first. The `Window` operations let a
-- scanner inspect buffered text without consuming it, and commit what it used.
module Text.Reader exposing (Read(..), Reader, Window, asciiAt, atEnd, chunks, commitWindow, matchWindow, over, overWith, peekChar, peekWindow, position, readChar, readExactly, readLine, readUntil, readUpTo, readWindow, refillWindow, skipAscii, spanWindow, spanWindowUntil, tryPeekChar, tryReadChar, tryReadScalar, tryReadSpan, tryReadWhile, window, windowPosition, windowText, withString)

import Basics exposing (..)
import Bytes
import Char
import Encoding exposing (Encoding, Error(..))
import Fail exposing (Fail, fromResult)
import List
import Maybe exposing (Maybe(..))
import Reader as ByteReader
import Result exposing (Result(..))
import Runtime.Local
import Stream exposing (Stream)
import String

-- Offsets passed to at/ready and consume are bytes; only this module sees
-- them. Staging a read before consuming makes refusal and failure atomic.
type Input e =
    { at : Int ->{e} Result Encoding.Error (Maybe (Char, Int))
    , peek : () ->{e} Result Encoding.Error (Maybe Char)
    , ready : Int ->{e} Bool
    , consume : Int ->{e} ()
    , position : () ->{e} Int
    , buffered : () ->{e} Bytes.Bytes
    , refill : () ->{e} Bool
    , encoding : Encoding
    }

-- A text reader whose operations perform `e`.
type Reader e = Reader (Input e)

-- Immutable buffer storage is shared across derived positions and tokens.
-- Empty windows need no buffer object; byte decoding remains private here.
type Buffer = EmptyBuffer | Buffered Encoding Bytes.Bytes Int
-- An immutable snapshot of a reader's buffered bytes and a position in it.
-- Inspecting one never refills or consumes; positions derived from it count
-- bytes from the snapshot's start. An empty window does not mean the source
-- has ended.
type Window = { buffer : Buffer, index : Int }

-- The three distinct answers to a delimited read.
type Read
    -- The run before the delimiter, both consumed.
    = Found String
    -- The unterminated remainder at the end of input, consumed.
    | Ended String
    -- The limit was reached before either; nothing was consumed.
    | Overflowed
    deriving (Eq, Show)

-- Bytes below 128 are one-byte scalars with the same code under every bundled
-- encoding, so the common ASCII case needs no encoding dispatch. Everything
-- else, including end of window, is decided by Encoding. The window scanners
-- below repeat the check inline so their ASCII paths perform no calls.
decodeScalar : Encoding -> Bytes.Bytes -> Int -> Result Encoding.Error (Maybe (Char, Int))
decodeScalar encoding bytes offset =
    case Bytes.byteAt offset bytes of
        Just code ->
            if code < 128 then
                case Char.fromCode code of
                    Just char -> Ok (Just (char, 1))
                    Nothing -> Encoding.decodeAt encoding bytes offset
            else Encoding.decodeAt encoding bytes offset
        Nothing -> Encoding.decodeAt encoding bytes offset

inspect : Encoding -> ByteReader.Reader e -> Int -> Int ->{e} Result Encoding.Error (Maybe (Char, Int))
inspect encoding parent base offset =
    case decodeScalar encoding parent.buffered() offset of
        Ok Nothing ->
            if parent.refill() then inspect encoding parent base offset
            else Ok Nothing
        Ok value -> Ok value
        Err (IncompleteSequence _) ->
            if parent.refill() then inspect encoding parent base offset
            else Err (IncompleteSequence (base + offset))
        Err (InvalidSequence _) -> Err (InvalidSequence (base + offset))
        Err error -> Err error

peekResult result =
    case result of
        Err error -> Err error
        Ok Nothing -> Ok Nothing
        Ok (Just (char, _)) -> Ok (Just char)

readyAt encoding bytes offset =
    case decodeScalar encoding bytes offset of
        Ok Nothing -> False
        Err (IncompleteSequence _) -> False
        _ -> True

-- Runs `action` with a text reader over `parent` in `encoding`. It does not
-- close the parent.
{-# scoped s #-}
overWith : Encoding -> ByteReader.Reader e -> (Reader s ->{s} a) ->{e} a
overWith encoding parent action =
    Runtime.Local.run 0 { consumed ->
        action (Reader (Input
            { at = { offset -> inspect encoding parent consumed.read() offset }
            , peek = { peekResult (inspect encoding parent consumed.read() 0) }
            , ready = { offset -> readyAt encoding parent.buffered() offset }
            , consume = { size ->
                ignore (parent.skip size)
                consumed.write (consumed.read() + size)
              }
            , position = consumed.read
            , buffered = parent.buffered
            , refill = parent.refill
            , encoding = encoding
            }
        ))
    }

-- Runs `action` with a UTF-8 text reader over `parent`.
{-# scoped s #-}
over : ByteReader.Reader e -> (Reader s ->{s} a) ->{e} a
over parent action = overWith Encoding.utf8 parent action

-- Runs `action` with a text reader over `text` in memory. The input cannot
-- be malformed, but the reads still perform `Fail Encoding.Error`; handle it
-- around the read or the whole consumer.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Fail.attempt { Text.Reader.withString "héllo" { r -> Text.Reader.readUpTo r 2 } } == Ok "hé"
-- ```
{-# scoped s #-}
withString : String -> (Reader s ->{s} a) ->{e} a
withString text action =
    bytes = Bytes.fromString text
    Runtime.Local.run 0 { consumed ->
        action (Reader (Input
            { at = { offset -> decodeScalar Encoding.utf8 bytes (consumed.read() + offset) }
            , peek = { peekResult (decodeScalar Encoding.utf8 bytes consumed.read()) }
            , ready = { offset -> consumed.read() + offset < Bytes.length bytes }
            , consume = { size -> consumed.write (consumed.read() + size) }
            , position = consumed.read
            , buffered = { Bytes.slice consumed.read() (Bytes.length bytes) bytes }
            , refill = { False }
            , encoding = Encoding.utf8
            }
        ))
    }

-- The number of bytes consumed since the reader was created.
position : Reader e ->{e} Int
position (Reader input) = input.position()

-- The next character without consuming it, or `Nothing` at the end of
-- input. It may refill.
peekChar : Reader e ->{Fail Encoding.Error | e} Maybe Char
peekChar reader = fromResult (tryPeekChar reader)

-- `peekChar`, answering a decoding error as a value.
tryPeekChar : Reader e ->{e} Result Encoding.Error (Maybe Char)
tryPeekChar (Reader input) = input.peek()

-- `readChar`, answering a decoding error as a value.
tryReadChar : Reader e ->{e} Result Encoding.Error (Maybe Char)
tryReadChar reader = peekResult (tryReadScalar reader)

-- Consumes the next character and answers it with its encoded width in
-- bytes, or `Nothing` at the end of input. The width is in the reader's
-- encoding, which may differ from the character's UTF-8 width.
tryReadScalar : Reader e ->{e} Result Encoding.Error (Maybe (Char, Int))
tryReadScalar (Reader input) =
    case input.at 0 of
        Err error -> Err error
        Ok Nothing -> Ok Nothing
        Ok (Just (char, size)) ->
            input.consume size
            Ok (Just (char, size))

-- Consumes and answers the next character, or `Nothing` at the end of input.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Fail.attempt { Text.Reader.withString "ab" { r -> [Text.Reader.readChar r, Text.Reader.readChar r, Text.Reader.readChar r] } } == Ok [Just 'a', Just 'b', Nothing]
-- ```
readChar : Reader e ->{Fail Encoding.Error | e} Maybe Char
readChar reader = fromResult (tryReadChar reader)

-- Scan one immutable window without performing state operations per scalar.
-- A later malformed or incomplete scalar belongs to the next read, so a
-- successful prefix retains the precise position of a subsequent error.
prefixWidth : Encoding -> Bytes.Bytes -> (Char -> Bool) -> Int -> Int
prefixWidth encoding bytes keep offset =
    case Bytes.byteAt offset bytes of
        Nothing -> offset
        Just code ->
            if code < 128 then
                case Char.fromCode code of
                    Just char -> if keep char then prefixWidth encoding bytes keep (offset + 1) else offset
                    Nothing -> offset
            else
                case Encoding.decodeAt encoding bytes offset of
                    Ok (Just (char, width)) ->
                        if keep char then prefixWidth encoding bytes keep (offset + width)
                        else offset
                    _ -> offset

-- A snapshot of the bytes buffered now, without refilling or consuming.
window : Reader e ->{e} Window
window (Reader input) =
    bytes = input.buffered()
    Window
        { buffer = if Bytes.length bytes == 0 then EmptyBuffer else Buffered input.encoding bytes input.position()
        , index = 0
        }

-- The position's distance in bytes from the snapshot's start.
windowPosition : Window -> Int
windowPosition snapshot = snapshot.index

-- The character at the position and its encoded width, or `Nothing` at the
-- end of the window.
peekWindow : Window -> Result Encoding.Error (Maybe (Char, Int))
peekWindow snapshot =
    case snapshot.buffer of
        EmptyBuffer -> Ok Nothing
        Buffered encoding bytes _ -> decodeScalar encoding bytes snapshot.index

-- Scanners read most characters through here, so the ASCII path stays a
-- short sequence of small calls the Go backend inlines; every other byte
-- leaves for the decoding path in a separate function.
readWindow : Window -> Result Encoding.Error (Maybe (Char, Int, Window))
readWindow snapshot =
    case snapshot.buffer of
        EmptyBuffer -> Ok Nothing
        Buffered encoding bytes _ -> case Bytes.byteAt snapshot.index bytes of
            Nothing -> Ok Nothing
            Just code ->
                if code < 128 then case Char.fromCode code of
                    Just char -> Ok (Just (char, 1, { snapshot | index = snapshot.index + 1 }))
                    Nothing -> readDecoded encoding bytes snapshot
                else readDecoded encoding bytes snapshot

readDecoded : Encoding -> Bytes.Bytes -> Window -> Result Encoding.Error (Maybe (Char, Int, Window))
readDecoded encoding bytes snapshot =
    case Encoding.decodeAt encoding bytes snapshot.index of
        Err error -> Err error
        Ok Nothing -> Ok Nothing
        Ok (Just (char, width)) -> Ok (Just (char, width, { snapshot | index = snapshot.index + width }))

-- Grammars spelled in ASCII can branch on plain codes: every bundled encoding
-- maps bytes below 128 to the same one-byte scalars. The answer is -1 at the
-- end of the window and -2 for any other byte, valid or not.
asciiAt : Window -> Int
asciiAt snapshot =
    case snapshot.buffer of
        EmptyBuffer -> -1
        Buffered _ bytes _ -> case Bytes.byteAt snapshot.index bytes of
            Nothing -> -1
            Just code -> if code < 128 then code else -2

-- Advance past the one-byte character asciiAt answered at this position. The
-- caller has already inspected it, so the advance repeats no check.
skipAscii : Window -> Window
skipAscii snapshot = { snapshot | index = snapshot.index + 1 }

-- An exact encoded prefix of valid text can be compared in bulk without
-- decoding each scalar or materializing the source substring. A mismatch,
-- short buffer, or unrepresentable requested text leaves the view unchanged.
matchWindow : Window -> String -> Maybe Window
matchWindow snapshot text =
    if text == "" then Just snapshot
    else case snapshot.buffer of
        EmptyBuffer -> Nothing
        Buffered encoding bytes _ -> case Encoding.matchAt encoding bytes snapshot.index text of
            Nothing -> Nothing
            Just width -> Just { snapshot | index = snapshot.index + width }

-- The longest valid prefix at the position whose characters satisfy `keep`,
-- with its width in bytes and the position after it. A malformed or
-- incomplete character ends the prefix; the next read at that position
-- reports it.
spanWindow : Window -> (Char -> Bool) -> Result Encoding.Error (String, Int, Window)
spanWindow snapshot keep =
    case peekWindow snapshot of
        Err error -> Err error
        Ok _ ->
            case snapshot.buffer of
                EmptyBuffer -> Ok ("", 0, snapshot)
                Buffered encoding bytes _ ->
                    end = prefixWidth encoding bytes keep snapshot.index
                    case Encoding.decode encoding (Bytes.slice snapshot.index end bytes) of
                        Err error -> Err error
                        Ok text -> Ok (text, end - snapshot.index, { snapshot | index = end })

-- The span contract of spanWindow for a fixed set of ASCII stops. The run
-- is found and validated in one pass, without a predicate call per byte.
spanWindowUntil : Window -> Encoding.AsciiSet -> Result Encoding.Error (String, Int, Window)
spanWindowUntil snapshot stops =
    case peekWindow snapshot of
        Err error -> Err error
        Ok _ ->
            case snapshot.buffer of
                EmptyBuffer -> Ok ("", 0, snapshot)
                Buffered encoding bytes _ ->
                    end = Encoding.spanUntil encoding stops bytes snapshot.index
                    case Encoding.decode encoding (Bytes.slice snapshot.index end bytes) of
                        Err error -> Err error
                        Ok text -> Ok (text, end - snapshot.index, { snapshot | index = end })

-- The text between two positions derived from the same snapshot, `start`
-- first.
windowText : Window -> Window -> Result Encoding.Error String
windowText start end =
    case start.buffer of
        EmptyBuffer -> Ok ""
        Buffered encoding bytes _ -> Encoding.decode encoding (Bytes.slice start.index end.index bytes)

-- Publish only the newly consumed prefix. Derived positions from one window
-- may be committed repeatedly, in increasing order, on their original reader.
commitWindow : Reader e -> Window ->{e} ()
commitWindow (Reader input) snapshot =
    case snapshot.buffer of
        EmptyBuffer -> ()
        Buffered _ _ base ->
            width = base + snapshot.index - input.position()
            if width > 0 then input.consume width else ()

-- Reconcile consumption before growing the parent buffer. A False result is
-- proof of source EOF, unlike an empty immutable window. Incomplete scalars
-- remain in the parent and can be completed by the next chunk.
refillWindow : Reader e -> Window ->{e} (Window, Bool)
refillWindow reader snapshot =
    commitWindow reader snapshot
    Reader input = reader
    grew = input.refill()
    (window reader, grew)

-- Consumes and answers the longest prefix of characters satisfying `keep`
-- among those available. It waits for the first complete character, then
-- stops at the current buffer boundary or the first rejected character,
-- without pulling more input to extend the prefix. An empty answer means
-- the end of input or a rejected first character. A valid prefix before
-- malformed input succeeds; the next call reports the error.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Text.Reader.withString "abc1" { r -> Text.Reader.tryReadWhile r { c -> c /= '1' } } == Ok "abc"
-- ```
tryReadWhile : Reader e -> (Char -> Bool) ->{e} Result Encoding.Error String
tryReadWhile reader keep =
    case tryReadSpan reader keep of
        Err error -> Err error
        Ok (text, _) -> Ok text

-- `tryReadWhile`, also answering the number of bytes consumed in the
-- reader's encoding.
tryReadSpan : Reader e -> (Char -> Bool) ->{e} Result Encoding.Error (String, Int)
tryReadSpan (Reader input) keep =
    case input.at 0 of
        Err error -> Err error
        Ok _ ->
            bytes = input.buffered()
            width = prefixWidth input.encoding bytes keep 0
            case Encoding.decode input.encoding (Bytes.slice 0 width bytes) of
                Err error -> Err error
                Ok text ->
                    if width > 0 then input.consume width else ()
                    Ok (text, width)

-- Whether no characters remain.
atEnd : Reader e ->{Fail Encoding.Error | e} Bool
atEnd reader = peekChar reader == Nothing

finish : Input e -> Int -> List.List Char ->{e} String
finish input offset reverse =
    input.consume offset
    String.fromList (List.reverse reverse)

upTo : Input e -> Int -> Int -> List.List Char ->{Fail Encoding.Error | e} String
upTo input remaining offset reverse =
    if remaining <= 0 || (offset > 0 && input.ready offset == False) then
        finish input offset reverse
    else case fromResult (input.at offset) of
        Nothing -> finish input offset reverse
        Just (char, size) -> upTo input (remaining - 1) (offset + size) [char | reverse]

-- Consumes and answers at most `count` characters. It waits for the first
-- complete character, then answers those already available without waiting
-- to fill the count. A short answer is not the end of input; an empty one
-- is, unless `count` is zero or less.
readUpTo : Reader e -> Int ->{Fail Encoding.Error | e} String
readUpTo (Reader input) count = upTo input count 0 []

exactly : Input e -> Int -> Int -> List.List Char ->{Fail Encoding.Error | e} Maybe String
exactly input remaining offset reverse =
    if remaining <= 0 then Just (finish input offset reverse)
    else case fromResult (input.at offset) of
        Nothing -> Nothing
        Just (char, size) -> exactly input (remaining - 1) (offset + size) [char | reverse]

-- Consumes and answers exactly `count` characters, or `Nothing`, consuming
-- nothing, when fewer remain. A count of zero or less answers `Just ""`.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Fail.attempt { Text.Reader.withString "héllo" { r -> Text.Reader.readExactly r 2 } } == Ok (Just "hé")
-- Fail.attempt { Text.Reader.withString "hé" { r -> Text.Reader.readExactly r 3 } } == Ok Nothing
-- ```
readExactly : Reader e -> Int ->{Fail Encoding.Error | e} Maybe String
readExactly (Reader input) count = exactly input count 0 []

reverseChars text reverse =
    case String.uncons text of
        Nothing -> reverse
        Just part -> reverseChars part.rest [part.first | reverse]

prefix expected actual =
    case expected of
        [] -> True
        [char | rest] -> case actual of
            [] -> False
            [got | tail] -> char == got && prefix rest tail

drop count values =
    if count <= 0 then values
    else case values of
        [] -> []
        [_ | rest] -> drop (count - 1) rest

until : Input e -> List.List Char -> Int -> Int -> Int -> Int -> List.List Char ->{Fail Encoding.Error | e} Read
until input delimiter delimiterLength limit count offset reverse =
    if prefix delimiter reverse then
        input.consume offset
        Found (String.fromList (List.reverse (drop delimiterLength reverse)))
    else if count >= limit then Overflowed
    else case fromResult (input.at offset) of
        Nothing -> Ended (finish input offset reverse)
        Just (char, size) -> until input delimiter delimiterLength limit (count + 1) (offset + size) [char | reverse]

-- Reads up to `delimiter`, consuming it without answering it. `limit` counts
-- the characters of the run and delimiter together; a limit of zero or less
-- always overflows. A delimiter may span source chunks.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Fail.attempt { Text.Reader.withString "k=v" { r -> Text.Reader.readUntil r "=" 10 } } == Ok (Text.Reader.Found "k")
-- Fail.attempt { Text.Reader.withString "kv" { r -> Text.Reader.readUntil r "=" 10 } } == Ok (Text.Reader.Ended "kv")
-- Fail.attempt { Text.Reader.withString "kv=" { r -> Text.Reader.readUntil r "=" 2 } } == Ok Text.Reader.Overflowed
-- ```
readUntil : Reader e -> String -> Int ->{Fail Encoding.Error | e} Read
readUntil (Reader input) delimiter limit =
    if limit <= 0 then Overflowed
    else until input (reverseChars delimiter []) (String.length delimiter) limit 0 0 []

-- Reads a line, dropping its line feed and a carriage return right before
-- it; any other carriage return is content. The limit counts the actual
-- terminator, so CRLF counts as two.
--
-- ```fango
-- import Fail
-- import Result exposing (Result(..))
-- import Text.Reader
--
-- Fail.attempt { Text.Reader.withString "a\r\nb" { r -> [Text.Reader.readLine r 10, Text.Reader.readLine r 10] } } == Ok [Text.Reader.Found "a", Text.Reader.Ended "b"]
-- ```
readLine : Reader e -> Int ->{Fail Encoding.Error | e} Read
readLine reader limit =
    case readUntil reader "\n" limit of
        Found text ->
            size = String.length text
            Found (if String.slice (size - 1) size text == "\r" then String.slice 0 (size - 1) text else text)
        other -> other

chunkStep reader _ =
    text = readUpTo reader 9223372036854775807
    if text == "" then Nothing else Just (text, ())

-- The rest of the input as a stream of nonempty strings of whole
-- characters. Its boundaries may differ from the source's chunks.
-- Traversing it advances the reader.
chunks : Reader e -> Stream () String {Fail Encoding.Error | e}
chunks reader = Stream.unfold () (chunkStep reader)
