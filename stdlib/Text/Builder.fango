{-# no-prelude #-}
-- Text assembled by appending.
--
-- A builder is immutable: appending returns a new builder and leaves the old
-- one answering exactly the text it had, whichever builders extend it, in
-- whatever order, and from whichever tasks. Appending in sequence costs
-- amortized time proportional to the text appended.
module Text.Builder exposing (Builder, append, appendChar, empty, isEmpty, toString)

import Basics exposing (..)
import Char
import Maybe exposing (Maybe(..))
import Runtime.Native
import String

{- Text assembled by appending, as an immutable value.

Successive versions share one growable buffer and each records its own
length. An append extends the buffer in place only when the version it
extends is the buffer's newest; otherwise it copies that version's prefix
into a fresh buffer. Bytes below a version's length are never rewritten, so
every version, old or new, keeps answering exactly its own text. -}

type Buffer = Buffer Runtime.Native.Any

-- Text built by appending. Builders have no equality or display; compare or
-- show their `toString`.
type Builder = Builder (Maybe Buffer) Int

-- The natives hold UTF-8 bytes; lengths are byte counts.
newBuffer : String -> Buffer
newBuffer = native

extendBuffer : Buffer -> Int -> String -> Buffer
extendBuffer = native

newBufferChar : Char -> Buffer
newBufferChar = native

extendBufferChar : Buffer -> Int -> Char -> Buffer
extendBufferChar = native

bufferText : Buffer -> Int -> String
bufferText = native

charWidth : Char -> Int
charWidth char =
    code = Char.toCode char
    if code < 128 then 1 else if code < 2048 then 2 else if code < 65536 then 3 else 4

-- The builder holding no text.
empty : Builder
empty = Builder Nothing 0

-- The builder with `text` appended. Extending the most recently extended
-- builder reuses its storage; extending an older one copies its text first.
--
-- ```fango
-- import Text.Builder
--
-- base = Text.Builder.append Text.Builder.empty "a"
-- left = Text.Builder.append base "b"
-- right = Text.Builder.append base "c"
--
-- Text.Builder.toString left == "ab"
-- Text.Builder.toString right == "ac"
-- Text.Builder.toString base == "a"
-- ```
append : Builder -> String -> Builder
append (Builder buffer size) text =
    if text == "" then Builder buffer size
    else case buffer of
        Nothing -> Builder (Just (newBuffer text)) (String.byteLength text)
        Just shared -> Builder (Just (extendBuffer shared size text)) (size + String.byteLength text)

-- The builder with one character appended.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.toString (Text.Builder.appendChar (Text.Builder.append Text.Builder.empty "o") 'k') == "ok"
-- ```
appendChar : Builder -> Char -> Builder
appendChar (Builder buffer size) char =
    case buffer of
        Nothing -> Builder (Just (newBufferChar char)) (charWidth char)
        Just shared -> Builder (Just (extendBufferChar shared size char)) (size + charWidth char)

-- Whether the builder holds no text.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.isEmpty Text.Builder.empty
-- Text.Builder.isEmpty (Text.Builder.append Text.Builder.empty "")
-- ```
isEmpty : Builder -> Bool
isEmpty (Builder _ size) = size == 0

-- The text the builder holds, copied once.
toString : Builder -> String
toString (Builder buffer size) =
    case buffer of
        Nothing -> ""
        Just shared -> bufferText shared size
