{-# no-prelude #-}
-- Text assembled by appending.
--
-- A builder is immutable: appending returns a new builder and leaves the old
-- one answering exactly the text it had, whichever builders extend it, in
-- whatever order, and from whichever tasks. Appending in sequence costs
-- amortized time proportional to the text appended.
--
-- Append operations take the text or scalar first and the builder last, so
-- they compose with `|>`.
--
-- ```fango
-- import Text.Builder
--
-- built = Text.Builder.empty |> Text.Builder.append "foo" |> Text.Builder.appendInt 123
-- Text.Builder.toString built == "foo123"
-- ```
module Text.Builder exposing (Builder, append, appendChar, appendCharLiteral, appendFloat, appendInt, appendStringLiteral, charLiteral, charToString, empty, floatToString, intToString, isEmpty, stringLiteral, toString)

import Runtime.Native

{- The native buffer has fixed backing storage and an atomic append frontier.
Each version keeps its own byte length. Native append reserves unused tail
storage or copies that version's prefix into fresh storage; published bytes are
never rewritten. Appends and reads need no mutex, even across tasks.
This foundational module deliberately does not depend on Basics. -}

-- Text built by appending. Builders have no equality or display; compare or
-- show their `toString`.
type Builder = Builder Runtime.Native.Any Int

emptyBuffer : () -> Runtime.Native.Any
emptyBuffer = native

zero : () -> Int
zero = native

bufferAppend : Runtime.Native.Any -> Int -> String -> Runtime.Native.Any
bufferAppend = native

bufferAppendChar : Runtime.Native.Any -> Int -> Char -> Runtime.Native.Any
bufferAppendChar = native

bufferAppendInt : Runtime.Native.Any -> Int -> Int -> Runtime.Native.Any
bufferAppendInt = native

bufferAppendFloat : Runtime.Native.Any -> Int -> Float -> Runtime.Native.Any
bufferAppendFloat = native

bufferLength : Runtime.Native.Any -> Int
bufferLength = native

bufferText : Runtime.Native.Any -> Int -> String
bufferText = native

sizeIsEmpty : Int -> Bool
sizeIsEmpty = native "$1 == 0"

textIsEmpty : String -> Bool
textIsEmpty "" = True
textIsEmpty _ = False

-- The builder holding no text.
empty : Builder
empty = Builder emptyBuffer() zero()

-- The builder with `text` appended. Extending the most recently extended
-- builder reuses available storage; extending an older one copies its text.
--
-- ```fango
-- import Text.Builder
--
-- base = Text.Builder.append "a" Text.Builder.empty
-- left = Text.Builder.append "b" base
-- right = Text.Builder.append "c" base
--
-- Text.Builder.toString left == "ab"
-- Text.Builder.toString right == "ac"
-- Text.Builder.toString base == "a"
-- ```
append : String -> Builder -> Builder
append text (Builder buffer size) =
    if textIsEmpty text then Builder buffer size
    else
        next = bufferAppend buffer size text
        Builder next (bufferLength next)

-- The builder with one character appended.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.toString (Text.Builder.appendChar 'k' (Text.Builder.append "o" Text.Builder.empty)) == "ok"
-- ```
appendChar : Char -> Builder -> Builder
appendChar char (Builder buffer size) =
    next = bufferAppendChar buffer size char
    Builder next (bufferLength next)

-- The builder with an integer's decimal display appended without an
-- intermediate string.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.toString (Text.Builder.appendInt (-42) Text.Builder.empty) == "-42"
-- ```
appendInt : Int -> Builder -> Builder
appendInt value (Builder buffer size) =
    next = bufferAppendInt buffer size value
    Builder next (bufferLength next)

-- The builder with a float's display appended without an intermediate string.
-- Its spelling is the same as `show`: shortest round-trip decimals, unpadded
-- exponents outside the ordinary decimal range, `Infinity`, and `NaN`.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.toString (Text.Builder.appendFloat 1.25 Text.Builder.empty) == "1.25"
-- ```
appendFloat : Float -> Builder -> Builder
appendFloat value (Builder buffer size) =
    next = bufferAppendFloat buffer size value
    Builder next (bufferLength next)

-- Whether the builder holds no text.
--
-- ```fango
-- import Text.Builder
--
-- Text.Builder.isEmpty Text.Builder.empty
-- Text.Builder.isEmpty (Text.Builder.append "" Text.Builder.empty)
-- ```
isEmpty : Builder -> Bool
isEmpty (Builder _ size) = sizeIsEmpty size

-- The text the builder holds, copied once.
toString : Builder -> String
toString (Builder buffer size) = bufferText buffer size

bufferAppendStringLiteral : Runtime.Native.Any -> Int -> String -> Runtime.Native.Any
bufferAppendStringLiteral = native

-- Appends the quoted, escaped source representation of a String, without an
-- intermediate string. Its spelling agrees with `show`.
appendStringLiteral : String -> Builder -> Builder
appendStringLiteral value (Builder buffer size) =
    next = bufferAppendStringLiteral buffer size value
    Builder next (bufferLength next)

bufferAppendCharLiteral : Runtime.Native.Any -> Int -> Char -> Runtime.Native.Any
bufferAppendCharLiteral = native

-- Appends the quoted, escaped source representation of a Char, without an
-- intermediate string. Its spelling agrees with `show`.
appendCharLiteral : Char -> Builder -> Builder
appendCharLiteral value (Builder buffer size) =
    next = bufferAppendCharLiteral buffer size value
    Builder next (bufferLength next)

-- The decimal representation of an integer, without allocating a builder.
intToString : Int -> String
intToString = native

-- The float representation used by `appendFloat`, without allocating a builder.
floatToString : Float -> String
floatToString = native

-- A string containing one character, without quoting or escaping.
charToString : Char -> String
charToString = native

-- The quoted, escaped source representation of a string, including escaping `#{`.
stringLiteral : String -> String
stringLiteral = native

-- The quoted, escaped source representation of a character.
charLiteral : Char -> String
charLiteral = native
