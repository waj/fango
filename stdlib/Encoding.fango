{-# no-prelude #-}
-- Character encodings: converting between text and bytes.
--
-- UTF-8 and Latin-1 are supported. Neither encoding normalizes text, detects
-- an encoding, removes a byte order mark, or converts newlines; a UTF-8 byte
-- order mark decodes to U+FEFF. Byte offsets are zero-based and relative to
-- the bytes given. `Bytes.toStringLossy` decodes UTF-8 with replacement
-- instead of failing.
module Encoding exposing (AsciiSet, Encoding, Error(..), asciiSet, decode, decodeAt, encode, latin1, matchAt, message, spanUntil, utf8)

import Basics exposing (..)
import Bytes exposing (Bytes)
import Char
import List
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String

-- A character encoding: `utf8` or `latin1`.
type Encoding = Utf8 | Latin1

-- Why text could not be decoded or encoded.
type Error
    -- A malformed sequence starts at this byte offset. For UTF-8 that
    -- includes overlong forms, surrogates, and values above U+10FFFF.
    = InvalidSequence Int
    -- A valid but unfinished sequence starts at this byte offset at the end
    -- of the input; more bytes may complete it.
    | IncompleteSequence Int
    -- This character has no encoding in the selected encoding.
    | Unrepresentable Char
    deriving (Eq, Show)

-- UTF-8, the encoding adapters use when none is given. Decoding rejects
-- malformed sequences; encoding always succeeds, since a `String` is valid
-- text.
utf8 : Encoding
utf8 = Utf8

-- Latin-1 (ISO 8859-1): each byte is the character with the same code.
-- Every byte sequence decodes; only U+0000 to U+00FF encode.
latin1 : Encoding
latin1 = Latin1

-- A sentence describing the error, for reporting.
--
-- ```fango
-- import Bytes
-- import Encoding exposing (Error(..))
-- import Result exposing (Result(..))
--
-- Encoding.message (InvalidSequence 3) == "Invalid encoded sequence at byte 3"
-- ```
message : Error -> String
message error =
    case error of
        InvalidSequence offset -> "Invalid encoded sequence at byte " ++ show offset
        IncompleteSequence offset -> "Incomplete encoded sequence at byte " ++ show offset
        Unrepresentable char -> "Character is not representable in the selected encoding: " ++ show char

-- The native returns a scalar, or -1 (end), -2 (invalid), -3 (incomplete).
utf8CodeAt : Bytes -> Int -> Int
utf8CodeAt = native

width : Int -> Int
width code = if code < 128 then 1 else if code < 2048 then 2 else if code < 65536 then 3 else 4

-- The character encoded at byte `offset` and its width in bytes, without
-- consuming anything; `Ok Nothing` when the offset is outside the bytes. An
-- offset inside a UTF-8 sequence is invalid. An `IncompleteSequence` may
-- decode once more bytes are appended.
--
-- ```fango
-- import Bytes
-- import Encoding exposing (Error(..))
-- import Result exposing (Result(..))
--
-- Encoding.decodeAt Encoding.utf8 (Bytes.fromString "é!") 0 == Ok (Just ('é', 2))
-- Encoding.decodeAt Encoding.utf8 (Bytes.fromString "é!") 1 == Err (InvalidSequence 1)
-- Encoding.decodeAt Encoding.utf8 (Bytes.fromString "a") 1 == Ok Nothing
-- ```
decodeAt : Encoding -> Bytes -> Int -> Result Error (Maybe (Char, Int))
decodeAt encoding bytes offset =
    code =
        case encoding of
            Utf8 -> utf8CodeAt bytes offset
            Latin1 -> case Bytes.byteAt offset bytes of
                Nothing -> -1
                Just byte -> byte
    if code == -1 then Ok Nothing
    else if code == -2 then Err (InvalidSequence offset)
    else if code == -3 then Err (IncompleteSequence offset)
    else
        case Char.fromCode code of
            Nothing -> Err (InvalidSequence offset)
            Just char -> Ok (Just ( char, case encoding of
                                      Utf8 -> width code
                                      Latin1 -> 1
                                  ))

decodeHelp encoding bytes offset reverse =
    case decodeAt encoding bytes offset of
        Err error -> Err error
        Ok Nothing -> Ok (String.fromList (List.reverse reverse))
        Ok (Just (char, size)) -> decodeHelp encoding bytes (offset + size) [char | reverse]

-- The text the bytes encode, or the first error in them.
--
-- ```fango
-- import Bytes
-- import Encoding exposing (Error(..))
-- import Result exposing (Result(..))
--
-- Encoding.decode Encoding.utf8 (Bytes.fromList [104, 105]) == Ok "hi"
-- Encoding.decode Encoding.utf8 (Bytes.fromList [104, 255]) == Err (InvalidSequence 1)
-- Encoding.decode Encoding.utf8 (Bytes.fromList [104, 226, 130]) == Err (IncompleteSequence 1)
-- Encoding.decode Encoding.latin1 (Bytes.fromList [233]) == Ok "é"
-- ```
decode : Encoding -> Bytes -> Result Error String
decode encoding bytes =
    case encoding of
        Utf8 -> case Bytes.toString bytes of
            Just text -> Ok text
            Nothing -> decodeHelp encoding bytes 0 []
        Latin1 -> decodeHelp encoding bytes 0 []

latin1Help text reverse =
    case String.uncons text of
        Nothing -> Ok (Bytes.fromList (List.reverse reverse))
        Just part ->
            code = Char.toCode part.first
            if code > 255 then Err (Unrepresentable part.first)
            else latin1Help part.rest [code | reverse]

-- The bytes encoding the text, or `Unrepresentable` with the first
-- character the encoding cannot represent.
--
-- ```fango
-- import Bytes
-- import Encoding exposing (Error(..))
-- import Result exposing (Result(..))
--
-- Encoding.encode Encoding.latin1 "é" == Ok (Bytes.fromList [233])
-- Encoding.encode Encoding.latin1 "a€" == Err (Unrepresentable '€')
-- ```
encode : Encoding -> String -> Result Error Bytes
encode encoding text =
    case encoding of
        Utf8 -> Ok (Bytes.fromString text)
        Latin1 -> latin1Help text []

-- The native compares text's own UTF-8 bytes in place, so matching a known
-- spelling allocates nothing.
utf8MatchAt : Bytes -> Int -> String -> Bool
utf8MatchAt = native

-- The encoded width of `text` when its encoding occurs in `bytes` at
-- `offset`, or `Nothing`. Text the encoding cannot represent, and an offset
-- outside the bytes, never match; empty text matches at any offset from zero
-- through the length. Bytes after the match are not inspected.
--
-- ```fango
-- import Bytes
-- import Encoding exposing (Error(..))
-- import Result exposing (Result(..))
--
-- Encoding.matchAt Encoding.utf8 (Bytes.fromString "key: v") 0 "key" == Just 3
-- Encoding.matchAt Encoding.utf8 (Bytes.fromString "key: v") 1 "key" == Nothing
-- ```
matchAt : Encoding -> Bytes -> Int -> String -> Maybe Int
matchAt encoding bytes offset text =
    case encoding of
        Utf8 -> if utf8MatchAt bytes offset text then Just (String.byteLength text) else Nothing
        Latin1 -> case latin1Help text [] of
            Err _ -> Nothing
            Ok expected ->
                if Bytes.startsWith expected (Bytes.slice offset (Bytes.length bytes) bytes) then Just (Bytes.length expected)
                else Nothing

-- One byte per ASCII code, nonzero for members. Bytes at or above 128 are
-- never members, so a set describes stops only within ASCII.

-- A set of ASCII characters, built once by `asciiSet` and used by
-- `spanUntil` to find where a run of text stops.
type AsciiSet = AsciiSet Bytes

asciiCodes : (Char -> Bool) -> Int -> List.List Int -> List.List Int
asciiCodes member code flags =
    if code < 0 then flags
    else
        flag = case Char.fromCode code of
            Just char -> if member char then 1 else 0
            Nothing -> 0
        asciiCodes member (code - 1) [flag | flags]

-- The ASCII characters that satisfy `member`. It calls `member` once per
-- ASCII code while building the set and never afterwards, so build a set
-- outside a scanning loop. Characters at or above U+0080 are never members.
asciiSet : (Char -> Bool) -> AsciiSet
asciiSet member = AsciiSet (Bytes.fromList (asciiCodes member 127 []))

utf8SpanUntil : Bytes -> Bytes -> Int -> Int
utf8SpanUntil = native

latin1SpanUntil : Bytes -> Bytes -> Int -> Int
latin1SpanUntil table bytes offset =
    case Bytes.byteAt offset bytes of
        Nothing -> offset
        Just code ->
            if code >= 128 || Bytes.byteAt code table == Just 0 then latin1SpanUntil table bytes (offset + 1)
            else offset

-- The end of the longest run of complete, valid characters from `offset`
-- that contains no member of `stops`. A malformed or incomplete sequence
-- ends the run, as does the end of the bytes; an offset outside the bytes
-- is returned unchanged.
--
-- ```fango
-- import Bytes
-- import Encoding
--
-- stops = Encoding.asciiSet { c -> c == ',' }
--
-- Encoding.spanUntil Encoding.utf8 stops (Bytes.fromString "ab,c") 0 == 2
-- Encoding.spanUntil Encoding.utf8 stops (Bytes.fromString "ab,c") 3 == 4
-- ```
spanUntil : Encoding -> AsciiSet -> Bytes -> Int -> Int
spanUntil encoding (AsciiSet table) bytes offset =
    if offset < 0 || offset >= Bytes.length bytes then offset
    else case encoding of
        Utf8 -> utf8SpanUntil table bytes offset
        Latin1 -> latin1SpanUntil table bytes offset
