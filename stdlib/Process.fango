{-# no-prelude #-}
-- The running program's arguments and exit status. The prelude does not
-- expose it; import `Process`.
module Process exposing (args, exit)

import Basics exposing (..)
import IO exposing (IO)
import List exposing (List)

argCount : () ->{IO} Int
argCount = native

argAt : Int ->{IO} String
argAt = native

-- Ends the program at once with the given status. In the interpreter or the
-- REPL it ends the program without ending the session.
exit : Int ->{IO} ()
exit = native

argsFrom : Int -> Int ->{IO} List String
argsFrom index count =
    if index >= count then
        []
    else
        [argAt index | argsFrom (index + 1) count]

-- The program's command-line arguments, without the program name. `fango
-- run` passes every argument after the source file.
args : () ->{IO} List String
args() = argsFrom 0 argCount()
