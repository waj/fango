{-# no-prelude #-}
-- The derivers for the standard classes: `deriving (Eq, Ord, Show)` uses
-- them. They are ordinary `deriver` declarations, which is how any library
-- opens `deriving` to its own class; see `Meta`.
--
-- Derived `Eq` compares constructors and then fields; derived `Ord` orders
-- constructors by declaration position and then fields left to right; derived
-- `Show` writes a constructor applied to its arguments, or a record's
-- fields, with arguments parenthesized where juxtaposition would misread
-- them. The module exports nothing to import.
module Derive exposing ()

import Basics exposing (..)
import Meta exposing (Bound(..), BoundField(..), Code, Ctor(..), Field(..), Items(..), Lift(..), Shape(..), TypeInfo(..))
import Text.Builder as Builder

{- `deriving (Eq)` runs the `deriver Eq` block below: the compiler hands it the
type's schema plus one `Code` per method parameter, and it answers with the
method's body. Nothing here is privileged — this module is what any library
writes to open `deriving` to its own class.

Derive sits above Meta and Basics and below everything else. A module that
uses `deriving` depends on it, which is how the standard derivers are in
scope for `List` and `Maybe`, neither of which imports anything. -}

-- Small quoted fragments, composed rather than written as one large quote.
-- Each keeps the span it was written with, so a type error in a derived
-- method points at the line here that generated it.

appendCode : Code -> Code -> Code
appendCode built text = `Builder.append $(text) $(built)`

showCode : Code -> Code -> Code
showCode built value = `showTo $(built) $(value)`

showArgCode : Code -> Code -> Code
showArgCode built value = `showArgTo $(built) $(value)`

equalsCode : Code -> Code -> Code
equalsCode lhs rhs = `$(lhs) == $(rhs)`

lessCode : Code -> Code -> Code
lessCode lhs rhs = `$(lhs) < $(rhs)`

ifCode : Code -> Code -> Code -> Code
ifCode condition yes no = `if $(condition) then $(yes) else $(no)`

-- Eq: constructors must agree, then every field pair must.

eqFields : Items BoundField -> Items BoundField -> Code
eqFields lhs rhs =
    case lhs of
        NoItems -> lift True
        Item lhsField lhsRest ->
            case rhs of
                NoItems -> lift True
                Item rhsField rhsRest -> ifCode (equalsCode lhsField.value rhsField.value) (eqFields lhsRest rhsRest) (lift False)

eqBound : Bound -> Bound -> Code
eqBound lhs rhs =
    if lhs.ctor.index == rhs.ctor.index then
        eqFields lhs.fields rhs.fields
    else
        lift False

deriver Eq
    (==) subject leftCode rightCode =
        Meta.match subject leftCode { lhs -> Meta.match subject rightCode { rhs -> eqBound lhs rhs } }

-- Show: a union constructor prints its name then its fields in argument
-- position; a record prints its type name then `field = value` pairs, whose
-- values the braces and commas already delimit. As an argument itself, a
-- constructor with fields or a record is parenthesized.

unionShow : Code -> Bound -> Code
unionShow built bound =
    Meta.foldItems
        { sofar field -> showArgCode (appendCode sofar (lift " ")) field.value }
        (appendCode built (lift bound.ctor.name))
        bound.fields

recordShow : Code -> Bound -> Code
recordShow built bound =
    appendCode
        (Meta.foldItems
            { sofar field ->
                showCode
                    (appendCode sofar (lift ((if field.index == 0 then " " else ", ") ++ field.name ++ " = ")))
                    field.value
            }
            (appendCode built (lift (bound.ctor.name ++ " {")))
            bound.fields
        )
        (lift " }")

showBound : Code -> TypeInfo -> Bound -> Code
showBound built subject bound =
    case subject.shape of
        Record _ -> recordShow built bound
        Union _ -> unionShow built bound

showArgBound : Code -> TypeInfo -> Bound -> Code
showArgBound built subject bound =
    case subject.shape of
        Record _ -> appendCode (recordShow (appendCode built (lift "(")) bound) (lift ")")
        Union _ ->
            case bound.fields of
                NoItems -> unionShow built bound
                Item _ _ -> appendCode (unionShow (appendCode built (lift "(")) bound) (lift ")")

deriver Show
    showTo subject builtCode valueCode =
        Meta.match subject valueCode { bound -> showBound builtCode subject bound }
    showArgTo subject builtCode valueCode =
        Meta.match subject valueCode { bound -> showArgBound builtCode subject bound }

-- Ord: constructors order by declaration position, then fields
-- lexicographically. The three outcomes — less, greater, and equal — are what
-- separate the four methods, so one generator serves all of them.

ordFields : Bool -> Bool -> Bool -> Items BoundField -> Items BoundField -> Code
ordFields whenLess whenGreater whenEqual lhs rhs =
    case lhs of
        NoItems -> lift whenEqual
        Item lhsField lhsRest ->
            case rhs of
                NoItems -> lift whenEqual
                Item rhsField rhsRest ->
                    ifCode (lessCode lhsField.value rhsField.value) (lift whenLess)
                        (ifCode (lessCode rhsField.value lhsField.value) (lift whenGreater)
                            (ordFields whenLess whenGreater whenEqual lhsRest rhsRest)
                        )

ordBound : Bool -> Bool -> Bool -> Bound -> Bound -> Code
ordBound whenLess whenGreater whenEqual lhs rhs =
    if lhs.ctor.index < rhs.ctor.index then
        lift whenLess
    else if lhs.ctor.index > rhs.ctor.index then
        lift whenGreater
    else
        ordFields whenLess whenGreater whenEqual lhs.fields rhs.fields

ordering : Bool -> Bool -> Bool -> TypeInfo -> Code -> Code -> Code
ordering whenLess whenGreater whenEqual subject leftCode rightCode =
    Meta.match subject leftCode
        { lhs -> Meta.match subject rightCode { rhs -> ordBound whenLess whenGreater whenEqual lhs rhs } }

deriver Ord
    (<) subject leftCode rightCode = ordering True False False subject leftCode rightCode
    (>) subject leftCode rightCode = ordering False True False subject leftCode rightCode
    (<=) subject leftCode rightCode = ordering True False True subject leftCode rightCode
    (>=) subject leftCode rightCode = ordering False True True subject leftCode rightCode
