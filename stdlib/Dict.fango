{-# no-prelude #-}
-- Immutable dictionaries ordered by key.
--
-- A `Dict k v` maps keys of any `Ord` type to values. Operations that find a
-- key need `Ord k`; the rest never compare keys and take no constraint.
-- Traversals visit keys in ascending order, except `foldr`, which descends,
-- and callbacks run in that order.
--
-- `size` and `isEmpty` are constant time; `get`, `member`, `insert`,
-- `remove`, and `update` are logarithmic; `keys`, `values`, `toList`, the
-- folds, and `map` are linear; `fromList` is `n log n`. An update shares every
-- node off its search path rather than copying the dictionary.
module Dict exposing
    ( Dict
    , empty, foldl, foldr, fromList, get, insert, isEmpty, keys, map, member
    , remove, singleton, size, toList, update, values
    )

import Basics exposing (..)
import List exposing (List)
import Maybe exposing (Maybe(..))
import Tuple exposing (Pair(..), Triple(..))

-- A weight-balanced search tree, the shape Haskell's Data.Map uses. Every Bin
-- caches the size of the subtree rooted at it, so size is O(1) and balance can
-- decide rotations arithmetically.
--
-- Dict is exported without its constructors: the balance invariant is this
-- module's to hold, and an exposed Bin would let a caller hand balance a lie.
--
-- For every Bin n key value left right:
--   1. n == 1 + size left + size right;
--   2. every key in left is < key and every key in right is > key, where
--      "equivalent" means neither < holds in either direction; and
--   3. either size left + size right <= 1, or neither subtree exceeds delta
--      times the other.

-- A dictionary from keys `k` to values `v`. Its representation is private.
-- Dictionaries are equal when they hold the same entries, whatever order
-- they were built in, and display their entries in key order.
--
-- ```fango
-- import Dict exposing (Dict)
--
-- none : Dict Int String
-- none = Dict.empty
--
-- Dict.fromList [(2, "b"), (1, "a")] == Dict.fromList [(1, "a"), (2, "b")]
-- show (Dict.fromList [(2, "b"), (1, "a")]) == "Dict [1 = \"a\", 2 = \"b\"]"
-- show none == "Dict []"
-- ```
type Dict k v = Tip | Bin Int k v (Dict k v) (Dict k v)

-- delta bounds the size ratio between siblings; ratio picks a single rotation
-- over a double one. (3, 2) on element counts is Data.Map's pair, verified for
-- insertion and deletion together. Retuning them invalidates that.
delta : Int
delta = 3

ratio : Int
ratio = 2

-- The number of entries, in constant time.
size : Dict k v -> Int
size dict =
    case dict of
        Tip -> 0
        Bin count _ _ _ _ -> count

-- Whether the dictionary has no entries.
isEmpty : Dict k v -> Bool
isEmpty dict =
    case dict of
        Tip -> True
        Bin _ _ _ _ _ -> False

-- The dictionary with no entries.
empty : Dict k v
empty = Tip

-- The dictionary with one entry.
--
-- ```fango
-- import Dict
--
-- Dict.singleton 1 "one" == Dict.insert 1 "one" Dict.empty
-- Dict.size (Dict.singleton 1 "one") == 1
-- ```
singleton : k -> v -> Dict k v
singleton key value = Bin 1 key value Tip Tip

-- bin is the smart constructor: the only place a cached size is computed.
bin : k -> v -> Dict k v -> Dict k v -> Dict k v
bin key value left right = Bin (size left + size right + 1) key value left right

-- balance repairs one node after a single insertion or deletion below it. It
-- assumes both subtrees are internally balanced and that one of them changed
-- by at most one element; every call site below honours that.
--
-- The Tip branches inside the rotations are unreachable — a subtree more than
-- delta times its sibling holds at least two nodes — but a match must be
-- exhaustive and there is no crash primitive, so each rebuilds the node
-- unrotated. That is harmless while the invariant holds and silent if it ever
-- breaks, which is why the rotations are checked against tree height rather
-- than only against lookup results.
balance : k -> v -> Dict k v -> Dict k v -> Dict k v
balance key value left right =
    sizeLeft = size left
    sizeRight = size right
    if sizeLeft + sizeRight <= 1 then
        Bin (sizeLeft + sizeRight + 1) key value left right
    else if sizeRight > delta * sizeLeft then
        case right of
            Tip -> Bin (sizeLeft + sizeRight + 1) key value left right
            Bin _ rightKey rightValue rightLeft rightRight ->
                if size rightLeft < ratio * size rightRight then
                    bin rightKey rightValue (bin key value left rightLeft) rightRight
                else
                    case rightLeft of
                        Tip -> bin rightKey rightValue (bin key value left rightLeft) rightRight
                        Bin _ innerKey innerValue innerLeft innerRight ->
                            bin innerKey innerValue
                                (bin key value left innerLeft)
                                (bin rightKey rightValue innerRight rightRight)
    else if sizeLeft > delta * sizeRight then
        case left of
            Tip -> Bin (sizeLeft + sizeRight + 1) key value left right
            Bin _ leftKey leftValue leftLeft leftRight ->
                if size leftRight < ratio * size leftLeft then
                    bin leftKey leftValue leftLeft (bin key value leftRight right)
                else
                    case leftRight of
                        Tip -> bin leftKey leftValue leftLeft (bin key value leftRight right)
                        Bin _ innerKey innerValue innerLeft innerRight ->
                            bin innerKey innerValue
                                (bin leftKey leftValue leftLeft innerLeft)
                                (bin key value innerRight right)
    else
        Bin (sizeLeft + sizeRight + 1) key value left right

-- Ord has no compare, so navigation costs two comparisons per node.

-- The value stored under `key`, or `Nothing` when it is absent.
--
-- ```fango
-- import Dict
--
-- Dict.get 1 (Dict.fromList [(1, "one")]) == Just "one"
-- Dict.get 2 (Dict.fromList [(1, "one")]) == Nothing
-- ```
get : Ord k => k -> Dict k v -> Maybe v
get key dict =
    case dict of
        Tip -> Nothing
        Bin _ nodeKey nodeValue left right ->
            if key < nodeKey then
                get key left
            else if nodeKey < key then
                get key right
            else
                Just nodeValue

-- member is written out rather than as a get comparison, so a lookup that
-- only asks whether a key is present allocates no Maybe.

-- Whether `key` has an entry.
--
-- ```fango
-- import Dict
--
-- Dict.member 1 (Dict.fromList [(1, "one")])
-- ```
member : Ord k => k -> Dict k v -> Bool
member key dict =
    case dict of
        Tip -> False
        Bin _ nodeKey _ left right ->
            if key < nodeKey then
                member key left
            else if nodeKey < key then
                member key right
            else
                True

-- On a key already present the stored key is kept and only the value changes.
-- That is one rule for insert, update, and fromList alike; update has no new
-- key to substitute, so replacing here would need a second rule. It is
-- observable only through an Ord that calls distinguishable keys equivalent.

-- The dictionary with `value` stored under `key`, replacing any value it had.
-- A key already present keeps its original key; only an `Ord` that calls
-- distinguishable keys equivalent can tell.
--
-- ```fango
-- import Dict
--
-- Dict.get 1 (Dict.insert 1 "uno" (Dict.fromList [(1, "one")])) == Just "uno"
-- ```
insert : Ord k => k -> v -> Dict k v -> Dict k v
insert key value dict =
    case dict of
        Tip -> Bin 1 key value Tip Tip
        Bin count nodeKey nodeValue left right ->
            if key < nodeKey then
                balance nodeKey nodeValue (insert key value left) right
            else if nodeKey < key then
                balance nodeKey nodeValue left (insert key value right)
            else
                Bin count nodeKey value left right

-- minViewSure and maxViewSure take the node already destructured, so neither
-- needs an unreachable branch for the empty tree it could not answer for.
-- Each returns the extracted key, its value, and what is left.
minViewSure : k -> v -> Dict k v -> Dict k v -> (k, v, Dict k v)
minViewSure nodeKey nodeValue left right =
    case left of
        Tip -> (nodeKey, nodeValue, right)
        Bin _ leftKey leftValue leftLeft leftRight ->
            case minViewSure leftKey leftValue leftLeft leftRight of
                (foundKey, foundValue, rest) ->
                    (foundKey, foundValue, balance nodeKey nodeValue rest right)

maxViewSure : k -> v -> Dict k v -> Dict k v -> (k, v, Dict k v)
maxViewSure nodeKey nodeValue left right =
    case right of
        Tip -> (nodeKey, nodeValue, left)
        Bin _ rightKey rightValue rightLeft rightRight ->
            case maxViewSure rightKey rightValue rightLeft rightRight of
                (foundKey, foundValue, rest) ->
                    (foundKey, foundValue, balance nodeKey nodeValue left rest)

-- glue rejoins the two subtrees of a removed node. It draws the replacement
-- from the heavier side, which is what keeps balance's one-element
-- precondition true.
glue : Dict k v -> Dict k v -> Dict k v
glue left right =
    case left of
        Tip -> right
        Bin sizeLeft leftKey leftValue leftLeft leftRight ->
            case right of
                Tip -> left
                Bin sizeRight rightKey rightValue rightLeft rightRight ->
                    if sizeLeft > sizeRight then
                        case maxViewSure leftKey leftValue leftLeft leftRight of
                            (foundKey, foundValue, rest) -> balance foundKey foundValue rest right
                    else
                        case minViewSure rightKey rightValue rightLeft rightRight of
                            (foundKey, foundValue, rest) -> balance foundKey foundValue left rest

-- The dictionary without an entry for `key`; unchanged when it has none.
--
-- ```fango
-- import Dict
--
-- Dict.remove 1 (Dict.fromList [(1, "one"), (2, "two")]) == Dict.fromList [(2, "two")]
-- ```
remove : Ord k => k -> Dict k v -> Dict k v
remove key dict =
    case dict of
        Tip -> Tip
        Bin _ nodeKey nodeValue left right ->
            if key < nodeKey then
                balance nodeKey nodeValue (remove key left) right
            else if nodeKey < key then
                balance nodeKey nodeValue left (remove key right)
            else
                glue left right

-- update runs its callback exactly once, at the end of the search path, so a
-- curried callback costs one allocation per call rather than one per level.
-- Returning Nothing for a present key removes it; for an absent key it leaves
-- the dictionary alone.

-- Changes the entry for `key` through `alter`, which receives its current
-- value, or `Nothing`, and answers the new one: `Nothing` removes a present
-- key and leaves an absent one absent. `alter` runs exactly once.
--
-- ```fango
-- import Dict
--
-- increment : Maybe Int -> Maybe Int
-- increment count = Just (Maybe.withDefault 0 count + 1)
--
-- Dict.update "a" increment (Dict.fromList [("a", 1)]) == Dict.fromList [("a", 2)]
-- Dict.update "b" increment (Dict.fromList [("a", 1)]) == Dict.fromList [("a", 1), ("b", 1)]
-- Dict.update "a" { _ -> Nothing } (Dict.fromList [("a", 1)]) == Dict.empty
-- ```
update : Ord k => k -> (Maybe v ->{e} Maybe v) -> Dict k v ->{e} Dict k v
update key alter dict =
    case dict of
        Tip ->
            case alter Nothing of
                Nothing -> Tip
                Just value -> Bin 1 key value Tip Tip
        Bin count nodeKey nodeValue left right ->
            if key < nodeKey then
                balance nodeKey nodeValue (update key alter left) right
            else if nodeKey < key then
                balance nodeKey nodeValue left (update key alter right)
            else
                case alter (Just nodeValue) of
                    Nothing -> glue left right
                    Just value -> Bin count nodeKey value left right

-- The traversals take an accumulator and no callback, for the reason
-- List.reverse and List.length do: routing them through a fold would allocate
-- a closure per element. Each produces ascending key order.
keysHelp : Dict k v -> List k -> List k
keysHelp dict acc =
    case dict of
        Tip -> acc
        Bin _ key _ left right -> keysHelp left [key | keysHelp right acc]

-- The keys in ascending order.
--
-- ```fango
-- import Dict
--
-- Dict.keys (Dict.fromList [(2, "b"), (1, "a")]) == [1, 2]
-- ```
keys : Dict k v -> List k
keys dict = keysHelp dict []

valuesHelp : Dict k v -> List v -> List v
valuesHelp dict acc =
    case dict of
        Tip -> acc
        Bin _ _ value left right -> valuesHelp left [value | valuesHelp right acc]

-- The values in ascending order of their keys.
--
-- ```fango
-- import Dict
--
-- Dict.values (Dict.fromList [(2, "b"), (1, "a")]) == ["a", "b"]
-- ```
values : Dict k v -> List v
values dict = valuesHelp dict []

toListHelp : Dict k v -> List (k, v) -> List (k, v)
toListHelp dict acc =
    case dict of
        Tip -> acc
        Bin _ key value left right -> toListHelp left [(key, value) | toListHelp right acc]

-- The entries in ascending key order.
--
-- ```fango
-- import Dict
--
-- Dict.toList (Dict.fromList [(2, "b"), (1, "a")]) == [(1, "a"), (2, "b")]
-- ```
toList : Dict k v -> List (k, v)
toList dict = toListHelp dict []

fromListHelp : Ord k => List (k, v) -> Dict k v -> Dict k v
fromListHelp entries dict =
    case entries of
        [] -> dict
        [entry | rest] ->
            case entry of
                (key, value) -> fromListHelp rest (insert key value dict)

-- The dictionary of the given entries. When a key repeats, the later entry's
-- value wins and the first entry's key is kept.
--
-- ```fango
-- import Dict
--
-- Dict.fromList [(1, "one"), (1, "uno")] == Dict.fromList [(1, "uno")]
-- ```
fromList : Ord k => List (k, v) -> Dict k v
fromList entries = fromListHelp entries Tip

-- Callbacks take one pair rather than a curried key and value: a curried
-- boundary allocates once per argument, so the pair costs one allocation
-- where k -> v -> b would cost two.
--
-- Effects are propagated, so visit order is part of the contract: foldl and
-- map ascend, foldr descends.

-- Combines the entries into one value in ascending key order: `combine`
-- receives each `(key, value)` pair and the result so far.
--
-- ```fango
-- import Dict
--
-- Dict.foldl { (k, v) acc -> acc ++ k ++ v } "" (Dict.fromList [("b", "2"), ("a", "1")]) == "a1b2"
-- ```
foldl : ((k, v) -> b ->{e} b) -> b -> Dict k v ->{e} b
foldl combine initial dict =
    case dict of
        Tip -> initial
        Bin _ key value left right ->
            afterLeft = foldl combine initial left
            afterNode = combine (key, value) afterLeft
            foldl combine afterNode right

-- Combines the entries into one value in descending key order: `combine`
-- receives each `(key, value)` pair and the result so far.
--
-- ```fango
-- import Dict
--
-- Dict.foldr { (k, _) acc -> [k | acc] } [] (Dict.fromList [(2, "b"), (1, "a")]) == [1, 2]
-- ```
foldr : ((k, v) -> b ->{e} b) -> b -> Dict k v ->{e} b
foldr combine initial dict =
    case dict of
        Tip -> initial
        Bin _ key value left right ->
            afterRight = foldr combine initial right
            afterNode = combine (key, value) afterRight
            foldr combine afterNode left

-- map preserves every key, so it preserves search order and balance too: it
-- reuses each cached size and never calls balance, and takes no Ord. The
-- three bindings force ascending callback order rather than relying on
-- constructor argument evaluation order.

-- Replaces every value with `transform` of its `(key, value)` pair, keeping
-- the keys. `transform` runs in ascending key order.
--
-- ```fango
-- import Dict
--
-- Dict.map { (k, v) -> k * v } (Dict.fromList [(2, 10), (3, 10)]) == Dict.fromList [(2, 20), (3, 30)]
-- ```
map : ((k, a) ->{e} b) -> Dict k a ->{e} Dict k b
map transform dict =
    case dict of
        Tip -> Tip
        Bin count key value left right ->
            newLeft = map transform left
            newValue = transform (key, value)
            newRight = map transform right
            Bin count key newValue newLeft newRight

showEntries : (Show k, Show v) => List (k, v) -> String
showEntries entries =
    case entries of
        [] -> "]"
        [entry] ->
            case entry of
                (key, value) -> show key ++ " = " ++ show value ++ "]"
        [entry | rest] ->
            case entry of
                (key, value) -> show key ++ " = " ++ show value ++ ", " ++ showEntries rest

instance (Show k, Show v) => Show (Dict k v)
    show dict = "Dict [" ++ showEntries (toList dict)
    showArg dict = "(" ++ show dict ++ ")"

-- Equality compares entries in key order, never tree shape: the same entries
-- inserted in different orders build differently shaped trees. Deriving Eq
-- here would be wrong, not merely slower. The size test short-circuits the
-- common unequal case before either list is built.
instance (Eq k, Eq v) => Eq (Dict k v)
    (==) left right = size left == size right && toList left == toList right
