module String exposing (Uncons(..), byteLength, fromChar, length, slice, startsWith, toInt, uncons, words)

import Basics
import List exposing (List(..))
import Maybe exposing (Maybe(..))

type Uncons = { first : Char, rest : String }

-- length counts Unicode scalar values.
length : String -> Int
length = native "fangort.StringLength($1)"

byteLength : String -> Int
byteLength = native "fangort.StringByteLength($1)"

-- byteAt is private: the byte at a 0-based index, or -1 out of range.
byteAt : Int -> String -> Int
byteAt = native "fangort.ByteAt($1, $2)"

-- byteSlice is private and uses validated half-open byte indices.
byteSlice : Int -> Int -> String -> String
byteSlice = native "fangort.StringByteSlice($1, $2, $3)"

-- slice uses clamped half-open Unicode-scalar indices.
slice : Int -> Int -> String -> String
slice = native "fangort.StringSlice($1, $2, $3)"

firstChar : String -> Char
firstChar = native "fangort.StringFirst($1)"

restString : String -> String
restString = native "fangort.StringRest($1)"

fromChar : Char -> String
fromChar = native "fangort.StringFromChar($1)"

uncons : String -> Maybe Uncons
uncons text =
    if text == "" then
        Nothing
    else
        Just (Uncons { first = firstChar text, rest = restString text })

startsWith : String -> String -> Bool
startsWith prefix text = slice 0 (length prefix) text == prefix

-- Space, tab, newline, carriage return, vertical tab, and form feed.
isSpace : Int -> Bool
isSpace byte =
    byte == 32 || byte == 9 || byte == 10
        || byte == 13 || byte == 11 || byte == 12

skipSpace : String -> Int -> Int -> Int
skipSpace text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        skipSpace text (index + 1) size
    else
        index

scanWord : String -> Int -> Int -> Int
scanWord text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        index
    else
        scanWord text (index + 1) size

reverseWords : List String -> List String -> List String
reverseWords remaining result =
    case remaining of
        Nil -> result
        Cons word rest -> reverseWords rest (Cons word result)

wordsHelp : String -> Int -> Int -> List String -> List String
wordsHelp text index size result =
    start = skipSpace text index size
    end = scanWord text start size
    if start >= size then
        reverseWords result Nil
    else
        wordsHelp text end size (Cons (byteSlice start end text) result)

-- words splits on ASCII whitespace while preserving every non-whitespace byte.
words : String -> List String
words text = wordsHelp text 0 (byteLength text) Nil

-- Digits accumulate as a non-positive value so the most negative Int parses.
-- finish rejects a non-negative result that only fits when negative; the
-- most negative Int is not writable as a literal, so compare beyond -maxInt.
finish : Bool -> Int -> Maybe Int
finish negative acc =
    case negative of
        True -> Just acc
        False -> if acc < -9223372036854775807 then Nothing else Just (0 - acc)

toIntHelp : String -> Int -> Int -> Bool -> Int -> Maybe Int
toIntHelp text index size negative acc =
    case index >= size of
        True -> finish negative acc
        False ->
            digit = byteAt index text - 48
            next = acc * 10 - digit
            -- A non-digit byte, or an accumulator that would overflow past
            -- the most negative Int, stops the parse.
            if digit < 0 || digit > 9 then
                Nothing
            else if acc < -922337203685477580 || next > 0 then
                Nothing
            else
                toIntHelp text (index + 1) size negative next

-- toInt parses an optional +/- sign followed by base-10 digits. Anything
-- else, an empty digit sequence, or a value outside Int's 64-bit range is
-- Nothing.
toInt : String -> Maybe Int
toInt text =
    size = byteLength text
    first = byteAt 0 text
    start =
        if first == 45 || first == 43 then
            1
        else
            0
    if start >= size then
        Nothing
    else
        toIntHelp text start size (first == 45) 0
