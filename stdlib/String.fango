{-# no-prelude #-}
-- Operations on text.
--
-- A `String` is always valid UTF-8 and is not normalized; a `Char` is one
-- Unicode scalar value. Lengths and indices count scalars unless a name says
-- bytes. Whitespace-aware operations (`words`, `trim`) recognize ASCII
-- whitespace only: space, tab, line feed, carriage return, vertical tab, and
-- form feed.
module String exposing (Uncons(..), byteLength, concat, contains, fromChar, fromList, length, padLeft, padRight, slice, span, split, startsWith, toFloat, toInt, trim, uncons, words)

import Basics exposing (..)
import List exposing (List)
import Maybe exposing (Maybe(..))

-- A nonempty string split after its first character, as `uncons` answers.
type Uncons =
    {
      -- The first character.
      first : Char
      -- Everything after it.
    , rest : String
    }

-- The number of Unicode scalar values.
--
-- ```fango
-- import String
--
-- String.length "naïve" == 5
-- String.length "" == 0
-- ```
length : String -> Int
length = native

-- The number of bytes in the text's UTF-8 encoding.
--
-- ```fango
-- import String
--
-- String.byteLength "naïve" == 6
-- ```
byteLength : String -> Int
byteLength = native

-- byteAt is private: the byte at a 0-based index, or -1 out of range.
byteAt : Int -> String -> Int
byteAt = native

-- byteSlice is private and uses validated half-open byte indices.
byteSlice : Int -> Int -> String -> String
byteSlice = native

-- The characters from index `start` up to but not including `end`, counted
-- in scalars from zero. Indices are clamped to the text, and the result is
-- `""` when `end` is not greater than `start`.
--
-- ```fango
-- import String
--
-- String.slice 1 3 "abcd" == "bc"
-- String.slice 2 10 "abcd" == "cd"
-- String.slice 3 1 "abcd" == ""
-- ```
slice : Int -> Int -> String -> String
slice = native

firstChar : String -> Char
firstChar = native

restString : String -> String
restString = native

-- The one-character string.
--
-- ```fango
-- import String
--
-- String.fromChar 'a' == "a"
-- ```
fromChar : Char -> String
fromChar = native

-- The characters joined in list order, allocated once.
--
-- ```fango
-- import String
--
-- String.fromList ['a', 'b'] == "ab"
-- String.fromList [] == ""
-- ```
fromList : List Char -> String
fromList = native "fangort.StringFromList($1)"

-- The strings joined in list order, allocated once.
--
-- ```fango
-- import String
--
-- String.concat ["ab", "", "c"] == "abc"
-- String.concat [] == ""
-- ```
concat : List String -> String
concat = native "fangort.StringConcat($1)"

-- The first character and the rest of the text, or `Nothing` for `""`.
--
-- ```fango
-- import String
--
-- firstOf : String -> Maybe Char
-- firstOf text =
--     case String.uncons text of
--         Just parts -> Just parts.first
--         Nothing -> Nothing
--
-- firstOf "ab" == Just 'a'
-- firstOf "" == Nothing
-- ```
uncons : String -> Maybe Uncons
uncons text =
    if text == "" then
        Nothing
    else
        Just (Uncons { first = firstChar text, rest = restString text })

-- Stop at the first rejected scalar, keeping it in the remaining suffix.
spanHelp : (Char ->{e} Bool) -> String -> String ->{e} (String, String)
spanHelp keep original rest =
    case uncons rest of
        Nothing -> (original, "")
        Just part ->
            if keep part.first then
                spanHelp keep original part.rest
            else
                (byteSlice 0 (byteLength original - byteLength rest) original, rest)

-- The longest prefix whose characters all satisfy `keep`, and the rest.
-- `keep` runs on each character from the start, including the first one it
-- rejects, and then stops; on `""` it never runs.
--
-- ```fango
-- import String
--
-- String.span { c -> c /= ' ' } "hello world" == ("hello", " world")
-- String.span { c -> c /= ' ' } "" == ("", "")
-- ```
span : (Char ->{e} Bool) -> String ->{e} (String, String)
span keep text = spanHelp keep text text

-- Whether `text` begins with `prefix`.
--
-- ```fango
-- import String
--
-- String.startsWith "ab" "abc"
-- String.startsWith "" "abc"
-- ```
startsWith : String -> String -> Bool
startsWith prefix text = slice 0 (length prefix) text == prefix

-- Space, tab, newline, carriage return, vertical tab, and form feed.
isSpace : Int -> Bool
isSpace byte =
    byte == 32 || byte == 9 || byte == 10
        || byte == 13 || byte == 11 || byte == 12

skipSpace : String -> Int -> Int -> Int
skipSpace text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        skipSpace text (index + 1) size
    else
        index

scanWord : String -> Int -> Int -> Int
scanWord text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        index
    else
        scanWord text (index + 1) size

reverseWords : List String -> List String -> List String
reverseWords remaining result =
    case remaining of
        [] -> result
        [word | rest] -> reverseWords rest [word | result]

wordsHelp : String -> Int -> Int -> List String -> List String
wordsHelp text index size result =
    start = skipSpace text index size
    end = scanWord text start size
    if start >= size then
        reverseWords result []
    else
        wordsHelp text end size [byteSlice start end text | result]

-- The runs of non-whitespace text, in order. Whitespace between, before,
-- and after them is dropped.
--
-- ```fango
-- import String
--
-- String.words "  one two\tthree\n" == ["one", "two", "three"]
-- String.words "  " == []
-- ```
words : String -> List String
words text = wordsHelp text 0 (byteLength text) []

-- Digits accumulate as a non-positive value so the most negative Int parses.
-- finish rejects a non-negative result that only fits when negative; the
-- most negative Int is not writable as a literal, so compare beyond -maxInt.
finish : Bool -> Int -> Maybe Int
finish negative acc =
    case negative of
        True -> Just acc
        False -> if acc < -9223372036854775807 then Nothing else Just (0 - acc)

toIntHelp : String -> Int -> Int -> Bool -> Int -> Maybe Int
toIntHelp text index size negative acc =
    case index >= size of
        True -> finish negative acc
        False ->
            digit = byteAt index text - 48
            next = acc * 10 - digit
            -- A non-digit byte, or an accumulator that would overflow past
            -- the most negative Int, stops the parse.
            if digit < 0 || digit > 9 then
                Nothing
            else if acc < -922337203685477580 || next > 0 then
                Nothing
            else
                toIntHelp text (index + 1) size negative next

-- The integer the whole text spells: an optional `+` or `-` sign followed by
-- base-10 digits. Any other character, an empty digit sequence, and a value
-- outside the signed 64-bit range answer `Nothing`. The most negative `Int`
-- parses.
--
-- ```fango
-- import String
--
-- String.toInt "007" == Just 7
-- String.toInt "-42" == Just (-42)
-- String.toInt "4 2" == Nothing
-- String.toInt "9223372036854775808" == Nothing
-- String.toInt "-9223372036854775808" == Just (-9223372036854775807 - 1)
-- ```
toInt : String -> Maybe Int
toInt text =
    size = byteLength text
    first = byteAt 0 text
    start =
        if first == 45 || first == 43 then
            1
        else
            0
    if start >= size then
        Nothing
    else
        toIntHelp text start size (first == 45) 0

-- The native validates the complete decimal grammar and returns NaN as its
-- private failure sentinel. Accepted input can never itself denote NaN.
toFloatNative : String -> Float
toFloatNative = native

-- The number the whole text spells: an optional sign, decimal digits, an
-- optional fraction with digits on both sides of `.`, and an optional
-- decimal exponent. Whitespace, `NaN`, infinities, hexadecimal, `.5`, and
-- `1.` answer `Nothing`, as do values that overflow, or that are nonzero and
-- underflow to zero. Every other finite value parses, negative zero and
-- subnormal values included.
--
-- ```fango
-- import String
--
-- String.toFloat "2.5e3" == Just 2500.0
-- String.toFloat "-0.25" == Just (-0.25)
-- String.toFloat ".5" == Nothing
-- ```
toFloat : String -> Maybe Float
toFloat text =
    value = toFloatNative text
    if value == value then Just value else Nothing

-- matchesAt is private: whether separator occurs at index. The bounds test
-- comes first because byteSlice does not clamp, unlike slice.
matchesAt : String -> Int -> String -> Int -> Int -> Bool
matchesAt separator sepSize text index size =
    if index + sepSize > size then
        False
    else
        byteSlice index (index + sepSize) text == separator

splitHelp : String -> Int -> String -> Int -> Int -> Int -> List String -> List String
splitHelp separator sepSize text start index size result =
    if index > size - sepSize then
        reverseWords [byteSlice start size text | result] []
    else if matchesAt separator sepSize text index size then
        piece = byteSlice start index text
        splitHelp separator sepSize text (index + sepSize) (index + sepSize) size [piece | result]
    else
        splitHelp separator sepSize text start (index + 1) size result

-- The pieces of `text` between occurrences of `separator`, so n occurrences
-- give n + 1 pieces and adjacent separators give empty ones. An empty
-- separator yields the whole text as one piece.
--
-- ```fango
-- import String
--
-- String.split "," "a,,b" == ["a", "", "b"]
-- String.split "," "" == [""]
-- String.split "" "ab" == ["ab"]
-- ```
split : String -> String -> List String
split separator text =
    sepSize = byteLength separator
    if sepSize == 0 then
        [text]
    else
        splitHelp separator sepSize text 0 0 (byteLength text) []

-- containsFrom is private: whether needle occurs at or after index.
containsFrom : String -> Int -> String -> Int -> Int -> Bool
containsFrom needle needleSize text index size =
    if index + needleSize > size then
        False
    else if matchesAt needle needleSize text index size then
        True
    else
        containsFrom needle needleSize text (index + 1) size

-- Whether `needle` occurs anywhere in `text`. The empty needle occurs in
-- every string.
--
-- ```fango
-- import String
--
-- String.contains "lo w" "hello world"
-- String.contains "" ""
-- ```
contains : String -> String -> Bool
contains needle text = containsFrom needle (byteLength needle) text 0 (byteLength text)

-- scanSpaceBack is private: the index just past the last non-space byte,
-- never below limit.
scanSpaceBack : String -> Int -> Int -> Int
scanSpaceBack text index limit =
    if index <= limit then
        limit
    else if isSpace (byteAt (index - 1) text) then
        scanSpaceBack text (index - 1) limit
    else
        index

-- The text without leading and trailing whitespace.
--
-- ```fango
-- import String
--
-- String.trim "  a b \n" == "a b"
-- String.trim " \t " == ""
-- ```
trim : String -> String
trim text =
    size = byteLength text
    start = skipSpace text 0 size
    byteSlice start (scanSpaceBack text size start) text

-- repeatHelp is private: filler repeated count times, prepended to tail.
repeatHelp : String -> Int -> String -> String
repeatHelp filler count tail =
    if count <= 0 then
        tail
    else
        repeatHelp filler (count - 1) (filler ++ tail)

-- The text widened to `width` characters by adding `filler` in front. Text
-- already that wide is returned unchanged, never truncated.
--
-- ```fango
-- import String
--
-- String.padLeft 3 '0' "7" == "007"
-- String.padLeft 1 '0' "42" == "42"
-- ```
padLeft : Int -> Char -> String -> String
padLeft width filler text = repeatHelp (fromChar filler) (width - length text) text

-- The text widened to `width` characters by adding `filler` after it. Text
-- already that wide is returned unchanged, never truncated.
--
-- ```fango
-- import String
--
-- String.padRight 3 '.' "ab" == "ab."
-- ```
padRight : Int -> Char -> String -> String
padRight width filler text =
    padding = repeatHelp (fromChar filler) (width - length text) ""
    text ++ padding
