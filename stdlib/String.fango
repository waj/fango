module String exposing (Uncons(..), byteLength, fromChar, length, padLeft, padRight, slice, split, startsWith, toInt, trim, uncons, words)

import Basics
import List exposing (List(..))
import Maybe exposing (Maybe(..))

type Uncons = { first : Char, rest : String }

-- length counts Unicode scalar values.
length : String -> Int
length = native

byteLength : String -> Int
byteLength = native

-- byteAt is private: the byte at a 0-based index, or -1 out of range.
byteAt : Int -> String -> Int
byteAt = native

-- byteSlice is private and uses validated half-open byte indices.
byteSlice : Int -> Int -> String -> String
byteSlice = native

-- slice uses clamped half-open Unicode-scalar indices.
slice : Int -> Int -> String -> String
slice = native

firstChar : String -> Char
firstChar = native

restString : String -> String
restString = native

fromChar : Char -> String
fromChar = native

uncons : String -> Maybe Uncons
uncons text =
    if text == "" then
        Nothing
    else
        Just (Uncons { first = firstChar text, rest = restString text })

startsWith : String -> String -> Bool
startsWith prefix text = slice 0 (length prefix) text == prefix

-- Space, tab, newline, carriage return, vertical tab, and form feed.
isSpace : Int -> Bool
isSpace byte =
    byte == 32 || byte == 9 || byte == 10
        || byte == 13 || byte == 11 || byte == 12

skipSpace : String -> Int -> Int -> Int
skipSpace text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        skipSpace text (index + 1) size
    else
        index

scanWord : String -> Int -> Int -> Int
scanWord text index size =
    if index >= size then
        index
    else if isSpace (byteAt index text) then
        index
    else
        scanWord text (index + 1) size

reverseWords : List String -> List String -> List String
reverseWords remaining result =
    case remaining of
        Nil -> result
        Cons word rest -> reverseWords rest (Cons word result)

wordsHelp : String -> Int -> Int -> List String -> List String
wordsHelp text index size result =
    start = skipSpace text index size
    end = scanWord text start size
    if start >= size then
        reverseWords result Nil
    else
        wordsHelp text end size (Cons (byteSlice start end text) result)

-- words splits on ASCII whitespace while preserving every non-whitespace byte.
words : String -> List String
words text = wordsHelp text 0 (byteLength text) Nil

-- Digits accumulate as a non-positive value so the most negative Int parses.
-- finish rejects a non-negative result that only fits when negative; the
-- most negative Int is not writable as a literal, so compare beyond -maxInt.
finish : Bool -> Int -> Maybe Int
finish negative acc =
    case negative of
        True -> Just acc
        False -> if acc < -9223372036854775807 then Nothing else Just (0 - acc)

toIntHelp : String -> Int -> Int -> Bool -> Int -> Maybe Int
toIntHelp text index size negative acc =
    case index >= size of
        True -> finish negative acc
        False ->
            digit = byteAt index text - 48
            next = acc * 10 - digit
            -- A non-digit byte, or an accumulator that would overflow past
            -- the most negative Int, stops the parse.
            if digit < 0 || digit > 9 then
                Nothing
            else if acc < -922337203685477580 || next > 0 then
                Nothing
            else
                toIntHelp text (index + 1) size negative next

-- toInt parses an optional +/- sign followed by base-10 digits. Anything
-- else, an empty digit sequence, or a value outside Int's 64-bit range is
-- Nothing.
toInt : String -> Maybe Int
toInt text =
    size = byteLength text
    first = byteAt 0 text
    start =
        if first == 45 || first == 43 then
            1
        else
            0
    if start >= size then
        Nothing
    else
        toIntHelp text start size (first == 45) 0

-- matchesAt is private: whether separator occurs at index. The bounds test
-- comes first because byteSlice does not clamp, unlike slice.
matchesAt : String -> Int -> String -> Int -> Int -> Bool
matchesAt separator sepSize text index size =
    if index + sepSize > size then
        False
    else
        byteSlice index (index + sepSize) text == separator

splitHelp : String -> Int -> String -> Int -> Int -> Int -> List String -> List String
splitHelp separator sepSize text start index size result =
    if index > size - sepSize then
        reverseWords (Cons (byteSlice start size text) result) Nil
    else if matchesAt separator sepSize text index size then
        piece = byteSlice start index text
        splitHelp separator sepSize text (index + sepSize) (index + sepSize) size (Cons piece result)
    else
        splitHelp separator sepSize text start (index + 1) size result

-- split cuts text at every occurrence of separator, so n occurrences give
-- n + 1 pieces and adjacent separators give empty ones. Splitting on the
-- empty separator yields the whole text unchanged.
split : String -> String -> List String
split separator text =
    sepSize = byteLength separator
    if sepSize == 0 then
        Cons text Nil
    else
        splitHelp separator sepSize text 0 0 (byteLength text) Nil

-- scanSpaceBack is private: the index just past the last non-space byte,
-- never below limit.
scanSpaceBack : String -> Int -> Int -> Int
scanSpaceBack text index limit =
    if index <= limit then
        limit
    else if isSpace (byteAt (index - 1) text) then
        scanSpaceBack text (index - 1) limit
    else
        index

-- trim removes leading and trailing bytes from the same ASCII whitespace set
-- words splits on. An all-whitespace string trims to "".
trim : String -> String
trim text =
    size = byteLength text
    start = skipSpace text 0 size
    byteSlice start (scanSpaceBack text size start) text

-- repeatHelp is private: filler repeated count times, prepended to tail.
repeatHelp : String -> Int -> String -> String
repeatHelp filler count tail =
    if count <= 0 then
        tail
    else
        repeatHelp filler (count - 1) (filler ++ tail)

-- padLeft and padRight measure width in Unicode scalars, like length, and
-- return a string that is already wide enough unchanged.
padLeft : Int -> Char -> String -> String
padLeft width filler text = repeatHelp (fromChar filler) (width - length text) text

padRight : Int -> Char -> String -> String
padRight width filler text =
    padding = repeatHelp (fromChar filler) (width - length text) ""
    text ++ padding
