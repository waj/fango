{-# no-prelude #-}
module Async.IO exposing (get, sleep, timeout)

import Async
import Basics exposing (..)
import IO exposing (IO)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Async.Native
import Runtime.Completion
import Runtime.Native
import Runtime.NativeRequest
import Runtime.Scope
import Runtime.Service

-- A native worker writes one bounded result. It is allocated outside its
-- request scope, so the request drains before this state is released.
type State = State Runtime.Native.Any

newState : () ->{IO} State
newState = native
closeState : State ->{IO} ()
closeState = native
submitSleep : Runtime.NativeRequest.Registration -> Runtime.Async.Native.Bridge -> State -> Int -> Int ->{IO} ()
submitSleep = native
submitGet : Runtime.NativeRequest.Registration -> Runtime.Async.Native.Bridge -> State -> Int -> String ->{IO} ()
submitGet = native
ok : State ->{IO} Bool
ok = native
body : State ->{IO} String
body = native
errorText : State ->{IO} String
errorText = native

awaitNative host callback ticket =
    case Runtime.NativeRequest.poll host callback of
        Just completed -> Runtime.Completion.replay completed
        Nothing ->
            Async.nativeWait ticket
            awaitNative host callback ticket

-- The wait parks its Fango task. Cancellation drains the native timer before
-- its state and admission slot are released.
sleep : Int ->{Async.Async, Runtime.Service.Invocation Async.Request Int, IO} ()
sleep millis =
    eventBridge = Async.nativeBridge()
    ticket = Async.nativeReserve()
    Runtime.Scope.finally (\_ -> Runtime.Scope.bracket newState closeState (\state ->
        Runtime.NativeRequest.scope 1 (\host ->
            case Runtime.NativeRequest.register host (\token -> submitSleep token eventBridge state ticket millis) (\_ -> ()) of
                Nothing -> ()
                Just callback -> awaitNative host callback ticket)))
        (\_ -> Runtime.Async.Native.release eventBridge ticket)

-- GET reads at most one MiB. A request can be interrupted while the driver
-- executes other tasks; HTTP cancellation is signalled through its token.
get : String ->{Async.Async, Runtime.Service.Invocation Async.Request Int, IO} Result String String
get url =
    eventBridge = Async.nativeBridge()
    ticket = Async.nativeReserve()
    Runtime.Scope.finally (\_ -> Runtime.Scope.bracket newState closeState (\state ->
        Runtime.NativeRequest.scope 1 (\host ->
            case Runtime.NativeRequest.register host (\token -> submitGet token eventBridge state ticket url) (\_ -> ()) of
                Nothing -> Err "request admission failed"
                Just callback ->
                    awaitNative host callback ticket
                    if ok state then Ok (body state) else Err (errorText state))))
        (\_ -> Runtime.Async.Native.release eventBridge ticket)

timeout : Int -> (() ->{Async.Async, Runtime.Service.Invocation Async.Request Int, IO | e} a) ->{Async.Async, Runtime.Service.Invocation Async.Request Int, IO | e} Result Async.Error (Maybe a)
timeout millis action =
    if millis < 0 then Err (Async.InvalidTimeout millis)
    else case Async.race action (\_ -> sleep millis) of
        Async.LeftWon value -> Ok (Just value)
        Async.RightWon _ -> Ok Nothing
