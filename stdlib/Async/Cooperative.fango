{-# no-prelude #-}
module Async.Cooperative exposing (run)

import Async
import Basics exposing (..)
import IO exposing (IO)
import Result exposing (Result)
import Runtime.Async.Cooperative

run : (() ->{Async.Async | e} a) ->{IO | e} Result Async.Error a
run action = Runtime.Async.Cooperative.run [] (Async.worker action)
