{-# no-prelude #-}
module Async.Cooperative exposing (run)

import Async
import Basics exposing (..)
import IO exposing (IO)
import Result exposing (Result)
import Runtime.Executor
import Runtime.Service

run : (() ->{Async.Async, Runtime.Service.Invocation Async.Request Int, IO | e} a) ->{IO | e} Result Async.Error a
run action = Async.runOn Runtime.Executor.cooperative action
