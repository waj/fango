{-# no-prelude #-}
-- Inspecting detached failures.
--
-- `Fail.attemptReport` and `Fail.attemptDiagnostic` report cleanup failures
-- raised while a computation unwound as `Failure` snapshots. A snapshot names
-- the effect operation that failed and keeps its arguments, but exposes no handler or
-- resumption. Snapshots retain their payloads, including resources; keeping a
-- snapshot does not extend a resource's lifetime.
module Failure exposing (Failure, argument, argumentCount, effectName, operationName, suppressed, trace)

import Basics exposing (..)
import List exposing (List)
import Maybe exposing (Maybe)
import Text.Builder as Builder
import Trace

-- A detached snapshot of one failure: the aborting operation and its
-- arguments, with any failures suppressed beneath it.
-- `Show` renders a metadata summary containing the effect, operation,
-- argument count, optional trace, and nested suppressed failures. Argument
-- contents remain opaque: snapshots do not retain their Show dictionaries.
type Failure = Failure

-- The name of the effect whose operation failed, such as `Fail.Fail`.
effectName : Failure -> String
effectName = native

-- The name of the operation that failed, such as `Fail.fail`.
operationName : Failure -> String
operationName = native

-- How many arguments the failing operation was given.
argumentCount : Failure -> Int
argumentCount = native

-- The failures suppressed beneath this one, which keep their own.
suppressed : Failure -> List Failure
suppressed = native

-- The stack captured at this failure's original abort site, innermost first.
-- `Nothing` means its handler did not request capture; `Just []` means capture
-- was requested but found no frames. Reading a snapshot never captures the
-- current stack. Nested suppressed failures keep their own optional traces.
trace : Failure -> Maybe (List Trace.Frame)
trace = native

-- The argument at a zero-based index, when it has the requested type,
-- including all its type arguments. A wrong type, an index out of range, and
-- a type containing functions or resources answer `Nothing`. An ordinary
-- immutable type is inspectable without exposing its constructors:
-- annotating `payload : Maybe IO.Error` and binding
-- `payload = Failure.argument 0 failure` reads an IO error.
argument : Int -> Failure -> Maybe a
argument = native

instance Show Failure
    showTo built failure =
        withEffect = showTo (Builder.append "Failure { effect = " built) (effectName failure)
        withOperation = showTo (Builder.append ", operation = " withEffect) (operationName failure)
        withCount = showTo (Builder.append ", argumentCount = " withOperation) (argumentCount failure)
        withTrace = showTo (Builder.append ", trace = " withCount) (trace failure)
        withSuppressed = showTo (Builder.append ", suppressed = " withTrace) (suppressed failure)
        Builder.append " }" withSuppressed
    showArgTo built failure = Builder.append ")" (showTo (Builder.append "(" built) failure)
