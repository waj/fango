{-# no-prelude #-}
-- The compile-time stage: code values, type and effect reflection,
-- attributes, and the builders derivers use.
--
-- A backtick quotation is a `Code` value, and `$(...)` splices one back in.
-- `typeOf T` reflects a type as a `TypeRepr`, which `info` reads as a schema
-- when it is visible where `typeOf` was written. `Code`, `TypeRepr`, and the
-- types built from them exist only while the compiler runs, so a definition
-- whose type mentions them is never part of a program.
module Meta exposing
    ( Arrow(..), ArrowInfo(..), Attached(..), Attributes, Bound(..)
    , BoundField(..), Code, Ctor(..), Effect(..), EffectRepr, Field(..)
    , Items(..), Lift(..), Reflected(..), Shape(..), Site, Tail(..)
    , TypeInfo(..), TypeRepr
    , args, arrow, attributes, construct, ctorsIn, declaredType, fail, failAt
    , foldItems, head, info, isReference, isVar, lambda, lengthItems
    , localFunction, mapItems, match, sameEffect, sameType, sequence, siteOf
    , typeName
    )

import Basics exposing (..)

{- The compile-time stage's representations.

`Code` is abstract: it has no constructor here, and the only way to build one
is a `quote` or the traversal skeleton below. Its values exist only while the
compiler is running, so a definition whose type mentions `Code` — or
`TypeRepr`, or anything reachable from one — is never emitted.

Meta imports only Basics, which imports nothing. Derivers live in `Derive`,
above this module, so nothing here has to reach a collection module: `List`
derives its own instances, and would therefore depend on the module that
depends on this one. `Items` is the small list that avoids the cycle.

The natives below have Go templates that are never emitted, because every one
of them has a compile-time-only type. They exist so the interpreter registry
and the surface declaration agree on arity. -}

-- A piece of Fango code at compile time, from a quotation or a builder. It
-- keeps the scope it was written in, and is checked when it is spliced.
type Code = Code

-- A reflected type. Nominal types compare by compiler identity; applications
-- and function arrows compare structurally, including their effects.
type TypeRepr = TypeRepr

-- `Meta`'s own list. `Meta` cannot use `List`, which derives its instances
-- and so depends on the module that depends on `Meta`.
type Items a
    -- The empty list.
    = NoItems
    -- An item in front of the rest.
    | Item a (Items a)

-- Combines the items into one value, first to last.
--
-- ```fango
-- import Meta exposing (Items(..))
--
-- Meta.foldItems { total n -> total + n } 0 (Item 1 (Item 2 NoItems)) == 3
-- ```
foldItems : (b -> a -> b) -> b -> Items a -> b
foldItems combine start items =
    case items of
        NoItems -> start
        Item value rest -> foldItems combine (combine start value) rest

-- Applies a function to every item, keeping their order.
--
-- ```fango
-- import Meta exposing (Items(..))
--
-- Meta.lengthItems (Meta.mapItems { n -> n * 2 } (Item 1 (Item 2 NoItems))) == 2
-- ```
mapItems : (a -> b) -> Items a -> Items b
mapItems change items =
    case items of
        NoItems -> NoItems
        Item value rest -> Item (change value) (mapItems change rest)

-- The number of items.
lengthItems : Items a -> Int
lengthItems items = foldItems { total _ -> total + 1 } 0 items

-- Values that become literal code. `Int`, `Float`, `String`, `Char`, `Bool`,
-- and `()` have it.
class Lift a
    -- A literal for the value, which keeps its own type.
    lift : a -> Code

liftInt : Int -> Code
liftInt = native "$1"

liftFloat : Float -> Code
liftFloat = native "$1"

liftString : String -> Code
liftString = native "$1"

liftChar : Char -> Code
liftChar = native "$1"

liftBool : Bool -> Code
liftBool = native "$1"

liftUnit : () -> Code
liftUnit = native "$1"

instance Lift Int
    lift value = liftInt value

instance Lift Float
    lift value = liftFloat value

instance Lift String
    lift value = liftString value

instance Lift Char
    lift value = liftChar value

instance Lift Bool
    lift value = liftBool value

instance Lift ()
    lift value = liftUnit value

-- Reflected types compare by compiler identity, never by name.

-- Whether two reflected types are the same type. Names never decide it.
sameType : TypeRepr -> TypeRepr -> Bool
sameType = native "$1 == $2"

-- The type constructor an application applies, or the type itself.
head : TypeRepr -> TypeRepr
head = native "$1"

-- Whether the type is a type variable.
isVar : TypeRepr -> Bool
isVar = native "$1"

-- typeName is for display only. Identity is sameType.
typeName : TypeRepr -> String
typeName = native "$1"

argCount : TypeRepr -> Int
argCount = native "$1"

argAt : TypeRepr -> Int -> TypeRepr
argAt = native "$1 == $2"

schemaVisible : TypeRepr -> Bool
schemaVisible = native "$1"

typeSurfaceName : TypeRepr -> String
typeSurfaceName = native "$1"

typeModuleName : TypeRepr -> String
typeModuleName = native "$1"

isRecordType : TypeRepr -> Bool
isRecordType = native "$1"

ctorCount : TypeRepr -> Int
ctorCount = native "$1"

ctorSymbol : TypeRepr -> Int -> String
ctorSymbol = native "$1 == $2"

ctorName : TypeRepr -> Int -> String
ctorName = native "$1 == $2"

fieldCount : TypeRepr -> Int -> Int
fieldCount = native "$1 == $2"

fieldName : TypeRepr -> Int -> Int -> String
fieldName = native "$1 == $2 == $3"

fieldType : TypeRepr -> Int -> Int -> TypeRepr
fieldType = native "$1 == $2 == $3"

-- Generic, typed metadata. The lookup primitive is specialized by the compiler.
type Attributes = Attributes

-- Where an attribute was written, for reporting a failure there.
type Site = Site

-- An attribute value and where it was written.
type Attached a =
    {
      -- The attribute's value.
      value : a
      -- Its source location.
    , site : Site
    }

-- The attributes in a collection whose type is exactly `a`, type arguments
-- included, in source order. Collections follow reflection visibility: an
-- opaque import hides a type's metadata.
attributes : Type a -> Attributes -> Items (Attached a)
attributes = native "$1 == $2"

-- Stops compilation with a `COMPILE-TIME FAILURE` at an attribute's site.
failAt : Site -> String -> a
failAt = native "$1 == $2"

typeAttributes : TypeRepr -> Attributes
typeAttributes = native "$1"

ctorAttributes : TypeRepr -> Int -> Attributes
ctorAttributes = native "$1 == $2"

fieldAttributes : TypeRepr -> Int -> Int -> Attributes
fieldAttributes = native "$1 == $2 == $3"

-- One field of a reflected constructor.
type Field =
    {
      -- The field's name, or `""` for a union constructor's positional field.
      name : String
      -- Its zero-based position.
    , index : Int
      -- Its type, instantiated at the reflected type's arguments.
    , ty : TypeRepr
      -- Its attributes.
    , attributes : Attributes
    }

-- One constructor of a reflected type. A record's sole constructor carries
-- the type's own name.
type Ctor =
    {
      -- The constructor's name.
      name : String
      -- Its canonical name, which identifies it in generated code.
    , symbol : String
      -- Its zero-based declaration position.
    , index : Int
      -- The type it constructs.
    , owner : TypeRepr
      -- Its fields in order.
    , fields : Items Field
      -- Its own attributes; a record's synthetic constructor has none.
    , attributes : Attributes
    }

-- How a reflected type is built.
type Shape
    -- A union of these constructors.
    = Union (Items Ctor)
    -- A record, as its one constructor with named fields.
    | Record Ctor

-- The schema of a reflected type.
type TypeInfo =
    {
      -- The type's name.
      name : String
      -- The module that declares it.
    , moduleName : String
      -- The reflected type itself.
    , ty : TypeRepr
      -- Its type arguments.
    , params : Items TypeRepr
      -- Its constructors or record fields.
    , shape : Shape
      -- The attributes written before its `type`.
    , attributes : Attributes
    }

-- info answers Opaque unless the type's schema is visible where `typeOf` was
-- written: `exposing (T)` reflects opaque and `exposing (T(..))` reflects in
-- full, exactly as those forms already govern patterns and field access. Types
-- with constructor-local hidden state also answer Opaque; their public type
-- arguments and nominal identity remain available.
type Reflected
    -- No schema is readable: the type is imported opaquely, or it is a
    -- scalar, a type variable, or a type with constructor-local hidden state.
    = Opaque
    -- The type's schema.
    | Visible TypeInfo

argsFrom : TypeRepr -> Int -> Items TypeRepr
argsFrom repr index =
    if index >= argCount repr then
        NoItems
    else
        Item (argAt repr index) (argsFrom repr (index + 1))

-- The arguments a type application applies, in order.
args : TypeRepr -> Items TypeRepr
args repr = argsFrom repr 0

fieldsFrom : TypeRepr -> Int -> Int -> Items Field
fieldsFrom repr ctorIndex index =
    if index >= fieldCount repr ctorIndex then
        NoItems
    else
        entry = Field
            { name = fieldName repr ctorIndex index
            , index = index
            , ty = fieldType repr ctorIndex index
            , attributes = fieldAttributes repr ctorIndex index
            }
        Item entry (fieldsFrom repr ctorIndex (index + 1))

ctorFor : TypeRepr -> Int -> Ctor
ctorFor repr index =
    { name = ctorName repr index
    , symbol = ctorSymbol repr index
    , index = index
    , owner = repr
    , attributes = ctorAttributes repr index
    , fields = fieldsFrom repr index 0
    }

ctorsFrom : TypeRepr -> Int -> Items Ctor
ctorsFrom repr index =
    if index >= ctorCount repr then
        NoItems
    else
        Item (ctorFor repr index) (ctorsFrom repr (index + 1))

shapeOf : TypeRepr -> Shape
shapeOf repr =
    if isRecordType repr then
        Record (ctorFor repr 0)
    else
        Union (ctorsFrom repr 0)

-- infoOf reads a schema the caller already knows is visible. The compiler
-- calls it when it invokes a deriver for a type it is declaring.
infoOf : TypeRepr -> TypeInfo
infoOf repr =
    { name = typeSurfaceName repr
    , moduleName = typeModuleName repr
    , ty = repr
    , params = args repr
    , attributes = typeAttributes repr
    , shape = shapeOf repr
    }

-- The type's schema, when visible where `typeOf` was written and without
-- constructor-local hidden types.
info : TypeRepr -> Reflected
info repr = if schemaVisible repr then Visible (infoOf repr) else Opaque

-- ctorsIn flattens the two shapes: a record is a single constructor whose
-- fields carry names.
ctorsIn : TypeInfo -> Items Ctor
ctorsIn subject =
    case subject.shape of
        Union ctors -> ctors
        Record ctor -> Item ctor NoItems

-- Function arrows and the effects on their rows.

-- A reflected effect application, compared with `sameEffect`.
type EffectRepr = EffectRepr

-- One effect application on an arrow's row. Its identity, name, and
-- arguments are always readable. Its attributes are readable where the
-- effect's operations are visible: `exposing (E(..))` reflects them, while
-- `exposing (E)` leaves a collection whose lookups fail at compile time.
type Effect =
    {
      -- The effect's name.
      name : String
      -- The module that declares it.
    , moduleName : String
      -- The reflected application.
    , repr : EffectRepr
      -- Its type arguments.
    , args : Items TypeRepr
      -- The attributes written before its `effect`.
    , attributes : Attributes
    }

-- How an arrow's row ends.
type Tail
    -- The row lists every effect the arrow may perform.
    = Closed
    -- The row continues with this row variable.
    | Open TypeRepr

-- A decomposed function arrow.
type ArrowInfo =
    {
      -- The argument type.
      param : TypeRepr
      -- The result type, which is itself an arrow for a curried function.
    , result : TypeRepr
      -- The effects on this arrow's row, ordered by module and name.
    , effects : Items Effect
      -- Whether the row is closed or open.
    , tail : Tail
    }

-- What `arrow` finds.
type Arrow
    -- The type is not a function arrow.
    = NotArrow
    -- The arrow's parts.
    | Arrow ArrowInfo

isArrow : TypeRepr -> Bool
isArrow = native "$1"

arrowParam : TypeRepr -> TypeRepr
arrowParam = native "$1"

arrowResult : TypeRepr -> TypeRepr
arrowResult = native "$1"

arrowEffectCount : TypeRepr -> Int
arrowEffectCount = native "$1"

arrowEffectAt : TypeRepr -> Int -> EffectRepr
arrowEffectAt = native "$1 == $2"

arrowRowOpen : TypeRepr -> Bool
arrowRowOpen = native "$1"

arrowRowTail : TypeRepr -> TypeRepr
arrowRowTail = native "$1"

sameEffectRepr : EffectRepr -> EffectRepr -> Bool
sameEffectRepr = native "$1 == $2"

effectSurfaceName : EffectRepr -> String
effectSurfaceName = native "$1"

effectModuleName : EffectRepr -> String
effectModuleName = native "$1"

effectArgCount : EffectRepr -> Int
effectArgCount = native "$1"

effectArgAt : EffectRepr -> Int -> TypeRepr
effectArgAt = native "$1 == $2"

effectAttributes : EffectRepr -> Attributes
effectAttributes = native "$1"

effectArgsFrom : EffectRepr -> Int -> Items TypeRepr
effectArgsFrom applied index =
    if index >= effectArgCount applied then
        NoItems
    else
        Item (effectArgAt applied index) (effectArgsFrom applied (index + 1))

effectFor : EffectRepr -> Effect
effectFor applied =
    { name = effectSurfaceName applied
    , moduleName = effectModuleName applied
    , repr = applied
    , args = effectArgsFrom applied 0
    , attributes = effectAttributes applied
    }

effectsFrom : TypeRepr -> Int -> Items Effect
effectsFrom repr index =
    if index >= arrowEffectCount repr then
        NoItems
    else
        Item (effectFor (arrowEffectAt repr index)) (effectsFrom repr (index + 1))

-- Decomposes a function arrow. A curried function is an arrow whose result
-- is another arrow, each with its own row.
--
-- ```fango
-- import Meta exposing (Arrow(..))
--
-- resultIsString =
--     $(Meta.lift
--         (case Meta.arrow (typeOf (Int -> String)) of
--             Arrow parts -> Meta.sameType parts.result (typeOf String)
--             NotArrow -> False))
--
-- resultIsString
-- ```
arrow : TypeRepr -> Arrow
arrow repr =
    if isArrow repr then
        parts = ArrowInfo
            { param = arrowParam repr
            , result = arrowResult repr
            , effects = effectsFrom repr 0
            , tail = if arrowRowOpen repr then Open (arrowRowTail repr) else Closed
            }
        Arrow parts
    else
        NotArrow

-- Whether two effect applications are the same effect with the same
-- arguments. Names never decide it.
sameEffect : Effect -> Effect -> Bool
sameEffect a b = sameEffectRepr a.repr b.repr

-- Whether the code is a quote of exactly one top-level name, such as
-- `` `List.map` ``.
isReference : Code -> Bool
isReference = native "$1"

-- The declared type of a quoted top-level name. Its quantified type and row
-- variables stay variables, so `isVar` and `sameType` can relate them; its
-- schemas are visible as they are where the quote was written. Reading a
-- declaration that is still being checked, or code that is not a reference,
-- stops compilation.
declaredType : Code -> TypeRepr
declaredType = native "$1"

-- Where a piece of code was written, for reporting a failure there with
-- `failAt`. Code the compiler built reports at the splice site instead.
siteOf : Code -> Site
siteOf = native "$1"

-- The traversal skeleton. The compiler owns every binder a generated method
-- introduces, so a deriver never invents a name and exhaustiveness is
-- structural rather than checked after the fact.

-- One field of a constructor that `match` has bound.
type BoundField =
    {
      -- The field's name, or `""` for a positional field.
      name : String
      -- Its zero-based position.
    , index : Int
      -- Its type.
    , ty : TypeRepr
      -- Code naming the bound value.
    , value : Code
      -- Its attributes.
    , attributes : Attributes
    }

-- One branch of a `match`: a constructor and its bound fields.
type Bound =
    {
      -- The constructor matched.
      ctor : Ctor
      -- Its fields, bound in order.
    , fields : Items BoundField
    }

binderName : Code -> Int -> Int -> String
binderName = native "$1 == $2 == $3"

varCode : String -> Code
varCode = native "$1"

lambdaCode : String -> Code -> Code
lambdaCode = native "$1 == $2"

-- Give a generator a reference to a local binder and wrap its result in a
-- lambda. The caller supplies a private name; generated bodies can then keep
-- one typed slot per reflected field without generating declarations.
lambda : String -> (Code -> Code) -> Code
lambda name build = lambdaCode name (build (varCode name))

localFunctionStart : String -> Code -> Code -> Code
localFunctionStart = native "$1 == $2 == $3"

localFunctionParam : Code -> String -> Code
localFunctionParam = native "$1 == $2"

-- fail stops expansion and reports COMPILE-TIME FAILURE at the splice site.
fail : String -> Code
fail = native "$1"

-- Build a named local function, including self-recursive references, and an
-- expression that uses it. Names must be private and parameters nonempty.
localFunction : String -> Items String -> (Code -> Items Code -> Code) -> (Code -> Code) -> Code
localFunction name parameters build action =
    case parameters of
        NoItems -> fail "A generated local function requires at least one parameter."
        Item _ _ ->
            self = varCode name
            foldItems localFunctionParam
                (localFunctionStart name (build self (mapItems varCode parameters)) (action self))
                parameters

-- Sequence a Unit expression before a result without introducing a lambda.
sequence : Code -> Code -> Code
sequence = native "$1 == $2"

matchStart : Code -> Code
matchStart = native "$1"

patternStart : String -> Code
patternStart = native "$1"

patternBind : Code -> String -> Code
patternBind = native "$1 == $2"

matchBranch : Code -> Code -> Code -> Code
matchBranch = native "$1 == $2 == $3"

constructStart : TypeRepr -> Int -> Code
constructStart = native "$1 == $2"

constructPush : Code -> Code -> Code
constructPush = native "$1 == $2"

bindField : Code -> Ctor -> Field -> BoundField
bindField scrutinee ctor field =
    { name = field.name
    , index = field.index
    , ty = field.ty
    , value = varCode (binderName scrutinee ctor.index field.index)
    , attributes = field.attributes
    }

boundOf : Code -> Ctor -> Bound
boundOf scrutinee ctor =
    { ctor = ctor, fields = mapItems (bindField scrutinee ctor) ctor.fields }

patternOf : Code -> Ctor -> Code
patternOf scrutinee ctor =
    foldItems
        { sofar field -> patternBind sofar (binderName scrutinee ctor.index field.index) }
        (patternStart ctor.symbol)
        ctor.fields

-- match builds the exhaustive case over subject's constructors and binds
-- every field, handing each branch's bindings to build. Nesting two calls
-- produces the nested case a two-argument method needs.
match : TypeInfo -> Code -> (Bound -> Code) -> Code
match subject scrutinee build =
    foldItems
        { sofar ctor -> matchBranch sofar (patternOf scrutinee ctor) (build (boundOf scrutinee ctor)) }
        (matchStart scrutinee)
        (ctorsIn subject)

-- construct is the other direction, for a method that produces an `a`.
construct : Ctor -> Items Code -> Code
construct ctor values = foldItems constructPush (constructStart ctor.owner ctor.index) values
