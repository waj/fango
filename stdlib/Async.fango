{-# no-prelude #-}
-- Concurrent tasks, cancellation, and channels.
--
-- `run` starts a root scope in which tasks share a failure type `err`; tasks
-- spawned inside it run in parallel, and every scope waits for its children
-- before it completes. A child inherits the resumptive handlers around it,
-- sharing their state cells, but must handle abort effects other than
-- `Fail err` inside itself. A failed task cancels its siblings, but not the
-- parent body, which can observe and handle the failure. Cancellation is
-- cooperative: sleeps, channel transfers, and task waits respond to it, but
-- CPU loops need `checkpoint`, and blocking IO is not interrupted except by
-- the cancellation-aware `Net` operations.
module Async exposing
    ( Async, Channel, Outcome(..), Task
    , await, awaitResult, cancel, cancelScope, cancelled, channel, checkpoint
    , close, completed, contextToken, parMap, receive, run, send, sleep, spawn
    , wait, within
    )

import Basics exposing (..)
import Fail exposing (Fail)
import IO exposing (IO)
import List exposing (List)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Native
import Runtime.Scope

{-# resource #-}
type Scope err = Scope Runtime.Native.Any

type Context = Context Runtime.Native.Any

{-# resource #-}
type RawTask result = RawTask Runtime.Native.Any

-- A running or finished task that answers a `value` or fails with an `err`.
-- A task handle may outlive the scope that started it.
type Task err value = Task (RawTask (Result err value))

-- A channel carrying values between tasks. It lives independently of the
-- tasks that use it.
{-# resource #-}
type Channel value = Channel Runtime.Native.Any

{-# resource #-}
type ReadResult value = ReadResult Runtime.Native.Any

-- How a task or scope ended.
type Outcome value
    -- It finished with this value.
    = Completed value
    -- It was cancelled first.
    | Cancelled
    deriving (Eq, Show)

-- Running inside a task scope whose tasks fail with `err`. Only `run`
-- handles it.
effect Async err
    current : () -> Scope err
    active : () -> Scope err

effect Cancellation
    abort stopTask : () -> value

newRoot : () -> Scope err
newRoot = native
childScope : Scope err -> Scope err
childScope = native
scopeContext : Scope err -> Context
scopeContext = native

-- The current task's opaque cancellation context, for native sidecars that
-- must interrupt a blocking operation when the task is cancelled.
contextToken : () ->{Async err} Runtime.Native.Any
contextToken() =
    case scopeContext current() of
        Context value -> value
scopeCancelled : Scope err -> Bool
scopeCancelled = native
cancelOwner : Scope err -> ()
cancelOwner = native
finishScope : Scope err -> Int -> ()
finishScope = native
scopeStatus : Scope err -> Int
scopeStatus = native
scopeFailure : Scope err -> err
scopeFailure = native

-- The checked invocation boundaries retain source rows and sealed result indices.
launch : Scope err -> (Scope err ->{IO | effects} Outcome (Result err value)) ->{effects} RawTask (Result err value)
launch = native
rebase : (() ->{Async err, IO, Fail err, Cancellation | effects} value) ->{Async err, IO, Fail err, Cancellation | effects} value
rebase = native
supervise : (() ->{IO | effects} value) ->{IO | effects} value
supervise = native

newCompleted : result -> RawTask result
newCompleted = native
completeSuccess : Context -> RawTask result -> ()
completeSuccess = native
completeFailure : Scope err -> RawTask result -> err -> ()
completeFailure = native
cancelTask : RawTask result -> ()
cancelTask = native
waitTask : RawTask result ->{IO} ()
waitTask = native
waitTaskIn : Context -> RawTask result -> Bool
waitTaskIn = native
taskStatus : RawTask result -> Int
taskStatus = native
taskValue : RawTask result -> result
taskValue = native
sleepIn : Context -> Int -> Bool
sleepIn = native

newChannel : () -> Channel value
newChannel = native
setCapacity : Channel value -> Int -> ()
setCapacity = native
sendIn : Context -> Channel value -> value -> Bool
sendIn = native
receiveIn : Context -> Channel value -> ReadResult value
receiveIn = native
readStatus : ReadResult value -> Int
readStatus = native
readValue : ReadResult value -> value
readValue = native
closeChannel : Channel value -> ()
closeChannel = native

enter owner body =
    handle body() on
        current () -> resume owner
        active () -> if scopeCancelled owner then stopTask() else resume owner

capture owner body =
    handle Completed (Fail.attempt { enter owner body }) on
        stopTask () -> Cancelled

status outcome =
    case outcome of
        Cancelled -> 2
        Completed (Err _) -> 1
        Completed (Ok _) -> 0

finish owner outcome =
    finishScope owner (status outcome)
    case outcome of
        Completed (Err _) -> outcome
        _ ->
            case scopeStatus owner of
                1 -> Completed (Err (scopeFailure owner))
                2 -> Cancelled
                _ -> outcome

-- Cleanup drains even when an unrelated outer abort leaves the body.
runIn owner body =
    Runtime.Scope.bracket { () } { finishScope owner 2 } {
        outcome = capture owner body
        finish owner outcome
    }

-- Runs `body` in a new root scope and answers how it ended: completed with
-- its value or its failure, or cancelled. The scope waits for every task it
-- started. When the body succeeds, the earliest failure of a task nobody
-- observed becomes the scope's failure; a failure of the body itself wins.
run : (() ->{Async err, IO, Fail err | effects} value) ->{IO | effects} Outcome (Result err value)
run body = supervise { runIn newRoot() body }

-- Runs `body` in a nested scope that waits for the tasks it starts before
-- returning. Its failure fails the caller; its cancellation cancels the
-- caller's scope.
within : (() ->{Async err, Fail err | effects} value) ->{Async err, Fail err | effects} value
within body =
    owner = active()
    outcome = runIn (childScope owner) body
    case outcome of
        Completed result -> Fail.fromResult result
        Cancelled ->
            cancelOwner owner
            stopCurrent()

-- Starts `body` as a child task of the current scope and answers its handle
-- at once. The child catches its own `Fail err` locally; an ordinary `Err`
-- it returns is a successful value.
spawn : (() ->{Async err, IO, Fail err | effects} value) ->{Async err | effects} Task err value
spawn body =
    owner = active()
    Task (launch owner { child -> runIn child { rebase body } })

-- A task that has already finished with `result`.
completed : Result err value ->{Async err} Task err value
completed result =
    owner = active()
    task = newCompleted result
    case result of
        Ok _ -> completeSuccess (scopeContext owner) task
        Err error -> completeFailure owner task error
    Task task

observe task = if taskStatus task == 2 then Cancelled else Completed (taskValue task)

-- Waits, outside any task scope, for the task to finish and answers how it
-- ended.
wait : Task err value ->{IO} Outcome (Result err value)
wait (Task task) =
    waitTask task
    observe task

-- Waits for the task to finish and answers how it ended, without failing.
-- Observing a task marks its failure as handled; repeated observations
-- answer the same result. Cancelling the waiting task interrupts the wait.
awaitResult : Task err value ->{Async err} Outcome (Result err value)
awaitResult (Task task) =
    owner = active()
    if waitTaskIn (scopeContext owner) task then
        observe task
    else
        stopCurrent()

-- Waits for the task and answers its value. A failed task fails the caller
-- with the same error; a cancelled one cancels the caller's scope.
await : Task err value ->{Async err, Fail err} value
await task =
    case awaitResult task of
        Completed result -> Fail.fromResult result
        Cancelled ->
            cancelScope()
            stopCurrent()

-- Requests the task's cancellation, and its children's. It does not cancel
-- the caller.
cancel : Task err value ->{Async err} ()
cancel (Task task) =
    ignore current()
    cancelTask task

-- Requests cancellation of the current scope and its children.
cancelScope : () ->{Async err} ()
cancelScope() = cancelOwner current()

-- Whether the current scope has been cancelled.
cancelled : () ->{Async err} Bool
cancelled() = scopeCancelled current()

-- Called only after this scope is cancelled; active aborts to capture.
stopCurrent : () ->{Async err} value
stopCurrent() =
    ignore active()
    stopCurrent()

-- Leaves the current task if it has been cancelled, running cleanup on the
-- way; otherwise does nothing. Long computations call it to respond to
-- cancellation.
checkpoint : () ->{Async err} ()
checkpoint() = ignore active()

-- Pauses the task for `milliseconds`, waking early when it is cancelled. A
-- duration of zero or less is a checkpoint.
sleep : Int ->{Async err} ()
sleep milliseconds =
    owner = active()
    if sleepIn (scopeContext owner) milliseconds then () else checkpoint()

-- A new channel buffering up to `capacity` values. Zero or less makes it
-- unbuffered: each send waits for a receiver.
channel : Int ->{Async err} Channel value
channel capacity =
    ignore active()
    result = newChannel()
    setCapacity result capacity
    result

-- Sends a value, waiting while the buffer is full. Answers `False` when the
-- channel is closed, including while waiting.
send : Channel value -> value ->{Async err} Bool
send ch value =
    owner = active()
    sent = sendIn (scopeContext owner) ch value
    if sent then True
    else
        checkpoint()
        False

-- The next value, waiting while none is buffered, or `Nothing` once the
-- channel is closed and drained.
receive : Channel value ->{Async err} Maybe value
receive ch =
    owner = active()
    result = receiveIn (scopeContext owner) ch
    case readStatus result of
        0 -> Just (readValue result)
        _ ->
            checkpoint()
            Nothing

-- Closes the channel, waking blocked senders and receivers. Closing it again
-- does nothing.
close : Channel value ->{Async err} ()
close ch =
    ignore current()
    closeChannel ch

-- Applies a pure function to every element in parallel, keeping their order.
-- It uses at most one worker per available processor and needs no task
-- scope.
--
-- ```fango
-- import Async
--
-- Async.parMap { n -> n * n } [1, 2, 3] == [1, 4, 9]
-- ```
parMap : (a -> b) -> List a -> List b
parMap = native
