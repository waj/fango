{-# no-prelude #-}
module Json exposing
    ( Decode(..), Emit(..), Encode(..), Error(..), FieldOption(..), Number
    , Pull(..), Scan, ScanStep(..), Token(..), Value(..)
    , beginArray, beginObject, decodeValue, mapScan, next, nextElement, nextKey
    , number, numberText, parse, parseBytes, parseBytesValue, parseValue, peek
    , read, readText, readValue, runScan, scanFromPull, skipValue, stringify
    , stringifyValue, syntaxError, withIndex, withPath, withPull, withTextPull
    , withTextWriter, withWriter, write, writeText
    )

import Basics exposing (..)
import Bytes exposing (Bytes)
import Char
import Encoding
import Fail exposing (Fail, fail)
import List exposing (List)
import Maybe exposing (Maybe(..))
import Meta exposing (Bound(..), BoundField(..), Code, Ctor(..), Field(..), Items(..), Lift(..), Shape(..), TypeInfo(..))
import Reader exposing (Reader)
import Result exposing (Result(..))
import Runtime.Scope
import String
import Text.Reader as TextReader
import Text.Writer as TextWriter
import Tuple
import Writer exposing (Writer)

type Error = { message : String, offset : Int, line : Int, column : Int, path : String }

type Token
    = BeginObject
    | EndObject
    | BeginArray
    | EndArray
    | Colon
    | Comma
    | StringTokenValue String
    | NumberToken String
    | BooleanToken Bool
    | NullToken
    | EndInput

type Number = Number String

type Value
    = Null
    | Boolean Bool
    | Numeric Number
    | Text String
    | Array (List Value)
    | Object (List (String, Value))

effect Pull
    next : () -> Token
    peek : () -> Token
    at : () -> Error
    arrayElement : Bool -> Bool
    objectKey : Bool -> Maybe String
    decodedString : () -> Result String String
    decodedInt : () -> Result String Int
    decodedFloat : () -> Result String Float
    bufferedScan : () -> Maybe Scan
    currentScan : () -> Scan
    stringTail : Scan -> String -> List String -> (String, Scan)
    literalTail : Scan -> String -> Scan
    numberTail : Scan -> TextReader.Window -> NumberRun -> (String, Scan)
    integerTail : Scan -> IntegerRun -> (Result String Int, Scan)
    acceptScan : Scan -> ()
    enter : String -> ()
    enterIndex : Int -> ()
    leave : () -> ()

effect Emit
    emit : String -> ()

class Decode a
    scanValue : Scan -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)

class Encode a
    encodeValue : a ->{Emit, Fail Error} ()

-- Options interpreted by the JSON derivers, using generic Meta attributes.
type FieldOption = Key String | Skip | Default Code

type FieldSettings =
    { key : String
    , skip : Bool
    , fallback : Maybe Code
    , keySite : Maybe Meta.Site
    , skipSite : Maybe Meta.Site
    , defaultSite : Maybe Meta.Site
    }

addFieldOption : FieldSettings -> Meta.Attached FieldOption -> FieldSettings
addFieldOption settings attached =
    case attached.value of
        Key text ->
            case settings.keySite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON key option."
                Nothing -> { settings | key = text, keySite = Just attached.site }
        Skip ->
            case settings.skipSite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON skip option."
                Nothing -> { settings | skip = True, skipSite = Just attached.site }
        Default code ->
            case settings.defaultSite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON default option."
                Nothing -> { settings | fallback = Just code, defaultSite = Just attached.site }

fieldSettings : String -> Meta.Attributes -> FieldSettings
fieldSettings name attached =
    initial = FieldSettings { key = name, skip = False, fallback = Nothing, keySite = Nothing, skipSite = Nothing, defaultSite = Nothing }
    settings = Meta.foldItems addFieldOption initial (Meta.attributes @FieldOption attached)
    case settings.skipSite of
        Nothing -> settings
        Just site ->
            case settings.fallback of
                Nothing -> Meta.failAt site "A skipped JSON field requires a default expression."
                Just _ ->
                    case settings.keySite of
                        Just keySite -> Meta.failAt keySite "A skipped JSON field cannot also rename its key."
                        Nothing -> settings

rejectFieldOptions : Meta.Attributes -> ()
rejectFieldOptions attached =
    case Meta.attributes @FieldOption attached of
        NoItems -> ()
        Item option _ -> Meta.failAt option.site "JSON field options belong on record fields."

findKey : String -> Items Field -> Maybe Meta.Site
findKey key fields =
    case fields of
        NoItems -> Nothing
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            if settings.key == key then settings.keySite else findKey key rest

hasKey : String -> Items Field -> Bool
hasKey key fields =
    case fields of
        NoItems -> False
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            settings.key == key || hasKey key rest

validateRecordFields : Items Field -> Items Field -> ()
validateRecordFields previous fields =
    case fields of
        NoItems -> ()
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            if settings.skip then validateRecordFields previous rest
            else if hasKey settings.key previous then
                case settings.keySite of
                    Just site -> Meta.failAt site ("Two fields use the same JSON key: " ++ settings.key)
                    Nothing ->
                        case findKey settings.key previous of
                            Just site -> Meta.failAt site ("Two fields use the same JSON key: " ++ settings.key)
                            Nothing -> ()
            else validateRecordFields (Item field previous) rest

validateUnionFields : Items Field -> ()
validateUnionFields fields =
    case fields of
        NoItems -> ()
        Item field rest ->
            rejectFieldOptions field.attributes
            validateUnionFields rest

validateUnionCtors : Items Ctor -> ()
validateUnionCtors ctors =
    case ctors of
        NoItems -> ()
        Item ctor rest ->
            rejectFieldOptions ctor.attributes
            validateUnionFields ctor.fields
            validateUnionCtors rest

validateJSONSchema : TypeInfo -> ()
validateJSONSchema subject =
    rejectFieldOptions subject.attributes
    case subject.shape of
        Record ctor ->
            rejectFieldOptions ctor.attributes
            validateRecordFields NoItems ctor.fields
        Union ctors -> validateUnionCtors ctors

-- One segment of the error path: an object key, or an element index.
type Segment = { key : String, index : Maybe Int }

-- The path is a stack, innermost segment first. It is rendered only when an
-- error is built, so entering a field or element allocates one cons.
type Cursor = { window : TextReader.Window, ended : Bool, offset : Int, line : Int, column : Int, path : List Segment }

segmentText : Segment -> String
segmentText segment =
    case segment.index of
        Just index -> show index
        Nothing -> segment.key

renderPath : List Segment -> String
renderPath segments = List.foldl { segment rendered -> "/" ++ segmentText segment ++ rendered } "" segments

errorAt : Cursor -> String -> Error
errorAt cursor message =
    Error { message = message, offset = cursor.offset, line = cursor.line, column = cursor.column, path = renderPath cursor.path }

-- Grammar and decoding errors publish only the prefix already consumed by the
-- scanner. A stale outer cleanup position cannot consume that prefix twice.
badAt : TextReader.Reader e -> Cursor -> Cursor -> String ->{Fail Error | e} a
badAt reader site consumed message =
    TextReader.commitWindow reader consumed.window
    fail (errorAt site message)

bad : TextReader.Reader e -> Cursor -> String ->{Fail Error | e} a
bad reader cursor message = badAt reader cursor cursor message

encodingError : TextReader.Reader e -> Cursor -> Encoding.Error ->{Fail Error | e} a
encodingError reader cursor problem =
    bad reader cursor (case problem of
            Encoding.InvalidSequence _ -> "Invalid UTF-8 in JSON input"
            Encoding.IncompleteSequence _ -> "Incomplete UTF-8 in JSON input"
            _ -> Encoding.message problem
    )

-- A complete scalar is obtained by growing the immutable window only at a
-- boundary. Refill commits its consumed prefix and retains incomplete bytes.
readyCursor : TextReader.Reader e -> Cursor ->{e} Cursor
readyCursor reader cursor =
    needsInput = case TextReader.peekWindow cursor.window of
        Ok Nothing -> True
        Err (Encoding.IncompleteSequence _) -> True
        _ -> False
    if needsInput && cursor.ended == False then
        (snapshot, grew) = TextReader.refillWindow reader cursor.window
        readyCursor reader { cursor | window = snapshot, ended = grew == False }
    else cursor

peekChar : TextReader.Reader e -> Cursor ->{Fail Error | e} (Maybe Char, Cursor)
peekChar reader cursor =
    case TextReader.peekWindow cursor.window of
        Ok Nothing ->
            if cursor.ended then (Nothing, cursor)
            else peekChar reader (readyCursor reader cursor)
        Ok (Just (char, _)) -> (Just char, cursor)
        Err (Encoding.IncompleteSequence _) ->
            if cursor.ended then encodingError reader cursor (Encoding.IncompleteSequence cursor.offset)
            else peekChar reader (readyCursor reader cursor)
        Err problem -> encodingError reader cursor problem

takeChar : TextReader.Reader e -> Cursor ->{Fail Error | e} (Maybe Char, Cursor)
takeChar reader cursor =
    case TextReader.readWindow cursor.window of
        Err (Encoding.IncompleteSequence _) ->
            if cursor.ended then encodingError reader cursor (Encoding.IncompleteSequence cursor.offset)
            else takeChar reader (readyCursor reader cursor)
        Err problem -> encodingError reader cursor problem
        Ok Nothing ->
            if cursor.ended then (Nothing, cursor)
            else takeChar reader (readyCursor reader cursor)
        Ok (Just (char, size, snapshot)) ->
            if char == '\n' then
                (Just char, { cursor | window = snapshot, offset = cursor.offset + size, line = cursor.line + 1, column = 1 })
            else
                (Just char, { cursor | window = snapshot, offset = cursor.offset + size, column = cursor.column + size })

white : Char -> Bool
white char = char == ' ' || char == '\t' || char == '\n' || char == '\r'

skipWhite : TextReader.Reader e -> Cursor ->{Fail Error | e} Cursor
skipWhite reader cursor =
    (got, ready) = peekChar reader cursor
    case got of
        Just char ->
            if white char then
                (_, after) = takeChar reader ready
                skipWhite reader after
            else ready
        Nothing -> ready

expectChar : TextReader.Reader e -> Cursor -> Char ->{Fail Error | e} Cursor
expectChar reader cursor wanted =
    (got, after) = takeChar reader cursor
    if got == Just wanted then after else badAt reader cursor after "Invalid JSON literal"

literal : TextReader.Reader e -> Cursor -> String ->{Fail Error | e} Cursor
literal reader cursor text =
    case literalRun cursor.window text of
        Ok snapshot ->
            width = TextReader.windowPosition snapshot - TextReader.windowPosition cursor.window
            { cursor | window = snapshot, offset = cursor.offset + width, column = cursor.column + width }
        Err (snapshot, remaining) ->
            width = TextReader.windowPosition snapshot - TextReader.windowPosition cursor.window
            stopped = { cursor | window = snapshot, offset = cursor.offset + width, column = cursor.column + width }
            case String.uncons remaining of
                Nothing -> stopped
                Just part -> literal reader (expectChar reader stopped part.first) part.rest

hex : Char -> Int
hex char =
    code = Char.toCode char
    if char >= '0' && char <= '9' then code - Char.toCode '0'
    else if char >= 'A' && char <= 'F' then code - Char.toCode 'A' + 10
    else if char >= 'a' && char <= 'f' then code - Char.toCode 'a' + 10
    else -1

readHex : TextReader.Reader e -> Cursor -> Int -> Int ->{Fail Error | e} (Int, Cursor)
readHex reader cursor remaining acc =
    if remaining == 0 then (acc, cursor)
    else
        (got, after) = takeChar reader cursor
        case got of
            Nothing -> bad reader after "Incomplete Unicode escape"
            Just char ->
                nibble = hex char
                if nibble < 0 then badAt reader cursor after "Invalid Unicode escape"
                else readHex reader after (remaining - 1) (acc * 16 + nibble)

scalar : TextReader.Reader e -> Cursor -> Int ->{Fail Error | e} Char
scalar reader cursor code =
    case Char.fromCode code of
        Just char -> char
        Nothing -> bad reader cursor "Invalid Unicode scalar"

escaped : TextReader.Reader e -> Cursor ->{Fail Error | e} (Char, Cursor)
escaped reader cursor =
    (got, after) = takeChar reader cursor
    case got of
        Just '"' -> ('"', after)
        Just '\\' -> ('\\', after)
        Just '/' -> ('/', after)
        Just 'b' -> (scalar reader after 8, after)
        Just 'f' -> (scalar reader after 12, after)
        Just 'n' -> ('\n', after)
        Just 'r' -> ('\r', after)
        Just 't' -> ('\t', after)
        Just 'u' ->
            (code, afterHex) = readHex reader after 4 0
            if code >= 56320 && code <= 57343 then badAt reader cursor afterHex "Unexpected low surrogate"
            else if code >= 55296 && code <= 56319 then
                afterSlash = expectChar reader afterHex '\\'
                afterU = expectChar reader afterSlash 'u'
                (low, rest) = readHex reader afterU 4 0
                if low < 56320 || low > 57343 then badAt reader afterU rest "Invalid surrogate pair"
                else (scalar reader rest (65536 + (code - 55296) * 1024 + low - 56320), rest)
            else (scalar reader afterHex code, afterHex)
        _ -> badAt reader cursor after "Invalid JSON escape"

plainStringChar : Char -> Bool
plainStringChar char = case char of
    '"' -> False
    '\\' -> False
    _ -> Char.toCode char >= 32

plainStringStops : Encoding.AsciiSet
plainStringStops = Encoding.asciiSet { char -> plainStringChar char == False }

stringFragments : String -> List String -> String
stringFragments current reverse =
    case reverse of
        [] -> current
        _ -> String.concat (List.reverse [current | reverse])

priorFragment : String -> List String -> List String
priorFragment current reverse = if current == "" then reverse else [current | reverse]

scanString : TextReader.Reader e -> Cursor -> String -> List String ->{Fail Error | e} (String, Cursor)
scanString reader cursor current reverse =
    case stringRun cursor.window current reverse of
        Ok (text, snapshot) ->
            width = TextReader.windowPosition snapshot - TextReader.windowPosition cursor.window
            (text, { cursor | window = snapshot, offset = cursor.offset + width, column = cursor.column + width })
        Err (snapshot, fragment, fragments) ->
            width = TextReader.windowPosition snapshot - TextReader.windowPosition cursor.window
            afterPlain = { cursor | window = snapshot, offset = cursor.offset + width, column = cursor.column + width }
            (got, after) = takeChar reader afterPlain
            case got of
                Nothing -> bad reader after "Unterminated JSON string"
                Just '"' -> (stringFragments fragment fragments, after)
                Just '\\' ->
                    (char, rest) = escaped reader after
                    scanString reader rest (String.fromChar char) (priorFragment fragment fragments)
                Just char ->
                    if Char.toCode char < 32 then badAt reader afterPlain after "Unescaped control character in JSON string"
                    else scanString reader after (String.fromChar char) (priorFragment fragment fragments)

digit : Char -> Bool
digit char = char >= '0' && char <= '9'

type NumberPhase = MinusDigit | ZeroEnd | WholeDigits | FractionDigit | FractionDigits | ExponentSign | ExponentDigit | ExponentDigits | NumberEnd | BadMinus | BadDigit | BadZero

type NumberRun = { window : TextReader.Window, phase : NumberPhase, done : Bool, message : String, site : Int }

-- A pure loop over one text window. Only scalar positions and a small enum
-- move through the digit loop; the reader and JSON cursor stay outside it.
numberRun : TextReader.Window -> NumberPhase -> NumberRun
numberRun snapshot phase =
    case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) ->
            following = case phase of
                MinusDigit -> if char == '0' then ZeroEnd else if digit char then WholeDigits else BadMinus
                ZeroEnd -> if digit char then BadZero else if char == '.' then FractionDigit else if char == 'e' || char == 'E' then ExponentSign else NumberEnd
                WholeDigits -> if digit char then WholeDigits else if char == '.' then FractionDigit else if char == 'e' || char == 'E' then ExponentSign else NumberEnd
                FractionDigit -> if digit char then FractionDigits else BadDigit
                FractionDigits -> if digit char then FractionDigits else if char == 'e' || char == 'E' then ExponentSign else NumberEnd
                ExponentSign -> if char == '+' || char == '-' then ExponentDigit else if digit char then ExponentDigits else BadDigit
                ExponentDigit -> if digit char then ExponentDigits else BadDigit
                ExponentDigits -> if digit char then ExponentDigits else NumberEnd
                _ -> NumberEnd
            case following of
                NumberEnd -> NumberRun { window = snapshot, phase = phase, done = True, message = "", site = 0 }
                BadMinus -> NumberRun { window = rest, phase = phase, done = False, message = "Expected digit after minus", site = TextReader.windowPosition snapshot }
                BadDigit -> NumberRun { window = snapshot, phase = phase, done = False, message = "Expected JSON digit", site = TextReader.windowPosition snapshot }
                BadZero -> NumberRun { window = snapshot, phase = phase, done = False, message = "Leading zero in JSON number", site = TextReader.windowPosition snapshot }
                _ -> numberRun rest following
        _ -> NumberRun { window = snapshot, phase = phase, done = False, message = "", site = 0 }

numberComplete : NumberPhase -> Bool
numberComplete phase = case phase of
    ZeroEnd -> True
    WholeDigits -> True
    FractionDigits -> True
    ExponentDigits -> True
    _ -> False

numberWindows : TextReader.Reader e -> TextReader.Window -> Cursor -> NumberPhase -> List String ->{Fail Error | e} (String, Cursor)
numberWindows reader start cursor phase reverse =
    numberScanned reader start cursor (numberRun cursor.window phase) reverse

numberScanned : TextReader.Reader e -> TextReader.Window -> Cursor -> NumberRun -> List String ->{Fail Error | e} (String, Cursor)
numberScanned reader start cursor scanned reverse =
    base = TextReader.windowPosition cursor.window
    width = TextReader.windowPosition scanned.window - base
    after = { cursor | window = scanned.window, offset = cursor.offset + width, column = cursor.column + width }
    if scanned.message == "" then
        text = case TextReader.windowText start scanned.window of
            Ok value -> value
            Err problem -> encodingError reader after problem
        if scanned.done then (stringFragments text reverse, after)
        else
            ready = readyCursor reader after
            case TextReader.peekWindow ready.window of
                Err problem -> encodingError reader ready problem
                Ok Nothing ->
                    if numberComplete scanned.phase then (stringFragments text reverse, ready)
                    else bad reader ready (case scanned.phase of
                            MinusDigit -> "Expected digit after minus"
                            _ -> "Expected JSON digit"
                    )
                Ok (Just _) -> numberWindows reader ready.window ready scanned.phase (priorFragment text reverse)
    else
        siteWidth = scanned.site - base
        site = { cursor | offset = cursor.offset + siteWidth, column = cursor.column + siteWidth }
        badAt reader site after scanned.message

scanNumber : TextReader.Reader e -> TextReader.Window -> Cursor -> Char ->{Fail Error | e} (String, Cursor)
scanNumber reader start cursor first =
    phase = if first == '-' then MinusDigit else if first == '0' then ZeroEnd else WholeDigits
    numberWindows reader start cursor phase []

-- JSON punctuation, whitespace and digits are ASCII, so the buffered
-- scanners below branch on asciiAt codes: 9 tab, 10 newline, 13 return,
-- 32 space, 34 quote, 44 comma, 45 minus, 46 period, 48-57 digits,
-- 69/101 exponent, 93 bracket, 125 brace.
-- Whitespace stops at any other byte, valid or not: the token scanner that
-- follows reads it and declines a malformed sequence for the source-aware
-- path to diagnose.
fastWhite : TextReader.Window -> Int -> Int -> Maybe (TextReader.Window, Int, Int)
fastWhite snapshot line column =
    code = TextReader.asciiAt snapshot
    if code == 32 || code == 9 || code == 13 then fastWhite (TextReader.skipAscii snapshot) line (column + 1)
    else if code == 10 then fastWhite (TextReader.skipAscii snapshot) (line + 1) 1
    else if code == -1 then Nothing
    else Just (snapshot, line, column)

literalRun : TextReader.Window -> String -> Result (TextReader.Window, String) TextReader.Window
literalRun snapshot text =
    case String.uncons text of
        Nothing -> Ok snapshot
        Just part ->
            case TextReader.readWindow snapshot of
                Ok (Just (char, _, rest)) ->
                    if char == part.first then literalRun rest part.rest else Err (snapshot, text)
                _ -> Err (snapshot, text)

fastLiteral : TextReader.Window -> String -> Maybe TextReader.Window
fastLiteral snapshot text = case literalRun snapshot text of
    Ok rest -> Just rest
    Err _ -> Nothing

fastHex : TextReader.Window -> Int -> Int -> Maybe (Int, TextReader.Window)
fastHex snapshot remaining acc =
    if remaining == 0 then Just (acc, snapshot)
    else case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) ->
            nibble = hex char
            if nibble < 0 then Nothing else fastHex rest (remaining - 1) (acc * 16 + nibble)
        _ -> Nothing

fastScalar : Int -> TextReader.Window -> Maybe (Char, TextReader.Window)
fastScalar code snapshot =
    case Char.fromCode code of
        Nothing -> Nothing
        Just char -> Just (char, snapshot)

fastEscape : TextReader.Window -> Maybe (Char, TextReader.Window)
fastEscape snapshot =
    case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) -> case char of
            '"' -> Just ('"', rest)
            '\\' -> Just ('\\', rest)
            '/' -> Just ('/', rest)
            'b' -> fastScalar 8 rest
            'f' -> fastScalar 12 rest
            'n' -> Just ('\n', rest)
            'r' -> Just ('\r', rest)
            't' -> Just ('\t', rest)
            'u' -> case fastHex rest 4 0 of
                Nothing -> Nothing
                Just (code, afterHex) ->
                    if code >= 56320 && code <= 57343 then Nothing
                    else if code >= 55296 && code <= 56319 then
                        case fastLiteral afterHex "\\u" of
                            Nothing -> Nothing
                            Just afterU -> case fastHex afterU 4 0 of
                                Nothing -> Nothing
                                Just (low, afterLow) ->
                                    if low < 56320 || low > 57343 then Nothing
                                    else fastScalar (65536 + (code - 55296) * 1024 + low - 56320) afterLow
                    else fastScalar code afterHex
            _ -> Nothing
        _ -> Nothing

stringRun : TextReader.Window -> String -> List String -> Result (TextReader.Window, String, List String) (String, TextReader.Window)
stringRun snapshot current reverse =
    case TextReader.spanWindowUntil snapshot plainStringStops of
        Err _ -> Err (snapshot, current, reverse)
        Ok (text, _, afterPlain) ->
            fragment = if text == "" then current else text
            fragments = if text == "" then reverse else priorFragment current reverse
            case TextReader.readWindow afterPlain of
                Ok (Just ('"', _, rest)) -> Ok (stringFragments fragment fragments, rest)
                Ok (Just ('\\', _, rest)) -> case fastEscape rest of
                    Nothing -> Err (afterPlain, fragment, fragments)
                    Just (char, afterEscape) -> stringRun afterEscape (String.fromChar char) (priorFragment fragment fragments)
                _ -> Err (afterPlain, fragment, fragments)

fastString : TextReader.Window -> String -> List String -> Maybe (String, TextReader.Window)
fastString snapshot current reverse = case stringRun snapshot current reverse of
    Ok value -> Just value
    Err _ -> Nothing

-- One lexer dispatches the token once. Its scalar loops run purely within
-- each window and resume their saved phase after source refills.
lex : TextReader.Reader e -> Cursor ->{Fail Error | e} (Token, Cursor)
lex reader before =
    cursor = case fastWhite before.window before.line before.column of
        Nothing -> skipWhite reader before
        Just (start, line, column) -> { before | window = start, offset = before.offset + TextReader.windowPosition start - TextReader.windowPosition before.window, line = line, column = column }
    (got, after) = takeChar reader cursor
    case got of
        Nothing -> (EndInput, after)
        Just '{' -> (BeginObject, after)
        Just '}' -> (EndObject, after)
        Just '[' -> (BeginArray, after)
        Just ']' -> (EndArray, after)
        Just ':' -> (Colon, after)
        Just ',' -> (Comma, after)
        Just '"' ->
            (value, rest) = scanString reader after "" []
            (StringTokenValue value, rest)
        Just 't' -> (BooleanToken True, literal reader after "rue")
        Just 'f' -> (BooleanToken False, literal reader after "alse")
        Just 'n' -> (NullToken, literal reader after "ull")
        Just char ->
            if char == '-' || digit char then
                (value, rest) = scanNumber reader cursor.window after char
                (NumberToken value, rest)
            else badAt reader cursor after "Unexpected character in JSON"

type PullState = { cursor : Cursor, pending : Maybe Token, depth : Int }

-- A pure, bounded view of one immutable text window. A completed value keeps
-- its container allowance unchanged. Negative allowance marks lookahead that
-- must be consumed through Pull before scanning can continue.
type Scan = { window : TextReader.Window, line : Int, column : Int, allowance : Int }

-- Suspensions return a step, so a long sequence of refills or unknown keys
-- runs through runScan's tail loop instead of nesting continuation calls.
type ScanStep a = ScanDone a Scan | ScanContinue (Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan))

-- Every typed value enters the same resumable parser, including when a
-- custom token consumer has left lookahead pending.
decodeValue : Decode a => () ->{Pull, Fail Error} a
decodeValue() =
    start = currentScan()
    (value, rest) = runScan (scanValue start)
    acceptScan rest
    value

runScan : Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan) ->{Pull, Fail Error} (a, Scan)
runScan result = case result of
    Ok value -> value
    Err suspendedAction -> case suspendedAction() of
        ScanDone value cursor -> (value, cursor)
        ScanContinue following -> runScan following

-- Keep recursive pure scans behind an explicitly pure thunk when their
-- suspended action executes in an effectful scope.
resumeScan : (() -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)) -> ScanStep a
resumeScan scan = ScanContinue scan()

finishScan : (() -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)) ->{Pull, Fail Error} (a, Scan)
finishScan scan = runScan scan()

-- A deferred action runs only after the pure scan reaches a boundary or a
-- token/custom decoder. It publishes that prefix and returns its new window.
scanFromPull : Scan -> (() ->{Pull, Fail Error} a) -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)
scanFromPull cursor action = Err {
    acceptScan cursor
    value = action()
    ScanDone value currentScan()
}

mapScan : (a -> b) -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan) -> Result (() ->{Pull, Fail Error} ScanStep b) (b, Scan)
mapScan convert result = case result of
    Ok (value, rest) -> Ok (convert value, rest)
    Err suspendedAction -> Err {
        (value, rest) = runScan (Err suspendedAction)
        ScanDone (convert value) rest
    }

tokenDepth : TextReader.Reader e -> Token -> Int -> Cursor ->{Fail Error | e} Int
tokenDepth reader token depth cursor =
    case token of
        BeginArray -> if depth >= 256 then bad reader cursor "JSON nesting exceeds 256 levels" else depth + 1
        BeginObject -> if depth >= 256 then bad reader cursor "JSON nesting exceeds 256 levels" else depth + 1
        EndArray -> depth - 1
        EndObject -> depth - 1
        _ -> depth

consumeToken : TextReader.Reader e -> PullState ->{Fail Error | e} (Token, PullState)
consumeToken reader state =
    (token, cursor) = case state.pending of
        Just token -> (token, state.cursor)
        Nothing -> lex reader state.cursor
    depth = tokenDepth reader token state.depth cursor
    (token, { state | cursor = cursor, pending = Nothing, depth = depth })

elementStart : TextReader.Reader e -> Bool -> PullState ->{Fail Error | e} (Bool, PullState)
elementStart reader trailing state =
    case state.pending of
        Just EndArray ->
            (_, after) = consumeToken reader state
            if trailing then bad reader after.cursor "Trailing array comma" else (False, after)
        Just _ -> (True, state)
        Nothing ->
            ready = skipWhite reader state.cursor
            (got, cursor) = peekChar reader ready
            if got == Just ']' then
                (_, rest) = takeChar reader cursor
                after = { state | cursor = rest, depth = state.depth - 1 }
                if trailing then bad reader rest "Trailing array comma" else (False, after)
            else (True, { state | cursor = cursor })

elementState : TextReader.Reader e -> Bool -> PullState ->{Fail Error | e} (Bool, PullState)
elementState reader first state =
    if first then elementStart reader False state
    else
        (separator, after) = consumeToken reader state
        case separator of
            EndArray -> (False, after)
            Comma -> elementStart reader True after
            _ -> bad reader after.cursor "Expected comma or array end"

type ElementRun = { more : Bool, window : TextReader.Window, line : Int, column : Int }

fastElementStart : TextReader.Window -> Bool -> Int -> Int -> Maybe ElementRun
fastElementStart snapshot trailing line column =
    case fastWhite snapshot line column of
        Nothing -> Nothing
        Just (start, nextLine, nextColumn) ->
            if TextReader.asciiAt start == 93 then
                if trailing then Nothing else Just (ElementRun { more = False, window = TextReader.skipAscii start, line = nextLine, column = nextColumn + 1 })
            else Just (ElementRun { more = True, window = start, line = nextLine, column = nextColumn })

fastElement : TextReader.Window -> Bool -> Int -> Int -> Maybe ElementRun
fastElement snapshot first line column =
    if first then fastElementStart snapshot False line column
    else case fastWhite snapshot line column of
        Nothing -> Nothing
        Just (start, nextLine, nextColumn) ->
            code = TextReader.asciiAt start
            if code == 93 then Just (ElementRun { more = False, window = TextReader.skipAscii start, line = nextLine, column = nextColumn + 1 })
            else if code == 44 then fastElementStart (TextReader.skipAscii start) True nextLine (nextColumn + 1)
            else Nothing

colonState : TextReader.Reader e -> String -> PullState ->{Fail Error | e} (Maybe String, PullState)
colonState reader key state =
    (token, after) = consumeToken reader state
    case token of
        Colon -> (Just key, after)
        _ -> bad reader after.cursor "Expected colon"

keyState : TextReader.Reader e -> Bool -> PullState ->{Fail Error | e} (Maybe String, PullState)
keyState reader first state =
    (token, after) = consumeToken reader state
    case token of
        EndObject -> (Nothing, after)
        StringTokenValue key ->
            if first then colonState reader key after
            else bad reader after.cursor "Expected comma or object end"
        Comma ->
            if first then bad reader after.cursor "Expected object key"
            else
                (keyToken, afterKey) = consumeToken reader after
                case keyToken of
                    EndObject -> bad reader afterKey.cursor "Trailing object comma"
                    StringTokenValue key -> colonState reader key afterKey
                    _ -> bad reader afterKey.cursor "Expected object key"
        _ -> bad reader after.cursor (if first then "Expected object key" else "Expected comma or object end")

type KeyRun = { key : Maybe String, window : TextReader.Window, line : Int, column : Int }

fastKeyColon : TextReader.Window -> String -> Int -> Int -> Maybe KeyRun
fastKeyColon snapshot key line column =
    case fastWhite snapshot line column of
        Nothing -> Nothing
        Just (start, nextLine, nextColumn) -> case TextReader.readWindow start of
            Ok (Just (':', width, rest)) -> Just (KeyRun { key = Just key, window = rest, line = nextLine, column = nextColumn + width })
            _ -> Nothing

fastKeyString : TextReader.Window -> Int -> Int -> Maybe KeyRun
fastKeyString snapshot line column =
    case fastString snapshot "" [] of
        Nothing -> Nothing
        Just (key, rest) -> fastKeyColon rest key line (column + TextReader.windowPosition rest - TextReader.windowPosition snapshot)

fastKeyName : TextReader.Window -> Int -> Int -> Maybe KeyRun
fastKeyName snapshot line column =
    case fastWhite snapshot line column of
        Nothing -> Nothing
        Just (start, nextLine, nextColumn) -> case TextReader.readWindow start of
            Ok (Just ('"', width, rest)) -> fastKeyString rest nextLine (nextColumn + width)
            _ -> Nothing

-- A record key, separator and colon form one buffered grammar operation. The
-- common path returns the key directly, without punctuation or string tokens.
fastKey : TextReader.Window -> Bool -> Int -> Int -> Maybe KeyRun
fastKey snapshot first line column =
    case fastWhite snapshot line column of
        Nothing -> Nothing
        Just (start, nextLine, nextColumn) -> case TextReader.readWindow start of
            Ok (Just ('}', width, rest)) -> Just (KeyRun { key = Nothing, window = rest, line = nextLine, column = nextColumn + width })
            Ok (Just ('"', width, rest)) ->
                if first then fastKeyString rest nextLine (nextColumn + width) else Nothing
            Ok (Just (',', width, rest)) ->
                if first then Nothing else fastKeyName rest nextLine (nextColumn + width)
            _ -> Nothing

-- Both buffered and refilled integers use this accumulator. A stopped run
-- retains its sign and grammar phase, including a minus awaiting its digit.
-- States 0/1 are whole positive/negative, 2/3 zero positive/negative,
-- 4 complete, and 5/6 awaiting a negative/positive first digit. Packing the
-- sign and phase keeps successful window results compact.
type IntegerRun = { value : Int, window : TextReader.Window, phase : Int }

integerNegative : IntegerRun -> Bool
integerNegative scanned = scanned.phase == 1 || scanned.phase == 3 || scanned.phase == 5

integerPhase : IntegerRun -> NumberPhase
integerPhase scanned = if scanned.phase >= 5 then MinusDigit else if scanned.phase == 2 || scanned.phase == 3 then ZeroEnd else WholeDigits

integerStopped : TextReader.Window -> Bool -> Bool -> Int -> IntegerRun
integerStopped snapshot negative zero value = IntegerRun { value = value, window = snapshot, phase = (if zero then 2 else 0) + (if negative then 1 else 0) }

-- Keep the magnitude negative so the full signed range, including minInt,
-- can be accumulated without overflow or a temporary decimal string.
integerDigits : TextReader.Window -> Bool -> Bool -> Int -> IntegerRun
integerDigits snapshot negative zero value =
    code = TextReader.asciiAt snapshot
    if code >= 48 && code <= 57 then
        if zero || value < -922337203685477580 || (value == -922337203685477580 && code - 48 > (if negative then 8 else 7)) then integerStopped snapshot negative zero value
        else integerDigits (TextReader.skipAscii snapshot) negative False (value * 10 - (code - 48))
    else if code == 46 || code == 101 || code == 69 || code == -1 then integerStopped snapshot negative zero value
    else if code == -2 then
        -- A malformed byte stays in the window for the source-aware driver.
        case TextReader.readWindow snapshot of
            Ok (Just _) -> IntegerRun { value = if negative then value else -value, window = snapshot, phase = 4 }
            _ -> integerStopped snapshot negative zero value
    else IntegerRun { value = if negative then value else -value, window = snapshot, phase = 4 }

integerFirst : TextReader.Window -> Bool -> IntegerRun
integerFirst snapshot negative =
    code = TextReader.asciiAt snapshot
    if code >= 48 && code <= 57 then integerDigits (TextReader.skipAscii snapshot) negative (code == 48) (48 - code)
    else IntegerRun { value = 0, window = snapshot, phase = if negative then 5 else 6 }

fastIntegerValue : TextReader.Window -> Int -> Int -> Maybe (IntegerRun, Int, Int)
fastIntegerValue snapshot line column = case fastWhite snapshot line column of
    Nothing -> Nothing
    Just (start, nextLine, nextColumn) ->
        code = TextReader.asciiAt start
        if code == 45 || (code >= 48 && code <= 57) then
            after = TextReader.skipAscii start
            scanned = if code == 45 then integerFirst after True else integerDigits after False (code == 48) (48 - code)
            Just (scanned, nextLine, nextColumn + TextReader.windowPosition scanned.window - TextReader.windowPosition start)
        else Nothing

integerWindows : TextReader.Reader e -> Cursor -> IntegerRun ->{Fail Error | e} (Result String Int, Cursor)
integerWindows reader before scanned =
    if scanned.phase == 4 then (Ok scanned.value, before)
    else
        (got, ready) = peekChar reader before
        case got of
            Nothing ->
                if scanned.phase >= 5 then bad reader ready "Expected digit after minus"
                else (Ok (if integerNegative scanned then scanned.value else -scanned.value), ready)
            Just _ ->
                nextRun = if scanned.phase >= 5 then integerFirst ready.window (integerNegative scanned) else integerDigits ready.window (integerNegative scanned) (scanned.phase == 2 || scanned.phase == 3) scanned.value
                width = TextReader.windowPosition nextRun.window - TextReader.windowPosition ready.window
                after = { ready | window = nextRun.window, offset = ready.offset + width, column = ready.column + width }
                if nextRun.phase == 4 then (Ok nextRun.value, after)
                else if width > 0 then integerWindows reader after nextRun
                else
                    -- A decimal, exponent, overflow or invalid digit still
                    -- needs complete number validation before type mismatch.
                    (_, rest) = numberWindows reader ready.window ready (integerPhase scanned) []
                    (Err "Expected 64-bit JSON integer", rest)

integerResult : String -> Result String Int
integerResult text = case String.toInt text of
    Just value -> Ok value
    Nothing -> Err "Expected 64-bit JSON integer"

floatResult : String -> Result String Float
floatResult text = case String.toFloat text of
    Just value -> Ok value
    Nothing -> Err "JSON number is outside Float range"

scanNumericToken : Scan -> Result (() ->{Pull, Fail Error} ScanStep String) (String, Scan)
scanNumericToken cursor = scanFromPull cursor {
    case next() of
        NumberToken text -> text
        _ -> syntaxError "Expected JSON number"
}

scanNumeric : Scan -> Result (() ->{Pull, Fail Error} ScanStep String) (String, Scan)
scanNumeric cursor =
    if cursor.allowance < 0 then scanNumericToken cursor
    else case fastWhite cursor.window cursor.line cursor.column of
        Nothing -> scanNumericToken cursor
        Just (start, line, column) -> case TextReader.readWindow start of
            Ok (Just (char, _, after)) ->
                if char == '-' || digit char then
                    phase = if char == '-' then MinusDigit else if char == '0' then ZeroEnd else WholeDigits
                    scanned = numberRun after phase
                    rest = { cursor | window = scanned.window, line = line, column = column + TextReader.windowPosition scanned.window - TextReader.windowPosition start }
                    if scanned.done then case TextReader.windowText start scanned.window of
                        Ok text -> Ok (text, rest)
                        Err _ -> scanNumericToken cursor
                    else Err {
                        -- The source driver receives the completed window run,
                        -- so it can refill without revisiting its digits.
                        position = { cursor | window = after, line = line, column = column + TextReader.windowPosition after - TextReader.windowPosition start }
                        (text, following) = numberTail position start scanned
                        ScanDone text following
                    }
                else scanNumericToken cursor
            _ -> scanNumericToken cursor

scanLiteral : Char -> String -> a -> Scan -> Maybe (Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan))
scanLiteral first suffix value cursor =
    if cursor.allowance < 0 then Nothing else case fastWhite cursor.window cursor.line cursor.column of
        Nothing -> Nothing
        Just (start, line, column) -> case TextReader.readWindow start of
            Ok (Just (char, _, after)) ->
                if char == first then case literalRun after suffix of
                    Ok rest -> Just (Ok (value, { cursor | window = rest, line = line, column = column + TextReader.windowPosition rest - TextReader.windowPosition start }))
                    Err (stopped, remaining) ->
                        position = { cursor | window = stopped, line = line, column = column + TextReader.windowPosition stopped - TextReader.windowPosition start }
                        Just (Err {
                                rest = literalTail position remaining
                                ScanDone value rest
                        })
                else Nothing
            _ -> Nothing

scanOpen : Char -> Scan -> Maybe Scan
scanOpen wanted cursor =
    if cursor.allowance <= 0 then Nothing
    else case fastWhite cursor.window cursor.line cursor.column of
        Nothing -> Nothing
        Just (start, line, column) ->
            if TextReader.asciiAt start == Char.toCode wanted then Just { cursor | window = TextReader.skipAscii start, line = line, column = column + 1, allowance = cursor.allowance - 1 }
            else Nothing

scanMark : Char -> Scan -> Maybe Scan
scanMark wanted cursor = if cursor.allowance < 0 then Nothing else case fastWhite cursor.window cursor.line cursor.column of
    Nothing -> Nothing
    Just (start, line, column) ->
        if TextReader.asciiAt start == Char.toCode wanted then Just { cursor | window = TextReader.skipAscii start, line = line, column = column + 1 }
        else Nothing

scanExpectedKey : Bool -> String -> Scan -> Maybe Scan
scanExpectedKey first quoted cursor =
    separated = if first then Just cursor else scanMark ',' cursor
    case separated of
        Nothing -> Nothing
        Just before -> case fastWhite before.window before.line before.column of
            Nothing -> Nothing
            Just (start, line, column) -> case TextReader.matchWindow start quoted of
                Nothing -> Nothing
                Just rest -> scanMark ':' { before | window = rest, line = line, column = column + TextReader.windowPosition rest - TextReader.windowPosition start }

scanObjectEnd : Scan -> Maybe Scan
scanObjectEnd cursor = case scanMark '}' cursor of
    Nothing -> Nothing
    Just rest -> Just { rest | allowance = rest.allowance + 1 }

-- Leave the next key at its opening quote, so generated dispatch can compare
-- encoded spellings without constructing a String for each key.
scanObjectField : Bool -> Scan -> Maybe (Bool, Scan)
scanObjectField first cursor = if cursor.allowance < 0 then Nothing else case fastWhite cursor.window cursor.line cursor.column of
    Nothing -> Nothing
    Just (start, line, column) ->
        code = TextReader.asciiAt start
        if code == 125 then Just (False, { cursor | window = TextReader.skipAscii start, line = line, column = column + 1, allowance = cursor.allowance + 1 })
        else if code == 34 then
            if first then Just (True, { cursor | window = start, line = line, column = column })
            else Nothing
        else if code == 44 then
            if first then Nothing
            else case fastWhite (TextReader.skipAscii start) line (column + 1) of
                Nothing -> Nothing
                Just (key, keyLine, keyColumn) ->
                    if TextReader.asciiAt key == 34 then Just (True, { cursor | window = key, line = keyLine, column = keyColumn })
                    else Nothing
        else Nothing

scanElement : Bool -> Scan -> Maybe (Bool, Scan)
scanElement first cursor = if cursor.allowance < 0 then Nothing else case fastElement cursor.window first cursor.line cursor.column of
    Nothing -> Nothing
    Just scanned -> Just (scanned.more, { cursor | window = scanned.window, line = scanned.line, column = scanned.column, allowance = if scanned.more then cursor.allowance else cursor.allowance + 1 })

scanListMore : (Scan -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)) -> Int -> Bool -> List a -> Scan -> Result (() ->{Pull, Fail Error} ScanStep (List a)) (List a, Scan)
scanListMore scan index first reverse cursor = case scanElement first cursor of
    Nothing -> Err {
        acceptScan cursor
        if nextElement first then
            (value, rest) = withIndex index {
                position = currentScan()
                runScan (scan position)
            }
            resumeScan { scanListMore scan (index + 1) False [value | reverse] rest }
        else ScanDone (List.reverse reverse) currentScan()
    }
    Just (False, rest) -> Ok (List.reverse reverse, rest)
    Just (True, start) -> case scan start of
        Ok (value, rest) -> scanListMore scan (index + 1) False [value | reverse] rest
        Err suspendedAction -> Err {
            (value, rest) = withIndex index { runScan (Err suspendedAction) }
            resumeScan { scanListMore scan (index + 1) False [value | reverse] rest }
        }

scanListShort : (Scan -> Result (() ->{Pull, Fail Error} ScanStep a) (a, Scan)) -> Int -> Bool -> Int -> Scan -> Result (() ->{Pull, Fail Error} ScanStep (List a)) (List a, Scan)
scanListShort scan index first remaining cursor =
    if remaining == 0 then scanListMore scan index first [] cursor
    else case scanElement first cursor of
        Nothing -> Err {
            acceptScan cursor
            if nextElement first then
                (value, rest) = withIndex index {
                    position = currentScan()
                    runScan (scan position)
                }
                (tail, after) = finishScan { scanListShort scan (index + 1) False (remaining - 1) rest }
                ScanDone [value | tail] after
            else ScanDone [] currentScan()
        }
        Just (False, rest) -> Ok ([], rest)
        Just (True, start) -> case scan start of
            Ok (value, rest) -> case scanListShort scan (index + 1) False (remaining - 1) rest of
                Ok (tail, after) -> Ok ([value | tail], after)
                Err suspendedAction -> Err {
                    (tail, after) = runScan (Err suspendedAction)
                    ScanDone [value | tail] after
                }
            Err suspendedAction -> Err {
                (value, rest) = withIndex index { runScan (Err suspendedAction) }
                (tail, after) = finishScan { scanListShort scan (index + 1) False (remaining - 1) rest }
                ScanDone [value | tail] after
            }

scanState : PullState -> Scan
scanState state = Scan
    { window = state.cursor.window
    , line = state.cursor.line
    , column = state.cursor.column
    , allowance = case state.pending of
        Nothing -> 256 - state.depth
        Just _ -> -1
    }

scanCursor : Cursor -> Scan -> Cursor
scanCursor before scanned =
    width = TextReader.windowPosition scanned.window - TextReader.windowPosition before.window
    { before | window = scanned.window, offset = before.offset + width, line = scanned.line, column = scanned.column }

withPull : Reader e -> (() ->{Pull, Fail Error} a) ->{e} Result Error a
withPull reader action =
    TextReader.over reader { text -> withTextPull text action }

withTextPull : TextReader.Reader e -> (() ->{Pull, Fail Error} a) ->{e} Result Error a
withTextPull reader action =
    initial = TextReader.window reader
    Fail.attempt {
        handle Runtime.Scope.finally action { ignore at() } with state = PullState { cursor = Cursor { window = initial, ended = False, offset = 0, line = 1, column = 1, path = [] }, pending = Nothing, depth = 0 } of
            peek () ->
                case state.pending of
                    Just token -> resume token with state
                    Nothing ->
                        (token, cursor) = lex reader state.cursor
                        resume token with { state | cursor = cursor, pending = Just token }
            next () ->
                case state.pending of
                    Just token ->
                        depth = tokenDepth reader token state.depth state.cursor
                        resume token with { state | pending = Nothing, depth = depth }
                    Nothing ->
                        (token, cursor) = lex reader state.cursor
                        depth = tokenDepth reader token state.depth cursor
                        resume token with { state | cursor = cursor, pending = Nothing, depth = depth }
            arrayElement first ->
                buffered = case state.pending of
                    Just _ -> Nothing
                    Nothing -> fastElement state.cursor.window first state.cursor.line state.cursor.column
                case buffered of
                    Nothing ->
                        (more, after) = elementState reader first state
                        resume more with after
                    Just scanned ->
                        width = TextReader.windowPosition scanned.window - TextReader.windowPosition state.cursor.window
                        cursor = { state.cursor | window = scanned.window, offset = state.cursor.offset + width, line = scanned.line, column = scanned.column }
                        depth = if scanned.more then state.depth else state.depth - 1
                        resume scanned.more with { state | cursor = cursor, depth = depth }
            objectKey first ->
                buffered = case state.pending of
                    Just _ -> Nothing
                    Nothing -> fastKey state.cursor.window first state.cursor.line state.cursor.column
                case buffered of
                    Nothing ->
                        (key, after) = keyState reader first state
                        resume key with after
                    Just scanned ->
                        width = TextReader.windowPosition scanned.window - TextReader.windowPosition state.cursor.window
                        cursor = { state.cursor | window = scanned.window, offset = state.cursor.offset + width, line = scanned.line, column = scanned.column }
                        depth = case scanned.key of
                            Nothing -> state.depth - 1
                            Just _ -> state.depth
                        resume scanned.key with { state | cursor = cursor, depth = depth }
            decodedString () ->
                (token, after) = consumeToken reader state
                value = case token of
                    StringTokenValue text -> Ok text
                    _ -> Err "Expected JSON string"
                resume value with after
            decodedInt () ->
                buffered = case state.pending of
                    Just _ -> Nothing
                    Nothing -> fastIntegerValue state.cursor.window state.cursor.line state.cursor.column
                case buffered of
                    Just (scanned, line, column) ->
                        width = TextReader.windowPosition scanned.window - TextReader.windowPosition state.cursor.window
                        before = { state.cursor | window = scanned.window, offset = state.cursor.offset + width, line = line, column = column }
                        (value, cursor) = integerWindows reader before scanned
                        resume value with { state | cursor = cursor }
                    Nothing ->
                        (token, after) = consumeToken reader state
                        value = case token of
                            NumberToken text -> integerResult text
                            _ -> Err "Expected JSON number"
                        resume value with after
            decodedFloat () ->
                (token, after) = consumeToken reader state
                value = case token of
                    NumberToken text -> floatResult text
                    _ -> Err "Expected JSON number"
                resume value with after
            bufferedScan () ->
                view = case state.pending of
                    Just _ -> Nothing
                    Nothing -> Just (scanState state)
                resume view with state
            currentScan () -> resume (scanState state) with state
            stringTail scanned current reverse ->
                before = scanCursor state.cursor scanned
                (text, cursor) = scanString reader before current reverse
                after = { state | cursor = cursor, depth = 256 - scanned.allowance }
                resume (text, scanState after) with after
            literalTail scanned remaining ->
                before = scanCursor state.cursor scanned
                cursor = literal reader before remaining
                after = { state | cursor = cursor, depth = 256 - scanned.allowance }
                resume (scanState after) with after
            numberTail scanned start run ->
                before = scanCursor state.cursor scanned
                (text, cursor) = numberScanned reader start before run []
                after = { state | cursor = cursor, depth = 256 - scanned.allowance }
                resume (text, scanState after) with after
            integerTail scanned run ->
                before = scanCursor state.cursor scanned
                (value, cursor) = integerWindows reader before run
                after = { state | cursor = cursor, depth = 256 - scanned.allowance }
                resume (value, scanState after) with after
            acceptScan scanned ->
                if scanned.allowance < 0 then resume () with state
                else resume () with { state | cursor = scanCursor state.cursor scanned, depth = 256 - scanned.allowance }
            at () ->
                TextReader.commitWindow reader state.cursor.window
                resume (errorAt state.cursor "") with state
            enter segment ->
                resume () with { state | cursor = { state.cursor | path = [Segment { key = segment, index = Nothing } | state.cursor.path] } }
            enterIndex index ->
                resume () with { state | cursor = { state.cursor | path = [Segment { key = "", index = Just index } | state.cursor.path] } }
            leave () ->
                case state.cursor.path of
                    [] -> resume () with state
                    [_ | rest] -> resume () with { state | cursor = { state.cursor | path = rest } }
            return value -> value
    }

syntaxError : String ->{Pull, Fail Error} a
syntaxError message = fail { at() | message = message }

withPath : String -> (() ->{Pull, Fail Error} a) ->{Pull, Fail Error} a
withPath segment action =
    Runtime.Scope.bracket { enter segment } { leave() } { action() }

withIndex : Int -> (() ->{Pull, Fail Error} a) ->{Pull, Fail Error} a
withIndex index action =
    Runtime.Scope.bracket { enterIndex index } { leave() } { action() }

beginArray : () ->{Pull, Fail Error} ()
beginArray() =
    case next() of
        BeginArray -> ()
        _ -> syntaxError "Expected JSON array"

nextElement : Bool ->{Pull} Bool
nextElement first = arrayElement first

beginObject : () ->{Pull, Fail Error} ()
beginObject() =
    case next() of
        BeginObject -> ()
        _ -> syntaxError "Expected JSON object"

-- A key and its colon never need lookahead: consume them directly.
nextKey : Bool ->{Pull} Maybe String
nextKey first = objectKey first

expectComma : () ->{Pull, Fail Error} ()
expectComma() =
    case next() of
        Comma -> ()
        _ -> syntaxError "Expected union field separator"

finishPayload : a ->{Pull, Fail Error} a
finishPayload value =
    case next() of
        EndArray -> ()
        _ -> syntaxError "Expected end of union field array"
    case next() of
        EndObject -> value
        _ -> syntaxError "Expected end of tagged union object"

decodeUnion : (String ->{Pull, Fail Error} a) -> (String ->{Pull, Fail Error} a) ->{Pull, Fail Error} a
decodeUnion nullary payload =
    case next() of
        StringTokenValue tag -> nullary tag
        BeginObject ->
            tag = case next() of
                StringTokenValue text -> text
                _ -> syntaxError "Expected union tag"
            case next() of
                Colon -> ()
                _ -> syntaxError "Expected colon after union tag"
            beginArray()
            payload tag
        _ -> syntaxError "Expected tagged JSON union"

readValue : () ->{Pull, Fail Error} Value
readValue() =
    case next() of
        NullToken -> Null
        BooleanToken value -> Boolean value
        NumberToken text -> Numeric (Number text)
        StringTokenValue text -> Text text
        BeginArray -> Array (readArray 0 [])
        BeginObject -> Object (readObject [])
        _ -> syntaxError "Expected JSON value"

readArray : Int -> List Value ->{Pull, Fail Error} List Value
readArray index reverse =
    case peek() of
        EndArray ->
            ignore next()
            List.reverse reverse
        _ ->
            value = withIndex index { readValue() }
            case next() of
                Comma -> readArrayAfterComma (index + 1) [value | reverse]
                EndArray -> List.reverse [value | reverse]
                _ -> syntaxError "Expected comma or array end"

readArrayAfterComma : Int -> List Value ->{Pull, Fail Error} List Value
readArrayAfterComma index reverse =
    case peek() of
        EndArray -> syntaxError "Trailing array comma"
        _ -> readArray index reverse

readObject : List (String, Value) ->{Pull, Fail Error} List (String, Value)
readObject reverse =
    case peek() of
        EndObject ->
            ignore next()
            List.reverse reverse
        _ ->
            key = case next() of
                StringTokenValue text -> text
                _ -> syntaxError "Expected object key"
            case next() of
                Colon -> ()
                _ -> syntaxError "Expected colon"
            value = withPath key { readValue() }
            case next() of
                Comma -> readObjectAfterComma [(key, value) | reverse]
                EndObject -> List.reverse [(key, value) | reverse]
                _ -> syntaxError "Expected comma or object end"

readObjectAfterComma : List (String, Value) ->{Pull, Fail Error} List (String, Value)
readObjectAfterComma reverse =
    case peek() of
        EndObject -> syntaxError "Trailing object comma"
        _ -> readObject reverse

skipValue : () ->{Pull, Fail Error} ()
skipValue() =
    case next() of
        BeginArray -> skipArray True
        BeginObject -> skipObject True
        StringTokenValue _ -> ()
        NumberToken _ -> ()
        BooleanToken _ -> ()
        NullToken -> ()
        _ -> syntaxError "Expected JSON value"

skipArray : Bool ->{Pull, Fail Error} ()
skipArray first =
    if nextElement first then
        skipValue()
        skipArray False
    else ()

skipObject : Bool ->{Pull, Fail Error} ()
skipObject first =
    case nextKey first of
        Nothing -> ()
        Just _ ->
            skipValue()
            skipObject False

parseBytes : Decode a => Type a -> Bytes -> Result Error a
parseBytes _ input =
    Reader.withBytes input { reader ->
        withPull reader {
            value = decodeValue()
            case next() of
                EndInput -> value
                _ -> syntaxError "Trailing JSON input"
        }
    }

parse : Decode a => Type a -> String -> Result Error a
parse witness text = parseBytes witness (Bytes.fromString text)

read : Decode a => Type a -> Reader e ->{e} Result Error a
read _ reader =
    withPull reader {
        value = decodeValue()
        case next() of
            EndInput -> value
            _ -> syntaxError "Trailing JSON input"
    }

readText : Decode a => Type a -> TextReader.Reader e ->{e} Result Error a
readText _ reader =
    withTextPull reader {
        value = decodeValue()
        case next() of
            EndInput -> value
            _ -> syntaxError "Trailing JSON input"
    }

instance Decode String
    scanValue cursor = scanStringValue cursor

instance Decode Char
    scanValue cursor = scanFromPull cursor {
        case next() of
            StringTokenValue text ->
                case String.uncons text of
                    Just part -> if part.rest == "" then part.first else syntaxError "Expected one JSON character"
                    Nothing -> syntaxError "Expected one JSON character"
            _ -> syntaxError "Expected JSON string"
    }

pullString : () ->{Pull, Fail Error} String
pullString() = case decodedString() of
    Ok text -> text
    Err message -> syntaxError message

scanStringValue : Scan -> Result (() ->{Pull, Fail Error} ScanStep String) (String, Scan)
scanStringValue cursor =
    if cursor.allowance < 0 then scanFromPull cursor { pullString() }
    else case fastWhite cursor.window cursor.line cursor.column of
        Nothing -> scanFromPull cursor { pullString() }
        Just (start, line, column) -> case TextReader.readWindow start of
            Ok (Just ('"', _, afterQuote)) -> case stringRun afterQuote "" [] of
                Ok (text, rest) -> Ok (text, { cursor | window = rest, line = line, column = column + TextReader.windowPosition rest - TextReader.windowPosition start })
                Err (stopped, current, reverse) ->
                    rest = { cursor | window = stopped, line = line, column = column + TextReader.windowPosition stopped - TextReader.windowPosition start }
                    Err {
                        (value, after) = stringTail rest current reverse
                        ScanDone value after
                    }
            _ -> scanFromPull cursor { pullString() }

instance Decode Int
    scanValue cursor =
        buffered = if cursor.allowance < 0 then Nothing else fastIntegerValue cursor.window cursor.line cursor.column
        case buffered of
            Just (scanned, line, column) ->
                rest = { cursor | window = scanned.window, line = line, column = column }
                if scanned.phase == 4 then Ok (scanned.value, rest)
                else Err {
                    (result, after) = integerTail rest scanned
                    case result of
                        Ok value -> ScanDone value after
                        Err message -> syntaxError message
                }
            Nothing -> scanFromPull cursor {
                case decodedInt() of
                    Ok value -> value
                    Err message -> syntaxError message
            }

instance Decode Float
    scanValue cursor = case scanNumeric cursor of
        Ok (text, rest) -> case floatResult text of
            Ok value -> Ok (value, rest)
            Err message -> scanFromPull rest { syntaxError message }
        Err suspendedAction -> Err {
            (text, rest) = runScan (Err suspendedAction)
            case floatResult text of
                Ok value -> ScanDone value rest
                Err message ->
                    acceptScan rest
                    syntaxError message
        }

instance Decode Bool
    scanValue cursor =
        scanned = case scanLiteral 't' "rue" True cursor of
            Just result -> Just result
            Nothing -> scanLiteral 'f' "alse" False cursor
        case scanned of
            Just result -> result
            Nothing -> scanFromPull cursor {
                case next() of
                    BooleanToken value -> value
                    _ -> syntaxError "Expected JSON boolean"
            }

instance Decode ()
    scanValue cursor = case scanLiteral 'n' "ull" () cursor of
        Just result -> result
        Nothing -> scanFromPull cursor {
            case next() of
                NullToken -> ()
                _ -> syntaxError "Expected JSON null"
        }

instance Decode a => Decode (List a)
    scanValue cursor = case scanOpen '[' cursor of
        Nothing -> Err {
            acceptScan cursor
            beginArray()
            position = currentScan()
            resumeScan { scanListShort scanValue 0 True 8 position }
        }
        Just start -> scanListShort scanValue 0 True 8 start

instance Decode a => Decode (Maybe a)
    scanValue cursor = case scanLiteral 'n' "ull" () cursor of
        Just result -> mapScan { _ -> Nothing } result
        Nothing -> case fastWhite cursor.window cursor.line cursor.column of
            Nothing -> scanFromPull cursor { pullMaybe() }
            Just (start, _, _) -> case TextReader.peekWindow start of
                Ok (Just ('n', _)) -> scanFromPull cursor { pullMaybe() }
                Ok (Just _) ->
                    if cursor.allowance < 0 then scanFromPull cursor { pullMaybe() }
                    else case scanValue cursor of
                        Ok (value, rest) -> Ok (Just value, rest)
                        Err suspendedAction -> Err {
                            (value, rest) = runScan (Err suspendedAction)
                            ScanDone (Just value) rest
                        }
                _ -> scanFromPull cursor { pullMaybe() }

pullMaybe : Decode a => () ->{Pull, Fail Error} Maybe a
pullMaybe() = case peek() of
    NullToken ->
        ignore next()
        Nothing
    _ -> Just decodeValue()

instance Decode Value
    scanValue cursor = scanFromPull cursor { readValue() }

withWriter : Writer e -> (() ->{Emit, Fail Error} a) ->{e} Result Error a
withWriter writer action = TextWriter.borrow writer { text -> withTextWriter text action }

withTextWriter : TextWriter.Writer e -> (() ->{Emit, Fail Error} a) ->{e} Result Error a
withTextWriter writer action =
    Fail.attempt {
        handle action() of
            emit text ->
                case TextWriter.tryWrite writer text of
                    Ok _ -> resume ()
                    Err problem -> fail (Error { message = Encoding.message problem, offset = -1, line = 0, column = 0, path = "" })
            return value -> value
    }

write : Encode a => Writer e -> a ->{e} Result Error ()
write writer value = withWriter writer { encodeValue value }

writeText : Encode a => TextWriter.Writer e -> a ->{e} Result Error ()
writeText writer value = withTextWriter writer { encodeValue value }

stringify : Encode a => a -> Result Error String
stringify value =
    (outcome, text) = TextWriter.collecting { writer -> writeText writer value }
    case outcome of
        Err problem -> Err problem
        Ok _ -> Ok text

hexChar : Int -> String
hexChar value = String.slice value (value + 1) "0123456789abcdef"

escapeChar : Char -> String
escapeChar char =
    code = Char.toCode char
    if char == '"' then "\\\""
    else if char == '\\' then "\\\\"
    else if code == 8 then "\\b"
    else if code == 12 then "\\f"
    else if char == '\n' then "\\n"
    else if char == '\r' then "\\r"
    else if char == '\t' then "\\t"
    else "\\u00" ++ hexChar (quotientBy 16 code) ++ hexChar (remainderBy 16 code)

plainChar : Char -> Bool
plainChar char = char /= '"' && char /= '\\' && Char.toCode char >= 32

emitStringBody : String ->{Emit} ()
emitStringBody text =
    (run, rest) = String.span plainChar text
    if run == "" then () else emit run
    case String.uncons rest of
        Nothing -> ()
        Just part ->
            emit (escapeChar part.first)
            emitStringBody part.rest

emitString : String ->{Emit} ()
emitString text =
    emit "\""
    emitStringBody text
    emit "\""

instance Encode String
    encodeValue value = emitString value

instance Encode Char
    encodeValue value = emitString (String.fromChar value)

instance Encode Int
    encodeValue value = emit (show value)

instance Encode Float
    encodeValue value =
        text = show value
        if text == "NaN" || text == "Infinity" || text == "-Infinity" then
            fail (Error { message = "Non-finite Float is not JSON", offset = -1, line = 0, column = 0, path = "" })
        else emit text

instance Encode Bool
    encodeValue value = emit (if value then "true" else "false")

instance Encode ()
    encodeValue _ = emit "null"

emitList : Encode a => List a -> Bool ->{Emit, Fail Error} ()
emitList values first =
    case values of
        [] -> ()
        [value | rest] ->
            if first then () else emit ","
            encodeValue value
            emitList rest False

instance Encode a => Encode (List a)
    encodeValue values =
        emit "["
        emitList values True
        emit "]"

instance Encode a => Encode (Maybe a)
    encodeValue value =
        case value of
            Nothing -> emit "null"
            Just present -> encodeValue present

instance Encode Value
    encodeValue value = emitValue value

emitValue : Value ->{Emit, Fail Error} ()
emitValue value =
    case value of
        Null -> emit "null"
        Boolean item -> encodeValue item
        Numeric (Number text) -> emit text
        Text text -> emitString text
        Array items ->
            emit "["
            emitValueList items True
            emit "]"
        Object entries ->
            emit "{"
            emitObject entries True
            emit "}"

emitValueList : List Value -> Bool ->{Emit, Fail Error} ()
emitValueList items first =
    case items of
        [] -> ()
        [item | rest] ->
            if first then () else emit ","
            emitValue item
            emitValueList rest False

emitObject : List (String, Value) -> Bool ->{Emit, Fail Error} ()
emitObject entries first =
    case entries of
        [] -> ()
        [(key, value) | rest] ->
            if first then () else emit ","
            emitString key
            emit ":"
            emitValue value
            emitObject rest False

stringifyValue : Value -> Result Error String
stringifyValue value = stringify value

sequenceCode : Code -> Code -> Code
sequenceCode left right = `{ $(left); $(right) }()`

emitCode : String -> Code
emitCode text = `emit $(lift text)`

quotedCode : String -> Code
quotedCode text = `emitString $(lift text)`

recordField : (Code, Bool) -> BoundField -> (Code, Bool)
recordField (prefix, first) field =
    settings = fieldSettings field.name field.attributes
    if settings.skip then (prefix, first)
    else
        separator = if first then "" else ","
        ( sequenceCode prefix
            (sequenceCode (emitCode separator)
                (sequenceCode (quotedCode settings.key)
                    (sequenceCode (emitCode ":") `encodeValue $(field.value)`)
                )
            )
        , False
        )

recordBody : Bound -> Code
recordBody bound =
    (fields, _) = Meta.foldItems recordField (emitCode "", True) bound.fields
    sequenceCode (emitCode "{")
        (sequenceCode fields (emitCode "}"))

unionField : Code -> BoundField -> Code
unionField prefix field =
    separator = if field.index == 0 then "" else ","
    sequenceCode prefix
        (sequenceCode (emitCode separator) `encodeValue $(field.value)`)

unionBody : Bound -> Code
unionBody bound =
    case bound.fields of
        NoItems -> quotedCode bound.ctor.name
        _ ->
            sequenceCode (emitCode "{")
                (sequenceCode (quotedCode bound.ctor.name)
                    (sequenceCode (emitCode ":[")
                        (sequenceCode (Meta.foldItems unionField (emitCode "") bound.fields)
                            (emitCode "]}")
                        )
                    )
                )

derivedEncode : TypeInfo -> Bound -> Code
derivedEncode subject bound =
    case subject.shape of
        Record _ -> recordBody bound
        Union _ -> unionBody bound

deriver Encode
    encodeValue subject valueCode =
        validateJSONSchema subject
        Meta.match subject valueCode (derivedEncode subject)

type Slot = { field : Field, read : Code }

slotValue : Slot -> Code
slotValue slot =
    settings = fieldSettings slot.field.name slot.field.attributes
    case settings.fallback of
        Nothing ->
            `case $(slot.read) of
                    Just value -> value
                    Nothing -> withPath $(lift settings.key) { syntaxError $(lift ("Missing JSON field: " ++ settings.key)) }`
        Just fallback ->
            if settings.skip then fallback
            else
                `case $(slot.read) of
                        Just value -> value
                        Nothing -> $(fallback)`

fieldSlots : Items Field -> Items Code -> Items Slot
fieldSlots fields values = case (fields, values) of
    (NoItems, NoItems) -> NoItems
    (Item field rest, Item value more) -> Item (Slot { field = field, read = value }) (fieldSlots rest more)
    _ ->
        ignore (Meta.fail "Generated JSON field arguments do not match the record fields.")
        NoItems

-- Defaults may execute consumer effects. Defer final construction for these
-- schemas instead of evaluating a default speculatively in a pure scan.
scanRecordSupported : Items Field -> Bool
scanRecordSupported fields = Meta.foldItems { supported field ->
    settings = fieldSettings field.name field.attributes
    supported && settings.skip == False && (case settings.fallback of
            Nothing -> True
            Just _ -> False)
} True fields

appendCode : Items Code -> Code -> Items Code
appendCode values value = case values of
    NoItems -> Item value NoItems
    Item first rest -> Item first (appendCode rest value)

scanOr : Code -> Code -> (Code -> Code) -> Code
scanOr expression fallback build = case Meta.info (typeOf (Maybe ())) of
    Meta.Opaque -> Meta.fail "Expected visible Maybe constructors"
    Meta.Visible schema -> Meta.match schema expression { bound ->
        case bound.fields of
            NoItems -> fallback
            Item value _ -> build value.value
    }

scanPair : Code -> (Code -> Code -> Code) -> Code
scanPair expression build = case Meta.info (typeOf ((), ())) of
    Meta.Opaque -> Meta.fail "Expected visible tuple constructor"
    Meta.Visible schema -> Meta.match schema expression { bound ->
        case bound.fields of
            Item value (Item cursor NoItems) -> build value.value cursor.value
            _ -> Meta.fail "Expected pair fields"
    }

scanResultPair : Code -> (Code -> Code -> Code) -> (Code -> Code) -> Code
scanResultPair expression complete suspended = case Meta.info (typeOf (Result () ())) of
    Meta.Opaque -> Meta.fail "Expected visible Result constructors"
    Meta.Visible schema -> Meta.match schema expression { bound ->
        case bound.fields of
            Item field NoItems ->
                if bound.ctor.name == "Ok" then scanPair field.value complete
                else suspended field.value
            _ -> Meta.fail "Expected scan result"
    }

scanQuotedKey : Field -> Code
scanQuotedKey field = case stringify (fieldSettings field.name field.attributes).key of
    Ok text -> lift text
    Err _ -> Meta.fail "Invalid JSON field key"

callScanFields : Code -> Code -> Code -> Items Code -> Code
callScanFields loop cursor first values = Meta.foldItems { call value -> `$(call) $(value)` } `$(loop) $(cursor) $(first)` values

scanFinishFields : Ctor -> Items Slot -> Items Slot -> Items Code -> Code -> Code
scanFinishFields ctor allSlots slots values cursor = case slots of
    NoItems -> `Ok ($(Meta.construct ctor values), $(cursor))`
    Item slot tail ->
        fallback = `scanFromPull $(cursor) { $(Meta.construct ctor (Meta.mapItems slotValue allSlots)) }`
        scanOr slot.read fallback { value -> scanFinishFields ctor allSlots tail (appendCode values value) cursor }

scanResumeField : Code -> Slot -> (Code -> Code -> Code) -> Code
scanResumeField suspendedAction slot continue =
    key = (fieldSettings slot.field.name slot.field.attributes).key
    `Err { $(scanPair `withPath $(lift key) { runScan (Err $(suspendedAction)) }` { value rest -> `resumeScan { $(continue value rest) }` }) }`

scanSlotHandler : Code -> Items Slot -> Code -> Code -> Slot -> Code
scanSlotHandler loop slots cursor fallback slot =
    settings = fieldSettings slot.field.name slot.field.attributes
    if settings.skip then fallback
    else
        continue = { value rest ->
            values = Meta.mapItems { candidate ->
                if candidate.field.index == slot.field.index then `Just $(value)` else candidate.read
            } slots
            callScanFields loop rest `False` values
        }
        scanOr `scanExpectedKey True $(scanQuotedKey slot.field) $(cursor)` fallback { start ->
            duplicate = `scanFromPull $(start) { withPath $(lift settings.key) { syntaxError $(lift ("Duplicate JSON field: " ++ settings.key)) } }`
            decodeField = scanResultPair `scanValue $(start)` continue { suspendedAction -> scanResumeField suspendedAction slot continue }
            scanOr slot.read decodeField { _ -> duplicate }
        }

-- The slow key branch shares the already decoded fields with the pure loop.
-- After parsing a split/escaped/unknown key, resume the same buffered loop.
scanStreamingSlot : Code -> Items Slot -> Code -> Code -> Slot -> Code
scanStreamingSlot loop slots key fallback slot =
    settings = fieldSettings slot.field.name slot.field.attributes
    if settings.skip then fallback
    else
        decoded = scanPair `withPath $(lift settings.key) {
                position = currentScan()
                runScan (scanValue position)
        }` { value rest ->
            values = Meta.mapItems { candidate ->
                if candidate.field.index == slot.field.index then `Just $(value)` else candidate.read
            } slots
            `resumeScan { $(callScanFields loop rest `False` values) }`
        }
        duplicate = `withPath $(lift settings.key) { syntaxError $(lift ("Duplicate JSON field: " ++ settings.key)) }`
        `if $(key) == $(lift settings.key) then $(scanOr slot.read decoded { _ -> duplicate }) else $(fallback)`

scanStreamingKey : Ctor -> Code -> Items Slot -> Code -> Code -> Code
scanStreamingKey ctor loop slots first cursor =
    values = Meta.mapItems { slot -> slot.read } slots
    finish = `ScanDone $(Meta.construct ctor (Meta.mapItems slotValue slots)) (currentScan())`
    `Err {
        acceptScan $(cursor)
        $(case Meta.info (typeOf (Maybe String)) of
            Meta.Opaque -> Meta.fail "Expected visible Maybe constructors"
            Meta.Visible schema -> Meta.match schema `nextKey $(first)` { bound ->
                case bound.fields of
                    NoItems -> finish
                    Item key NoItems ->
                        skipped = Meta.sequence `withPath $(key.value) { skipValue() }` `$(scanPair `((), currentScan())` { _ position -> `resumeScan { $(callScanFields loop position `False` values) }` })`
                        Meta.foldItems (scanStreamingSlot loop slots key.value) skipped slots
                    _ -> Meta.fail "Expected object key"
            })
    }`

scanOrderedFields : Ctor -> Code -> Items Field -> Items Code -> Bool -> Code -> Code
scanOrderedFields ctor loop fields values first cursor = case fields of
    NoItems ->
        fallback = callScanFields loop cursor (lift first) (Meta.mapItems { value -> `Just $(value)` } values)
        scanOr `scanObjectEnd $(cursor)` fallback { rest -> `Ok ($(Meta.construct ctor values), $(rest))` }
    Item field tail ->
        saved = Meta.mapItems { value -> `Just $(value)` } values
        pending = Meta.mapItems { _ -> `Nothing` } fields
        fallback = callScanFields loop cursor (lift first) (Meta.foldItems appendCode saved pending)
        scanOr `scanExpectedKey $(lift first) $(scanQuotedKey field) $(cursor)` fallback { start ->
            scanResultPair `scanValue $(start)` { value rest ->
                scanOrderedFields ctor loop tail (appendCode values value) False rest
            } { suspendedAction ->
                slot = Slot { field = field, read = `Nothing` }
                scanResumeField suspendedAction slot { value rest ->
                    completed = Meta.mapItems { savedValue -> `Just $(savedValue)` } (appendCode values value)
                    remaining = Meta.mapItems { _ -> `Nothing` } tail
                    callScanFields loop rest `False` (Meta.foldItems appendCode completed remaining)
                }
            }
        }

recordScanner : Ctor -> Code
recordScanner ctor = Meta.lambda "_json_scan_start" { cursor ->
    parameters = Item "_json_scan_cursor" (Item "_json_scan_first" (Meta.mapItems { field -> "_json_scan_slot_" ++ show field.index } ctor.fields))
    Meta.localFunction "_json_scan_fields" parameters { loop arguments ->
        case arguments of
            Item position (Item first values) ->
                slots = fieldSlots ctor.fields values
                fallback = scanStreamingKey ctor loop slots first position
                scanOr `scanObjectField $(first) $(position)` fallback { pair ->
                    scanPair pair { more start ->
                        finish = if scanRecordSupported ctor.fields then scanFinishFields ctor slots slots NoItems start else `scanFromPull $(start) { $(Meta.construct ctor (Meta.mapItems slotValue slots)) }`
                        dispatch = Meta.foldItems (scanSlotHandler loop slots start) (scanStreamingKey ctor loop slots `True` start) slots
                        `if $(more) then $(dispatch) else $(finish)`
                    }
                }
            _ -> Meta.fail "Expected generated cursor and field arguments"
    } { loop ->
        initial = Meta.mapItems { _ -> `Nothing` } ctor.fields
        fallback = `Err {
                acceptScan $(cursor)
                beginObject()
                $(scanPair `((), currentScan())` { _ position -> `resumeScan { $(callScanFields loop position `True` initial) }` })
        }`
        scanOr `scanOpen '{' $(cursor)` fallback { start ->
            if scanRecordSupported ctor.fields then scanOrderedFields ctor loop ctor.fields NoItems True start
            else callScanFields loop start `True` initial
        }
    }
}

nullaryBranch : Code -> Code -> Ctor -> Code
nullaryBranch tagCode fallback ctor =
    case ctor.fields of
        NoItems ->
            `if $(tagCode) == $(lift ctor.name) then
                    $(Meta.construct ctor NoItems)
                else $(fallback)`
        _ -> fallback

fieldDecoder : Field -> Code
fieldDecoder field =
    if field.index == 0 then `withIndex $(lift field.index) { decodeValue() }`
    else sequenceCode `expectComma()` `withIndex $(lift field.index) { decodeValue() }`

payloadBranch : Code -> Code -> Ctor -> Code
payloadBranch tagCode fallback ctor =
    case ctor.fields of
        NoItems -> fallback
        _ ->
            values = Meta.mapItems fieldDecoder ctor.fields
            result = Meta.construct ctor values
            `if $(tagCode) == $(lift ctor.name) then
                    finishPayload $(result)
                else $(fallback)`

unionParser : Items Ctor -> Code
unionParser ctors =
    nullary = Meta.lambda "_json_nullary_tag" { tagCode ->
        Meta.foldItems (nullaryBranch tagCode) `syntaxError "Unknown nullary union tag"` ctors
    }
    payload = Meta.lambda "_json_payload_tag" { tagCode ->
        Meta.foldItems (payloadBranch tagCode) `syntaxError "Unknown payload union tag"` ctors
    }
    `decodeUnion $(nullary) $(payload)`

deriver Decode
    scanValue subject cursor =
        validateJSONSchema subject
        case subject.shape of
            Record ctor -> `$(recordScanner ctor) $(cursor)`
            Union ctors -> `scanFromPull $(cursor) { $(unionParser ctors) }`

parseBytesValue : Bytes -> Result Error Value
parseBytesValue input =
    Reader.withBytes input { reader ->
        withPull reader {
            value = readValue()
            case next() of
                EndInput -> value
                _ -> syntaxError "Trailing JSON input"
        }
    }

parseValue : String -> Result Error Value
parseValue text = parseBytesValue (Bytes.fromString text)

number : String -> Result Error Number
number text =
    case parseValue text of
        Ok (Numeric value) -> Ok value
        Ok _ -> Err (Error { message = "Expected JSON number", offset = 0, line = 1, column = 1, path = "" })
        Err problem -> Err problem

numberText : Number -> String
numberText (Number text) = text
