{-# no-prelude #-}
module Json exposing
    ( Decode(..), Emit(..), Encode(..), Error(..), FieldOption(..), Number
    , Pull(..), Token(..), Value(..)
    , beginArray, beginObject, next, nextElement, nextKey, number, numberText
    , parse, parseBytes, parseBytesValue, parseValue, peek, read, readText
    , readValue, skipValue, stringify, stringifyValue, syntaxError, withPath
    , withPull, withTextPull, withTextWriter, withWriter, write, writeText
    )

import Basics exposing (..)
import Bytes exposing (Bytes)
import Char
import Encoding
import Fail exposing (Fail, fail)
import List exposing (List)
import Maybe exposing (Maybe(..))
import Meta exposing (Bound(..), BoundField(..), Code, Ctor(..), Field(..), Items(..), Lift(..), Shape(..), TypeInfo(..))
import Reader exposing (Reader)
import Result exposing (Result(..))
import Runtime.Local
import Runtime.Scope
import String
import Text.Reader as TextReader
import Text.Writer as TextWriter
import Tuple
import Writer exposing (Writer)

type Error = { message : String, offset : Int, line : Int, column : Int, path : String }

type Token
    = BeginObject
    | EndObject
    | BeginArray
    | EndArray
    | Colon
    | Comma
    | StringTokenValue String
    | NumberToken String
    | BooleanToken Bool
    | NullToken
    | EndInput

type Number = Number String

type Value
    = Null
    | Boolean Bool
    | Numeric Number
    | Text String
    | Array (List Value)
    | Object (List (String, Value))

effect Pull
    next : () -> Token
    peek : () -> Token
    at : () -> Error
    enter : String -> ()
    leave : () -> ()

effect Emit
    emit : String -> ()

class Decode a
    decodeValue : () ->{Pull, Fail Error} a

class Encode a
    encodeValue : a ->{Emit, Fail Error} ()

-- Options interpreted by the JSON derivers, using generic Meta attributes.
type FieldOption = Key String | Skip | Default Code

type FieldSettings =
    { key : String
    , skip : Bool
    , fallback : Maybe Code
    , keySite : Maybe Meta.Site
    , skipSite : Maybe Meta.Site
    , defaultSite : Maybe Meta.Site
    }

addFieldOption : FieldSettings -> Meta.Attached FieldOption -> FieldSettings
addFieldOption settings attached =
    case attached.value of
        Key text ->
            case settings.keySite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON key option."
                Nothing -> { settings | key = text, keySite = Just attached.site }
        Skip ->
            case settings.skipSite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON skip option."
                Nothing -> { settings | skip = True, skipSite = Just attached.site }
        Default code ->
            case settings.defaultSite of
                Just _ -> Meta.failAt attached.site "This field already has a JSON default option."
                Nothing -> { settings | fallback = Just code, defaultSite = Just attached.site }

fieldSettings : String -> Meta.Attributes -> FieldSettings
fieldSettings name attached =
    initial = FieldSettings { key = name, skip = False, fallback = Nothing, keySite = Nothing, skipSite = Nothing, defaultSite = Nothing }
    settings = Meta.foldItems addFieldOption initial (Meta.attributes @FieldOption attached)
    case settings.skipSite of
        Nothing -> settings
        Just site ->
            case settings.fallback of
                Nothing -> Meta.failAt site "A skipped JSON field requires a default expression."
                Just _ ->
                    case settings.keySite of
                        Just keySite -> Meta.failAt keySite "A skipped JSON field cannot also rename its key."
                        Nothing -> settings

rejectFieldOptions : Meta.Attributes -> ()
rejectFieldOptions attached =
    case Meta.attributes @FieldOption attached of
        NoItems -> ()
        Item option _ -> Meta.failAt option.site "JSON field options belong on record fields."

findKey : String -> Items Field -> Maybe Meta.Site
findKey key fields =
    case fields of
        NoItems -> Nothing
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            if settings.key == key then settings.keySite else findKey key rest

hasKey : String -> Items Field -> Bool
hasKey key fields =
    case fields of
        NoItems -> False
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            settings.key == key || hasKey key rest

validateRecordFields : Items Field -> Items Field -> ()
validateRecordFields previous fields =
    case fields of
        NoItems -> ()
        Item field rest ->
            settings = fieldSettings field.name field.attributes
            if settings.skip then validateRecordFields previous rest
            else if hasKey settings.key previous then
                case settings.keySite of
                    Just site -> Meta.failAt site ("Two fields use the same JSON key: " ++ settings.key)
                    Nothing ->
                        case findKey settings.key previous of
                            Just site -> Meta.failAt site ("Two fields use the same JSON key: " ++ settings.key)
                            Nothing -> ()
            else validateRecordFields (Item field previous) rest

validateUnionFields : Items Field -> ()
validateUnionFields fields =
    case fields of
        NoItems -> ()
        Item field rest ->
            rejectFieldOptions field.attributes
            validateUnionFields rest

validateUnionCtors : Items Ctor -> ()
validateUnionCtors ctors =
    case ctors of
        NoItems -> ()
        Item ctor rest ->
            rejectFieldOptions ctor.attributes
            validateUnionFields ctor.fields
            validateUnionCtors rest

validateJSONSchema : TypeInfo -> ()
validateJSONSchema subject =
    rejectFieldOptions subject.attributes
    case subject.shape of
        Record ctor ->
            rejectFieldOptions ctor.attributes
            validateRecordFields NoItems ctor.fields
        Union ctors -> validateUnionCtors ctors

type Cursor e = { reader : TextReader.Reader e, offset : Int, line : Int, column : Int, path : String }

errorAt : Cursor e -> String -> Error
errorAt cursor message =
    Error { message = message, offset = cursor.offset, line = cursor.line, column = cursor.column, path = cursor.path }

bad : Cursor e -> String ->{Fail Error} a
bad cursor message = fail (errorAt cursor message)

encodingError : Cursor e -> Encoding.Error ->{Fail Error} a
encodingError cursor problem =
    bad cursor (case problem of
            Encoding.InvalidSequence _ -> "Invalid UTF-8 in JSON input"
            Encoding.IncompleteSequence _ -> "Incomplete UTF-8 in JSON input"
            _ -> Encoding.message problem
    )

peekChar : Cursor e ->{Fail Error | e} Maybe Char
peekChar cursor =
    case TextReader.tryPeekChar cursor.reader of
        Ok value -> value
        Err problem -> encodingError cursor problem

takeChar : Cursor e ->{Fail Error | e} (Maybe Char, Cursor e)
takeChar cursor =
    case TextReader.tryReadScalar cursor.reader of
        Err problem -> encodingError cursor problem
        Ok Nothing -> (Nothing, cursor)
        Ok (Just (char, size)) ->
            if char == '\n' then
                (Just char, { cursor | offset = cursor.offset + size, line = cursor.line + 1, column = 1 })
            else
                (Just char, { cursor | offset = cursor.offset + size, column = cursor.column + size })

white : Char -> Bool
white char = char == ' ' || char == '\t' || char == '\n' || char == '\r'

skipWhite : Cursor e ->{Fail Error | e} Cursor e
skipWhite cursor =
    case peekChar cursor of
        Just char ->
            if white char then
                (_, after) = takeChar cursor
                skipWhite after
            else cursor
        Nothing -> cursor

expectChar : Cursor e -> Char ->{Fail Error | e} Cursor e
expectChar cursor wanted =
    (got, after) = takeChar cursor
    if got == Just wanted then after else bad cursor "Invalid JSON literal"

literal : Cursor e -> String ->{Fail Error | e} Cursor e
literal cursor text =
    case String.uncons text of
        Nothing -> cursor
        Just part -> literal (expectChar cursor part.first) part.rest

hex : Char -> Int
hex char =
    code = Char.toCode char
    if char >= '0' && char <= '9' then code - Char.toCode '0'
    else if char >= 'A' && char <= 'F' then code - Char.toCode 'A' + 10
    else if char >= 'a' && char <= 'f' then code - Char.toCode 'a' + 10
    else -1

readHex : Cursor e -> Int -> Int ->{Fail Error | e} (Int, Cursor e)
readHex cursor remaining acc =
    if remaining == 0 then (acc, cursor)
    else
        (got, after) = takeChar cursor
        case got of
            Nothing -> bad cursor "Incomplete Unicode escape"
            Just char ->
                nibble = hex char
                if nibble < 0 then bad cursor "Invalid Unicode escape"
                else readHex after (remaining - 1) (acc * 16 + nibble)

scalar : Cursor e -> Int ->{Fail Error} Char
scalar cursor code =
    case Char.fromCode code of
        Just char -> char
        Nothing -> bad cursor "Invalid Unicode scalar"

escaped : Cursor e ->{Fail Error | e} (Char, Cursor e)
escaped cursor =
    (got, after) = takeChar cursor
    case got of
        Just '"' -> ('"', after)
        Just '\\' -> ('\\', after)
        Just '/' -> ('/', after)
        Just 'b' -> (scalar cursor 8, after)
        Just 'f' -> (scalar cursor 12, after)
        Just 'n' -> ('\n', after)
        Just 'r' -> ('\r', after)
        Just 't' -> ('\t', after)
        Just 'u' ->
            (code, afterHex) = readHex after 4 0
            if code >= 56320 && code <= 57343 then bad cursor "Unexpected low surrogate"
            else if code >= 55296 && code <= 56319 then
                afterSlash = expectChar afterHex '\\'
                afterU = expectChar afterSlash 'u'
                (low, rest) = readHex afterU 4 0
                if low < 56320 || low > 57343 then bad afterU "Invalid surrogate pair"
                else (scalar cursor (65536 + (code - 55296) * 1024 + low - 56320), rest)
            else (scalar cursor code, afterHex)
        _ -> bad cursor "Invalid JSON escape"

plainStringChar : Char -> Bool
plainStringChar char = case char of
    '"' -> False
    '\\' -> False
    _ -> Char.toCode char >= 32

-- Keep the current fragment outside the list so one-window strings need no
-- list nodes or concatenation. Longer strings still concatenate only once.
stringFragments : String -> List String -> String
stringFragments current reverse =
    case reverse of
        [] -> current
        _ -> String.concat (List.reverse [current | reverse])

priorFragment : String -> List String -> List String
priorFragment current reverse = if current == "" then reverse else [current | reverse]

scanString : Cursor e -> String -> List String ->{Fail Error | e} (String, Cursor e)
scanString cursor current reverse =
    case TextReader.tryReadSpan cursor.reader plainStringChar of
        Err problem -> encodingError cursor problem
        Ok (text, width) ->
            if text == "" then scanStringSpecial cursor current reverse
            else
                scanStringSpecial { cursor | offset = cursor.offset + width, column = cursor.column + width } text (priorFragment current reverse)

scanStringSpecial : Cursor e -> String -> List String ->{Fail Error | e} (String, Cursor e)
scanStringSpecial cursor current reverse =
    (got, after) = takeChar cursor
    case got of
        Nothing -> bad cursor "Unterminated JSON string"
        Just '"' -> (stringFragments current reverse, after)
        Just '\\' ->
            (char, rest) = escaped after
            scanString rest (String.fromChar char) (priorFragment current reverse)
        Just char ->
            if Char.toCode char < 32 then bad cursor "Unescaped control character in JSON string"
            else scanString after (String.fromChar char) (priorFragment current reverse)

digit : Char -> Bool
digit char = char >= '0' && char <= '9'

digits : Cursor e -> List String ->{Fail Error | e} (List String, Cursor e)
digits cursor reverse =
    case TextReader.tryReadSpan cursor.reader digit of
        Err problem -> encodingError cursor problem
        Ok (text, width) ->
            if text == "" then (reverse, cursor)
            else
                digits { cursor | offset = cursor.offset + width, column = cursor.column + width } [text | reverse]

requiredDigits : Cursor e -> List String ->{Fail Error | e} (List String, Cursor e)
requiredDigits cursor reverse =
    case peekChar cursor of
        Just char -> if digit char then digits cursor reverse else bad cursor "Expected JSON digit"
        Nothing -> bad cursor "Expected JSON digit"

scanNumber : Cursor e -> Char ->{Fail Error | e} (String, Cursor e)
scanNumber cursor first =
    if first == '-' then
        (got, after) = takeChar cursor
        case got of
            Just char -> if digit char then numberTail after char [String.fromChar char, "-"] else bad cursor "Expected digit after minus"
            Nothing -> bad cursor "Expected digit after minus"
    else numberTail cursor first [String.fromChar first]

numberTail : Cursor e -> Char -> List String ->{Fail Error | e} (String, Cursor e)
numberTail cursor first reverse =
    (whole, afterWhole) =
        if first == '0' then (reverse, cursor) else digits cursor reverse
    case peekChar afterWhole of
        Just char -> if digit char then bad afterWhole "Leading zero in JSON number" else ()
        Nothing -> ()
    (fraction, afterFraction) =
        case peekChar afterWhole of
            Just '.' ->
                (_, afterDot) = takeChar afterWhole
                requiredDigits afterDot ["." | whole]
            _ -> (whole, afterWhole)
    (complete, afterExponent) =
        case peekChar afterFraction of
            Just 'e' -> exponent afterFraction fraction
            Just 'E' -> exponent afterFraction fraction
            _ -> (fraction, afterFraction)
    ( case complete of
        [] -> ""
        [single] -> single
        [lastPart, firstPart] -> firstPart ++ lastPart
        _ -> String.concat (List.reverse complete)
    , afterExponent
    )

exponent : Cursor e -> List String ->{Fail Error | e} (List String, Cursor e)
exponent cursor reverse =
    (marker, afterMarker) = takeChar cursor
    case marker of
        Nothing -> bad cursor "Invalid JSON exponent"
        Just mark ->
            (prefix, afterSign) =
                case peekChar afterMarker of
                    Just '+' ->
                        (_, rest) = takeChar afterMarker
                        (["+", String.fromChar mark | reverse], rest)
                    Just '-' ->
                        (_, rest) = takeChar afterMarker
                        (["-", String.fromChar mark | reverse], rest)
                    _ -> ([String.fromChar mark | reverse], afterMarker)
            requiredDigits afterSign prefix

-- The buffered path is pure and publishes its consumed prefix once. A window
-- boundary or malformed token declines without changing the reader; the
-- incremental scanner below then owns refills, failure positions and effects.
fastWhite : TextReader.Window -> Int -> Int -> Maybe (TextReader.Window, Int, Int)
fastWhite snapshot line column =
    case TextReader.readWindow snapshot of
        Ok (Just (char, width, rest)) ->
            if white char then
                if char == '\n' then fastWhite rest (line + 1) 1
                else fastWhite rest line (column + width)
            else Just (snapshot, line, column)
        _ -> Nothing

fastLiteral : TextReader.Window -> String -> Maybe TextReader.Window
fastLiteral snapshot text =
    case String.uncons text of
        Nothing -> Just snapshot
        Just part ->
            case TextReader.readWindow snapshot of
                Ok (Just (char, _, rest)) ->
                    if char == part.first then fastLiteral rest part.rest else Nothing
                _ -> Nothing

fastHex : TextReader.Window -> Int -> Int -> Maybe (Int, TextReader.Window)
fastHex snapshot remaining acc =
    if remaining == 0 then Just (acc, snapshot)
    else case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) ->
            nibble = hex char
            if nibble < 0 then Nothing else fastHex rest (remaining - 1) (acc * 16 + nibble)
        _ -> Nothing

fastScalar : Int -> TextReader.Window -> Maybe (Char, TextReader.Window)
fastScalar code snapshot =
    case Char.fromCode code of
        Nothing -> Nothing
        Just char -> Just (char, snapshot)

fastEscape : TextReader.Window -> Maybe (Char, TextReader.Window)
fastEscape snapshot =
    case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) -> case char of
            '"' -> Just ('"', rest)
            '\\' -> Just ('\\', rest)
            '/' -> Just ('/', rest)
            'b' -> fastScalar 8 rest
            'f' -> fastScalar 12 rest
            'n' -> Just ('\n', rest)
            'r' -> Just ('\r', rest)
            't' -> Just ('\t', rest)
            'u' -> case fastHex rest 4 0 of
                Nothing -> Nothing
                Just (code, afterHex) ->
                    if code >= 56320 && code <= 57343 then Nothing
                    else if code >= 55296 && code <= 56319 then
                        case fastLiteral afterHex "\\u" of
                            Nothing -> Nothing
                            Just afterU -> case fastHex afterU 4 0 of
                                Nothing -> Nothing
                                Just (low, afterLow) ->
                                    if low < 56320 || low > 57343 then Nothing
                                    else fastScalar (65536 + (code - 55296) * 1024 + low - 56320) afterLow
                    else fastScalar code afterHex
            _ -> Nothing
        _ -> Nothing

fastString : TextReader.Window -> String -> List String -> Maybe (String, TextReader.Window)
fastString snapshot current reverse =
    case TextReader.spanWindow snapshot plainStringChar of
        Err _ -> Nothing
        Ok (text, _, afterPlain) ->
            fragment = if text == "" then current else text
            fragments = if text == "" then reverse else priorFragment current reverse
            case TextReader.readWindow afterPlain of
                Ok (Just ('"', _, rest)) -> Just (stringFragments fragment fragments, rest)
                Ok (Just ('\\', _, rest)) -> case fastEscape rest of
                    Nothing -> Nothing
                    Just (char, afterEscape) -> fastString afterEscape (String.fromChar char) (priorFragment fragment fragments)
                _ -> Nothing

type NumberPhase = MinusDigit | ZeroEnd | WholeDigits | FractionDigit | FractionDigits | ExponentSign | ExponentDigit | ExponentDigits

fastNumber : TextReader.Window -> TextReader.Window -> NumberPhase -> Maybe (String, TextReader.Window)
fastNumber start snapshot phase =
    -- A number needs a following scalar: buffer end cannot prove token end.
    case TextReader.readWindow snapshot of
        Ok (Just (char, _, rest)) ->
            nextPhase = case phase of
                MinusDigit -> if char == '0' then Just ZeroEnd else if digit char then Just WholeDigits else Nothing
                ZeroEnd -> if char == '.' then Just FractionDigit else if char == 'e' || char == 'E' then Just ExponentSign else Nothing
                WholeDigits -> if digit char then Just WholeDigits else if char == '.' then Just FractionDigit else if char == 'e' || char == 'E' then Just ExponentSign else Nothing
                FractionDigit -> if digit char then Just FractionDigits else Nothing
                FractionDigits -> if digit char then Just FractionDigits else if char == 'e' || char == 'E' then Just ExponentSign else Nothing
                ExponentSign -> if char == '+' || char == '-' then Just ExponentDigit else if digit char then Just ExponentDigits else Nothing
                ExponentDigit -> if digit char then Just ExponentDigits else Nothing
                ExponentDigits -> if digit char then Just ExponentDigits else Nothing
            case nextPhase of
                Just following -> fastNumber start rest following
                Nothing ->
                    complete = case phase of
                        ZeroEnd -> digit char == False
                        WholeDigits -> True
                        FractionDigits -> True
                        ExponentDigits -> True
                        _ -> False
                    if complete then
                        case TextReader.windowText start snapshot of
                            Ok text -> Just (text, snapshot)
                            Err _ -> Nothing
                    else Nothing
        _ -> Nothing

fastToken : TextReader.Window -> Maybe (Token, TextReader.Window)
fastToken snapshot =
    case TextReader.readWindow snapshot of
        Ok (Just (char, _, after)) -> case char of
            '{' -> Just (BeginObject, after)
            '}' -> Just (EndObject, after)
            '[' -> Just (BeginArray, after)
            ']' -> Just (EndArray, after)
            ':' -> Just (Colon, after)
            ',' -> Just (Comma, after)
            '"' -> case fastString after "" [] of
                Nothing -> Nothing
                Just (text, rest) -> Just (StringTokenValue text, rest)
            't' -> case fastLiteral after "rue" of
                Nothing -> Nothing
                Just rest -> Just (BooleanToken True, rest)
            'f' -> case fastLiteral after "alse" of
                Nothing -> Nothing
                Just rest -> Just (BooleanToken False, rest)
            'n' -> case fastLiteral after "ull" of
                Nothing -> Nothing
                Just rest -> Just (NullToken, rest)
            _ ->
                phase = if char == '-' then MinusDigit else if char == '0' then ZeroEnd else WholeDigits
                if char == '-' || digit char then
                    case fastNumber snapshot after phase of
                        Nothing -> Nothing
                        Just (text, rest) -> Just (NumberToken text, rest)
                else Nothing
        _ -> Nothing

lex : Cursor e ->{Fail Error | e} (Token, Cursor e)
lex before =
    snapshot = TextReader.window before.reader
    case fastWhite snapshot before.line before.column of
        Nothing -> lexIncremental before
        Just (start, line, column) -> case fastToken start of
            Nothing -> lexIncremental before
            Just (token, rest) ->
                width = TextReader.windowPosition rest
                TextReader.commitWindow before.reader rest
                (token, { before | offset = before.offset + width, line = line, column = column + width - TextReader.windowPosition start })

lexIncremental : Cursor e ->{Fail Error | e} (Token, Cursor e)
lexIncremental before =
    cursor = skipWhite before
    (got, after) = takeChar cursor
    case got of
        Nothing -> (EndInput, cursor)
        Just '{' -> (BeginObject, after)
        Just '}' -> (EndObject, after)
        Just '[' -> (BeginArray, after)
        Just ']' -> (EndArray, after)
        Just ':' -> (Colon, after)
        Just ',' -> (Comma, after)
        Just '"' ->
            (value, rest) = scanString after "" []
            (StringTokenValue value, rest)
        Just 't' -> (BooleanToken True, literal after "rue")
        Just 'f' -> (BooleanToken False, literal after "alse")
        Just 'n' -> (NullToken, literal after "ull")
        Just char ->
            if char == '-' || digit char then
                (value, rest) = scanNumber after char
                (NumberToken value, rest)
            else bad cursor "Unexpected character in JSON"

type PullState e = { cursor : Cursor e, pending : Maybe Token, depth : Int, paths : List String }

tokenDepth : Token -> Int -> Cursor e ->{Fail Error} Int
tokenDepth token depth cursor =
    case token of
        BeginArray -> if depth >= 256 then bad cursor "JSON nesting exceeds 256 levels" else depth + 1
        BeginObject -> if depth >= 256 then bad cursor "JSON nesting exceeds 256 levels" else depth + 1
        EndArray -> depth - 1
        EndObject -> depth - 1
        _ -> depth

withPull : Reader e -> (() ->{Pull, Fail Error} a) ->{e} Result Error a
withPull reader action =
    TextReader.over reader { text -> withTextPull text action }

withTextPull : TextReader.Reader e -> (() ->{Pull, Fail Error} a) ->{e} Result Error a
withTextPull reader action =
    Fail.attempt {
        handle action() with state = PullState { cursor = Cursor { reader = reader, offset = 0, line = 1, column = 1, path = "" }, pending = Nothing, depth = 0, paths = [] } of
            peek () ->
                case state.pending of
                    Just token -> resume token with state
                    Nothing ->
                        (token, cursor) = lex state.cursor
                        resume token with { state | cursor = cursor, pending = Just token }
            next () ->
                case state.pending of
                    Just token ->
                        depth = tokenDepth token state.depth state.cursor
                        resume token with { state | pending = Nothing, depth = depth }
                    Nothing ->
                        (token, cursor) = lex state.cursor
                        depth = tokenDepth token state.depth cursor
                        resume token with { state | cursor = cursor, pending = Nothing, depth = depth }
            at () -> resume (errorAt state.cursor "") with state
            enter segment ->
                before = state.cursor.path
                resume () with { state | cursor = { state.cursor | path = before ++ "/" ++ segment }, paths = [before | state.paths] }
            leave () ->
                case state.paths of
                    [] -> resume () with state
                    [before | rest] -> resume () with { state | cursor = { state.cursor | path = before }, paths = rest }
            return value -> value
    }

syntaxError : String ->{Pull, Fail Error} a
syntaxError message = fail { at() | message = message }

withPath : String -> (() ->{Pull, Fail Error} a) ->{Pull, Fail Error} a
withPath segment action =
    Runtime.Scope.bracket { enter segment } { leave() } { action() }

beginArray : () ->{Pull, Fail Error} ()
beginArray() =
    case next() of
        BeginArray -> ()
        _ -> syntaxError "Expected JSON array"

nextElement : Bool ->{Pull, Fail Error} Bool
nextElement first =
    case peek() of
        EndArray ->
            ignore next()
            False
        _ ->
            if first then True
            else
                case next() of
                    Comma ->
                        case peek() of
                            EndArray -> syntaxError "Trailing array comma"
                            _ -> True
                    _ -> syntaxError "Expected comma or array end"

beginObject : () ->{Pull, Fail Error} ()
beginObject() =
    case next() of
        BeginObject -> ()
        _ -> syntaxError "Expected JSON object"

nextKey : Bool ->{Pull, Fail Error} Maybe String
nextKey first =
    case peek() of
        EndObject ->
            ignore next()
            Nothing
        _ ->
            if first then readKey()
            else
                case next() of
                    Comma ->
                        case peek() of
                            EndObject -> syntaxError "Trailing object comma"
                            _ -> readKey()
                    _ -> syntaxError "Expected comma or object end"

readKey : () ->{Pull, Fail Error} Maybe String
readKey() =
    key = case next() of
        StringTokenValue text -> text
        _ -> syntaxError "Expected object key"
    case next() of
        Colon -> Just key
        _ -> syntaxError "Expected colon"

readFields : (String ->{Pull, Fail Error | e} ()) ->{Pull, Fail Error | e} ()
readFields onKey =
    beginObject()
    readFieldsMore onKey True

readFieldsMore : (String ->{Pull, Fail Error | e} ()) -> Bool ->{Pull, Fail Error | e} ()
readFieldsMore onKey first =
    case nextKey first of
        Nothing -> ()
        Just key ->
            onKey key
            readFieldsMore onKey False

expectComma : () ->{Pull, Fail Error} ()
expectComma() =
    case next() of
        Comma -> ()
        _ -> syntaxError "Expected union field separator"

finishPayload : a ->{Pull, Fail Error} a
finishPayload value =
    case next() of
        EndArray -> ()
        _ -> syntaxError "Expected end of union field array"
    case next() of
        EndObject -> value
        _ -> syntaxError "Expected end of tagged union object"

decodeUnion : (String ->{Pull, Fail Error} a) -> (String ->{Pull, Fail Error} a) ->{Pull, Fail Error} a
decodeUnion nullary payload =
    case next() of
        StringTokenValue tag -> nullary tag
        BeginObject ->
            tag = case next() of
                StringTokenValue text -> text
                _ -> syntaxError "Expected union tag"
            case next() of
                Colon -> ()
                _ -> syntaxError "Expected colon after union tag"
            beginArray()
            payload tag
        _ -> syntaxError "Expected tagged JSON union"

readValue : () ->{Pull, Fail Error} Value
readValue() =
    case next() of
        NullToken -> Null
        BooleanToken value -> Boolean value
        NumberToken text -> Numeric (Number text)
        StringTokenValue text -> Text text
        BeginArray -> Array (readArray 0 [])
        BeginObject -> Object (readObject [])
        _ -> syntaxError "Expected JSON value"

readArray : Int -> List Value ->{Pull, Fail Error} List Value
readArray index reverse =
    case peek() of
        EndArray ->
            ignore next()
            List.reverse reverse
        _ ->
            value = withPath (show index) { readValue() }
            case next() of
                Comma -> readArrayAfterComma (index + 1) [value | reverse]
                EndArray -> List.reverse [value | reverse]
                _ -> syntaxError "Expected comma or array end"

readArrayAfterComma : Int -> List Value ->{Pull, Fail Error} List Value
readArrayAfterComma index reverse =
    case peek() of
        EndArray -> syntaxError "Trailing array comma"
        _ -> readArray index reverse

readObject : List (String, Value) ->{Pull, Fail Error} List (String, Value)
readObject reverse =
    case peek() of
        EndObject ->
            ignore next()
            List.reverse reverse
        _ ->
            key = case next() of
                StringTokenValue text -> text
                _ -> syntaxError "Expected object key"
            case next() of
                Colon -> ()
                _ -> syntaxError "Expected colon"
            value = withPath key { readValue() }
            case next() of
                Comma -> readObjectAfterComma [(key, value) | reverse]
                EndObject -> List.reverse [(key, value) | reverse]
                _ -> syntaxError "Expected comma or object end"

readObjectAfterComma : List (String, Value) ->{Pull, Fail Error} List (String, Value)
readObjectAfterComma reverse =
    case peek() of
        EndObject -> syntaxError "Trailing object comma"
        _ -> readObject reverse

skipValue : () ->{Pull, Fail Error} ()
skipValue() =
    case next() of
        BeginArray -> skipArray True
        BeginObject -> skipObject True
        StringTokenValue _ -> ()
        NumberToken _ -> ()
        BooleanToken _ -> ()
        NullToken -> ()
        _ -> syntaxError "Expected JSON value"

skipArray : Bool ->{Pull, Fail Error} ()
skipArray first =
    if nextElement first then
        skipValue()
        skipArray False
    else ()

skipObject : Bool ->{Pull, Fail Error} ()
skipObject first =
    case nextKey first of
        Nothing -> ()
        Just _ ->
            skipValue()
            skipObject False

parseBytes : Decode a => Type a -> Bytes -> Result Error a
parseBytes _ input =
    Reader.withBytes input { reader ->
        withPull reader {
            value = decodeValue()
            case next() of
                EndInput -> value
                _ -> syntaxError "Trailing JSON input"
        }
    }

parse : Decode a => Type a -> String -> Result Error a
parse witness text = parseBytes witness (Bytes.fromString text)

read : Decode a => Type a -> Reader e ->{e} Result Error a
read _ reader =
    withPull reader {
        value = decodeValue()
        case next() of
            EndInput -> value
            _ -> syntaxError "Trailing JSON input"
    }

readText : Decode a => Type a -> TextReader.Reader e ->{e} Result Error a
readText _ reader =
    withTextPull reader {
        value = decodeValue()
        case next() of
            EndInput -> value
            _ -> syntaxError "Trailing JSON input"
    }

instance Decode String
    decodeValue() =
        case next() of
            StringTokenValue text -> text
            _ -> syntaxError "Expected JSON string"

instance Decode Char
    decodeValue() =
        case next() of
            StringTokenValue text ->
                case String.uncons text of
                    Just part -> if part.rest == "" then part.first else syntaxError "Expected one JSON character"
                    Nothing -> syntaxError "Expected one JSON character"
            _ -> syntaxError "Expected JSON string"

instance Decode Int
    decodeValue() =
        case next() of
            NumberToken text ->
                case String.toInt text of
                    Just value -> value
                    Nothing -> syntaxError "Expected 64-bit JSON integer"
            _ -> syntaxError "Expected JSON number"

instance Decode Float
    decodeValue() =
        case next() of
            NumberToken text ->
                case String.toFloat text of
                    Just value -> value
                    Nothing -> syntaxError "JSON number is outside Float range"
            _ -> syntaxError "Expected JSON number"

instance Decode Bool
    decodeValue() =
        case next() of
            BooleanToken value -> value
            _ -> syntaxError "Expected JSON boolean"

instance Decode ()
    decodeValue() =
        case next() of
            NullToken -> ()
            _ -> syntaxError "Expected JSON null"

decodeList : Decode a => Int -> Bool -> List a ->{Pull, Fail Error} List a
decodeList index first reverse =
    if nextElement first then
        value = withPath (show index) { decodeValue() }
        decodeList (index + 1) False [value | reverse]
    else List.reverse reverse

instance Decode a => Decode (List a)
    decodeValue() =
        beginArray()
        decodeList 0 True []

instance Decode a => Decode (Maybe a)
    decodeValue() =
        case peek() of
            NullToken ->
                ignore next()
                Nothing
            _ -> Just decodeValue()

instance Decode Value
    decodeValue() = readValue()

withWriter : Writer e -> (() ->{Emit, Fail Error} a) ->{e} Result Error a
withWriter writer action = TextWriter.borrow writer { text -> withTextWriter text action }

withTextWriter : TextWriter.Writer e -> (() ->{Emit, Fail Error} a) ->{e} Result Error a
withTextWriter writer action =
    Fail.attempt {
        handle action() of
            emit text ->
                case TextWriter.tryWrite writer text of
                    Ok _ -> resume ()
                    Err problem -> fail (Error { message = Encoding.message problem, offset = -1, line = 0, column = 0, path = "" })
            return value -> value
    }

write : Encode a => Writer e -> a ->{e} Result Error ()
write writer value = withWriter writer { encodeValue value }

writeText : Encode a => TextWriter.Writer e -> a ->{e} Result Error ()
writeText writer value = withTextWriter writer { encodeValue value }

stringify : Encode a => a -> Result Error String
stringify value =
    (outcome, text) = TextWriter.collecting { writer -> writeText writer value }
    case outcome of
        Err problem -> Err problem
        Ok _ -> Ok text

hexChar : Int -> String
hexChar value = String.slice value (value + 1) "0123456789abcdef"

escapeChar : Char -> String
escapeChar char =
    code = Char.toCode char
    if char == '"' then "\\\""
    else if char == '\\' then "\\\\"
    else if code == 8 then "\\b"
    else if code == 12 then "\\f"
    else if char == '\n' then "\\n"
    else if char == '\r' then "\\r"
    else if char == '\t' then "\\t"
    else "\\u00" ++ hexChar (quotientBy 16 code) ++ hexChar (remainderBy 16 code)

plainChar : Char -> Bool
plainChar char = char /= '"' && char /= '\\' && Char.toCode char >= 32

emitStringBody : String ->{Emit} ()
emitStringBody text =
    (run, rest) = String.span plainChar text
    if run == "" then () else emit run
    case String.uncons rest of
        Nothing -> ()
        Just part ->
            emit (escapeChar part.first)
            emitStringBody part.rest

emitString : String ->{Emit} ()
emitString text =
    emit "\""
    emitStringBody text
    emit "\""

instance Encode String
    encodeValue value = emitString value

instance Encode Char
    encodeValue value = emitString (String.fromChar value)

instance Encode Int
    encodeValue value = emit (show value)

instance Encode Float
    encodeValue value =
        text = show value
        if text == "NaN" || text == "Infinity" || text == "-Infinity" then
            fail (Error { message = "Non-finite Float is not JSON", offset = -1, line = 0, column = 0, path = "" })
        else emit text

instance Encode Bool
    encodeValue value = emit (if value then "true" else "false")

instance Encode ()
    encodeValue _ = emit "null"

emitList : Encode a => List a -> Bool ->{Emit, Fail Error} ()
emitList values first =
    case values of
        [] -> ()
        [value | rest] ->
            if first then () else emit ","
            encodeValue value
            emitList rest False

instance Encode a => Encode (List a)
    encodeValue values =
        emit "["
        emitList values True
        emit "]"

instance Encode a => Encode (Maybe a)
    encodeValue value =
        case value of
            Nothing -> emit "null"
            Just present -> encodeValue present

instance Encode Value
    encodeValue value = emitValue value

emitValue : Value ->{Emit, Fail Error} ()
emitValue value =
    case value of
        Null -> emit "null"
        Boolean item -> encodeValue item
        Numeric (Number text) -> emit text
        Text text -> emitString text
        Array items ->
            emit "["
            emitValueList items True
            emit "]"
        Object entries ->
            emit "{"
            emitObject entries True
            emit "}"

emitValueList : List Value -> Bool ->{Emit, Fail Error} ()
emitValueList items first =
    case items of
        [] -> ()
        [item | rest] ->
            if first then () else emit ","
            emitValue item
            emitValueList rest False

emitObject : List (String, Value) -> Bool ->{Emit, Fail Error} ()
emitObject entries first =
    case entries of
        [] -> ()
        [(key, value) | rest] ->
            if first then () else emit ","
            emitString key
            emit ":"
            emitValue value
            emitObject rest False

stringifyValue : Value -> Result Error String
stringifyValue value = stringify value

sequenceCode : Code -> Code -> Code
sequenceCode left right = `{ $(left); $(right) }()`

emitCode : String -> Code
emitCode text = `emit $(lift text)`

quotedCode : String -> Code
quotedCode text = `emitString $(lift text)`

recordField : (Code, Bool) -> BoundField -> (Code, Bool)
recordField (prefix, first) field =
    settings = fieldSettings field.name field.attributes
    if settings.skip then (prefix, first)
    else
        separator = if first then "" else ","
        ( sequenceCode prefix
            (sequenceCode (emitCode separator)
                (sequenceCode (quotedCode settings.key)
                    (sequenceCode (emitCode ":") `encodeValue $(field.value)`)
                )
            )
        , False
        )

recordBody : Bound -> Code
recordBody bound =
    (fields, _) = Meta.foldItems recordField (emitCode "", True) bound.fields
    sequenceCode (emitCode "{")
        (sequenceCode fields (emitCode "}"))

unionField : Code -> BoundField -> Code
unionField prefix field =
    separator = if field.index == 0 then "" else ","
    sequenceCode prefix
        (sequenceCode (emitCode separator) `encodeValue $(field.value)`)

unionBody : Bound -> Code
unionBody bound =
    case bound.fields of
        NoItems -> quotedCode bound.ctor.name
        _ ->
            sequenceCode (emitCode "{")
                (sequenceCode (quotedCode bound.ctor.name)
                    (sequenceCode (emitCode ":[")
                        (sequenceCode (Meta.foldItems unionField (emitCode "") bound.fields)
                            (emitCode "]}")
                        )
                    )
                )

derivedEncode : TypeInfo -> Bound -> Code
derivedEncode subject bound =
    case subject.shape of
        Record _ -> recordBody bound
        Union _ -> unionBody bound

deriver Encode
    encodeValue subject valueCode =
        validateJSONSchema subject
        Meta.match subject valueCode (derivedEncode subject)

type Slot = { field : Field, read : Code, write : Code }

slotValue : Slot -> Code
slotValue slot =
    settings = fieldSettings slot.field.name slot.field.attributes
    case settings.fallback of
        Nothing ->
            `case $(slot.read) of
                    Just value -> value
                    Nothing -> withPath $(lift settings.key) { syntaxError $(lift ("Missing JSON field: " ++ settings.key)) }`
        Just fallback ->
            if settings.skip then fallback
            else
                `case $(slot.read) of
                        Just value -> value
                        Nothing -> $(fallback)`

slotHandler : Code -> Code -> Slot -> Code
slotHandler keyCode fallback slot =
    settings = fieldSettings slot.field.name slot.field.attributes
    if settings.skip then fallback
    else
        `if $(keyCode) == $(lift settings.key) then
                case $(slot.read) of
                    Nothing -> $(slot.write) (Just (withPath $(lift settings.key) { decodeValue() }))
                    Just _ -> withPath $(lift settings.key) { syntaxError $(lift ("Duplicate JSON field: " ++ settings.key)) }
            else $(fallback)`

recordParser : Ctor -> Items Slot -> Code
recordParser ctor slots =
    action = Meta.lambda "_json_key" { keyCode ->
        Meta.foldItems (slotHandler keyCode) `withPath $(keyCode) { skipValue() }` slots
    }
    values = Meta.mapItems slotValue slots
    sequenceCode `readFields $(action)` (Meta.construct ctor values)

-- A typed tuple of optional fields uses one local activation per record.
-- Generate projections and updates rather than allocating a cell per field.
slotInitial : Items Field -> Code
slotInitial fields =
    case fields of
        NoItems -> `()`
        Item _ rest -> `(Nothing, $(slotInitial rest))`

slotProjection : Int -> Code -> Code
slotProjection index values =
    if index == 0 then `Tuple.first $(values)`
    else slotProjection (index - 1) `Tuple.second $(values)`

slotUpdate : Int -> Code -> Code -> Code
slotUpdate index value values =
    if index == 0 then `($(value), Tuple.second $(values))`
    else `(Tuple.first $(values), $(slotUpdate (index - 1) value `Tuple.second $(values)`))`

aggregateSlot : Code -> Field -> Slot
aggregateSlot cell field =
    readCode = slotProjection field.index `$(cell).read()`
    writeCode = Meta.lambda ("_json_value_" ++ show field.index) { value ->
        update = Meta.lambda ("_json_state_" ++ show field.index) { values ->
            `$(cell).write $(slotUpdate field.index value values)`
        }
        `$(update) $(cell).read()`
    }
    Slot { field = field, read = readCode, write = writeCode }

slotScope : Ctor -> Code
slotScope ctor =
    case ctor.fields of
        NoItems -> recordParser ctor NoItems
        _ ->
            callback = Meta.lambda "_json_slots" { cell ->
                recordParser ctor (Meta.mapItems (aggregateSlot cell) ctor.fields)
            }
            `Runtime.Local.run $(slotInitial ctor.fields) $(callback)`

nullaryBranch : Code -> Code -> Ctor -> Code
nullaryBranch tagCode fallback ctor =
    case ctor.fields of
        NoItems ->
            `if $(tagCode) == $(lift ctor.name) then
                    $(Meta.construct ctor NoItems)
                else $(fallback)`
        _ -> fallback

fieldDecoder : Field -> Code
fieldDecoder field =
    if field.index == 0 then `withPath $(lift (show field.index)) { decodeValue() }`
    else sequenceCode `expectComma()` `withPath $(lift (show field.index)) { decodeValue() }`

payloadBranch : Code -> Code -> Ctor -> Code
payloadBranch tagCode fallback ctor =
    case ctor.fields of
        NoItems -> fallback
        _ ->
            values = Meta.mapItems fieldDecoder ctor.fields
            result = Meta.construct ctor values
            `if $(tagCode) == $(lift ctor.name) then
                    finishPayload $(result)
                else $(fallback)`

unionParser : Items Ctor -> Code
unionParser ctors =
    nullary = Meta.lambda "_json_nullary_tag" { tagCode ->
        Meta.foldItems (nullaryBranch tagCode) `syntaxError "Unknown nullary union tag"` ctors
    }
    payload = Meta.lambda "_json_payload_tag" { tagCode ->
        Meta.foldItems (payloadBranch tagCode) `syntaxError "Unknown payload union tag"` ctors
    }
    `decodeUnion $(nullary) $(payload)`

deriver Decode
    decodeValue subject _ =
        validateJSONSchema subject
        case subject.shape of
            Record ctor -> slotScope ctor
            Union ctors -> unionParser ctors

parseBytesValue : Bytes -> Result Error Value
parseBytesValue input =
    Reader.withBytes input { reader ->
        withPull reader {
            value = readValue()
            case next() of
                EndInput -> value
                _ -> syntaxError "Trailing JSON input"
        }
    }

parseValue : String -> Result Error Value
parseValue text = parseBytesValue (Bytes.fromString text)

number : String -> Result Error Number
number text =
    case parseValue text of
        Ok (Numeric value) -> Ok value
        Ok _ -> Err (Error { message = "Expected JSON number", offset = 0, line = 1, column = 1, path = "" })
        Err problem -> Err problem

numberText : Number -> String
numberText (Number text) = text
