{-# no-prelude #-}
-- Software transactional memory: shared variables that tasks read and update
-- in composable atomic transactions.
--
-- A transaction is a callback typed `() ->{STM} a`. `atomically` runs it so
-- that its reads observe one consistent snapshot and its writes become
-- visible to other tasks all at once, or not at all. Several variables
-- therefore change together, and functions performing `STM` combine into
-- larger transactions. `retry` abandons an attempt until a variable it read
-- changes, so any condition over shared state becomes a blocking wait.
-- `orElse` chooses between alternatives that may retry, and `attempt` undoes
-- the writes of an action that fails.
--
-- A transaction may be run more than once: when another task commits to a
-- variable it read, it is discarded and started again. Its row is closed, so
-- it cannot perform `IO`, `Async`, or any other effect handled outside it,
-- and replaying it is unobservable. Effects handled inside the transaction,
-- such as a local `Fail.attempt` or `Runtime.Local.run`, are allowed. Read
-- outside services before `atomically` and pass the values in; return
-- side effects that depend on the outcome as data and perform them after it
-- commits. `atomically` itself needs `Async`, so transactions do not nest.
--
-- Only `atomically` handles `STM`; its operations are private to this module.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- result = Async.runOutcome {
--     alice = STM.atomically { STM.new 100 }
--     bob = STM.atomically { STM.new 0 }
--     STM.atomically { STM.modify alice { n -> n - 30 }; STM.modify bob { n -> n + 30 } }
--     STM.atomically { (STM.read alice, STM.read bob) }
--     }
-- result == Completed (70, 30)
-- ```
module STM exposing (STM, Var, atomically, attempt, check, exchange, modify, new, orElse, read, retry, write)

import Async exposing (Async)
import Basics exposing (..)
import Fail exposing (Fail)
import Result exposing (Result(..))
import Runtime.Native

-- A shared mutable variable holding an `a`. Its identity, not its value,
-- distinguishes it; it may cross task boundaries freely. A variable lives
-- until it is unreachable, and has no equality or `Show`.
{-# resource #-}
type Var a = Var Runtime.Native.Any

-- Running inside a transaction. Only `atomically` handles it.
effect STM
    readVar : Var a -> a
    writeVar : Var a -> a -> ()
    newVar : a -> Var a
    savepoint : () -> Int
    rollback : Int -> ()
    abort abandon : () -> value

-- Raised by a read that sees a variable published after the attempt began.
effect Restart
    abort restart : () -> value

-- How one attempt ended.
type Attempt a = Finished a | Conflicted | Blocked

{-# resource #-}
type Log = Log Runtime.Native.Any

{-# resource #-}
type ReadResult a = ReadResult Runtime.Native.Any

stmBegin : () -> Log
stmBegin = native
stmRead : Log -> Var a -> ReadResult a
stmRead = native
stmFresh : ReadResult a -> Bool
stmFresh = native
stmValue : ReadResult a -> a
stmValue = native
stmWrite : Log -> Var a -> a -> ()
stmWrite = native
stmNew : Log -> a -> Var a
stmNew = native
stmCommit : Log -> Bool
stmCommit = native
stmAwait : Runtime.Native.Any -> Log -> Bool
stmAwait = native
stmSavepoint : Log -> Int
stmSavepoint = native
stmRollback : Log -> Int -> ()
stmRollback = native

-- Runs `transaction` until it commits and answers its value.
--
-- Every attempt observes one consistent snapshot of the variables it reads;
-- a read that would see a later commit restarts the attempt at once, so a
-- transaction never computes on inconsistent values. Its writes become
-- visible together when it commits. If another task committed to a variable
-- it read in the meantime, the attempt is discarded and the transaction runs
-- again. Conflict restarts are invisible to the program.
--
-- A transaction responds to cancellation only while waiting after `retry`.
-- One that never retries runs to commit even in a cancelled task, so
-- cancellation cleanup can still release a lock or return a permit with
-- `atomically`.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- Async.runOutcome { STM.atomically { STM.read (STM.new 7) } } == Completed 7
-- ```
atomically : (() ->{STM} a) ->{Async} a
atomically transaction = attemptLoop (Async.contextToken ()) transaction

attemptLoop : Runtime.Native.Any -> (() ->{STM} a) ->{Async} a
attemptLoop context transaction =
    log = stmBegin ()
    case runAttempt log transaction of
        Finished value -> if stmCommit log then value else attemptLoop context transaction
        Conflicted -> attemptLoop context transaction
        Blocked ->
            if stmAwait context log then
                attemptLoop context transaction
            else
                Async.checkpoint ()
                attemptLoop context transaction

runAttempt : Log -> (() ->{STM} a) -> Attempt a
runAttempt log transaction =
    handle
        handle transaction() on
            readVar var ->
                result = stmRead log var
                if stmFresh result then resume (stmValue result) else restart ()
            writeVar var value -> resume (stmWrite log var value)
            newVar value -> resume (stmNew log value)
            savepoint () -> resume (stmSavepoint log)
            rollback point -> resume (stmRollback log point)
            abandon () -> Blocked
            return value -> Finished value
    on
        restart () -> Conflicted

-- A fresh variable holding `value`. Outside a transaction, use
-- `atomically { STM.new value }`. A variable created by an attempt that is
-- discarded is never seen by anyone.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- Async.runOutcome { STM.atomically { STM.read (STM.new "hi") } } == Completed "hi"
-- ```
new : a ->{STM} Var a
new value = newVar value

-- The variable's value, including the transaction's own earlier writes.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- Async.runOutcome { STM.atomically { v = STM.new 1; STM.write v 2; STM.read v } } == Completed 2
-- ```
read : Var a ->{STM} a
read var = readVar var

-- Replaces the variable's value when the transaction commits. Later reads in
-- the same transaction see it at once.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- result = Async.runOutcome {
--     v = STM.atomically { STM.new [1] }
--     STM.atomically { STM.write v [2, 3] }
--     STM.atomically { STM.read v }
--     }
-- result == Completed [2, 3]
-- ```
write : Var a -> a ->{STM} ()
write var value = writeVar var value

-- Replaces the variable's value with `f` applied to it.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- Async.runOutcome { STM.atomically { v = STM.new 3; STM.modify v { n -> n * 7 }; STM.read v } } == Completed 21
-- ```
modify : Var a -> (a -> a) ->{STM} ()
modify var f = writeVar var (f (readVar var))

-- Replaces the variable's value with `next` and answers the value it
-- replaced.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- result = Async.runOutcome { STM.atomically { v = STM.new "old"; previous = STM.exchange v "new"; (previous, STM.read v) } }
-- result == Completed ("old", "new")
-- ```
exchange : Var a -> a ->{STM} a
exchange var next =
    previous = readVar var
    writeVar var next
    previous

-- Abandons the attempt: its writes are discarded, and the task waits until
-- another transaction commits a write to a variable the attempt read, then
-- runs the transaction again from the start. A `retry` that read nothing
-- waits until the task is cancelled.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import Maybe exposing (Maybe(..))
-- import STM
--
-- result = Async.runOutcome {
--     box = STM.atomically { STM.new Nothing }
--     consumer = Async.spawn {
--         STM.atomically {
--             case STM.read box of
--                 Just value -> value
--                 Nothing -> STM.retry ()
--         }
--     }
--     STM.atomically { STM.write box (Just 42) }
--     Async.await consumer
--     }
-- result == Completed 42
-- ```
retry : () ->{STM} a
retry () = abandon ()

-- Does nothing when `condition` holds, and `retry`s otherwise.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- result = Async.runOutcome {
--     permits = STM.atomically { STM.new 0 }
--     worker = Async.spawn {
--         STM.atomically {
--             available = STM.read permits
--             STM.check (available > 0)
--             STM.write permits (available - 1)
--         }
--         "acquired"
--     }
--     STM.atomically { STM.modify permits { n -> n + 1 } }
--     Async.await worker
--     }
-- result == Completed "acquired"
-- ```
check : Bool ->{STM} ()
check condition = if condition then () else abandon ()

-- Runs `first`, or `second` if `first` retries. The writes `first` made are
-- discarded before `second` runs, but its reads are kept: if both retry, the
-- transaction waits until a variable either of them read changes. A conflict
-- in `first` restarts the whole transaction rather than choosing `second`.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import STM
--
-- result = Async.runOutcome {
--     empty = STM.atomically { STM.new 0 }
--     full = STM.atomically { STM.new 5 }
--     takeFrom = { var ->
--         n = STM.read var
--         STM.write var 0
--         STM.check (n > 0)
--         n
--     }
--     STM.atomically {
--         taken = STM.orElse { takeFrom empty } { takeFrom full }
--         (taken, STM.read empty, STM.read full)
--     }
--     }
-- result == Completed (5, 0, 0)
-- ```
orElse : (() ->{STM} a) -> (() ->{STM} a) ->{STM} a
orElse first second =
    point = savepoint ()
    handle first() on
        readVar var -> resume (readVar var)
        writeVar var value -> resume (writeVar var value)
        newVar value -> resume (newVar value)
        savepoint () -> resume (savepoint ())
        rollback p -> resume (rollback p)
        abandon () ->
            rollback point
            second()

-- Runs `action`, answering `Ok` with its value, or `Err` with its failure
-- after discarding every write it made. Its reads are kept, so they still
-- decide whether the transaction commits. The transaction itself commits
-- either way; `Fail.fromResult` raises the error after `atomically`.
--
-- ```fango
-- import Async exposing (Outcome(..))
-- import Fail
-- import Result exposing (Result(..))
-- import STM
--
-- result = Async.runOutcome {
--     account = STM.atomically { STM.new 10 }
--     withdrawn = STM.atomically {
--         STM.attempt {
--             STM.modify account { n -> n - 30 }
--             if STM.read account < 0 then Fail.fail "overdrawn" else ()
--         }
--     }
--     (withdrawn, STM.atomically { STM.read account })
--     }
-- result == Completed (Err "overdrawn", 10)
-- ```
attempt : (() ->{STM, Fail error} a) ->{STM} Result error a
attempt action =
    point = savepoint ()
    case Fail.attempt action of
        Err error ->
            rollback point
            Err error
        success -> success
