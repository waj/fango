{-# no-prelude #-}
module IO exposing (Error(..), IO, Kind(..), Line(..), args, describeError, exit, lineEnding, lineText, print, readFile, readLine, write, writeFile)

import Basics exposing (..)
import List exposing (List)
import Maybe exposing (Maybe(..))

type Line = { text : String, ending : String } deriving (Eq, Show)

-- The kinds of operating-system failure a program can act on. Anything else
-- is Other, with the system's own text in the error's message.
type Kind = NotFound | PermissionDenied | AlreadyExists | IsDirectory | NotDirectory | Other deriving (Eq, Show)

-- A structured IO failure: what went wrong, the path the program supplied,
-- and a stable reason for a known kind or the system's message for Other.
-- Fallible natives produce these; see the design.
type Error = { kind : Kind, path : String, message : String } deriving (Eq, Show)

-- describeError renders a failure in the conventional `path: reason` form.
-- Known kinds use text from the kind rather than the host, so they are the
-- same on every platform; Other shows the system message.
describeError : Error -> String
describeError error =
    case error.kind of
        NotFound -> error.path ++ ": no such file or directory"
        PermissionDenied -> error.path ++ ": permission denied"
        AlreadyExists -> error.path ++ ": file exists"
        IsDirectory -> error.path ++ ": is a directory"
        NotDirectory -> error.path ++ ": not a directory"
        Other -> error.path ++ ": " ++ error.message

effect IO
    hasInput : () -> Bool = native
    readRawLine : () -> String = native
    write : String -> () = native
    argCount : () -> Int = native
    argAt : Int -> String = native
    pathExists : String -> Bool = native
    readFileText : String -> String = native
    writeFile : String -> String -> () = native
    exit : Int -> () = native

lineText : String -> String
lineText = native

lineEnding : String -> String
lineEnding = native

readLine : () ->{IO} Maybe Line
readLine() =
    case hasInput() of
        False -> Nothing
        True ->
            raw = readRawLine()
            Just (Line { text = lineText raw, ending = lineEnding raw })

print : Show a => a ->{IO} ()
print value = write (show value ++ "\n")

argsFrom : Int -> Int ->{IO} List String
argsFrom index count =
    if index >= count then
        []
    else
        [argAt index | argsFrom (index + 1) count]

args : () ->{IO} List String
args() = argsFrom 0 (argCount())

readFile : String ->{IO} Maybe String
readFile path = if pathExists path then Just (readFileText path) else Nothing
