{-# no-prelude #-}
module IO exposing (IO, Line(..), args, exit, print, readFile, readLine, write, writeFile)

import Basics exposing (..)
import List exposing (List(..))
import Maybe exposing (Maybe(..))

type Line = { text : String, ending : String } deriving (Eq, Show)

effect IO
    hasInput : () -> Bool = native
    readRawLine : () -> String = native
    write : String -> () = native
    argCount : () -> Int = native
    argAt : Int -> String = native
    pathExists : String -> Bool = native
    readFileText : String -> String = native
    writeFile : String -> String -> () = native
    exit : Int -> () = native

lineText : String -> String
lineText = native

lineEnding : String -> String
lineEnding = native

readLine : () ->{IO} Maybe Line
readLine() =
    case hasInput() of
        False -> Nothing
        True ->
            raw = readRawLine()
            Just (Line { text = lineText raw, ending = lineEnding raw })

print : Show a => a ->{IO} ()
print value = write (show value ++ "\n")

argsFrom : Int -> Int ->{IO} List String
argsFrom index count =
    if index >= count then
        Nil
    else
        Cons (argAt index) (argsFrom (index + 1) count)

args : () ->{IO} List String
args() = argsFrom 0 (argCount())

readFile : String ->{IO} Maybe String
readFile path = if pathExists path then Just (readFileText path) else Nothing
