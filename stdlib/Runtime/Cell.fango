{-# no-prelude #-}
module Runtime.Cell exposing (Publisher, Reader, create, publish, read, reader)

-- A scope-owned cell that accepts one value and then allows repeated reads.
-- Create it in a Coroutine scope, give its Reader to children in that scope,
-- and publish through its Publisher. The first publication wins. Readers
-- never wait or run a producer; they report whether a value is ready.
-- Stored values must be safe to share and cannot retain borrowed resources.

import Basics exposing (..)
import IO exposing (IO)
import Maybe exposing (Maybe(..))
import Runtime.Coroutine
import Runtime.Native

-- Private native storage behind the publication capability. Its type index
-- fixes the value type for this cell, even though the payload is opaque here.
{-# shared-resource #-}
type PublisherHandle a = PublisherHandle Runtime.Native.Any

-- Private native view of the same storage, limited to readiness and reads.
{-# shared-resource #-}
type ReaderHandle a = ReaderHandle Runtime.Native.Any

-- The capability to try to publish one value of type `a`. It retains the
-- creating Coroutine scope, so it cannot escape that scope's lifetime.
{-# resource #-}
type Publisher a = Publisher Runtime.Coroutine.Facet (PublisherHandle a)

-- A read-only view of the cell. It shares the stored value and readiness with
-- every other Reader of this Publisher and retains the same scope lifetime.
{-# resource #-}
type Reader a = Reader Runtime.Coroutine.Facet (ReaderHandle a)

-- Allocate empty native storage for a value of one fixed type.
cellNew : () ->{IO} PublisherHandle a
cellNew = native

-- Obtain a read-only native view of an existing cell.
cellReader : PublisherHandle a -> ReaderHandle a
cellReader = native

-- Attempt the one allowed publication; report whether this call won.
cellPublish : PublisherHandle a -> a ->{IO} Bool
cellPublish = native

-- Check whether the cell has received its value without waiting.
cellReady : ReaderHandle a ->{IO} Bool
cellReady = native

-- Read a published value. The public `read` checks readiness first.
cellRead : ReaderHandle a ->{IO} a
cellRead = native

-- Allocate an empty cell owned by `scope` and return its Publisher. The cell
-- and any Readers derived from it cannot outlive that scope.
create : Runtime.Coroutine.Scope e ->{IO} Publisher a
create scope = Publisher (Runtime.Coroutine.facet scope) (cellNew())

-- Make a read-only view of this Publisher. Multiple Readers observe the same
-- first published value; none can publish through this view.
reader : Publisher a -> Reader a
reader (Publisher owner cell) = Reader owner (cellReader cell)

-- Try to store `value`. Return True only for the first successful publication;
-- later calls return False and leave that value unchanged. The value cannot
-- retain a borrowed resource or mutable handler state.
publish : Publisher a -> a ->{IO} Bool
publish (Publisher _ cell) value = cellPublish cell value

-- Return Nothing before publication or Just the stored value afterward.
-- This checks readiness immediately and never waits or advances a coroutine.
read : Reader a ->{IO} Maybe a
read (Reader _ cell) = if cellReady cell then Just (cellRead cell) else Nothing
