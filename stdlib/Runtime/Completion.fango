{-# no-prelude #-}
module Runtime.Completion exposing (Completion, capture, failure, replay)

-- A detached result of an action that has already run: either its value or an
-- outward failure. Capture runs the action now; replay returns its value or
-- raises its saved failure under the handlers active at replay time. The
-- action's effect row stays in the type, so observing the result still requires
-- those effects. This can be used inside a Coroutine without owning one.

import Basics exposing (..)
import Failure exposing (Failure)
import Maybe exposing (Maybe)

-- A completed value or saved outward failure. `a` is the success type; `e`
-- records the effects needed to observe it. The action has finished, and no
-- callback or handler target is stored for a later replay.
type Completion a e = Completion (() ->{e} a)

-- Run the action immediately and save its value or outward failure. Pending
-- cleanup finishes before this returns. Effects handled inside the action
-- behave normally; resumptive effects can still pass through this call.
capture : (() ->{e} a) ->{e} Completion a e
capture = native

-- Return the saved value or raise the saved failure to a handler active now.
-- Replaying again does not rerun the action or its cleanup.
replay : Completion a e ->{e} a
replay = native

-- Inspect whether capture saved an outward failure, without raising it.
-- Returns Nothing after success or Just a detached failure snapshot.
failure : Completion a e -> Maybe Failure
failure = native
