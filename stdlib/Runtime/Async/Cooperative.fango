{-# no-prelude #-}
module Runtime.Async.Cooperative exposing (await, run, signal, spawn, waitSignal, waitTask, yield)

-- Cooperative interpreter of the executor-neutral Async request protocol.
-- Low-level probes install their own service pause authority; ordinary task
-- bodies use Async and enter here through Async.Cooperative.run.

import Async exposing (Error(..), Request(..))
import Basics exposing (..)
import IO exposing (IO)
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Cell
import Runtime.Coroutine
import Runtime.Service
import Runtime.Work

type Key = TaskKey Int | SignalKey Int deriving (Eq)
type Task a = Task Int (Runtime.Cell.Reader a)
type Job = Job Int Int (Runtime.Work.Work Request Int ())
type Waiting = Waiting Key Job
type Jobs = NoJobs | Jobs Job Jobs
type Queue = Queue Jobs Jobs
type State = State (List Waiting) (List Key) Int (List Int)
type Decision = Continue Queue State | Done (Result Error ())

enqueue : Job -> Queue -> Queue
enqueue value (Queue front back) = Queue front (Jobs value back)

-- Ready queues frequently contain only a few jobs. Single links avoid the
-- unused capacity of the general-purpose List's chunks at every rotation.
reverseJobs : Jobs -> Jobs -> Jobs
reverseJobs values result =
    case values of
        NoJobs -> result
        Jobs job rest -> reverseJobs rest (Jobs job result)

queueFront (Queue front back) =
    case front of
        NoJobs -> case back of
            Jobs _ NoJobs -> back
            _ -> reverseJobs back NoJobs
        _ -> front

queueBack (Queue front back) =
    case front of
        NoJobs -> NoJobs
        _ -> back

contains : Key -> List Key -> Bool
contains key values =
    case values of
        [] -> False
        [value | rest] -> if key == value then True else contains key rest

-- Notification state is sticky, so early and duplicate delivery cannot create
-- a second ready entry or lose a later wait registration.
wake : Key -> List Waiting -> Queue -> (List Waiting, Queue)
wake key waits ready =
    case waits of
        [] -> ([], ready)
        [Waiting wanted job | rest] ->
            (remaining, next) = wake key rest ready
            if wanted == key then (remaining, enqueue job next)
            else ([Waiting wanted job | remaining], next)

spawn : Runtime.Coroutine.Facet -> Runtime.Work.Work Request Int () -> Runtime.Cell.Reader a ->{Runtime.Service.Invocation Request Int} Task a
spawn owner work reader =
    key = Runtime.Service.invoke (Spawn work)
    Task key reader

await : Task a ->{Runtime.Service.Invocation Request Int, IO} a
await task =
    Task key reader = task
    case Runtime.Cell.read reader of
        Just value -> value
        Nothing ->
            reply = waitTask key
            await task

yield : () ->{Runtime.Service.Invocation Request Int} ()
yield() =
    reply = Runtime.Service.invoke Yield
    ()

waitSignal : Int ->{Runtime.Service.Invocation Request Int} ()
waitSignal key =
    reply = Runtime.Service.invoke (WaitSignal key)
    ()

signal : Int ->{Runtime.Service.Invocation Request Int} ()
signal key =
    reply = Runtime.Service.invoke (Signal key)
    ()

-- Internal probe for the deterministic self-wait diagnostic. Root key is 0.
waitTask : Int ->{Runtime.Service.Invocation Request Int} ()
waitTask key =
    reply = Runtime.Service.invoke (WaitTask key)
    ()

-- The ready queue changes on every yield; waiting/notification state does not.
-- Keep that state separate so a scheduling turn can retain it unchanged.
dispatch owner ready state =
    State waiting notified nextKey script = state
    decision =
        case queueFront ready of
            Jobs job rest ->
                back = queueBack ready
                Job key reply work = job
                case Runtime.Work.advance owner work reply of
                    Runtime.Coroutine.Suspended request ->
                        case request of
                            Spawn child ->
                                Continue (Queue (Jobs (Job key nextKey work) rest) (Jobs (Job nextKey 0 child) back)) (State waiting notified (nextKey + 1) script)
                            Yield ->
                                nextJob = if reply == 0 then job else Job key 0 work
                                yieldReady = case rest of
                                    NoJobs -> case back of
                                        NoJobs -> if reply == 0 then ready else Queue (Jobs nextJob NoJobs) NoJobs
                                        _ -> Queue rest (Jobs nextJob back)
                                    _ -> Queue rest (Jobs nextJob back)
                                Continue yieldReady state
                            WaitTask target ->
                                if target == key then Done (Err SelfAwait)
                                else if contains (TaskKey target) notified then Done (Err Stalled)
                                else Continue (Queue rest back) (State [Waiting (TaskKey target) (Job key 0 work) | waiting] notified nextKey script)
                            WaitSignal target ->
                                if contains (SignalKey target) notified then Continue (Queue rest (Jobs (Job key 0 work) back)) state
                                else Continue (Queue rest back) (State [Waiting (SignalKey target) (Job key 0 work) | waiting] notified nextKey script)
                            WaitNative _ -> Done (Err Stalled)
                            WaitCapacity -> Done (Err Stalled)
                            Signal target ->
                                (remaining, awoken) = wake (SignalKey target) waiting (Queue rest back)
                                Continue (enqueue (Job key 0 work) awoken) (State remaining [SignalKey target | notified] nextKey script)
                            Start _ _ -> Done (Err Stalled)
                            StartContext _ _ _ -> Done (Err Stalled)
                            AwaitTask _ -> Done (Err Stalled)
                            AwaitAny _ -> Done (Err Stalled)
                            WaitDone _ -> Done (Err Stalled)
                            ForgetTask _ -> Done (Err Stalled)
                            CancelTask _ -> Done (Err Stalled)
                            NewContext -> Done (Err Stalled)
                            Check -> Done (Err Stalled)
                            Published -> Done (Err Stalled)
                            Report _ _ -> Done (Err Stalled)
                            Fault error -> Done (Err error)
                    Runtime.Coroutine.Finished () ->
                        (remaining, awoken) = wake (TaskKey key) waiting (Queue rest back)
                        Continue awoken (State remaining [TaskKey key | notified] nextKey script)
                    Runtime.Coroutine.Polled -> Continue (Queue rest (Jobs (Job key reply work) back)) state
                    Runtime.Coroutine.Closed -> Done (Err Stalled)
            NoJobs ->
                case script of
                    [key | remainingScript] ->
                        (remaining, awoken) = wake (SignalKey key) waiting ready
                        Continue awoken (State remaining [SignalKey key | notified] nextKey remainingScript)
                    [] -> case waiting of
                        [] -> Done (Ok ())
                        _ -> Done (Err Stalled)
    case decision of
        Continue nextReady nextState -> dispatch owner nextReady nextState
        Done result -> result

run : List Int -> (Runtime.Coroutine.Facet -> Runtime.Cell.Publisher a -> (Request ->{Runtime.Coroutine.Suspension} Int) -> Int ->{Runtime.Coroutine.Suspension, IO | e} ()) ->{IO | e} Result Error a
run script make = Runtime.Coroutine.scope (\scope ->
    owner = Runtime.Coroutine.facet scope
    publisher = Runtime.Cell.create scope
    worker = make owner publisher
    work = Runtime.Work.register owner worker
    result = dispatch (Runtime.Work.owner scope) (Queue (Jobs (Job 0 0 work) NoJobs) NoJobs) (State [] [] 1 script)
    case result of
        Err error -> Err error
        Ok () -> case Runtime.Cell.read (Runtime.Cell.reader publisher) of
            Just value -> Ok value
            Nothing -> Err Stalled)
