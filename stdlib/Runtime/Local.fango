{-# no-prelude #-}
module Runtime.Local exposing (Cell(..), run)

import Basics exposing (..)
-- Each handler activation owns its own state. The row records permission to
-- access that activation; it has no runtime identity.
type Cell e a =
    { read : () ->{e} a
    , write : a ->{e} ()
    }

effect LocalState a
    readState : () -> a
    writeState : a -> ()

{-# scoped s #-}
run : a -> (Cell s a ->{s} b) ->{e} b
run initial action =
    handle action { read = { readState() }, write = { value -> writeState value } } with state = initial on
        readState () -> resume state with state
        writeState value -> resume () with value
