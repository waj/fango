{-# no-prelude #-}
module Runtime.NativeRequest exposing (Callback, Counts, Host, Registration, cancel, counts, drain, immediate, poll, register, scope)

-- Bounded, scope-owned native requests with driver-owned Fango callbacks.
-- Native work may run in the background and publish readiness, but only a
-- later `poll` executes its Fango action. Cancelling revokes delivery; draining
-- also waits for native work to stop using retained resources. Scope exit
-- cancels and drains every outstanding request.

import Basics exposing (..)
import IO exposing (IO)
import Maybe exposing (Maybe(..))
import Runtime.Completion exposing (Completion)
import Runtime.Native
import Runtime.Scope

-- Owner of a bounded set of registrations. A Host cannot outlive its scope.
{-# resource #-}
type Host = Host Runtime.Native.Any

-- Fresh token passed to a native submission. Native code uses it to announce
-- readiness and to acknowledge that it has stopped using retained resources.
{-# resource #-}
type Registration = Registration Runtime.Native.Any

-- One registration paired with the Fango action to run when it is ready.
-- The action remains with the driver; native work never invokes it directly.
type Callback a e = Callback Registration (() ->{e} a)

-- A snapshot of unfinished native work and occupied registration slots.
-- A ready but unclaimed request still occupies a slot.
type Counts = { live : Int, registrations : Int } deriving (Show)

-- Allocate a host with the requested registration capacity.
hostNew : Int ->{IO} Host
hostNew = native
-- Stop admission, cancel outstanding registrations, and drain native work.
hostClose : Host ->{IO} ()
hostClose = native
-- Reserve a fresh token if capacity allows.
reserve : Host ->{IO} Registration
reserve = native
-- Report whether a reserved token was admitted to its host.
admitted : Registration -> Bool
admitted = native
-- Claim a ready, quiescent registration for at-most-once delivery by this host.
claim : Host -> Registration ->{IO} Bool
claim = native
-- Revoke delivery and request cancellation without waiting for native work.
cancelRegistration : Registration ->{IO} ()
cancelRegistration = native
-- Cancel and wait until native work and its cancellation hook are quiescent.
drainRegistration : Registration ->{IO} ()
drainRegistration = native
-- Mark a claimed callback finished after its typed action and cleanup return.
finishRegistration : Registration ->{IO} ()
finishRegistration = native
-- Count native work or cancellation hooks that have not yet finished.
liveCount : Host ->{IO} Int
liveCount = native
-- Count registration slots still occupied by this host.
registrationCount : Host ->{IO} Int
registrationCount = native

-- Run `body` with a host of the given capacity. Nonpositive capacity admits
-- no requests. On every exit, revoke delivery and drain outstanding work.
scope : Int -> (Host ->{IO | e} a) ->{IO | e} a
scope capacity body = Runtime.Scope.bracket (\_ -> hostNew capacity) hostClose body

-- Run an action immediately and return its typed completion, without making
-- a registration. The action may succeed or fail but cannot suspend outward.
immediate : (() ->{e} a) ->{e} Completion a e
immediate = native

-- Reserve a slot, invoke `start` once with its native token, and retain the
-- Fango action for later delivery. Return Nothing when capacity is exhausted;
-- neither callback runs then. If start fails, drain its token before replaying
-- that failure. Neither start nor the eventual action may suspend outward.
register : Host -> (Registration ->{IO | e} ()) -> (() ->{IO | f} a) ->{IO | e} Maybe (Callback a {IO | f})
register host start callback =
    token = reserve host
    if admitted token then
        started = immediate (\_ -> start token)
        case Runtime.Completion.failure started of
            Just _ -> drainRegistration token
            Nothing -> ()
        Runtime.Completion.replay started
        Just (Callback token callback)
    else Nothing

-- Check readiness without waiting. Once native work is quiescent, claim this
-- binding at most once and run its action on the calling Fango driver. Return
-- the saved success or failure as a Completion; Nothing also covers cancelled,
-- already delivered, or foreign-host bindings.
poll : Host -> Callback a {IO | e} ->{IO | e} Maybe (Completion a {IO | e})
poll host (Callback token action) =
    if claim host token then
        result = immediate action
        finishRegistration token
        Just result
    else Nothing

-- Revoke delivery and call the native cancellation hook at most once. Native
-- work may still be running when this returns.
cancel : Callback a e ->{IO} ()
cancel (Callback token _) = cancelRegistration token
-- Cancel delivery and wait until native work and its cancellation hook finish.
drain : Callback a e ->{IO} ()
drain (Callback token _) = drainRegistration token
-- Read the host's current unfinished-work and occupied-slot counts.
counts : Host ->{IO} Counts
counts host = Counts { live = liveCount host, registrations = registrationCount host }
