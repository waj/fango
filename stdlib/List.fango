module List exposing (List(..), range, each, foldl)

type List a = Nil | Cons a (List a) deriving (Eq, Show)

range start end =
    if start > end then Nil else Cons start (range (start + 1) end)

each : (a ->{e} ()) -> List a ->{e} ()
each action values =
    case values of
        Nil -> ()
        Cons value rest ->
            action value
            each action rest

foldl : (a -> b ->{e} b) -> b -> List a ->{e} b
foldl combine result values =
    case values of
        Nil -> result
        Cons value rest -> foldl combine (combine value result) rest
