{-# no-prelude #-}
module Prelude exposing ()

-- The default scope. Every module that does not carry `{-# no-prelude #-}`
-- resolves as though these imports stood at the top of its own file, so they
-- grant qualified access exactly as a written import does. The bundled
-- standard library sits below this file and carries the pragma.

import Basics exposing
    ( Eq, Num, Ord, Show
    , ignore, show
    , (*), (+), (++), (-), (/), (/=), (<), (<=), (<|), (==), (>), (>=), (|>)
    )
import IO exposing (IO, print, readLine)
import List exposing (List)
import Maybe exposing (Maybe(..))
