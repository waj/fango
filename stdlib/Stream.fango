{-# no-prelude #-}
module Stream exposing (Stream, Yield, filter, fold, forEach, fromList, generate, map, take, toList, withCursor, yield, zip)

import Basics exposing (..)
import Iterator exposing (Iterator, Traversal, next)
import List exposing (List(..))
import Maybe exposing (Maybe(..))

effect Yield a
    yield : a -> ()

type Stream a e = Stream (() ->{Yield a | e} ())

generate : (() ->{Yield a | e} ()) -> Stream a e
generate producer = Stream producer

withProducer : (() ->{Yield a | e} ()) -> (Iterator a e ->{Traversal | e} result) ->{e} result
withProducer = native

withCursor : Stream a e -> (Iterator a e ->{Traversal | e} result) ->{e} result
withCursor source consumer = case source of
    Stream producer -> withProducer producer consumer

fromList : List a -> Stream a e
fromList values = generate (\_ -> List.each yield values)

mapCursor : (a ->{e} b) -> Iterator a e ->{Traversal, Yield b | e} ()
mapCursor action cursor = case next cursor of
    Nothing -> ()
    Just value ->
        yield (action value)
        mapCursor action cursor

map : (a ->{e} b) -> Stream a e -> Stream b e
map action source = generate (\_ -> withCursor source (mapCursor action))

filterCursor : (a ->{e} Bool) -> Iterator a e ->{Traversal, Yield a | e} ()
filterCursor predicate cursor = case next cursor of
    Nothing -> ()
    Just value ->
        if predicate value then yield value else ()
        filterCursor predicate cursor

filter : (a ->{e} Bool) -> Stream a e -> Stream a e
filter predicate source = generate (\_ -> withCursor source (filterCursor predicate))

takeCursor : Int -> Iterator a e ->{Traversal, Yield a | e} ()
takeCursor count cursor =
    if count <= 0 then ()
    else
        case next cursor of
            Nothing -> ()
            Just value ->
                yield value
                takeCursor (count - 1) cursor

take : Int -> Stream a e -> Stream a e
take count source = generate (\_ -> if count <= 0 then () else withCursor source (takeCursor count))

foldCursor : (a -> b ->{e} b) -> b -> Iterator a e ->{Traversal | e} b
foldCursor combine accumulator cursor = case next cursor of
    Nothing -> accumulator
    Just value -> foldCursor combine (combine value accumulator) cursor

fold : (a -> b ->{e} b) -> b -> Stream a e ->{e} b
fold combine initial source = withCursor source (foldCursor combine initial)

forEach : (a ->{e} ()) -> Stream a e ->{e} ()
forEach action source = fold (\value _ -> action value) () source

toList : Stream a e ->{e} List a
toList source = List.reverse (fold (\value values -> Cons value values) Nil source)

zipCursors : Iterator a e -> Iterator b e ->{Traversal, Yield (a, b) | e} ()
zipCursors left right = case next left of
    Nothing -> ()
    Just a -> case next right of
        Nothing -> ()
        Just b ->
            yield (a, b)
            zipCursors left right

zip : Stream a e -> Stream b e -> Stream (a, b) e
zip left right = generate (\_ -> withCursor left (\leftCursor -> withCursor right (zipCursors leftCursor)))
