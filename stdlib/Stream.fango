{-# no-prelude #-}
module Stream exposing (Stream(..), filter, fold, forEach, fromList, map, take, toList, unfold, withCursor, zip)

import Basics exposing (..)
import Iterator exposing (Iterator)
import List exposing (List)
import Maybe exposing (Maybe(..))

-- A reusable traversal description. Each step returns its next state explicitly.
-- Resource acquisition and cleanup belong to the scope consuming the stream.
type Stream state a e = { initial : state, step : state ->{e} Maybe (a, state) }

unfold : state -> (state ->{e} Maybe (a, state)) -> Stream state a e
unfold initial step = { initial = initial, step = step }

withCursor : Stream state a e -> (Iterator state a e ->{e} result) ->{e} result
withCursor source consumer = consumer (Iterator.start source.initial source.step)

listStep values = case values of
    [] -> Nothing
    [value | rest] -> Just (value, rest)

fromList : List a -> Stream (List a) a e
fromList values = unfold values listStep

mapStep action step state = case step state of
    Nothing -> Nothing
    Just (value, next) -> Just (action value, next)

map : (a ->{e} b) -> Stream state a e -> Stream state b e
map action source = unfold source.initial (mapStep action source.step)

filterStep predicate step state = case step state of
    Nothing -> Nothing
    Just (value, next) ->
        if predicate value then Just (value, next)
        else filterStep predicate step next

filter : (a ->{e} Bool) -> Stream state a e -> Stream state a e
filter predicate source = unfold source.initial (filterStep predicate source.step)

takeStep step (remaining, state) =
    if remaining <= 0 then Nothing
    else case step state of
        Nothing -> Nothing
        Just (value, next) -> Just (value, (remaining - 1, next))

take : Int -> Stream state a e -> Stream (Int, state) a e
take count source = unfold (count, source.initial) (takeStep source.step)

foldStep combine step accumulator state = case step state of
    Nothing -> accumulator
    Just (value, next) -> foldStep combine step (combine value accumulator) next

fold : (a -> b ->{e} b) -> b -> Stream state a e ->{e} b
fold combine initial source = foldStep combine source.step initial source.initial

forEach : (a ->{e} ()) -> Stream state a e ->{e} ()
forEach action source = fold (\value _ -> action value) () source

toList : Stream state a e ->{e} List a
toList source = List.reverse (fold (\value values -> [value | values]) [] source)

zipStep left right (leftState, rightState) = case left leftState of
    Nothing -> Nothing
    Just (a, leftNext) -> case right rightState of
        Nothing -> Nothing
        Just (b, rightNext) -> Just ((a, b), (leftNext, rightNext))

zip : Stream left a e -> Stream right b e -> Stream (left, right) (a, b) e
zip left right = unfold (left.initial, right.initial) (zipStep left.step right.step)
