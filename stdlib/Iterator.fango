{-# no-prelude #-}
module Iterator exposing (Iterator, next, start)

import Basics exposing (..)
import Maybe exposing (Maybe(..))

-- An immutable position. Advancing returns a new position; aliases retain theirs.
type Iterator state a e = { state : state, step : state ->{e} Maybe (a, state) }

start : state -> (state ->{e} Maybe (a, state)) -> Iterator state a e
start state step = { state = state, step = step }

next : Iterator state a e ->{e} Maybe (a, Iterator state a e)
next cursor = case cursor.step cursor.state of
    Nothing -> Nothing
    Just (value, state) -> Just (value, { state = state, step = cursor.step })
