{-# no-prelude #-}
module Iterator exposing (Iterator, fromCoroutine, next)

import Basics exposing (..)
import Coroutine exposing (Coroutine, Drive, Step(..), advance)
import Maybe exposing (Maybe(..))

{-# resource #-}
type Iterator a e = Iterator (Coroutine a () () e)

fromCoroutine : Coroutine a () () e -> Iterator a e
fromCoroutine work = Iterator work

next : Iterator a e ->{Drive | e} Maybe a
next (Iterator work) = case advance work () of
    Suspended value -> Just value
    Finished () -> Nothing
    Closed -> Nothing
