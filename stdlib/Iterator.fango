{-# no-prelude #-}
module Iterator exposing (Iterator, Traversal, next)

import Basics exposing (..)
import Maybe exposing (Maybe(..))

effect Traversal
    advance : () -> ()

-- The private field establishes the element and latent effect-row kinds.
-- Cursor values and their producer state are supplied by the compiler.
{-# resource #-}
type Iterator a e = Iterator (() ->{e} a)

next : Iterator a e ->{Traversal | e} Maybe a
next = native
