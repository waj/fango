{-# no-prelude #-}
-- Files and directories.
--
-- `withFile`, `withOutput`, and `withAppend` open a file as a `Handle`
-- for the length of a callback and close it exactly once when the callback
-- exits, however it exits. A failed open raises before anything is acquired.
-- A failed close after a successful callback is the scope's failure; after a
-- failed one it is recorded beside it. A handle that escapes its scope
-- reports a closed-resource error when used. Closing a handle interrupts a
-- blocked read on it.
--
-- Whole-file and directory operations perform `FileSystem` and answer a
-- `Result`. `runSystem` is its default and resolves relative paths from the
-- program's working directory; `runMemory` interprets them without OS access.
-- Streaming operations use the same effect. Handles belong to one runner and
-- become invalid when closed or when that runner exits.
module File exposing
    ( Fault(..), Faults, FileSystem(..), Handle, Image, Provider, Snapshot(..)
    , empty, handleKey, isDirectory, newHandle, noFaults, read, readBytes
    , readLine, runMemory, runMemoryWith, runSystem, sink, size, source, textAt
    , withAppend, withByteFile, withDirectory, withFault, withFile, withOutput
    , withProvider, withTextFile, write, writeAll, writeBytes
    )

import Basics exposing (..)
import Bytes exposing (Bytes, Sink(..), Source(..))
import Dict exposing (Dict)
import Fail exposing (Fail, attempt, fromResult)
import IO exposing (Error(..), IO)
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Entry
import Runtime.IO
import Runtime.Native
import Runtime.Scope
import String

-- File acquisition, streaming access, and whole-file/directory queries. Every
-- operation is public so custom handlers can interpret the complete boundary.
#[Runtime.Entry.DefaultHandler `runSystem`]
effect FileSystem
    -- Opens a file for reading. Raw acquisitions must be closed by the caller;
    -- the provider also invalidates remaining handles at its exit.
    openRead : String -> Result Error Handle
    -- Creates or truncates a file and opens it for writing.
    openWrite : String -> Result Error Handle
    -- Opens a file for append, creating it when needed.
    openAppend : String -> Result Error Handle
    -- Closes a handle. Repeated close under its owning provider succeeds.
    closeHandle : Handle -> Result Error ()
    -- The next line, or `Nothing` at EOF. Invalid UTF-8 is replaced with U+FFFD.
    readHandleLine : Handle -> Result Error (Maybe IO.Line)
    -- Up to `count` bytes, bounded by 64 KiB, or `Nothing` at EOF. A nonpositive
    -- count answers empty bytes while input remains.
    readHandleBytes : Handle -> Int -> Result Error (Maybe Bytes)
    -- Writes all bytes; failure may leave a written prefix.
    writeHandleBytes : Handle -> Bytes -> Result Error ()
    -- Reads the file as text, replacing each consecutive run of malformed
    -- UTF-8 with U+FFFD.
    readFileResult : String -> Result Error String
    -- Creates or replaces a file with UTF-8 text; its parent must exist.
    writeFileResult : String -> String -> Result Error ()
    -- Whether the path names a directory.
    isDirectoryPath : String -> Result Error Bool
    -- The file's size in bytes. Directory sizes are provider-specific.
    fileSize : String -> Result Error Int
    -- The immediate entry names of the directory, sorted.
    listDirectory : String -> Result Error (List String)

-- A file handle. It cannot be forged, inspected, or compared. The standard
-- runners reject a handle created by another provider, and use after close or
-- after its provider exits.
{-# resource #-}
type Handle
    = SystemHandle SystemFile
    | VirtualHandle Provider String Int

{-# resource #-}
type SystemFile = SystemFile Runtime.Native.Any

-- The identity of one handler's files. A custom handler that creates handles
-- gets a fresh provider from `withProvider`; comparing a handle's provider
-- tells its own handles apart from those of nested or earlier handlers.
{-# resource #-}
type Provider = Provider Runtime.Native.Any

freshProvider : () -> Provider
freshProvider = native

retireProvider : Provider -> ()
retireProvider = native

providerStatus : Provider -> Result Error ()
providerStatus = native

sameProvider : Provider -> Provider -> Bool
sameProvider = native

systemFilePath : SystemFile -> String
systemFilePath = native

-- Gives a custom handler a fresh provider and retires it on every exit of
-- `action`. Handles created under it, including any the result carries, then
-- answer `closed provider`.
withProvider : (Provider ->{e} a) ->{e} a
withProvider action = Runtime.Scope.bracket freshProvider retireProvider action

-- A handle owned by the provider, for `path` and the handler's own backend
-- `key`. The handler chooses keys and must not reuse one within a provider:
-- whether a key is still open is the handler's own state, so a reused key
-- would make a closed handle valid again.
newHandle : Provider -> String -> Int -> Handle
newHandle provider path key = VirtualHandle provider path key

-- The backend key of a handle this provider created. Any other handle,
-- including a system one, answers `foreign handle`; after the provider exits,
-- `closed provider`. Both are `IO.Other` errors at the handle's path.
handleKey : Provider -> Handle -> Result Error Int
handleKey provider file =
    case file of
        SystemHandle real -> Err (otherError (systemFilePath real) "foreign handle")
        VirtualHandle owner path key ->
            if sameProvider owner provider then
                case providerStatus provider of
                    Err error -> Err { error | path = path }
                    Ok () -> Ok key
            else Err (otherError path "foreign handle")

handlePath : Handle -> String
handlePath file =
    case file of
        SystemHandle real -> systemFilePath real
        VirtualHandle _ path _ -> path

{-# resource #-}
type Directory = Directory Runtime.Native.Any

-- File text conversion preserves the native whole-file replacement policy.
fileText : Bytes -> String
fileText = native

systemFault : String ->{IO} ()
systemFault = native

systemProvider : () ->{IO} Provider
systemProvider = native

systemRetireProvider : Provider ->{IO} Result Error ()
systemRetireProvider = native

systemOpenRead : Provider -> String ->{IO} Result Error SystemFile
systemOpenRead = native

systemOpenWrite : Provider -> String ->{IO} Result Error SystemFile
systemOpenWrite = native

systemOpenAppend : Provider -> String ->{IO} Result Error SystemFile
systemOpenAppend = native

systemCloseHandle : Provider -> SystemFile ->{IO} Result Error ()
systemCloseHandle = native

systemHandleHasInput : Provider -> SystemFile ->{IO} Result Error Bool
systemHandleHasInput = native

systemReadHandleLine : Provider -> SystemFile ->{IO} Result Error String
systemReadHandleLine = native

systemReadHandleBytes : Provider -> SystemFile -> Int ->{IO} Result Error Bytes
systemReadHandleBytes = native

systemWriteHandleBytes : Provider -> SystemFile -> Bytes ->{IO} Result Error ()
systemWriteHandleBytes = native

systemReadFileResult : String ->{IO} Result Error String
systemReadFileResult = native

systemWriteFileResult : String -> String ->{IO} Result Error ()
systemWriteFileResult = native

openDirectory : String ->{IO} Result Error Directory
openDirectory = native

readDirectoryEntry : Directory ->{IO} Result Error String
readDirectoryEntry = native

closeDirectory : Directory ->{IO} Result Error ()
closeDirectory = native

systemIsDirectoryPath : String ->{IO} Result Error Bool
systemIsDirectoryPath = native

systemFileSize : String ->{IO} Result Error Int
systemFileSize = native

close : Handle ->{FileSystem, Fail Error} ()
close file = fromResult (closeHandle file)

withOpened : (String ->{FileSystem} Result Error Handle) -> String -> (Handle ->{FileSystem, Fail Error | e} a) ->{FileSystem, Fail Error | e} a
withOpened open path action = Runtime.Scope.bracket { fromResult (open path) } close action

-- Opens `path` for reading, runs the callback, and closes exactly once on
-- normal return or a language abort. Failed acquisition releases nothing.
withFile : String -> (Handle ->{FileSystem, Fail Error | e} a) ->{FileSystem, Fail Error | e} a
withFile path action = withOpened openRead path action

-- Creates or truncates `path`, runs the callback, and closes on every exit.
-- A close failure after success becomes primary; after a body failure it is
-- recorded as a suppressed failure.
withOutput : String -> (Handle ->{FileSystem, Fail Error | e} a) ->{FileSystem, Fail Error | e} a
withOutput path action = withOpened openWrite path action

-- Opens `path` for append, creating it if necessary, and closes on every exit.
withAppend : String -> (Handle ->{FileSystem, Fail Error | e} a) ->{FileSystem, Fail Error | e} a
withAppend path action = withOpened openAppend path action

-- The next line and its exact terminator, or `Nothing` at EOF. Byte and line
-- reads share one offset. A write-only, closed, or foreign handle fails.
readLine : Handle ->{FileSystem, Fail Error} Maybe IO.Line
readLine file = fromResult (readHandleLine file)

-- Up to `count` bytes, at most 64 KiB, or `Nothing` at EOF. A nonpositive
-- count returns empty bytes while input remains. Reads may be short.
readBytes : Handle -> Int ->{FileSystem, Fail Error} Maybe Bytes
readBytes file count = fromResult (readHandleBytes file count)

-- Writes all UTF-8 bytes of the text without adding a newline.
write : Handle -> String ->{FileSystem, Fail Error} ()
write file text = writeBytes file (Bytes.fromString text)

-- Writes all bytes. A read-only, closed, or foreign handle fails.
writeBytes : Handle -> Bytes ->{FileSystem, Fail Error} ()
writeBytes file data = fromResult (writeHandleBytes file data)

-- A byte source borrowing the file. It takes no ownership and checks the
-- handle's provider and validity on every pull.
source : Handle -> Source {FileSystem, Fail Error}
source file = Source { pull = { readBytes file Runtime.IO.chunk } }

-- A byte sink borrowing the file. It takes no ownership and checks the
-- handle's provider and validity on every write.
sink : Handle -> Sink {FileSystem, Fail Error}
sink file = Sink { write = { data -> writeBytes file data } }

-- Whole-file operations need no handle and report failure as a Result.

-- The whole contents of the file at `path` as text, with U+FFFD in place of
-- each consecutive run of malformed UTF-8.
read : String ->{FileSystem} Result Error String
read path = readFileResult path

-- Writes `text` as the whole contents of the file at `path`, creating or
-- replacing it.
writeAll : String -> String ->{FileSystem} Result Error ()
writeAll path text = writeFileResult path text

-- Whether `path` names a directory rather than a file.
isDirectory : String ->{FileSystem} Result Error Bool
isDirectory path = isDirectoryPath path

-- The size in bytes of the file at `path`.
size : String ->{FileSystem} Result Error Int
size path = fileSize path

collectEntries : Directory -> List String ->{IO, Fail Error} List String
collectEntries directory found =
    name = fromResult (readDirectoryEntry directory)
    if name == "" then
        List.reverse found
    else
        collectEntries directory [name | found]

closeListing : Directory ->{IO, Fail Error} ()
closeListing directory = fromResult (closeDirectory directory)

systemListDirectory : String ->{IO} Result Error (List String)
systemListDirectory path =
    attempt {
        Runtime.Scope.bracket { fromResult (openDirectory path) } closeListing { directory ->
            collectEntries directory []
        }
    }

systemPath : Provider -> String -> (() ->{IO} Result Error a) ->{IO} Result Error a
systemPath provider path action =
    case providerStatus provider of
        Err error -> Err { error | path = path }
        Ok () -> action()

activeResult : Provider -> String -> Result Error a -> Result Error a
activeResult provider path result =
    case providerStatus provider of
        Err error -> Err { error | path = path }
        Ok () -> result

systemOpen : (Provider -> String ->{IO} Result Error SystemFile) -> Provider -> String ->{IO} Result Error Handle
systemOpen open provider path = Result.map SystemHandle (open provider path)

-- The system runner owns only system handles; its natives check the owner.
systemHandle : Handle -> (SystemFile ->{IO} Result Error a) ->{IO} Result Error a
systemHandle file action =
    case file of
        SystemHandle real -> action real
        VirtualHandle _ path _ -> Err (otherError path "foreign handle")

systemBytes : Provider -> SystemFile -> Int ->{IO} Result Error (Maybe Bytes)
systemBytes provider file count =
    if count <= 0 then
        Result.map { available -> if available then Just Bytes.empty else Nothing } (systemHandleHasInput provider file)
    else
        Result.map Runtime.IO.bytes (systemReadHandleBytes provider file count)

-- Interprets FileSystem through the OS under a fresh provider. Scoped files
-- close before their callbacks leave; remaining raw handles close and become
-- invalid at runner exit. Raw acquisition callers must explicitly close their
-- handles; teardown reports its first native close failure.
runSystem : (() ->{FileSystem | e} a) ->{IO | e} a
runSystem action =
    -- Teardown failures are runtime faults: raw acquisition requires explicit
    -- close, whereas scoped close failures retain the normal Fail contract.
    Runtime.Scope.bracket systemProvider { provider ->
        case systemRetireProvider provider of
            Ok () -> ()
            Err error -> systemFault (IO.describeError error)
    } { provider ->
        handle action() on
            openRead path -> resume (systemOpen systemOpenRead provider path)
            openWrite path -> resume (systemOpen systemOpenWrite provider path)
            openAppend path -> resume (systemOpen systemOpenAppend provider path)
            closeHandle file -> resume (systemHandle file { real -> systemCloseHandle provider real })
            readHandleLine file ->
                resume (systemHandle file { real -> Result.map Runtime.IO.line (systemReadHandleLine provider real) })
            readHandleBytes file count -> resume (systemHandle file { real -> systemBytes provider real count })
            writeHandleBytes file data -> resume (systemHandle file { real -> systemWriteHandleBytes provider real data })
            readFileResult path -> resume (systemPath provider path { systemReadFileResult path })
            writeFileResult path text -> resume (systemPath provider path { systemWriteFileResult path text })
            isDirectoryPath path -> resume (systemPath provider path { systemIsDirectoryPath path })
            fileSize path -> resume (systemPath provider path { systemFileSize path })
            listDirectory path -> resume (systemPath provider path { systemListDirectory path })
    }

type Entry = Folder | Contents Bytes

-- An opaque immutable filesystem fixture. Paths use `/`, with `/` as both
-- root and working directory. Repeated separators and `.` are removed;
-- `..` moves to the parent and stays at root there. Empty paths and NUL are
-- invalid. No symlinks, permissions, or host path lookup are modeled.
type Image = Image (Dict String Entry)

-- An action's result and the final immutable filesystem image.
type Snapshot a =
    {
      -- The action's result.
      value : a
      -- The final image, independent of subsequent runners.
    , image : Image
    }

-- An image containing only the root directory.
empty : Image
empty = Image (Dict.singleton "/" Folder)

errorAt : IO.Kind -> String -> Error
errorAt kind path =
    Error { kind = kind, path = path, message = reason kind }

reason : IO.Kind -> String
reason kind =
    case kind of
        IO.NotFound -> "no such file or directory"
        IO.PermissionDenied -> "permission denied"
        IO.AlreadyExists -> "file exists"
        IO.IsDirectory -> "is a directory"
        IO.NotDirectory -> "not a directory"
        IO.Other -> "invalid path"

parts : List String -> List String -> List String
parts remaining reversed =
    case remaining of
        [] -> List.reverse reversed
        [part | rest] ->
            if part == "" || part == "." then parts rest reversed
            else if part == ".." then
                case reversed of
                    [] -> parts rest []
                    [_ | parent] -> parts rest parent
            else parts rest [part | reversed]

normalized : String -> Result Error (List String)
normalized path =
    if path == "" || String.contains (Bytes.toStringLossy (Bytes.fromList [0])) path then
        Err (errorAt IO.Other path)
    else Ok (parts (String.split "/" path) [])

child : String -> String -> String
child parent name = if parent == "/" then "/" ++ name else parent ++ "/" ++ name

keyOf : List String -> String
keyOf names = List.foldl { name parent -> child parent name } "/" names

-- Checks each parent so errors distinguish missing paths from file parents.
parents : Bool -> String -> String -> List String -> Dict String Entry -> Result Error (Dict String Entry)
parents create original parent names entries =
    case names of
        [] -> Ok entries
        [_] -> Ok entries
        [name | rest] ->
            key = child parent name
            case Dict.get key entries of
                Just Folder -> parents create original key rest entries
                Just (Contents _) -> Err (errorAt IO.NotDirectory original)
                Nothing ->
                    if create then parents create original key rest (Dict.insert key Folder entries)
                    else Err (errorAt IO.NotFound original)

put : Bool -> Entry -> String -> Image -> Result Error Image
put create entry path (Image entries) =
    case normalized path of
        Err error -> Err error
        Ok names ->
            case parents create path "/" names entries of
                Err error -> Err error
                Ok ready ->
                    key = keyOf names
                    case (Dict.get key ready, entry) of
                        (Just Folder, Contents _) -> Err (errorAt IO.IsDirectory path)
                        (Just (Contents _), Folder) -> Err (errorAt IO.NotDirectory path)
                        _ -> Ok (Image (Dict.insert key entry ready))

-- Adds a directory and missing parents. An existing directory is kept;
-- a file at the path or a parent answers `NotDirectory`.
withDirectory : String -> Image -> Result Error Image
withDirectory path image = put True Folder path image

-- Adds or replaces a file and creates missing parents. A directory at the
-- path answers `IsDirectory`; a file parent answers `NotDirectory`.
withByteFile : String -> Bytes -> Image -> Result Error Image
withByteFile path data image = put True (Contents data) path image

-- Like `withByteFile`, storing the UTF-8 bytes of the text.
--
-- ```fango
-- import File
-- import Result exposing (Result(..))
--
-- case File.withTextFile "config/settings" "ready" File.empty of
--     Ok image -> File.textAt "config/./settings" image == Ok "ready"
--     Err _ -> False
-- ```
withTextFile : String -> String -> Image -> Result Error Image
withTextFile path text image = withByteFile path (Bytes.fromString text) image

entryAt : String -> Image -> Result Error Entry
entryAt path (Image entries) =
    case normalized path of
        Err error -> Err error
        Ok names ->
            case parents False path "/" names entries of
                Err error -> Err error
                Ok _ ->
                    case Dict.get (keyOf names) entries of
                        Nothing -> Err (errorAt IO.NotFound path)
                        Just entry -> Ok entry

-- The file's text, replacing each consecutive run of malformed UTF-8 with
-- U+FFFD, without running
-- a service. Missing files and directory paths answer structured errors.
textAt : String -> Image -> Result Error String
textAt path image =
    case entryAt path image of
        Err error -> Err error
        Ok Folder -> Err (errorAt IO.IsDirectory path)
        Ok (Contents data) -> Ok (fileText data)

memoryDirectory : String -> Image -> Result Error Bool
memoryDirectory path image =
    case entryAt path image of
        Err error -> Err error
        Ok Folder -> Ok True
        Ok (Contents _) -> Ok False

memorySize : String -> Image -> Result Error Int
memorySize path image =
    case entryAt path image of
        Err error -> Err error
        Ok Folder -> Ok 0
        Ok (Contents data) -> Ok (Bytes.length data)

memoryListing : String -> Image -> Result Error (List String)
memoryListing path (Image entries) =
    case entryAt path (Image entries) of
        Err error -> Err error
        Ok (Contents _) -> Err (errorAt IO.NotDirectory path)
        Ok Folder ->
            case normalized path of
                Err error -> Err error
                Ok names ->
                    key = keyOf names
                    prefix = if key == "/" then key else key ++ "/"
                    direct = { candidate ->
                        if String.startsWith prefix candidate then
                            suffix = String.slice (String.length prefix) (String.length candidate) candidate
                            suffix /= "" && String.contains "/" suffix == False
                        else False
                    }
                    Ok (List.map { candidate -> String.slice (String.length prefix) (String.length candidate) candidate } (List.filter direct (Dict.keys entries)))

type Mode = ReadMode | WriteMode | AppendMode deriving (Eq)
type Cursor = { path : String, mode : Mode, position : Int, progress : Int }

-- Open cursors by key. Keys are never reused, so an owned key without a cursor
-- names a closed handle.
type Memory = { image : Image, faults : Faults, handles : Dict Int Cursor, next : Int }

-- A deterministic fault for `runMemoryWith`.
type Fault
    -- Fails acquisition before creating or truncating anything.
    = OpenFailure
    -- Allows this many bytes per open handle, then fails a read while input
    -- remains. EOF and nonpositive-count probes do not consume the budget.
    | ReadFailure Int
    -- Writes at most this many bytes per open handle; a short write fails
    -- after publishing its prefix.
    | WriteFailure Int
    -- Fails the first close after invalidating the handle.
    | CloseFailure
    deriving (Eq, Show)

-- Faults by normalized path. They configure a run rather than the image, so a
-- returned snapshot carries none of them.
type Faults = Faults (Dict String (List Fault))

-- No injected faults.
noFaults : Faults
noFaults = Faults Dict.empty

-- Adds a fault for this normalized path, including paths not yet present.
-- Later faults of the same kind take precedence. Negative byte limits and
-- invalid paths answer `IO.Other`.
--
-- ```fango
-- import File exposing (Fault(..))
-- import Result exposing (Result(..))
--
-- case File.withFault "data" (WriteFailure 2) File.noFaults of
--     Ok faults ->
--         run = File.runMemoryWith faults File.empty { File.writeAll "data" "hello" }
--         File.textAt "data" run.image == Ok "he"
--     Err _ -> False
-- ```
withFault : String -> Fault -> Faults -> Result Error Faults
withFault path fault (Faults faults) =
    invalid = case fault of
        ReadFailure n -> n < 0
        WriteFailure n -> n < 0
        _ -> False
    if invalid then Err (otherError path "invalid fault limit")
    else case normalized path of
        Err error -> Err error
        Ok names ->
            key = keyOf names
            old = Maybe.withDefault [] (Dict.get key faults)
            Ok (Faults (Dict.insert key [fault | old] faults))

hasFault : Fault -> List Fault -> Bool
hasFault target faults =
    case faults of
        [] -> False
        [fault | rest] -> if fault == target then True else hasFault target rest

otherError : String -> String -> Error
otherError path message = Error { kind = IO.Other, path = path, message = message }

faultsAt : String -> Faults -> List Fault
faultsAt path (Faults faults) =
    case normalized path of
        Err _ -> []
        Ok names -> Maybe.withDefault [] (Dict.get (keyOf names) faults)

limitOf : Bool -> List Fault -> Maybe Int
limitOf reading faults =
    case faults of
        [] -> Nothing
        [ReadFailure n | rest] -> if reading then Just n else limitOf reading rest
        [WriteFailure n | rest] -> if reading then limitOf reading rest else Just n
        [_ | rest] -> limitOf reading rest

allowance : Bool -> Cursor -> Int -> Faults -> Int
allowance reading cursor count faults =
    case limitOf reading (faultsAt cursor.path faults) of
        Nothing -> count
        Just limit ->
            left = limit - cursor.progress
            if left <= 0 then 0 else if left < count then left else count

remember : Int -> Cursor -> Memory -> Memory
remember key cursor memory = { memory | handles = Dict.insert key cursor memory.handles }

opened : Provider -> Mode -> String -> Image -> Memory -> (Result Error Handle, Memory)
opened provider mode path image memory =
    cursor = Cursor { path = path, mode = mode, position = 0, progress = 0 }
    (Ok (newHandle provider path memory.next), remember memory.next cursor { memory | image = image, next = memory.next + 1 })

memoryOpen : Provider -> Mode -> String -> Memory -> (Result Error Handle, Memory)
memoryOpen provider mode path memory =
    if hasFault OpenFailure (faultsAt path memory.faults) then
        (Err (otherError path "injected open failure"), memory)
    else case mode of
        ReadMode ->
            case entryAt path memory.image of
                Err error -> (Err error, memory)
                Ok _ -> opened provider mode path memory.image memory
        WriteMode ->
            case put False (Contents Bytes.empty) path memory.image of
                Err error -> (Err error, memory)
                Ok image -> opened provider mode path image memory
        AppendMode ->
            case entryAt path memory.image of
                Ok Folder -> (Err (errorAt IO.IsDirectory path), memory)
                Ok (Contents _) -> opened provider mode path memory.image memory
                Err error ->
                    if error.kind == IO.NotFound then
                        case put False (Contents Bytes.empty) path memory.image of
                            Err problem -> (Err problem, memory)
                            Ok image -> opened provider mode path image memory
                    else (Err error, memory)

cursorAt : Provider -> Handle -> Memory -> Result Error (Int, Cursor)
cursorAt provider file memory =
    case handleKey provider file of
        Err error -> Err error
        Ok key ->
            case Dict.get key memory.handles of
                Nothing -> Err (otherError (handlePath file) "closed handle")
                Just cursor -> Ok (key, cursor)

memoryRead : Provider -> Handle -> Int -> Bool -> Memory -> (Result Error (Maybe Bytes), Memory)
memoryRead provider file count line memory =
    case cursorAt provider file memory of
        Err error -> (Err error, memory)
        Ok (key, cursor) ->
            if cursor.mode /= ReadMode then (Err (otherError cursor.path "handle is not readable"), memory)
            else case entryAt cursor.path memory.image of
                Err error -> (Err error, memory)
                Ok Folder -> (Err (errorAt IO.IsDirectory cursor.path), memory)
                Ok (Contents data) ->
                    remaining = Bytes.slice cursor.position (Bytes.length data) data
                    length = Bytes.length remaining
                    if length == 0 then (Ok Nothing, memory)
                    else if count <= 0 && line == False then (Ok (Just Bytes.empty), memory)
                    else
                        asked =
                            if line then
                                case Bytes.indexOf (Bytes.fromString "\n") remaining of
                                    Nothing -> length
                                    Just at -> at + 1
                            else if count < length then count else length
                        bounded = if line || asked <= Runtime.IO.chunk then asked else Runtime.IO.chunk
                        taken = allowance True cursor bounded memory.faults
                        if taken == 0 then (Err (otherError cursor.path "injected read failure"), memory)
                        else
                            next = { cursor | position = cursor.position + taken, progress = cursor.progress + taken }
                            (Ok (Just (Bytes.slice 0 taken remaining)), remember key next memory)

memoryLine : Provider -> Handle -> Memory -> (Result Error (Maybe IO.Line), Memory)
memoryLine provider file memory =
    (result, next) = memoryRead provider file 1 True memory
    line = Result.map { data ->
        case data of
            Nothing -> Nothing
            Just raw -> Runtime.IO.line (fileText raw)
    } result
    (line, next)

zeroes : Int -> List Int -> List Int
zeroes n found = if n <= 0 then found else zeroes (n - 1) [0 | found]

replaceBytes : Int -> Bytes -> Bytes -> Bytes
replaceBytes position data old =
    gap = if position > Bytes.length old then Bytes.fromList (zeroes (position - Bytes.length old) []) else Bytes.empty
    Bytes.concat [Bytes.slice 0 position old, gap, data, Bytes.slice (position + Bytes.length data) (Bytes.length old) old]

memoryWrite : Provider -> Handle -> Bytes -> Memory -> (Result Error (), Memory)
memoryWrite provider file data memory =
    case cursorAt provider file memory of
        Err error -> (Err error, memory)
        Ok (key, cursor) ->
            if cursor.mode == ReadMode then (Err (otherError cursor.path "handle is not writable"), memory)
            else case entryAt cursor.path memory.image of
                Err error -> (Err error, memory)
                Ok Folder -> (Err (errorAt IO.IsDirectory cursor.path), memory)
                Ok (Contents old) ->
                    taken = allowance False cursor (Bytes.length data) memory.faults
                    position = if cursor.mode == AppendMode then Bytes.length old else cursor.position
                    written = Bytes.slice 0 taken data
                    contents = if taken == 0 then old else replaceBytes position written old
                    case put False (Contents contents) cursor.path memory.image of
                        Err error -> (Err error, memory)
                        Ok image ->
                            next = remember key { cursor | position = position + taken, progress = cursor.progress + taken } { memory | image = image }
                            if taken < Bytes.length data then (Err (otherError cursor.path "injected write failure"), next)
                            else (Ok (), next)

-- Closing drops the cursor, so a repeated close of an owned handle succeeds.
memoryClose : Provider -> Handle -> Memory -> (Result Error (), Memory)
memoryClose provider file memory =
    case handleKey provider file of
        Err error -> (Err error, memory)
        Ok key ->
            case Dict.get key memory.handles of
                Nothing -> (Ok (), memory)
                Just cursor ->
                    next = { memory | handles = Dict.remove key memory.handles }
                    if hasFault CloseFailure (faultsAt cursor.path memory.faults) then
                        (Err (otherError cursor.path "injected close failure"), next)
                    else (Ok (), next)

readChunks : Provider -> Handle -> List Bytes -> Memory -> (Result Error String, Memory)
readChunks provider file reversed memory =
    (result, next) = memoryRead provider file Runtime.IO.chunk False memory
    case result of
        Err error -> (Err error, next)
        Ok Nothing -> (Ok (fileText (Bytes.concat (List.reverse reversed))), next)
        Ok (Just data) -> readChunks provider file [data | reversed] next

closedResult : Provider -> Handle -> Result Error a -> Memory -> (Result Error a, Memory)
closedResult provider file result memory =
    (closed, next) = memoryClose provider file memory
    case result of
        Err error -> (Err error, next)
        Ok value -> (Result.map { _ -> value } closed, next)

memoryReadFile : Provider -> String -> Memory -> (Result Error String, Memory)
memoryReadFile provider path memory =
    (openedFile, acquired) = memoryOpen provider ReadMode path memory
    case openedFile of
        Err error -> (Err error, acquired)
        Ok file ->
            (result, next) = readChunks provider file [] acquired
            closedResult provider file result next

memoryWriteFile : Provider -> String -> String -> Memory -> (Result Error (), Memory)
memoryWriteFile provider path text memory =
    (openedFile, acquired) = memoryOpen provider WriteMode path memory
    case openedFile of
        Err error -> (Err error, acquired)
        Ok file ->
            (result, next) = memoryWrite provider file (Bytes.fromString text) acquired
            closedResult provider file result next

-- `runMemoryWith noFaults`.
--
-- ```fango
-- import File
-- import IO
-- import Result exposing (Result(..))
--
-- changed = File.runMemory File.empty {
--     written = File.writeAll "greeting.txt" "Hello!"
--     File.read "greeting.txt"
--     }
--
-- changed.value == Ok "Hello!"
-- File.textAt "greeting.txt" changed.image == Ok "Hello!"
-- case File.textAt "greeting.txt" File.empty of
--     Err error -> error.kind == IO.NotFound
--     Ok _ -> False
-- ```
runMemory : Image -> (() ->{FileSystem | e} a) ->{e} Snapshot a
runMemory image action = runMemoryWith noFaults image action

-- Interprets FileSystem without OS access, returning an immutable snapshot.
-- Reads/writes share the same image as whole-file calls; each open has its
-- own offset. Appends choose the current end on every write. Raw handles are
-- invalidated at provider exit; scoped handles close on every language exit.
-- Faults apply to both streaming and whole-file operations.
--
-- This runner is sequential: concurrent handler clauses may lose state
-- updates. It models no symlinks or permissions. Directory sizes are zero.
-- An abort escaping the runner returns no snapshot; put Fail.attempt inside
-- it to inspect partial progress.
runMemoryWith : Faults -> Image -> (() ->{FileSystem | e} a) ->{e} Snapshot a
runMemoryWith faults image action =
    withProvider { provider ->
        handle action() with state = Memory { image = image, faults = faults, handles = Dict.empty, next = 0 } on
            openRead path ->
                (result, next) = memoryOpen provider ReadMode path state
                resume result with next
            openWrite path ->
                (result, next) = memoryOpen provider WriteMode path state
                resume result with next
            openAppend path ->
                (result, next) = memoryOpen provider AppendMode path state
                resume result with next
            closeHandle file ->
                (result, next) = memoryClose provider file state
                resume result with next
            readHandleLine file ->
                (result, next) = memoryLine provider file state
                resume result with next
            readHandleBytes file count ->
                (result, next) = memoryRead provider file count False state
                resume result with next
            writeHandleBytes file data ->
                (result, next) = memoryWrite provider file data state
                resume result with next
            readFileResult path ->
                (result, next) = memoryReadFile provider path state
                resume result with next
            writeFileResult path text ->
                (result, next) = memoryWriteFile provider path text state
                resume result with next
            isDirectoryPath path -> resume (activeResult provider path (memoryDirectory path state.image)) with state
            fileSize path -> resume (activeResult provider path (memorySize path state.image)) with state
            listDirectory path -> resume (activeResult provider path (memoryListing path state.image)) with state
            return value -> Snapshot { value = value, image = state.image }
    }
