module Writer exposing (Writer(..), WriterResult(..), run)

effect Writer w
    tell : w -> ()

type WriterResult w a = { value : a, output : w }

run : (w -> w -> w) -> w -> (() ->{Writer w | e} a) ->{e} WriterResult w a
run combine empty action =
    handle action() with output = empty of
        tell item -> resume () with combine output item
        return value -> { value = value, output = output }
