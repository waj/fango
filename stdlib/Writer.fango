{-# no-prelude #-}
module Writer exposing (Writer(..), collecting, over, write, writeString)

import Basics exposing (..)
import Bytes exposing (Bytes, Sink(..))
import IO exposing (IO)
import List exposing (List)
import Runtime.Ref

type Writer e =
    { emit : Bytes ->{IO | e} ()
    , flush : () ->{IO | e} ()
    }

windowOf size = if size < 1 then 1 else size

-- Flush on normal completion only; a failed body does not emit a partial message.
over : Sink e -> Int -> (Writer e ->{IO | e} a) ->{IO | e} a
over sink size use =
    pending = Runtime.Ref.new Bytes.empty
    writer =
        { emit = \chunk ->
            grown = Bytes.append (Runtime.Ref.read pending) chunk
            if Bytes.length grown >= windowOf size then
                sink.write grown
                Runtime.Ref.write pending Bytes.empty
            else Runtime.Ref.write pending grown
        , flush = \_ ->
            buffered = Runtime.Ref.read pending
            if Bytes.length buffered > 0 then sink.write buffered else ()
            Runtime.Ref.write pending Bytes.empty
        }
    result = use writer
    writer.flush()
    result

collecting : (Writer e ->{IO | e} a) ->{IO | e} (a, Bytes)
collecting use =
    parts = Runtime.Ref.new []
    result = use
        { emit = \chunk -> Runtime.Ref.write parts [chunk | Runtime.Ref.read parts]
        , flush = \_ -> ()
        }
    (result, Bytes.concat (List.reverse (Runtime.Ref.read parts)))

write : Writer e -> Bytes ->{IO | e} ()
write writer text = writer.emit text

writeString : Writer e -> String ->{IO | e} ()
writeString writer text = writer.emit (Bytes.fromString text)
