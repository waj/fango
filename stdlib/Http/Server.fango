{-# no-prelude #-}
-- A concurrent HTTP/1.1 server.
--
-- `serve` accepts connections with a pool of tasks and answers each request
-- with a handler. A connection serves consecutive requests while each body
-- was read to its end and neither side asked to close. Invalid request
-- framing gets its error status and closes the connection; so does a
-- response that fails its checks (500), and a body that fails after its head
-- was written leaves the response incomplete and closes the connection.
module Http.Server exposing (Config(..), Request(..), Response(..), defaultConfig, serve, withRequest, writeResponse)

import Async exposing (Async, Channel, Outcome(..), Task)
import Basics exposing (..)
import Bytes exposing (Bytes)
import Fail exposing (Fail, attempt, fromResult)
import Http exposing (Body(..), Error(..), Header(..), Protocol(..), Version(..))
import Http.Wire as Wire exposing (Framing(..))
import IO exposing (IO)
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Net
import Reader exposing (Read(..), Reader(..))
import Result exposing (Result(..))
import String
import Writer exposing (Writer(..))

-- A request whose body reads perform `e`.
type Request e =
    {
      -- The method, such as `"GET"`.
      method : String
      -- The raw request target, query included; `Http.Server.Route.path`
      -- extracts the path.
    , target : String
      -- The protocol version.
    , version : Version
      -- The header fields in order.
    , headers : List Header
      -- The body, framed to its declared length or chunks.
    , body : Reader e
    }

-- A response whose body writes perform `e`. Its status is final, 200 to 599
-- except 101, and its headers may not set `Content-Length` or
-- `Transfer-Encoding`, which the server supplies from the body.
type Response e =
    {
      -- The status code.
      status : Int
      -- The header fields: names must be tokens, and values cannot hold
      -- control characters other than tab.
    , headers : List Header
      -- The body. 204 and 304 responses cannot carry one.
    , body : Body e
    }

type Head = { method : String, target : String, headers : List Header, framing : Framing }

targetByte : Int -> Bool
targetByte code = code >= 33 && code <= 126

allTarget : Bytes -> Int -> Bool
allTarget bytes index =
    if index >= Bytes.length bytes then index > 0
    else
        case Bytes.byteAt index bytes of
            Just code -> if targetByte code then allTarget bytes (index + 1) else False
            Nothing -> False

requestLine : Bytes ->{Protocol} (String, String)
requestLine bytes =
    case Bytes.indexOf (Bytes.fromString " ") bytes of
        Nothing -> invalid (Malformed "malformed request line")
        Just first ->
            case Bytes.indexOfFrom (first + 1) (Bytes.fromString " ") bytes of
                Nothing -> invalid (Malformed "malformed request line")
                Just second ->
                    method = Bytes.slice 0 first bytes
                    target = Bytes.slice (first + 1) second bytes
                    version = Bytes.slice (second + 1) (Bytes.length bytes) bytes
                    if Wire.allToken method 0 == False || allTarget target 0 == False || version /= Bytes.fromString "HTTP/1.1" then
                        invalid (Malformed "invalid HTTP/1.1 request line")
                    else
                        (Wire.decodeField method, Wire.decodeField target)

readHead : Reader e -> Int -> Int -> Int ->{Protocol | e} Maybe Head
readHead reader lineLimit headersLimit bodyLimit =
    case Reader.readUntil reader (Bytes.fromString "\r\n") lineLimit of
        Ended line ->
            if Bytes.length line == 0 then Nothing else invalid (Malformed "incomplete request line")
        Overflowed -> invalid LineTooLong
        Found line ->
            (method, target) = requestLine line
            headers = Wire.headerLines reader headersLimit []
            case Http.getHeaders "host" headers of
                [_] ->
                    bodyFraming = Wire.framing headers bodyLimit
                    Just (Head { method = method, target = target, headers = headers, framing = bodyFraming })
                _ -> invalid (Malformed "HTTP/1.1 requires one Host header")

-- Parses one request from `reader` and runs `action` with it, answering
-- `Nothing` at a clean end of input, or `Just` the result and whether the
-- body was read to its end. Request lines, header blocks, and bodies have
-- separate byte limits. The parser requires an HTTP/1.1 request line and one
-- `Host` field, and accepts one `Content-Length` or `Transfer-Encoding:
-- chunked`; anything else raises `Http.Protocol.invalid`. Chunk trailers
-- count against the header limit, and a fixed-length body that ends early
-- fails with `Malformed` when the consumer reads past what arrived. A response whose
-- body reads the request must be written inside `action`.
{-# scoped s #-}
withRequest : Int -> Int -> Int -> Reader e -> (Request s ->{s} a) ->{Protocol | e} Maybe (a, Bool)
withRequest lineLimit headersLimit bodyLimit input action =
    case readHead input lineLimit headersLimit bodyLimit of
        Nothing -> Nothing
        Just head ->
            result = Wire.withBody head.framing input bodyLimit headersLimit { body ->
                action (Request { method = head.method, target = head.target, version = Http11, headers = head.headers, body = body })
            }
            Just result

framedStatus : Int -> Bool
framedStatus status = status /= 204 && status /= 304

checkResponse : Response e ->{Protocol} ()
checkResponse response =
    if response.status < 200 || response.status > 599 || response.status == 101 then
        invalid (InvalidMessage "response status must be a final non-upgrade status")
    else Wire.checkMessage response.headers response.body (framedStatus response.status)

writeChecked : String -> Writer {Protocol | e} -> Response {Protocol | e} ->{Protocol | e} ()
writeChecked method output response =
    Wire.writeCheckedMessage { error -> invalid error } output ("HTTP/1.1 " ++ show response.status ++ " ") response.headers response.body
        (framedStatus response.status) (method /= "HEAD")

-- Checks a response and writes it as the answer to a request with `method`.
-- The server supplies `Content-Length` for empty, byte, and sized bodies and
-- chunked encoding for streams; a `HEAD` request gets only the head. Every
-- check runs before the first byte is written. A `HEAD` response includes a
-- sized body's length but runs no body.
writeResponse : String -> Writer {Protocol | e} -> Response {Protocol | e} ->{Protocol | e} ()
writeResponse method output response =
    checkResponse response
    writeChecked method output response

-- How `serve` listens and what it allows. `defaultConfig` fills in limits.
type Config =
    {
      -- The port to listen on, at every address.
      port : Int
      -- How many connections are served at once.
    , workers : Int
      -- The longest request line, in bytes, before 414.
    , requestLineLimit : Int
      -- The largest header block, in bytes, before 431.
    , headerLimit : Int
      -- The largest body, in bytes, before 413.
    , bodyLimit : Int
      -- How long reading a request's head may take, in milliseconds.
    , headerDeadlineMs : Int
      -- How long reading a request's body may take, in milliseconds.
    , bodyDeadlineMs : Int
      -- How long writing a response may take, in milliseconds.
    , writeDeadlineMs : Int
      -- How long stopping waits for active connections before cancelling
      -- them, in milliseconds.
    , shutdownGraceMs : Int
    }

-- The configuration for `port`: 64 workers, 8 KiB request lines, 64 KiB
-- header blocks, 16 MiB bodies, 10 s to read a head, 30 s to read a body or
-- write a response, and 5 s of shutdown grace.
--
-- ```fango
-- import Http.Server
--
-- (Http.Server.defaultConfig 8080).workers == 64
-- ```
defaultConfig : Int -> Config
defaultConfig port = Config
    { port = port
    , workers = 64
    , requestLineLimit = 8192
    , headerLimit = 65536
    , bodyLimit = 16777216
    , headerDeadlineMs = 10000
    , bodyDeadlineMs = 30000
    , writeDeadlineMs = 30000
    , shutdownGraceMs = 5000
    }

errorStatus : Http.Error -> Int
errorStatus error =
    case error of
        Malformed _ -> 400
        LineTooLong -> 414
        HeadersTooLarge -> 431
        BodyTooLarge -> 413
        Unsupported _ -> 501
        InvalidMessage _ -> 500
        BodyAborted _ -> 500

sendError : Writer e -> Int ->{e} ()
sendError output status =
    Writer.writeString output
        ("HTTP/1.1 " ++ show status ++ " \r\nConnection: close\r\nContent-Length: 0\r\n\r\n")
    output.flush()

isClose : List Header -> Bool
isClose headers =
    case Http.getHeader "connection" headers of
        Nothing -> False
        Just raw ->
            List.foldl { part found -> found || Http.equalAscii (String.trim part) "close" }
                False (String.split "," raw)

validResponse : Response e ->{Protocol} Bool
validResponse response =
    checkResponse response
    True

writeSuccessful : String -> Writer {Protocol | e} -> Response {Protocol | e} ->{Protocol | e} Bool
writeSuccessful method output response =
    writeChecked method output response
    True

-- An invalid response gets a 500 before anything is written. A body that fails
-- afterwards leaves the response truncated, and the connection closes.
respond : String -> Writer {Protocol | e} -> Response {Protocol | e} ->{Protocol | e} Bool
respond method output response =
    valid = handle validResponse response on
        Http.invalid _ -> False
    if valid then
        handle writeSuccessful method output response on
            Http.invalid _ -> False
    else
        sendError output 500
        False

{-# scoped s #-}
serveConnection : Config -> Net.Connection -> (Request s ->{s} Response s) ->{Async, IO, Fail Net.Error, Protocol | e} ()
serveConnection config connection handler =
    source = Net.sourceAsync connection
    sink = Net.sinkAsync connection
    Reader.over source { input ->
        Writer.over sink 8192 { output ->
            loop() =
                fromResult (Net.setReadDeadline connection config.headerDeadlineMs)
                handle
                    exchanged = withRequest config.requestLineLimit config.headerLimit config.bodyLimit input { request ->
                        fromResult (Net.setReadDeadline connection config.bodyDeadlineMs)
                        response = handler request
                        fromResult (Net.setWriteDeadline connection config.writeDeadlineMs)
                        sent = respond request.method output response
                        (sent, isClose request.headers, isClose response.headers)
                    }
                    case exchanged of
                        Nothing -> ()
                        Just ((sent, requestClose, responseClose), complete) ->
                            if sent && complete && requestClose == False && responseClose == False then loop()
                            else ()
                on
                    Http.invalid error -> sendError output (errorStatus error)
            loop()
        }
    }

-- Each worker installs its own connection, buffer, protocol, and Fail
-- handlers. Only a fatal accept error leaves this runner; its task captures
-- that error and reports it through the server's shutdown channel.
{-# scoped s #-}
worker : Config -> Net.Listener -> (Request {Protocol | s} ->{Protocol | s} Response {Protocol | s}) ->{Async, IO, Fail Net.Error} ()
worker config listener handler =
    loop() =
        outcome = attempt {
            Net.acceptAsync listener { connection ->
                ignored = attempt {
                    handle serveConnection config connection handler on
                        Http.invalid _ -> ()
                }
                ()
            }
        }
        case outcome of
            Ok _ -> loop()
            Err error ->
                if Net.listenerStopped listener then ()
                else Fail.fail error
    loop()

awaitWorkers : List (Task ()) ->{Async} ()
awaitWorkers tasks =
    case tasks of
        [] -> ()
        [task | rest] ->
            ignore (Async.awaitOutcome task)
            awaitWorkers rest

cancelWorkers : List (Task ()) ->{Async} ()
cancelWorkers tasks = List.each Async.cancel tasks

cancelStoppedWorkers : Result Net.Error () -> List (Task ()) ->{Async} ()
cancelStoppedWorkers stopped tasks =
    case stopped of
        Err _ -> cancelWorkers tasks
        Ok _ -> ()

listenerResult : Result Net.Error () -> Maybe (Maybe Net.Error) -> Result Net.Error ()
listenerResult stopped first =
    case stopped of
        Err error -> Err error
        Ok _ ->
            case first of
                Just (Just error) -> Err error
                _ -> Ok ()

runListener : Config -> Channel () -> Net.Listener -> (Channel (Maybe Net.Error) ->{Async, IO} List (Task ())) ->{Async, IO, Fail Net.Error} ()
runListener config stop listener startWorkers =
    result = Async.scope {
        events = Async.channel (config.workers + 1)
        ignore (Async.spawn {
                ignore (Async.receive stop)
                ignore (Async.send events Nothing)
        })
        tasks = startWorkers events
        first = Async.receive events
        stopped = Net.stopListener listener
        cancelStoppedWorkers stopped tasks
        ignore (Async.spawn {
                Async.sleep config.shutdownGraceMs
                cancelWorkers tasks
        })
        awaitWorkers tasks
        listenerResult stopped first
    }
    fromResult result

-- Serves `handler` on `config.port` until a value arrives on `stop`, then
-- closes the listener, waits up to `shutdownGraceMs` for active connections,
-- and cancels the rest, closing their sockets. Handlers and their bodies may
-- raise `Protocol`: before the head is written the server answers with the
-- error's status, and afterwards it closes the connection, so
-- `Http.Server.Route.dispatch` and `Http.abortBody` need no handler of their
-- own. A handler of type `Request e ->{e} Response e` also fits. Handle
-- application errors inside the handler. Connection failures are recovered
-- inside workers and do not stop unrelated connections. Fatal accept errors
-- trigger coordinated shutdown through the server's event channel; `serve`
-- raises the selected Net error in the caller after its workers are joined.
{-# scoped s #-}
serve : Config -> Channel () -> (Request {Protocol | s} ->{Protocol | s} Response {Protocol | s}) ->{Async, IO, Fail Net.Error} ()
serve config stop handler =
    Net.withListener config.port { listener ->
        startWorkers : Channel (Maybe Net.Error) ->{Async, IO} List (Task ())
        startWorkers events =
            loop remaining =
                if remaining <= 0 then []
                else
                    task = Async.spawn {
                        result = attempt { worker config listener handler }
                        case result of
                            Err error -> ignore (Async.send events (Just error))
                            Ok _ -> ()
                    }
                    [task | loop (remaining - 1)]
            loop config.workers
        runListener config stop listener startWorkers
    }
