{-# no-prelude #-}
-- Gzip content coding for HTTP bodies.
--
-- `wrap` compresses a handler's responses for clients that accept gzip, and
-- `decodeRequests` decompresses gzip request bodies before a handler sees
-- them. Compression and decompression both stream.
module Http.GZip exposing (acceptsGzip, decodeRequests, decoding, encoding, wrap)

import Basics exposing (..)
import Bytes exposing (Bytes)
import Http exposing (Body(..), Error(..), Protocol(..))
import Http.Server exposing (Request(..), Response(..))
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Reader exposing (Reader(..))
import Runtime.Native
import String
import Writer exposing (Writer(..))

type Compressor = Compressor Runtime.Native.Any

newCompressor : () -> Compressor
newCompressor = native

push : Compressor -> Bytes -> Bytes
push = native

flush : Compressor -> Bytes
flush = native

finish : Compressor -> Bytes
finish = native

type Decoder = Decoder Runtime.Native.Any

-- Status codes the decoder answers.
decoderOk : Int
decoderOk = 0

decoderTooLarge : Int
decoderTooLarge = 2

newDecoder : Int -> Decoder
newDecoder = native

decoderPush : Decoder -> Bytes -> Int
decoderPush = native

decoderFinish : Decoder -> Int
decoderFinish = native

decoderPending : Decoder -> Bytes
decoderPending = native

decoderSkip : Decoder -> Int -> Int
decoderSkip = native

decoderMessage : Decoder -> String
decoderMessage = native

checkStatus : Decoder -> Int ->{Protocol} ()
checkStatus decoder status =
    if status == decoderOk then ()
    else if status == decoderTooLarge then invalid BodyTooLarge
    else invalid (Malformed ("invalid gzip body: " ++ decoderMessage decoder))

-- Pulls compressed input until the decoder has new output or the input ends.
refillFrom : Decoder -> Reader {Protocol | e} ->{Protocol | e} Bool
refillFrom decoder input =
    before = Bytes.length (decoderPending decoder)
    chunk = Reader.readUpTo input 65536
    if Bytes.length chunk == 0 then
        checkStatus decoder (decoderFinish decoder)
        Bytes.length (decoderPending decoder) > before
    else
        checkStatus decoder (decoderPush decoder chunk)
        if Bytes.length (decoderPending decoder) > before then True else refillFrom decoder input

-- A reader of the gzip-decoded content of `input`, reading concatenated gzip
-- members as one stream. A corrupt or truncated stream raises `Malformed`,
-- and more than `limit` decoded bytes `BodyTooLarge`.
decoding : Int -> Reader {Protocol | e} -> Reader {Protocol | e}
decoding limit input =
    decoder = newDecoder limit
    Reader
        { buffered = { decoderPending decoder }
        , refill = { refillFrom decoder input }
        , skip = { count -> decoderSkip decoder count }
        }

-- A body that sends `body` gzip-compressed. Its length is not known in
-- advance, so it streams. An empty body stays empty.
encoding : Body e -> Body e
encoding body =
    case body of
        Empty -> Empty
        _ -> StreamBody (compressBody body)

-- Decodes request bodies sent with `Content-Encoding: gzip`, up to `limit`
-- decoded bytes, before `handler` sees them; the decoded request loses its
-- `Content-Encoding` and `Content-Length` headers. `identity` passes through
-- unchanged, and another content coding gets 415.
decodeRequests : Int -> (Request {Protocol | e} ->{Protocol | e} Response {Protocol | e}) -> Request {Protocol | e} ->{Protocol | e} Response {Protocol | e}
decodeRequests limit handler request =
    case Http.getHeader "content-encoding" request.headers of
        Nothing -> handler request
        Just raw ->
            coding = String.trim raw
            if Http.equalAscii coding "gzip" then
                handler { request | headers = Http.removeHeader "content-encoding" (Http.removeHeader "content-length" request.headers), body = decoding limit request.body }
            else if Http.equalAscii coding "identity" then handler request
            else Response { status = 415, headers = [], body = Empty }

weight : String -> Int
weight raw =
    value = String.trim raw
    case String.split "." value of
        ["0"] -> 0
        ["1"] -> 1000
        ["0", fraction] ->
            size = String.length fraction
            if size > 3 then 0
            else
                case String.toInt fraction of
                    Nothing -> 0
                    Just digits ->
                        if size == 0 then 0
                        else if size == 1 then digits * 100
                        else if size == 2 then digits * 10
                        else digits
        ["1", fraction] ->
            if fraction == "" || fraction == "0" || fraction == "00" || fraction == "000" then 1000 else 0
        _ -> 0

quality : List String -> Int
quality parameters =
    case parameters of
        [] -> 1000
        [parameter] ->
            case String.split "=" (String.trim parameter) of
                [name, value] -> if Http.equalAscii (String.trim name) "q" then weight value else 0
                _ -> 0
        _ -> 0

codingQuality : String -> List String -> Maybe Int
codingQuality wanted tokens =
    case tokens of
        [] -> Nothing
        [token | rest] ->
            case String.split ";" (String.trim token) of
                [] -> codingQuality wanted rest
                [name | parameters] ->
                    if Http.equalAscii (String.trim name) wanted then Just (quality parameters)
                    else codingQuality wanted rest

hasToken : String -> List String -> Bool
hasToken wanted tokens =
    case tokens of
        [] -> False
        [token | rest] ->
            if Http.equalAscii wanted (String.trim token) then True else hasToken wanted rest

-- Whether the request's `Accept-Encoding` headers accept gzip, honoring
-- quality values and the `*` wildcard.
--
-- ```fango
-- import Http exposing (Header(..))
-- import Http.GZip
--
-- Http.GZip.acceptsGzip [{ name = "Accept-Encoding", value = "br, gzip;q=0.5" }]
-- Http.GZip.acceptsGzip [{ name = "Accept-Encoding", value = "gzip;q=0, *" }] == False
-- Http.GZip.acceptsGzip [{ name = "Accept-Encoding", value = "*" }]
-- Http.GZip.acceptsGzip [] == False
-- ```
acceptsGzip : List Http.Header -> Bool
acceptsGzip headers =
    case Http.getHeaders "accept-encoding" headers of
        [] -> False
        values ->
            tokens = String.split "," (joinComma values)
            case codingQuality "gzip" tokens of
                Just q -> q > 0
                Nothing ->
                    case codingQuality "*" tokens of
                        Just q -> q > 0
                        Nothing -> False

joinComma : List String -> String
joinComma values =
    case values of
        [] -> ""
        [value] -> value
        [value | rest] -> value ++ "," ++ joinComma rest

vary : List Http.Header -> List Http.Header
vary headers =
    existing = joinComma (Http.getHeaders "vary" headers)
    if hasToken "accept-encoding" (String.split "," existing) || hasToken "*" (String.split "," existing) then headers
    else [Http.Header { name = "Vary", value = "Accept-Encoding" } | headers]

compressBody : Body e -> Writer e ->{e} ()
compressBody original output =
    compressor = newCompressor()
    encoded = Writer
        { emit = { bytes ->
            data = push compressor bytes
            if Bytes.length data > 0 then Writer.write output data else ()
          }
        , flush = {
            data = flush compressor
            if Bytes.length data > 0 then Writer.write output data else ()
            output.flush()
          }
        }
    case original of
        Empty -> ()
        BytesBody bytes -> Writer.write encoded bytes
        StreamBody body -> body encoded
        SizedBody _ body -> body encoded
    tail = finish compressor
    Writer.write output tail

-- Runs `handler` and compresses its response when the request accepts gzip.
-- `HEAD` requests, 204 and 304 responses, empty bodies, and responses that
-- already have a `Content-Encoding` pass through unchanged. A compressed
-- response streams chunked, even from a sized body, and gains
-- `Content-Encoding: gzip` and `Vary: Accept-Encoding`.
wrap : (Request e ->{e} Response e) -> Request e ->{e} Response e
wrap handler request =
    response = handler request
    eligible = request.method /= "HEAD" && response.status /= 204 && response.status /= 304
        && acceptsGzip request.headers && Http.hasHeader "content-encoding" response.headers == False
    if eligible then
        case response.body of
            Empty -> response
            body ->
                Response
                    { status = response.status
                    , headers = Http.setHeader "Content-Encoding" "gzip" (vary response.headers)
                    , body = StreamBody (compressBody body)
                    }
    else response
