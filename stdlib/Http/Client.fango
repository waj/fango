{-# no-prelude #-}
module Http.Client exposing
    ( Config(..), Connection, Error(..), Http, Reply(..), Request(..)
    , Response(..), Unexpected(..)
    , attempt, attemptUnexpected, compressRequest, configure, defaultConfig
    , expectSuccess, fetch, get, getBytes, getJson, getText, post, postJson, run
    , send, stub, url, withBearer, withHeader, withResponse
    )

import Basics exposing (..)
import Bytes exposing (Bytes, Source(..))
import Fail exposing (Fail, fromResult)
import Http exposing (Body(..), Header(..), Protocol(..))
import Http.GZip as GZip
import Http.Wire as Wire exposing (Framing(..))
import IO exposing (IO)
import Json exposing (Decode, Encode)
import List exposing (List(..))
import Maybe exposing (Maybe(..))
import Net
import Reader exposing (Reader(..))
import Result exposing (Result(..))
import Runtime.Scope
import String
import Url exposing (Url)
import Writer exposing (Writer(..))

{- An HTTP/1.1 client. Requests run through the `Http` effect, a byte
transport that `run` connects to sockets; framing, header policy, and URL
resolution run in the caller's code under every transport. -}

-- What can go wrong with a request, however the caller reads the response.
type Error
    = InvalidUrl String
    | Transport Net.Error
    | Timeout
    | Protocol Http.Error
    | TooManyRedirects
    deriving (Eq, Show)

type Request e =
    { method : String
    , url : Url
    , headers : List Header
    , body : Body e
    }

-- A response whose body streams inside `send`'s callback.
type Response e =
    { url : Url
    , status : Int
    , headers : List Header
    , body : Reader e
    }

-- A response with its body read into memory.
type Reply =
    { url : Url
    , status : Int
    , headers : List Header
    , body : Bytes
    }
    deriving (Eq, Show)

-- A response that does not meet a helper's expectation.
type Unexpected = BadStatus Reply | BadBody Json.Error deriving (Eq, Show)

type Config =
    { baseUrl : Maybe Url
    , headers : List Header
    , userAgent : String
    , decompress : Bool
    , connectTimeoutMs : Int
    , readTimeoutMs : Int
    , writeTimeoutMs : Int
    , maxHeaderBytes : Int
    , maxBodyBytes : Int
    , maxRedirects : Int
    , caFile : Maybe String
    }

defaultConfig : Config
defaultConfig = Config
    { baseUrl = Nothing
    , headers = []
    , userAgent = "fango"
    , decompress = True
    , connectTimeoutMs = 10000
    , readTimeoutMs = 30000
    , writeTimeoutMs = 30000
    , maxHeaderBytes = 65536
    , maxBodyBytes = 10485760
    , maxRedirects = 10
    , caFile = Nothing
    }

-- `fresh` asks for a new connection rather than an idle one.
type Endpoint = { secure : Bool, host : String, port : Int, connectTimeoutMs : Int, caFile : Maybe String, fresh : Bool }

-- A transport's handle on one connection; a socket knows whether it was
-- reused from the pool.
type Connection = Socket Net.Connection Bool | Memory Int

effect Http
    connect : Endpoint -> Result Error Connection
    transmit : Connection -> Bytes -> Int -> Result Error ()
    receive : Connection -> Int -> Int -> Result Error (Maybe Bytes)
    release : Connection -> Bool -> Result Error ()
    currentConfig : () -> Config

-- Running

netError : Net.Error -> Error
netError error = if error.kind == Net.TimedOut then Timeout else Transport error

fromNet : Result Net.Error a -> Result Error a
fromNet result =
    case result of
        Ok value -> Ok value
        Err error -> Err (netError error)

foreign : Result Error a
foreign = Err (Protocol (Http.InvalidMessage "connection belongs to another transport"))

dial : Net.Pool -> Endpoint ->{IO} Result Error Connection
dial pool endpoint =
    roots = Maybe.withDefault "" endpoint.caFile
    case Net.poolConnect pool endpoint.host endpoint.port endpoint.connectTimeoutMs endpoint.secure roots endpoint.fresh of
        Ok connection -> Ok (Socket connection (Net.connectionReused connection))
        Err error -> Err (netError error)

socketWrite : Connection -> Bytes -> Int ->{IO} Result Error ()
socketWrite connection bytes timeout =
    case connection of
        Socket socket _ ->
            case fromNet (Net.setWriteDeadline socket timeout) of
                Ok _ -> fromNet (Net.writeConnectionBytes socket bytes)
                Err error -> Err error
        Memory _ -> foreign

socketRead : Connection -> Int -> Int ->{IO} Result Error (Maybe Bytes)
socketRead connection most timeout =
    case connection of
        Socket socket _ ->
            case fromNet (Net.setReadDeadline socket timeout) of
                Err error -> Err error
                Ok _ ->
                    case fromNet (Net.readConnectionBytes socket most) of
                        Ok bytes -> Ok (if Bytes.length bytes == 0 then Nothing else Just bytes)
                        Err error -> Err error
        Memory _ -> foreign

socketRelease : Connection -> Bool ->{IO} Result Error ()
socketRelease connection reusable =
    case connection of
        Socket socket _ -> fromNet (Net.poolRelease socket reusable)
        Memory _ -> foreign

-- Runs requests over TCP with `config` as the global configuration. Idle
-- connections are kept for reuse until `run` returns.
run : Config -> (() ->{Http, Fail Error | e} a) ->{IO, Fail Error | e} a
run config action =
    pool = Net.newPool 8 60000
    Runtime.Scope.finally {
        handle action() of
            connect endpoint -> resume (dial pool endpoint)
            transmit connection bytes timeout -> resume (socketWrite connection bytes timeout)
            receive connection most timeout -> resume (socketRead connection most timeout)
            release connection reusable -> resume (socketRelease connection reusable)
            currentConfig () -> resume config
    } { ignore (Net.closePool pool) }

-- Runs `action` with the configuration adjusted. Overrides nest.
configure : (Config -> Config) -> (() ->{Http | e} a) ->{Http | e} a
configure adjust action =
    handle action() of
        connect endpoint -> resume (connect endpoint)
        transmit connection bytes timeout -> resume (transmit connection bytes timeout)
        receive connection most timeout -> resume (receive connection most timeout)
        release connection reusable -> resume (release connection reusable)
        currentConfig () -> resume (adjust currentConfig())

type Exchange = { request : Bytes, response : Maybe Bytes }

-- Answers each request from `respond`, given the request's bytes as written,
-- without sockets. `respond` may use the caller's effects, for example to
-- record requests. Requests run one at a time.
stub : (Bytes ->{e} Result Error Bytes) -> (() ->{Http, Fail Error | e} a) ->{Fail Error | e} a
stub respond action =
    handle action() with exchange = Exchange { request = Bytes.empty, response = Nothing } of
        connect _ -> resume (Ok (Memory 0)) with Exchange { request = Bytes.empty, response = Nothing }
        transmit _ bytes _ ->
            resume (Ok ()) with { exchange | request = Bytes.append exchange.request bytes }
        receive _ _ _ ->
            case exchange.response of
                Just _ -> resume (Ok Nothing) with exchange
                Nothing ->
                    case respond exchange.request of
                        Ok bytes -> resume (Ok (if Bytes.length bytes == 0 then Nothing else Just bytes)) with { exchange | response = Just bytes }
                        Err error -> resume (Err error) with exchange
        release _ _ -> resume (Ok ()) with exchange
        currentConfig () -> resume defaultConfig with exchange

-- Preparing requests

failWith : Error ->{Fail Error} a
failWith error = Fail.fail error

-- Header names the client writes itself.
managed : List String
managed = ["host", "content-length", "transfer-encoding", "connection"]

checkHeaders : List Header ->{Fail Error} ()
checkHeaders headers =
    List.each { header ->
        if List.foldl { name found -> found || Http.equalAscii name header.name } False managed then
            failWith (Protocol (Http.InvalidMessage ("the client manages the " ++ header.name ++ " header")))
        else ()
    } headers

-- Headers from `extra` replace same-named ones from `base`.
overlay : List Header -> List Header -> List Header
overlay base extra =
    kept = List.filter { header -> List.foldl { other found -> found && Http.equalAscii other.name header.name == False } True extra } base
    List.foldr { header rest -> [header | rest] } extra kept

absolute : Config -> Url ->{Fail Error} Url
absolute config target =
    case target.scheme of
        Just _ -> target
        Nothing ->
            case config.baseUrl of
                Just base -> Url.resolve base target
                Nothing -> failWith (InvalidUrl (Url.toString target))

endpointOf : Config -> Url -> Bool ->{Fail Error} Endpoint
endpointOf config target fresh =
    secure = case target.scheme of
        Just "http" -> False
        Just "https" -> True
        _ -> failWith (InvalidUrl (Url.toString target))
    if target.userinfo /= Nothing then failWith (InvalidUrl "credentials belong in a header, not the URL")
    else
        case target.host of
            Nothing -> failWith (InvalidUrl (Url.toString target))
            Just host ->
                if host == "" then failWith (InvalidUrl (Url.toString target))
                else
                    port = case target.port of
                        Just number -> number
                        Nothing -> if secure then 443 else 80
                    Endpoint { secure = secure, host = host, port = port, connectTimeoutMs = config.connectTimeoutMs, caFile = config.caFile, fresh = fresh }

hostHeader : Endpoint -> String
hostHeader endpoint =
    host = if String.contains ":" endpoint.host then "[" ++ endpoint.host ++ "]" else endpoint.host
    defaultPort = if endpoint.secure then 443 else 80
    if endpoint.port == defaultPort then host else host ++ ":" ++ show endpoint.port

-- A request without a body carries no framing headers unless its method
-- usually has one.
framedRequest : String -> Body e -> Bool
framedRequest method body =
    case body of
        Empty -> List.foldl { other found -> found && other /= method } True ["GET", "HEAD", "OPTIONS", "TRACE", "DELETE"]
        _ -> True

protocol : (() ->{Protocol, Fail Error | e} a) ->{Fail Error | e} a
protocol action =
    handle action() of
        Http.invalid error -> failWith (Protocol error)

-- Reading responses

statusCode : Bytes -> Maybe Int
statusCode bytes =
    if Bytes.length bytes /= 3 then Nothing
    else
        case String.toInt (Bytes.toStringLossy bytes) of
            Just code -> if code >= 100 then Just code else Nothing
            Nothing -> Nothing

statusLine : Bytes ->{Protocol} (Int, Bool)
statusLine line =
    http11 = Bytes.startsWith (Bytes.fromString "HTTP/1.1 ") line
    http10 = Bytes.startsWith (Bytes.fromString "HTTP/1.0 ") line
    if http11 == False && http10 == False then invalid (Http.Malformed "invalid status line")
    else
        afterCode = Bytes.slice 12 13 line
        if Bytes.length line > 12 && afterCode /= Bytes.fromString " " then invalid (Http.Malformed "invalid status line")
        else
            case statusCode (Bytes.slice 9 12 line) of
                Just code -> (code, http11)
                Nothing -> invalid (Http.Malformed "invalid status code")

type Head = { status : Int, http11 : Bool, headers : List Header }

-- Reads a status line and headers, skipping interim 1xx responses.
readHead : Reader e -> Int ->{Protocol | e} Head
readHead input limit =
    case Reader.readUntil input (Bytes.fromString "\r\n") limit of
        Reader.Found line ->
            (code, http11) = statusLine line
            headers = Wire.headerLines input limit []
            if code == 101 then invalid (Http.Unsupported "protocol upgrade")
            else if code < 200 then readHead input limit
            else Head { status = code, http11 = http11, headers = headers }
        Reader.Ended _ -> invalid (Http.Malformed "incomplete status line")
        Reader.Overflowed -> invalid Http.LineTooLong

largest : Int
largest = 9223372036854775807

gzipped : List Header -> Bool
gzipped headers =
    case Http.getHeader "content-encoding" headers of
        Just coding -> Http.equalAscii (String.trim coding) "gzip"
        Nothing -> False

closes : List Header -> Bool
closes headers =
    List.foldl { value found -> found || List.foldl { part seen -> seen || Http.equalAscii (String.trim part) "close" } False (String.split "," value) }
        False (Http.getHeaders "connection" headers)

-- Reads what the caller left of a body, up to `most` bytes, so the connection
-- can serve another request. A failure here only costs the connection.
drain : Reader {Protocol, Fail Error | e} -> Int ->{Protocol, Fail Error | e} ()
drain body most =
    if most <= 0 then ()
    else
        chunk = Reader.readUpTo body most
        if Bytes.length chunk == 0 then () else drain body (most - Bytes.length chunk)

drainQuietly : Reader {Protocol, Fail Error | e} ->{e} ()
drainQuietly body =
    ignore (attempt {
            handle drain body 65536 of
                Http.invalid _ -> ()
    })

-- Scopes the body of a response whose head was read to `use`, and reports
-- whether the connection can serve another request.
{-# scoped s #-}
responseBody : Url -> Bool -> Bool -> Int -> Head -> Reader {Fail Error | e} -> (Response s ->{s} a) ->{Protocol, Fail Error | e} (a, Bool)
responseBody target headRequest decode headerLimit head input use =
    bodyFraming =
        if headRequest || head.status == 204 || head.status == 304 then NoBody
        else Wire.responseFraming head.headers largest
    (value, complete) = Wire.withBody bodyFraming input largest headerLimit { body ->
        result =
            if decode && bodyFraming /= NoBody && gzipped head.headers then
                plain = Http.removeHeader "content-encoding" (Http.removeHeader "content-length" head.headers)
                use (Response { url = target, status = head.status, headers = plain, body = GZip.decoding largest body })
            else use (Response { url = target, status = head.status, headers = head.headers, body = body })
        drainQuietly body
        result
    }
    reusable = complete && head.http11 && bodyFraming /= UntilClose && closes head.headers == False
    (value, reusable)

-- Parses a response from `input` and scopes its body to `use`. A response to
-- HEAD, and a 204 or 304, has no body; any other is framed by Content-Length,
-- chunked encoding, or the connection closing. With `decode`, a gzip body is
-- decompressed and loses the headers that described its encoded form.
{-# scoped s #-}
withResponse : Url -> Bool -> Bool -> Int -> Reader {Fail Error | e} -> (Response s ->{s} a) ->{Protocol, Fail Error | e} a
withResponse target headRequest decode headerLimit input use =
    head = readHead input headerLimit
    (value, _) = responseBody target headRequest decode headerLimit head input use
    value

-- Sending

-- One hop of a request: the caller's result, where a redirect leads and
-- whether it keeps the method and body, or a retry on a new connection.
type Step a = Done a | Follow Url Bool | Retry

redirectStatus : Int -> Bool
redirectStatus status = status == 301 || status == 302 || status == 303 || status == 307 || status == 308

replayable : Body e -> Bool
replayable body =
    case body of
        Empty -> True
        BytesBody _ -> True
        _ -> False

-- Where a redirect response leads, unless it must be returned as it is: no
-- usable Location, a downgrade from https, or a body that cannot be sent again.
redirection : Request e -> Url -> Int -> List Header -> Maybe (Url, Bool)
redirection request target status headers =
    if redirectStatus status == False then Nothing
    else
        case Http.getHeader "location" headers of
            Nothing -> Nothing
            Just raw ->
                case Url.parse (String.trim raw) of
                    Nothing -> Nothing
                    Just location ->
                        next = Url.resolve target location
                        safeMethod = request.method == "GET" || request.method == "HEAD"
                        keep = status == 307 || status == 308 || (status /= 303 && safeMethod)
                        if target.scheme == Just "https" && next.scheme /= Just "https" then Nothing
                        else if keep && replayable request.body == False then Nothing
                        else Just (next, keep)

originOf : Url -> (Maybe String, Maybe String, Maybe Int)
originOf target = (target.scheme, target.host, target.port)

-- Credentials stay with the origin they were given for.
withoutCredentials : List Header -> List Header
withoutCredentials headers = Http.removeHeader "authorization" (Http.removeHeader "proxy-authorization" headers)

-- A request that may be sent again when a reused connection turns out closed.
retryable : Request e -> Bool
retryable request =
    idempotent = List.foldl { method found -> found || method == request.method } False ["GET", "HEAD", "OPTIONS", "TRACE", "PUT", "DELETE"]
    idempotent && replayable request.body

reused : Connection -> Bool
reused connection =
    case connection of
        Socket _ again -> again
        Memory _ -> False

-- Sends one request to `target`. `hops` redirects were followed before it.
{-# scoped s #-}
exchange : Config -> Request {Http, Fail Error | e} -> Url -> Bool -> Int -> Bool -> (Response s ->{s} a) ->{Http, Fail Error | e} Step a
exchange config request target crossOrigin hops fresh use =
    endpoint = endpointOf config target fresh
    defaults = [Header { name = "User-Agent", value = config.userAgent } | if config.decompress then [Header { name = "Accept-Encoding", value = "gzip" }] else []]
    merged = overlay (overlay defaults config.headers) request.headers
    headers = if crossOrigin then withoutCredentials merged else merged
    decode = config.decompress && Http.hasHeader "accept-encoding" config.headers == False && Http.hasHeader "accept-encoding" request.headers == False
    wireHeaders = [Header { name = "Host", value = hostHeader endpoint } | headers]
    framed = framedRequest request.method request.body
    protocol { Wire.checkMessage wireHeaders request.body framed }
    Runtime.Scope.bracket { fromResult (connect endpoint) } { connection -> ignore (release connection False) } { connection ->
        -- A reused connection the server already closed fails before any
        -- response byte; such a request starts over on a new connection.
        stale = reused connection && retryable request
        output = Writer
            { emit = { bytes -> fromResult (transmit connection bytes config.writeTimeoutMs) }
            , flush = { () }
            }
        written = attempt {
            Wire.writeCheckedMessage { error -> failWith (Protocol error) } output (request.method ++ " " ++ Url.requestTarget target ++ " HTTP/1.1")
                wireHeaders request.body framed True
        }
        case written of
            Err error -> if stale then Retry else failWith error
            Ok _ ->
                (step, reusable) = Reader.over (Source { pull = { fromResult (receive connection 65536 config.readTimeoutMs) } }) { input ->
                    case attempt { protocol { readHead input config.maxHeaderBytes } } of
                        Err error -> if stale then (Retry, False) else failWith error
                        Ok head ->
                            protocol {
                                responseBody target (request.method == "HEAD") decode config.maxHeaderBytes head input { response ->
                                    next = if config.maxRedirects > 0 then redirection request target response.status response.headers else Nothing
                                    case next of
                                        Just (location, keep) ->
                                            if hops >= config.maxRedirects then failWith TooManyRedirects else Follow location keep
                                        Nothing -> Done (use response)
                                }
                            }
                }
                ignore (release connection reusable)
                step
    }

-- Sends `request` and streams the response to `use`, which may read the body
-- only while it runs. Redirects are followed up to `maxRedirects`; any other
-- status is a normal response.
{-# scoped s #-}
send : Request {Http, Fail Error | e} -> (Response s ->{s} a) ->{Http, Fail Error | e} a
send request use =
    config = currentConfig()
    checkHeaders config.headers
    checkHeaders request.headers
    if Wire.allToken (Bytes.fromString request.method) 0 == False then failWith (Protocol (Http.InvalidMessage "invalid method")) else ()
    first = absolute config request.url
    follow current target hops fresh =
        case exchange config current target (originOf target /= originOf first) hops fresh use of
            Done value -> value
            Retry -> follow current target hops True
            Follow next keep ->
                following = if keep then { current | url = next } else { current | method = if current.method == "HEAD" then "HEAD" else "GET", body = Empty, url = next }
                follow following next (hops + 1) False
    follow request first 0 False

collect : Reader {Fail Error | e} -> Int -> List Bytes -> Int ->{Fail Error | e} Bytes
collect reader limit parts size =
    chunk = Reader.readUpTo reader 65536
    if Bytes.length chunk == 0 then Bytes.concat (List.reverse parts)
    else if size + Bytes.length chunk > limit then failWith (Protocol Http.BodyTooLarge)
    else collect reader limit [chunk | parts] (size + Bytes.length chunk)

-- Sends `request` and reads the whole body, up to `maxBodyBytes`.
fetch : Request {Http, Fail Error | e} ->{Http, Fail Error | e} Reply
fetch request =
    limit = currentConfig().maxBodyBytes
    send request { response ->
        body = collect response.body limit [] 0
        Reply { url = response.url, status = response.status, headers = response.headers, body = body }
    }

-- Requests and helpers

url : String ->{Fail Error} Url
url raw =
    case Url.parse raw of
        Just parsed -> parsed
        Nothing -> failWith (InvalidUrl raw)

get : Url -> Request e
get target = Request { method = "GET", url = target, headers = [], body = Empty }

post : Url -> Body e -> Request e
post target body = Request { method = "POST", url = target, headers = [], body = body }

withHeader : String -> String -> Request e -> Request e
withHeader name value request = { request | headers = Http.setHeader name value request.headers }

-- Sends the body gzip-compressed, which few servers accept unasked.
compressRequest : Request e -> Request e
compressRequest request =
    { request | headers = Http.setHeader "Content-Encoding" "gzip" request.headers, body = GZip.encoding request.body }

withBearer : String -> Request e -> Request e
withBearer token request = withHeader "Authorization" ("Bearer " ++ token) request

-- Fails with `BadStatus` unless the status is 2xx.
expectSuccess : Reply ->{Fail Unexpected} Reply
expectSuccess reply =
    if reply.status >= 200 && reply.status < 300 then reply else Fail.fail (BadStatus reply)

attempt : (() ->{Fail Error | e} a) ->{e} Result Error a
attempt action = Fail.attempt action

attemptUnexpected : (() ->{Fail Unexpected | e} a) ->{e} Result Unexpected a
attemptUnexpected action = Fail.attempt action

successful : Reply ->{Fail Unexpected} Bytes
successful reply = (expectSuccess reply).body

getBytes : String ->{Http, Fail Error, Fail Unexpected} Bytes
getBytes raw = successful (fetch (get (url raw)))

getText : String ->{Http, Fail Error, Fail Unexpected} String
getText raw = Bytes.toStringLossy (getBytes raw)

withDefaultHeader : String -> String -> Request e -> Request e
withDefaultHeader name value request =
    if Http.hasHeader name request.headers then request else withHeader name value request

-- Decodes a 2xx JSON response as it streams. Another status fails with its
-- buffered reply.
decodeReply : Decode a => Type a -> Int -> Response {Fail Error, Fail Unexpected | s} ->{Fail Error, Fail Unexpected | s} a
decodeReply witness limit response =
    if response.status >= 200 && response.status < 300 then
        (decoded, left, _) = Reader.limitedRemaining response.body limit { body -> Json.read witness body }
        case decoded of
            Ok value -> value
            Err problem ->
                if left == 0 && Reader.atEnd response.body == False then failWith (Protocol Http.BodyTooLarge)
                else Fail.fail (BadBody problem)
    else
        body = collect response.body limit [] 0
        Fail.fail (BadStatus (Reply { url = response.url, status = response.status, headers = response.headers, body = body }))

getJson : Decode a => Type a -> String ->{Http, Fail Error, Fail Unexpected} a
getJson witness raw =
    limit = currentConfig().maxBodyBytes
    request = withDefaultHeader "Accept" "application/json" (get (url raw))
    send request { response -> decodeReply witness limit response }

postJson : (Encode b, Decode a) => Type a -> String -> b ->{Http, Fail Error, Fail Unexpected} a
postJson witness raw value =
    limit = currentConfig().maxBodyBytes
    body = StreamBody { output ->
        case Json.write output value of
            Ok _ -> ()
            Err problem -> failWith (Protocol (Http.InvalidMessage problem.message))
    }
    request = withDefaultHeader "Accept" "application/json" (withDefaultHeader "Content-Type" "application/json" (post (url raw) body))
    send request { response -> decodeReply witness limit response }
