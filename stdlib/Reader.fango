{-# no-prelude #-}
-- Buffered byte readers.
--
-- A `Reader e` reads bytes from memory or a `Source`, through operations that
-- perform exactly `e`, so parsing code written against `Reader e` works over
-- any of them and adds no `IO` of its own. The constructors (`withBytes`,
-- `over`, `overBytes`, `limited`) are scoped runners: the reader cannot
-- leave their callback, and the callback's other effects pass through.
-- Separate readers advance independently.
module Reader exposing (Read(..), Reader(..), atEnd, chunks, ensure, forEachChunk, limited, limitedRemaining, over, overBytes, readExactly, readLine, readUntil, readUpTo, withBytes)

import Basics exposing (..)
import Bytes exposing (Bytes, Source(..))
import Maybe exposing (Maybe(..))
import Runtime.Local
import Stream exposing (Stream)

-- A byte reader whose operations perform `e`. The three fields are its
-- primitives; the module's functions build reads from them.
type Reader e =
    {
      -- The bytes in hand, without consuming them.
      buffered : () ->{e} Bytes
      -- Pulls until the buffer grows, answering `True`, or the source ends,
      -- answering `False`. It never answers `True` without growing, so a
      -- loop on it makes progress.
    , refill : () ->{e} Bool
      -- Consumes up to `n` buffered bytes and answers how many it took.
    , skip : Int ->{e} Int
    }

-- clamp keeps every count inside what is actually in hand, so no caller can
-- skip past the buffer or ask for a negative amount.
clamp : Int -> Int -> Int
clamp wanted available =
    if wanted < 0 then 0 else if wanted > available then available else wanted

-- grow pulls until the source answers bytes or ends. An empty chunk is not end
-- of input, so it is pulled through rather than reported: that is what lets
-- `refill` promise it never answers True without growing the buffer, and
-- therefore what makes a loop on `refill` terminate.
grow : Source e -> Bytes ->{e} Bytes
grow source pending =
    case source.pull() of
        Nothing -> pending
        Just chunk ->
            if Bytes.length chunk == 0 then grow source pending else Bytes.append pending chunk

{-# scoped s #-}
buffering : Bytes -> Source e -> (Reader s ->{s} a) ->{e} a
buffering initial source action =
    Runtime.Local.run initial { pending ->
        action
            { buffered = pending.read
            , refill = {
                before = pending.read()
                grown = grow source before
                pending.write grown
                Bytes.length grown > Bytes.length before
              }
            , skip = { n ->
                before = pending.read()
                taken = clamp n (Bytes.length before)
                pending.write (Bytes.slice taken (Bytes.length before) before)
                taken
              }
            }
    }

-- Runs `action` with a reader over at most `allowance` bytes of `parent`.
-- Every byte it hands out is consumed from the parent, so afterwards the
-- parent is positioned after what was read, not after the allowance; skip
-- the rest before leaving to discard a whole frame. The parent stays usable
-- inside the callback.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- framed =
--     Reader.withBytes (Bytes.fromString "abcdef") { reader ->
--         inner = Reader.limited reader 3 { frame -> Reader.readUpTo frame 10 }
--         (inner, Reader.readUpTo reader 10)
--     }
--
-- framed == (Bytes.fromString "abc", Bytes.fromString "def")
-- ```
{-# scoped s #-}
limited : Reader e -> Int -> (Reader s ->{s} a) ->{e} a
limited parent allowance action =
    (result, _, _) = limitedRemaining parent allowance action
    result

-- `limited`, also answering the allowance left unread and whether the parent
-- ended before the allowance was used. It does not pull from the parent to
-- find out, so a framed protocol can decide afterwards whether to reuse a
-- connection.
{-# scoped s #-}
limitedRemaining : Reader e -> Int -> (Reader s ->{s} a) ->{e} (a, Int, Bool)
limitedRemaining parent allowance action =
    Runtime.Local.run (clamp allowance allowance, False) { state ->
        result = action
            { buffered = {
                window = parent.buffered()
                (left, _) = state.read()
                Bytes.slice 0 (clamp left (Bytes.length window)) window
              }
            , refill = {
                (left, _) = state.read()
                if Bytes.length parent.buffered() >= left then False
                else
                    grew = parent.refill()
                    if grew == False then state.write (left, True) else ()
                    grew
              }
            , skip = { n ->
                (before, ended) = state.read()
                taken = parent.skip (clamp n before)
                state.write (before - taken, ended)
                taken
              }
            }
        (left, ended) = state.read()
        (result, left, ended)
    }

-- Runs `action` with a reader that pulls from `source` as it needs bytes.
{-# scoped s #-}
over : Source e -> (Reader s ->{s} a) ->{e} a
over source action = buffering Bytes.empty source action

-- Runs `action` with a reader whose buffer starts with `contents`, over a
-- source that has already ended.
{-# scoped s #-}
overBytes : Bytes -> (Reader s ->{s} a) ->{e} a
overBytes contents action = buffering contents { pull = { Nothing } } action

-- Runs `action` with a reader over `contents` in memory. With no other
-- effects in the callback, the call is pure. Nested calls give independent
-- readers that one parser can use together.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- Reader.withBytes (Bytes.fromString "abcdef") { reader -> Reader.readUpTo reader 4 } == Bytes.fromString "abcd"
-- ```
{-# scoped s #-}
withBytes : Bytes -> (Reader s ->{s} a) ->{e} a
withBytes contents action =
    Runtime.Local.run contents { pending ->
        action
            { buffered = pending.read
            , refill = { False }
            , skip = { n ->
                before = pending.read()
                taken = clamp n (Bytes.length before)
                pending.write (Bytes.slice taken (Bytes.length before) before)
                taken
              }
            }
    }

-- ensure loops on a real terminator rather than on a length comparison: it
-- stops because the source said end of input, never because two numbers
-- stopped changing.

-- Grows the buffer until it holds `n` bytes, answering whether it does. It
-- consumes nothing.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- Reader.withBytes (Bytes.fromString "abc") { reader -> Reader.ensure reader 3 }
-- Reader.withBytes (Bytes.fromString "abc") { reader -> Reader.ensure reader 4 } == False
-- ```
ensure : Reader e -> Int ->{e} Bool
ensure reader n =
    if Bytes.length reader.buffered() >= n then
        True
    else if reader.refill() then
        ensure reader n
    else
        False

-- Whether no bytes remain, in hand or in the source.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- Reader.withBytes Bytes.empty { reader -> Reader.atEnd reader }
-- ```
atEnd : Reader e ->{e} Bool
atEnd reader = if ensure reader 1 then False else True

-- Consumes and answers up to `n` bytes: what is in hand, once there is
-- anything at all, so it never waits for bytes the caller said were
-- optional. A short answer is not the end of input; an empty one is.
readUpTo : Reader e -> Int ->{e} Bytes
readUpTo reader n =
    if n <= 0 then
        Bytes.empty
    else
        ignore (ensure reader 1)
        window = reader.buffered()
        take = clamp n (Bytes.length window)
        ignore (reader.skip take)
        Bytes.slice 0 take window

-- Consumes and answers exactly `n` bytes, or `Nothing`, consuming nothing,
-- when fewer remain. The caller still holds what it could not frame.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- Reader.withBytes (Bytes.fromString "abc") { reader -> Reader.readExactly reader 2 } == Just (Bytes.fromString "ab")
-- Reader.withBytes (Bytes.fromString "abc") { reader -> Reader.readExactly reader 4 } == Nothing
-- ```
readExactly : Reader e -> Int ->{e} Maybe Bytes
readExactly reader n =
    if n <= 0 then
        Just Bytes.empty
    else if ensure reader n then
        text = Bytes.slice 0 n reader.buffered()
        ignore (reader.skip n)
        Just text
    else
        Nothing

-- The three distinct answers to a delimited read.
type Read
    -- The run before the delimiter, both consumed.
    = Found Bytes
    -- The unterminated remainder at the end of input, consumed.
    | Ended Bytes
    -- The limit was reached before either; nothing was consumed.
    | Overflowed
    deriving (Eq, Show)

-- A delimiter straddling a refill begins at most one byte short of a full
-- delimiter before the end of what was already scanned, so restarting there
-- finds it and rescans nothing else.
resumeAt : Int -> Int -> Int
resumeAt scanned delimiterLength = clamp (scanned - delimiterLength + 1) scanned

-- scanning doubles what it asks for between scans, so a long run costs a
-- bounded number of native scans rather than one per pull. `ensure` answering
-- False does not mean the window stopped growing — the source can end part way
-- to the target — so the window is remeasured before end of input is believed.
scanning : Reader e -> Bytes -> Int -> Int ->{e} Read
scanning reader delimiter limit scanned =
    window = reader.buffered()
    case Bytes.indexOfFrom (resumeAt scanned (Bytes.length delimiter)) delimiter window of
        Just at ->
            taken = at + Bytes.length delimiter
            if taken > limit then
                Overflowed
            else
                run = Bytes.slice 0 at window
                ignore (reader.skip taken)
                Found run
        Nothing ->
            have = Bytes.length window
            if have >= limit then
                Overflowed
            else if ensure reader (clamp (if have < 1 then 1 else have * 2) limit) then
                scanning reader delimiter limit have
            else if Bytes.length reader.buffered() > have then
                scanning reader delimiter limit have
            else
                ignore (reader.skip have)
                Ended window

-- Reads up to `delimiter`, consuming it without answering it. `limit` bounds
-- the run and its delimiter together, which is all the call will ever
-- buffer: reading an unbounded line from an untrusted peer is a memory bug,
-- so there is no unlimited spelling. A delimiter straddling a refill is
-- found, and the empty delimiter is found at once.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- Reader.withBytes (Bytes.fromString "a;b") { reader -> Reader.readUntil reader (Bytes.fromString ";") 10 } == Reader.Found (Bytes.fromString "a")
-- Reader.withBytes (Bytes.fromString "ab") { reader -> Reader.readUntil reader (Bytes.fromString ";") 10 } == Reader.Ended (Bytes.fromString "ab")
-- Reader.withBytes (Bytes.fromString "abcdef;") { reader -> Reader.readUntil reader (Bytes.fromString ";") 4 } == Reader.Overflowed
-- ```
readUntil : Reader e -> Bytes -> Int ->{e} Read
readUntil reader delimiter limit =
    if limit <= 0 then Overflowed else scanning reader delimiter limit 0

newline : Bytes
newline = Bytes.fromString "\n"

-- `readUntil` at a newline. A CRLF terminator leaves the carriage return on
-- the run, because whether that byte is framing or content is the caller's
-- question; a protocol that says CRLF reads until its own delimiter.
--
-- ```fango
-- import Bytes
-- import Reader
--
-- lines =
--     Reader.withBytes (Bytes.fromString "one\r\ntwo") { reader ->
--         first = Reader.readLine reader 100
--         second = Reader.readLine reader 100
--         [first, second]
--     }
--
-- lines == [Reader.Found (Bytes.fromString "one\r"), Reader.Ended (Bytes.fromString "two")]
-- ```
readLine : Reader e -> Int ->{e} Read
readLine reader limit = readUntil reader newline limit

-- Consumes the rest of the input, handing `action` each chunk as the source
-- produced it, so no chunk is resized or copied on the way.
forEachChunk : Reader e -> (Bytes ->{e} ()) ->{e} ()
forEachChunk reader action =
    if ensure reader 1 then
        window = reader.buffered()
        ignore (reader.skip (Bytes.length window))
        action window
        forEachChunk reader action
    else
        ()

-- The stream carries the reader's effects and an explicit Unit position.
chunkStep reader _ =
    if ensure reader 1 then
        window = reader.buffered()
        ignore (reader.skip (Bytes.length window))
        Just (window, ())
    else Nothing

-- The rest of the input as a stream of the source's chunks. Traversing it
-- advances the reader, so repeated traversals share its position.
--
-- ```fango
-- import Bytes
-- import Reader
-- import Stream
--
-- Reader.withBytes (Bytes.fromString "abc") { reader -> Stream.toList (Reader.chunks reader) } == [Bytes.fromString "abc"]
-- ```
chunks : Reader e -> Stream () Bytes {e}
chunks reader = Stream.unfold () (chunkStep reader)
