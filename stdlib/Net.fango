{-# no-prelude #-}
module Net exposing (Connection, Error(..), Kind(..), Listener, Pool, accept, acceptAsync, closeConnection, closePool, connectionReused, dialTimeout, dialTls, listenerStopped, newPool, poolConnect, poolRelease, readConnectionBytes, setReadDeadline, setWriteDeadline, sink, sinkAsync, source, sourceAsync, stopListener, withClient, withListener, writeConnectionBytes)

import Async
import Basics exposing (..)
import Bytes exposing (Bytes, Sink(..), Source(..))
import Fail exposing (Fail, fromResult)
import IO exposing (IO)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Native
import Runtime.Scope

{- TCP sockets as scoped resources. Listener and Connection contain opaque Go
values with private constructors. Native operations reject sockets after closure. -}

type Kind = ConnectionRefused | ConnectionReset | AddressInUse | TimedOut | Other deriving (Eq, Show)

type Error = { kind : Kind, address : String, message : String } deriving (Eq, Show)

{-# resource #-}
type Listener = Listener Runtime.Native.Any

{-# resource #-}
type Connection = Connection Runtime.Native.Any

listen : Int ->{IO} Result Error Listener
listen = native

closeListener : Listener ->{IO} Result Error ()
closeListener = native

stopListener : Listener ->{IO} Result Error ()
stopListener listener = closeListener listener

listenerStopped : Listener ->{IO} Bool
listenerStopped = native

acceptConnection : Listener ->{IO} Result Error Connection
acceptConnection = native

acceptConnectionAsync : Runtime.Native.Any -> Listener ->{IO} Result Error Connection
acceptConnectionAsync = native

dial : String -> Int ->{IO} Result Error Connection
dial = native

-- Connects within `millis` milliseconds; 0 leaves the limit to the system.
dialTimeout : String -> Int -> Int ->{IO} Result Error Connection
dialTimeout = native

-- Connects and completes a TLS handshake within `millis` milliseconds,
-- verifying the certificate for the host against the system roots plus those
-- in the PEM file at `roots`, unless it is "".
dialTls : String -> Int -> Int -> String ->{IO} Result Error Connection
dialTls = native

-- Idle client connections kept per endpoint, shared safely between tasks.
type Pool = Pool Runtime.Native.Any

-- At most `maxIdle` idle connections per endpoint, each kept `idleMillis`.
newPool : Int -> Int ->{IO} Pool
newPool = native

-- Leases an idle connection to the endpoint, unless `fresh`, or dials one like
-- `dialTls` (when secure, trusting `roots`) or `dialTimeout`.
poolConnect : Pool -> String -> Int -> Int -> Bool -> String -> Bool ->{IO} Result Error Connection
poolConnect = native

-- Ends a lease: a reusable connection returns to the pool, anything else is
-- closed. Releasing again does nothing.
poolRelease : Connection -> Bool ->{IO} Result Error ()
poolRelease = native

-- Whether a leased connection came from the pool rather than a new dial.
connectionReused : Connection ->{IO} Bool
connectionReused = native

closePool : Pool ->{IO} Result Error ()
closePool = native

closeConnection : Connection ->{IO} Result Error ()
closeConnection = native

connectionHasInput : Connection ->{IO} Result Error Bool
connectionHasInput = native

readConnectionBytes : Connection -> Int ->{IO} Result Error Bytes
readConnectionBytes = native

readConnectionBytesAsync : Runtime.Native.Any -> Connection -> Int ->{IO} Result Error Bytes
readConnectionBytesAsync = native

writeConnectionBytes : Connection -> Bytes ->{IO} Result Error ()
writeConnectionBytes = native

writeConnectionBytesAsync : Runtime.Native.Any -> Connection -> Bytes ->{IO} Result Error ()
writeConnectionBytesAsync = native

setReadDeadline : Connection -> Int ->{IO} Result Error ()
setReadDeadline = native

setWriteDeadline : Connection -> Int ->{IO} Result Error ()
setWriteDeadline = native

closeListenerFail : Listener ->{IO, Fail Error} ()
closeListenerFail listener = fromResult (closeListener listener)

closeConnectionFail : Connection ->{IO, Fail Error} ()
closeConnectionFail connection = fromResult (closeConnection connection)

-- withListener binds the wildcard address on port and closes the listener on
-- every exit from action.
withListener : Int -> (Listener ->{IO, Fail Error | e} a) ->{IO, Fail Error | e} a
withListener port action =
    Runtime.Scope.bracket { fromResult (listen port) } closeListenerFail action

-- accept waits for one client and scopes the accepted connection.
accept : Listener -> (Connection ->{IO, Fail Error | e} a) ->{IO, Fail Error | e} a
accept listener action =
    Runtime.Scope.bracket { fromResult (acceptConnection listener) } closeConnectionFail action

acceptAsync : Listener -> (Connection ->{IO, Fail Error, Async.Async err | e} a) ->{IO, Fail Error, Async.Async err | e} a
acceptAsync listener action =
    token = Async.contextToken()
    Runtime.Scope.bracket { fromResult (acceptConnectionAsync token listener) } closeConnectionFail action

-- withClient connects to host and port and scopes the connection.
withClient : String -> Int -> (Connection ->{IO, Fail Error | e} a) ->{IO, Fail Error | e} a
withClient host port action =
    Runtime.Scope.bracket { fromResult (dial host port) } closeConnectionFail action

chunk : Int
chunk = 8192

readBytes : Connection ->{IO, Fail Error} Maybe Bytes
readBytes connection =
    data = fromResult (readConnectionBytes connection chunk)
    if Bytes.length data == 0 then Nothing else Just data

source : Connection -> Source {IO, Fail Error}
source connection = Source { pull = { readBytes connection } }

readBytesAsync : Runtime.Native.Any -> Connection ->{IO, Fail Error} Maybe Bytes
readBytesAsync token connection =
    data = fromResult (readConnectionBytesAsync token connection chunk)
    if Bytes.length data == 0 then Nothing else Just data

sourceAsync : Connection ->{Async.Async err} Source {IO, Fail Error}
sourceAsync connection =
    token = Async.contextToken()
    Source { pull = { readBytesAsync token connection } }

sink : Connection -> Sink {IO, Fail Error}
sink connection = Sink { write = { data -> fromResult (writeConnectionBytes connection data) } }

sinkAsync : Connection ->{Async.Async err} Sink {IO, Fail Error}
sinkAsync connection =
    token = Async.contextToken()
    Sink { write = { data -> fromResult (writeConnectionBytesAsync token connection data) } }
