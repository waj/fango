module Basics exposing (Num(..), Eq(..), Ord(..), Show(..), modBy, remainderBy)

class Num a
    fromInt : Int -> a
    add : a -> a -> a
    sub : a -> a -> a
    mul : a -> a -> a
    negate : a -> a

class Eq a
    eq : a -> a -> Bool

class Ord a
    lt : a -> a -> Bool
    gt : a -> a -> Bool
    le : a -> a -> Bool
    ge : a -> a -> Bool

class Show a
    show : a -> String

intAdd : Int -> Int -> Int
intAdd = native "$1 + $2"

intSub : Int -> Int -> Int
intSub = native "$1 - $2"

intMul : Int -> Int -> Int
intMul = native "$1 * $2"

intEq : Int -> Int -> Bool
intEq = native "$1 == $2"

intLt : Int -> Int -> Bool
intLt = native "$1 < $2"

intGt : Int -> Int -> Bool
intGt = native "$1 > $2"

intLe : Int -> Int -> Bool
intLe = native "$1 <= $2"

intGe : Int -> Int -> Bool
intGe = native "$1 >= $2"

intNegate : Int -> Int
intNegate = native "-$1"

intShow : Int -> String
intShow = native "fangort.ShowInt($1)"

floatAdd : Float -> Float -> Float
floatAdd = native "$1 + $2"

floatSub : Float -> Float -> Float
floatSub = native "$1 - $2"

floatMul : Float -> Float -> Float
floatMul = native "$1 * $2"

floatEq : Float -> Float -> Bool
floatEq = native "$1 == $2"

floatLt : Float -> Float -> Bool
floatLt = native "$1 < $2"

floatGt : Float -> Float -> Bool
floatGt = native "$1 > $2"

floatLe : Float -> Float -> Bool
floatLe = native "$1 <= $2"

floatGe : Float -> Float -> Bool
floatGe = native "$1 >= $2"

floatNegate : Float -> Float
floatNegate = native "-$1"

floatShow : Float -> String
floatShow = native "fangort.ShowFloat($1)"

stringEq : String -> String -> Bool
stringEq = native "$1 == $2"

stringLt : String -> String -> Bool
stringLt = native "$1 < $2"

stringGt : String -> String -> Bool
stringGt = native "$1 > $2"

stringLe : String -> String -> Bool
stringLe = native "$1 <= $2"

stringGe : String -> String -> Bool
stringGe = native "$1 >= $2"

stringShow : String -> String
stringShow = native "fangort.ShowString($1)"

boolEq : Bool -> Bool -> Bool
boolEq = native "$1 == $2"

boolShow : Bool -> String
boolShow = native "fangort.ShowBool($1)"

charEq : Char -> Char -> Bool
charEq = native "$1 == $2"

charLt : Char -> Char -> Bool
charLt = native "$1 < $2"

charGt : Char -> Char -> Bool
charGt = native "$1 > $2"

charLe : Char -> Char -> Bool
charLe = native "$1 <= $2"

charGe : Char -> Char -> Bool
charGe = native "$1 >= $2"

charShow : Char -> String
charShow = native "fangort.ShowChar($1)"

floatFromInt : Int -> Float
floatFromInt = native "float64($1)"

instance Num Int
    fromInt x = x
    add x y = intAdd x y
    sub x y = intSub x y
    mul x y = intMul x y
    negate x = intNegate x

instance Num Float
    fromInt x = floatFromInt x
    add x y = floatAdd x y
    sub x y = floatSub x y
    mul x y = floatMul x y
    negate x = floatNegate x

instance Eq Int
    eq x y = intEq x y

instance Ord Int
    lt x y = intLt x y
    gt x y = intGt x y
    le x y = intLe x y
    ge x y = intGe x y

instance Show Int
    show x = intShow x

instance Eq Float
    eq x y = floatEq x y

instance Ord Float
    lt x y = floatLt x y
    gt x y = floatGt x y
    le x y = floatLe x y
    ge x y = floatGe x y

instance Show Float
    show x = floatShow x

instance Eq String
    eq x y = stringEq x y

instance Ord String
    lt x y = stringLt x y
    gt x y = stringGt x y
    le x y = stringLe x y
    ge x y = stringGe x y

instance Show String
    show x = stringShow x

instance Eq Bool
    eq x y = boolEq x y

instance Show Bool
    show x = boolShow x

instance Eq Char
    eq x y = charEq x y

instance Ord Char
    lt x y = charLt x y
    gt x y = charGt x y
    le x y = charLe x y
    ge x y = charGe x y

instance Show Char
    show x = charShow x

instance Eq ()
    eq x y = True

instance Show ()
    show x = "()"

neq : Eq a => a -> a -> Bool
neq x y = if eq x y then False else True

fdiv : Float -> Float -> Float
fdiv = native "$1 / $2"

append : String -> String -> String
append = native "$1 + $2"

infix (+) = add
infix (-) = sub
infix (*) = mul
infix (/) = fdiv
infix (++) = append
infix (==) = eq
infix (/=) = neq
infix (<) = lt
infix (>) = gt
infix (<=) = le
infix (>=) = ge

-- Truncated remainder (Go's %): the result has the dividend's sign.
-- A zero divisor crashes the program.
remainderBy : Int -> Int -> Int
remainderBy = native "$2 % $1"

-- Floored modulus: the result has the modulus's sign.
-- A zero modulus crashes the program.
modBy : Int -> Int -> Int
modBy modulus x =
    r = remainderBy modulus x
    if r == 0 then r else if (r < 0) == (modulus < 0) then r else r + modulus
