{-# no-prelude #-}
-- The standard classes, operators, and arithmetic helpers.
--
-- The prelude exposes the classes, `Type`, the operators, `show`,
-- `display`, and `ignore`. The other methods are reached qualified, as in
-- `Basics.negate`, and the integer helpers `modBy`, `remainderBy`, and
-- `quotientBy` need `import Basics exposing (modBy, quotientBy, remainderBy)`.
--
-- The standard classes are independent of each other: in particular, `Ord`
-- does not imply `Eq`.
module Basics exposing (Display(..), Eq(..), Num(..), Ord(..), Show(..), Type, ignore, modBy, quotientBy, remainderBy, (++), (/), (/=), (<|), (|>))

import Text.Builder

-- A runtime witness of a type argument, which directs a call whose result
-- type nothing else determines, as `Json.parse @Person text` does. The
-- witness expression `@T` is its only public constructor.
type Type a = Type

-- Numbers: `Int` and `Float`. An integer literal is a number of any `Num`
-- type, defaulting to `Int` when nothing else decides; a decimal literal is
-- a `Float`.
--
-- ```fango
-- 1 + 2 * 3 == 7
-- 7 - 10 == -3
-- 1.5 * 2.0 == 3.0
-- ```
class Num a
    -- The number equal to an `Int`.
    fromInt : Int -> a
    -- Addition.
    (+) : a -> a -> a
    -- Subtraction.
    (-) : a -> a -> a
    -- Multiplication.
    (*) : a -> a -> a
    -- The number with the opposite sign.
    negate : a -> a

-- Equality. Every standard scalar type has it, and derived instances
-- compare constructors and then their fields, left to right.
class Eq a
    -- Whether two values are equal.
    (==) : a -> a -> Bool

-- Ordering. `Int`, `Float`, `String`, and `Char` have it; derived instances
-- order by constructor, in declaration order, and then by fields, left to
-- right. Strings order by Unicode scalar values.
--
-- ```fango
-- 2 < 3
-- "apple" < "banana"
-- 'a' <= 'a'
-- ```
class Ord a
    -- Whether the first value is less than the second.
    (<) : a -> a -> Bool
    -- Whether the first value is greater than the second.
    (>) : a -> a -> Bool
    -- Whether the first value is less than or equal to the second.
    (<=) : a -> a -> Bool
    -- Whether the first value is greater than or equal to the second.
    (>=) : a -> a -> Bool

-- A value's representation: source-like text that reads back as the value,
-- so strings are quoted. `showArg` is the representation in constructor-
-- argument position, parenthesized where juxtaposition would misread it.
--
-- ```fango
-- show "a" == "\"a\""
-- show (Just 3) == "Just 3"
-- Basics.showArg (Just 3) == "(Just 3)"
-- ```
class Show a
    -- Appends a value's representation. Overrides of `show` must agree with
    -- this method, which nested values and interpolation use.
    showTo : Text.Builder.Builder -> a -> Text.Builder.Builder
    -- Appends a representation in constructor-argument position. Defaults to
    -- `showTo`; override it when the representation needs parentheses.
    showArgTo : Text.Builder.Builder -> a -> Text.Builder.Builder
    showArgTo built value = showTo built value
    -- The representation of a value. Defaults to `showTo` with an empty
    -- builder; an override can return a String directly to avoid allocations.
    show : a -> String
    show value = Text.Builder.toString (showTo Text.Builder.empty value)
    -- The representation in constructor-argument position. Defaults to
    -- `showArgTo` with an empty builder; an override must agree with it.
    showArg : a -> String
    showArg value = Text.Builder.toString (showArgTo Text.Builder.empty value)

-- Text for output. It differs from the representation only where a type
-- deliberately renders as itself, as String and Char do; everything else
-- displays its representation.
--
-- ```fango
-- display "a" == "a"
-- display 'x' == "x"
-- display (Just "a") == "Just \"a\""
-- ```
class Display a
    -- Appends a value's output text to an immutable builder. String
    -- interpolation uses this method, so it should agree with `display`.
    displayTo : Text.Builder.Builder -> a -> Text.Builder.Builder
    -- The text of a value for output. Defaults to rendering into an empty
    -- builder and returning its text.
    display : a -> String
    display value = Text.Builder.toString (displayTo Text.Builder.empty value)

-- Joins two strings.
--
-- ```fango
-- "ab" ++ "cd" == "abcd"
-- ```
(++) : String -> String -> String
(++) = native "$1 + $2"

intAdd : Int -> Int -> Int
intAdd = native "$1 + $2"

intSub : Int -> Int -> Int
intSub = native "$1 - $2"

intMul : Int -> Int -> Int
intMul = native "$1 * $2"

intEq : Int -> Int -> Bool
intEq = native "$1 == $2"

intLt : Int -> Int -> Bool
intLt = native "$1 < $2"

intGt : Int -> Int -> Bool
intGt = native "$1 > $2"

intLe : Int -> Int -> Bool
intLe = native "$1 <= $2"

intGe : Int -> Int -> Bool
intGe = native "$1 >= $2"

intNegate : Int -> Int
intNegate = native "-$1"

floatAdd : Float -> Float -> Float
floatAdd = native "$1 + $2"

floatSub : Float -> Float -> Float
floatSub = native "$1 - $2"

floatMul : Float -> Float -> Float
floatMul = native "$1 * $2"

floatEq : Float -> Float -> Bool
floatEq = native "$1 == $2"

floatLt : Float -> Float -> Bool
floatLt = native "$1 < $2"

floatGt : Float -> Float -> Bool
floatGt = native "$1 > $2"

floatLe : Float -> Float -> Bool
floatLe = native "$1 <= $2"

floatGe : Float -> Float -> Bool
floatGe = native "$1 >= $2"

floatNegate : Float -> Float
floatNegate = native "-$1"

stringEq : String -> String -> Bool
stringEq = native "$1 == $2"

stringLt : String -> String -> Bool
stringLt = native "$1 < $2"

stringGt : String -> String -> Bool
stringGt = native "$1 > $2"

stringLe : String -> String -> Bool
stringLe = native "$1 <= $2"

stringGe : String -> String -> Bool
stringGe = native "$1 >= $2"

stringShow : String -> String
stringShow value = value

boolEq : Bool -> Bool -> Bool
boolEq = native "$1 == $2"

boolShow : Bool -> String
boolShow True = "True"
boolShow False = "False"

charEq : Char -> Char -> Bool
charEq = native "$1 == $2"

charLt : Char -> Char -> Bool
charLt = native "$1 < $2"

charGt : Char -> Char -> Bool
charGt = native "$1 > $2"

charLe : Char -> Char -> Bool
charLe = native "$1 <= $2"

charGe : Char -> Char -> Bool
charGe = native "$1 >= $2"

floatFromInt : Int -> Float
floatFromInt = native "float64($1)"

instance Num Int
    fromInt x = x
    (+) x y = intAdd x y
    (-) x y = intSub x y
    (*) x y = intMul x y
    negate x = intNegate x

instance Num Float
    fromInt x = floatFromInt x
    (+) x y = floatAdd x y
    (-) x y = floatSub x y
    (*) x y = floatMul x y
    negate x = floatNegate x

instance Eq Int
    (==) x y = intEq x y

instance Ord Int
    (<) x y = intLt x y
    (>) x y = intGt x y
    (<=) x y = intLe x y
    (>=) x y = intGe x y

instance Show Int
    showTo built x = Text.Builder.appendInt x built
    showArgTo built x =
        if intLt x 0 then Text.Builder.append ")" (showTo (Text.Builder.append "(" built) x)
        else showTo built x
    show x = Text.Builder.intToString x
    showArg x = if intLt x 0 then "(" ++ Text.Builder.intToString x ++ ")" else Text.Builder.intToString x

instance Eq Float
    (==) x y = floatEq x y

instance Ord Float
    (<) x y = floatLt x y
    (>) x y = floatGt x y
    (<=) x y = floatLe x y
    (>=) x y = floatGe x y

instance Show Float
    showTo built x = Text.Builder.appendFloat x built
    showArgTo built x =
        if floatLt x 0.0 then Text.Builder.append ")" (showTo (Text.Builder.append "(" built) x)
        else showTo built x
    show x = Text.Builder.floatToString x
    showArg x = if floatLt x 0.0 then "(" ++ Text.Builder.floatToString x ++ ")" else Text.Builder.floatToString x

instance Eq String
    (==) x y = stringEq x y

instance Ord String
    (<) x y = stringLt x y
    (>) x y = stringGt x y
    (<=) x y = stringLe x y
    (>=) x y = stringGe x y

instance Show String
    showTo built x = Text.Builder.appendStringLiteral x built
    show x = Text.Builder.stringLiteral x

instance Eq Bool
    (==) x y = boolEq x y

instance Show Bool
    showTo built x = Text.Builder.append (boolShow x) built
    show x = boolShow x

instance Eq Char
    (==) x y = charEq x y

instance Ord Char
    (<) x y = charLt x y
    (>) x y = charGt x y
    (<=) x y = charLe x y
    (>=) x y = charGe x y

instance Show Char
    showTo built x = Text.Builder.appendCharLiteral x built
    show x = Text.Builder.charLiteral x

instance Eq ()
    (==) x y = True

instance Show ()
    showTo built () = Text.Builder.append "()" built
    show x = "()"

instance Show a => Display a
    displayTo built value = showTo built value
    display value = show value

instance Display String
    displayTo built value = Text.Builder.append value built
    display value = stringShow value

instance Display Char
    displayTo built value = Text.Builder.appendChar value built
    display value = Text.Builder.charToString value

instance Display Int
    displayTo built value = Text.Builder.appendInt value built
    display value = Text.Builder.intToString value

instance Display Float
    displayTo built value = Text.Builder.appendFloat value built
    display value = Text.Builder.floatToString value

instance Display Bool
    displayTo built True = Text.Builder.append "True" built
    displayTo built False = Text.Builder.append "False" built
    display value = boolShow value

instance Display ()
    displayTo built () = Text.Builder.append "()" built
    display () = "()"

-- Whether two values differ: the negation of `(==)`.
--
-- ```fango
-- 1 /= 2
-- ```
(/=) : Eq a => a -> a -> Bool
(/=) x y = if x == y then False else True

-- Floating-point division. Integers divide with `quotientBy`.
--
-- ```fango
-- 7.0 / 2.0 == 3.5
-- ```
(/) : Float -> Float -> Float
(/) = native "$1 / $2"

-- The precedences the language used to fix in its parser, now declared
-- like any other operator's.
infixl 7 (*)
infixl 7 (/)
infixl 6 (+)
infixl 6 (-)
infixr 5 (++)
infix 4 (==)
infix 4 (/=)
infix 4 (<)
infix 4 (>)
infix 4 (<=)
infix 4 (>=)

-- The remainder of dividing `x` by `divisor`, truncated: it has the
-- dividend's sign and pairs with `quotientBy`. A zero divisor crashes the
-- program.
--
-- ```fango
-- import Basics exposing (modBy, quotientBy, remainderBy)
--
-- remainderBy 3 7 == 1
-- remainderBy 3 (-4) == -1
-- ```
remainderBy : Int -> Int -> Int
remainderBy = native "$2 % $1"

-- `x` modulo `modulus`, floored: the result has the modulus's sign. A zero
-- modulus crashes the program.
--
-- ```fango
-- import Basics exposing (modBy, quotientBy, remainderBy)
--
-- modBy 3 (-4) == 2
-- modBy (-3) 4 == -2
-- ```
modBy : Int -> Int -> Int
modBy modulus x =
    r = remainderBy modulus x
    if r == 0 then r else if (r < 0) == (modulus < 0) then r else r + modulus

-- `x` divided by `divisor`, rounded toward zero, so
-- `quotientBy d x * d + remainderBy d x` is `x`. A zero divisor crashes the
-- program.
--
-- ```fango
-- import Basics exposing (modBy, quotientBy, remainderBy)
--
-- quotientBy 3 7 == 2
-- quotientBy 3 (-7) == -2
-- ```
quotientBy : Int -> Int -> Int
quotientBy = native "$2 / $1"

-- Discard an answer. A call stands as a statement only where its type is
-- Unit; a block discards with `_ = f x`, and `ignore (f x)` says the same in
-- expression position. The argument is evaluated before the call, as every
-- argument is.
--
-- ```fango
-- ignore 42 == ()
-- ```
ignore : a -> ()
ignore _ = ()

-- Passes a value to a function: `x |> f` is `f x`. It binds loosest and
-- associates left, so a pipeline reads in the order it runs. `fn`'s effects
-- are the call's.
--
-- ```fango
-- ([1, 2, 3] |> List.map { n -> n * 2 } |> List.length) == 3
-- ```
(|>) : a -> (a ->{e} b) ->{e} b
(|>) value fn = fn value

-- Applies a function to a value: `f <| x` is `f x`. It binds loosest and
-- associates right, which saves parentheses around a last argument. `fn`'s
-- effects are the call's.
--
-- ```fango
-- (List.length <| List.range 1 4) == 4
-- ```
(<|) : (a ->{e} b) -> a ->{e} b
(<|) fn value = fn value

infixl 0 (|>)
infixr 0 (<|)
