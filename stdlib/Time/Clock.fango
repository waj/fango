-- Scoped access to the current moment and a default zone. Install runSystem
-- or runSystemIn explicitly in production. Tests can freeze time with
-- runFixed, advance each reading with runStepped, or let real time pass from
-- a chosen moment with runOffset. withZone changes only the default zone of
-- an enclosing clock. Existing values never consult this effect for arithmetic.
-- Handlers nest and are inherited by tasks like other effects. None carries
-- Fail; an advancing clock outside the supported instants is a runtime fault.
--
-- ```fango
-- import Time.Clock as Clock
-- import Time.Date as Date
-- import Time.DateTime as DT
-- import Time.Zone as Zone
-- import Fail
-- import Result exposing (Result(..))
--
-- result = Fail.attempt {
--     fixed = DT.parse "2026-01-31T23:00:00-03:00"
--     Clock.runFixed fixed { (Date.toIso Clock.today(), Date.toIso (Clock.todayIn Zone.utc)) }
--     }
-- result == Ok ("2026-01-31", "2026-02-01")
-- ```
module Time.Clock exposing (Clock(..), now, nowIn, runFixed, runOffset, runStepped, runSystem, runSystemIn, today, todayIn, withZone)

import Fail
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Runtime.Entry
import Runtime.Native
import State
import Time.Date as Date
import Time.DateTime as DateTime
import Time.Duration as Duration
import Time.Instant as Instant
import Time.Internal as Checked
import Time.Zone as Zone

-- Reads the clock. A `main` that performs it runs under `runSystem` unless
-- it installs another runner; elsewhere it needs a handler.
#[Runtime.Entry.DefaultHandler `runSystem`]
effect Clock
    -- The current moment.
    instant : () -> Instant.Instant
    -- The default zone that now and today use.
    zone : () -> Zone.Zone

type Sample = Sample Runtime.Native.Any
clockRead : () ->{IO} Sample
clockRead = native
clockSeconds : Sample -> Int
clockSeconds = native
clockNanos : Sample -> Int
clockNanos = native

type Elapsed = Elapsed Runtime.Native.Any
clockElapsedRead : Sample ->{IO} Elapsed
clockElapsedRead = native
clockElapsedSeconds : Elapsed -> Int
clockElapsedSeconds = native
clockElapsedNanos : Elapsed -> Int
clockElapsedNanos = native
clockRangeFault : String -> Int
clockRangeFault = native

advance runner duration value = case Fail.attempt { Instant.add duration value } of
    Ok next -> next
    Err _ -> Checked.Instant (clockRangeFault runner) 0

-- The current moment in the default zone.
now : () ->{Clock} DateTime.DateTime
now() = DateTime.fromInstant zone() instant()

-- The current moment in the given zone.
nowIn : Zone.Zone ->{Clock} DateTime.DateTime
nowIn target = DateTime.fromInstant target instant()

-- The date from a single reading of the clock, in the default zone.
today : () ->{Clock} Date.Date
today() = DateTime.date now()

-- The date from a single reading of the clock, in the given zone.
todayIn : Zone.Zone ->{Clock} Date.Date
todayIn target = DateTime.date (nowIn target)

-- Answers every reading with the same moment and the value's zone, without
-- performing IO.
runFixed : DateTime.DateTime -> (() ->{Clock | e} a) ->{e} a
runFixed value action =
    handle action() on
        instant () -> resume (DateTime.toInstant value)
        zone () -> resume (DateTime.zone value)

-- Starts at value and advances by real elapsed time measured monotonically
-- from runner entry, performing IO. The first reading may already be later
-- than value. System wall-clock adjustments do not change the progression.
-- Readings use value's zone; leaving the supported instant range is a runtime
-- fault. Tasks inherit the same elapsed-time origin.
--
-- ```fango
-- import Time.Clock as Clock
-- import Time.DateTime as DT
-- import Fail
-- import Result exposing (Result(..))
--
-- result = Fail.attempt {
--     start = DT.parse "2000-01-01T00:00:00Z"
--     Clock.runOffset start { Clock.now() >= start }
--     }
-- result == Ok True
-- ```
runOffset : DateTime.DateTime -> (() ->{Clock | e} a) ->{IO | e} a
runOffset value action =
    anchor = clockRead()
    initial = DateTime.toInstant value
    handle action() on
        instant () ->
            elapsed = clockElapsedRead anchor
            duration = Duration.fromParts (clockElapsedSeconds elapsed) (clockElapsedNanos elapsed)
            resume (advance "Clock.runOffset" duration initial)
        zone () -> resume (DateTime.zone value)

-- Answers the first instant reading with value, then advances each subsequent
-- reading by step, without IO. step is an exact signed duration: zero freezes
-- time and a negative step moves backwards. now, nowIn, today, and todayIn
-- each consume one reading; zone queries consume none. Readings use value's
-- zone. A requested instant outside the supported range is a runtime fault;
-- the last valid reading still succeeds.
--
-- Nested runners have independent sequences. Tasks that inherit the runner
-- share its sequence: each reading consumes one step exactly once, so
-- simultaneous reads never repeat a value, but which task receives which
-- reading depends on their scheduling.
--
-- ```fango
-- import Time.Clock as Clock
-- import Time.DateTime as DT
-- import Time.Duration as Duration
-- import Fail
-- import Result exposing (Result(..))
--
-- result = Fail.attempt {
--     start = DT.parse "2026-01-31T23:59:59Z"
--     Clock.runStepped start (Duration.seconds 1) {
--         first = Clock.now()
--         second = Clock.now()
--         (DT.toIso first, DT.toIso second)
--         }
--     }
-- result == Ok ("2026-01-31T23:59:59Z", "2026-02-01T00:00:00Z")
-- ```
runStepped : DateTime.DateTime -> Duration.Duration -> (() ->{Clock | e} a) ->{e} a
runStepped value step action =
    initial = DateTime.toInstant value
    result = State.runAtomic (Stepped Nothing) {
        handle action() on
            instant () -> resume (State.update { previous -> stepReading initial step previous })
            zone () -> resume (DateTime.zone value)
    }
    result.value

-- runStepped's last reading, private so that no caller's own `State` handler
-- can intercept the runner's.
type Stepped = Stepped (Maybe Instant.Instant)

stepReading : Instant.Instant -> Duration.Duration -> Stepped -> (Instant.Instant, Stepped)
stepReading initial step previous =
    reading = case previous of
        Stepped Nothing -> initial
        Stepped (Just last) -> advance "Clock.runStepped" step last
    (reading, Stepped (Just reading))

-- Samples the system clock once per reading, with the machine's zone (see
-- Time.Zone.system) as the default, detected when the handler is installed.
runSystem : (() ->{Clock | e} a) ->{IO | e} a
runSystem action = runSystemIn Zone.system() action

-- Samples the system clock once per reading and uses the given default zone.
-- A host clock outside years 1 through 9999 is a runtime fault, not a value.
runSystemIn : Zone.Zone -> (() ->{Clock | e} a) ->{IO | e} a
runSystemIn target action =
    handle action() on
        instant () ->
            sample = clockRead()
            resume (Checked.Instant (clockSeconds sample) (clockNanos sample))
        zone () -> resume target

-- Changes the default zone while readings continue to come from the
-- enclosing clock.
withZone : Zone.Zone -> (() ->{Clock | e} a) ->{Clock | e} a
withZone target action =
    handle action() on
        instant () -> resume instant()
        zone () -> resume target
